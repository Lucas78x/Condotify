@model List<LicenseViewModel>
@{
    ViewData["Title"] = "Licenças";

    // Se você já tiver permissões no Claims/Policy, pode mapear aqui:
    // var canCreate = User.IsInRole("Admin") || User.HasClaim("perm", "licenses:create");
    var canCreate = true;

    string q =  "";
    string status = "all"; // all | full | expired | trial etc
}

<div class="max-w-[1400px]">

    <!-- Top bar -->
    <div class="flex items-center justify-between gap-4 mb-5">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gray-100 grid place-items-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M7 4h10a2 2 0 012 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 012-2z" />
                </svg>
            </div>

            <div>
                <h2 class="text-xl md:text-2xl font-semibold tracking-tight">Licenças</h2>
                <p class="text-sm text-gray-500 -mt-0.5">Gerencie as licenças que você tem acesso</p>
            </div>
        </div>

        @if (canCreate)
        {
            <a href="/Licencas/Nova"
               class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-xl shadow-sm transition">
                <span class="text-lg leading-none">+</span>
                Nova
            </a>
        }
    </div>

    <!-- Filters row -->
    <form method="get" class="flex flex-col lg:flex-row gap-3 mb-5">
        <!-- Search -->
        <div class="flex-1">
            <div class="flex items-center gap-2 bg-white border rounded-xl px-4 py-3 shadow-sm">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 21l-4.3-4.3" />
                    <circle cx="11" cy="11" r="7" />
                </svg>

                <input name="q"
                       value="@q"
                       class="w-full outline-none text-sm"
                       placeholder="Pesquise o nome ou código da licença..." />
            </div>
        </div>

        <!-- Status -->
        <div class="w-full lg:w-80">
            <div class="flex items-center gap-2 bg-white border rounded-xl px-4 py-3 shadow-sm">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>

                <select name="status" class="w-full outline-none text-sm bg-transparent">
                    <option value="all" selected="@(status == "all")">Todas</option>
                    <option value="full" selected="@(status == "full")">Full</option>
                    <option value="expired" selected="@(status == "expired")">Expirado</option>
                    <option value="trial" selected="@(status == "trial")">Trial</option>
                </select>
            </div>
        </div>

        <div class="hidden lg:block">
            <button class="px-5 py-3 rounded-xl bg-blue-600 text-white shadow-sm hover:bg-blue-700 transition">
                Filtrar
            </button>
        </div>
    </form>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">

        @if (Model == null || !Model.Any())
        {
            <div class="col-span-full bg-white border rounded-2xl p-8 text-center text-gray-600">
                Nenhuma licença encontrada.
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                var isExpired = false;
                var badgeClass = isExpired
                ? "bg-gray-200 text-gray-700"
                : "bg-blue-50 text-blue-700";

                <a href="@Url.Action("Detalhes", "Licencas", new { id = item.Id })"
                   class="group bg-white border rounded-2xl shadow-sm hover:shadow-md transition overflow-hidden">

                    <!-- card header -->
                    <div class="p-4 flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <p class="font-semibold text-gray-900 truncate">
                                    @item.Nome
                                </p>

                                <span class="text-gray-400">▾</span>
                            </div>

                            <p class="text-xs text-gray-500 mt-0.5 truncate">
                                @item.Estado
                            </p>
                        </div>

                        <div class="text-right">
                            <p class="text-xs text-gray-400 font-medium">@item.Codigo</p>
                            <span class="inline-flex mt-1 px-2 py-1 rounded-lg text-[11px] font-semibold @badgeClass">
                                @(isExpired ? "Expirado" : ("Full"))
                            </span>
                        </div>
                    </div>

                    <div class="border-t"></div>

                    <!-- card body -->
                    <div class="p-4 space-y-3">
                        <div class="text-sm">
                            <p class="font-semibold text-gray-900">@item.Nome</p>
                            <p class="text-gray-600">@item.Moradores</p>

                            <div class="flex items-center gap-2 text-gray-600 mt-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M12 21s-7-4.5-7-11a7 7 0 1114 0c0 6.5-7 11-7 11z" />
                                    <circle cx="12" cy="10" r="2.5" />
                                </svg>
                                <span>@item.Cidade</span>
                            </div>
                        </div>

                        <div class="text-sm text-blue-700 font-medium">
                            @item.Cidade
                            <div class="text-xs text-gray-500 font-normal">0</div>
                        </div>
                    </div>

                    <!-- subtle hover bar -->
                    <div class="h-1 bg-transparent group-hover:bg-blue-600 transition"></div>
                </a>
            }
        }

    </div>
</div>
