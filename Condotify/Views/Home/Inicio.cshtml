@model List<LicenseViewModel>
@{
    ViewData["Title"] = "Licenças";

    var query = (Context.Request.Query["q"].ToString() ?? "").Trim();
    var licenses = Model ?? new List<LicenseViewModel>();
    var filteredLicenses = string.IsNullOrWhiteSpace(query)
        ? licenses
        : licenses
            .Where(item =>
                (item.Nome ?? "").Contains(query, StringComparison.OrdinalIgnoreCase) ||
                (item.Codigo ?? "").Contains(query, StringComparison.OrdinalIgnoreCase) ||
                (item.Cidade ?? "").Contains(query, StringComparison.OrdinalIgnoreCase) ||
                (item.Estado ?? "").Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();

    var totalResidents = licenses.Sum(item => item.Moradores);
    var hasQuery = !string.IsNullOrWhiteSpace(query);
}

<div class="max-w-[1440px] mx-auto space-y-5">
    <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-2">
            <div class="inline-flex items-center gap-2 rounded-lg border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
                Operação
            </div>
            <div>
                <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-gray-950">Licenças</h2>
                <p class="mt-1 text-sm text-gray-500">Organizações, estrutura e módulos ativos em uma visão rápida.</p>
            </div>
        </div>

        <a href="@Url.Action("Nova", "Licencas")"
           class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-gray-950 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800">
            <span class="text-base leading-none">+</span>
            Nova licença
        </a>
    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
            @successMessage
        </div>
    }

    <section class="grid grid-cols-1 gap-3 md:grid-cols-3">
        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Total</p>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-3xl font-semibold tracking-tight text-gray-950">@licenses.Count</p>
                <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">licenças</span>
            </div>
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Ativas</p>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-3xl font-semibold tracking-tight text-gray-950">@licenses.Count</p>
                <span class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">em operação</span>
            </div>
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Moradores</p>
            <div class="mt-2 flex items-end justify-between">
                <p class="text-3xl font-semibold tracking-tight text-gray-950">@totalResidents</p>
                <span class="rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">vinculados</span>
            </div>
        </div>
    </section>

    <form method="get" class="rounded-lg border border-gray-200 bg-white p-3 shadow-sm">
        <div class="flex flex-col gap-3 lg:flex-row">
            <label class="flex min-h-11 flex-1 items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 focus-within:border-blue-300 focus-within:bg-white focus-within:ring-4 focus-within:ring-blue-50">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 21l-4.3-4.3" />
                    <circle cx="11" cy="11" r="7" />
                </svg>
                <input name="q"
                       value="@query"
                       class="w-full bg-transparent text-sm text-gray-800 outline-none placeholder:text-gray-400"
                       placeholder="Buscar por nome, código, cidade ou estado" />
            </label>

            <div class="flex gap-2">
                <button class="h-11 flex-1 rounded-lg bg-blue-600 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 lg:flex-none">
                    Filtrar
                </button>
                <a href="@Url.Action("Index", "Licencas")"
                   class="inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-gray-200 bg-white px-5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50 lg:flex-none">
                    Limpar
                </a>
            </div>
        </div>
    </form>

    @if (!filteredLicenses.Any())
    {
        <section class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-14 text-center shadow-sm">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M7 4h10a2 2 0 012 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 012-2z" />
                </svg>
            </div>
            <h3 class="mt-4 text-base font-semibold text-gray-950">
                @(hasQuery ? "Nenhuma licença encontrada para a busca" : "Nenhuma licença encontrada")
            </h3>
            <p class="mx-auto mt-1 max-w-md text-sm text-gray-500">
                @(hasQuery ? "Revise o termo pesquisado ou limpe o filtro para voltar à lista completa." : "Crie a primeira licença para começar a configurar blocos, unidades, moradores e equipamentos.")
            </p>
            <div class="mt-5 flex justify-center gap-2">
                @if (hasQuery)
                {
                    <a href="@Url.Action("Index", "Licencas")"
                       class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-200 bg-white px-4 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
                        Limpar filtro
                    </a>
                }
                <a href="@Url.Action("Nova", "Licencas")"
                   class="inline-flex h-10 items-center justify-center rounded-lg bg-gray-950 px-4 text-sm font-semibold text-white transition hover:bg-gray-800">
                    Nova licença
                </a>
            </div>
        </section>
    }
    else
    {
        <section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="grid grid-cols-[1.4fr_0.8fr_0.7fr_0.6fr_0.4fr] gap-4 border-b border-gray-200 bg-gray-50 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-gray-500 max-lg:hidden">
                <span>Licença</span>
                <span>Localização</span>
                <span>Código</span>
                <span>Moradores</span>
                <span></span>
            </div>

            <div class="divide-y divide-gray-100">
                @foreach (var item in filteredLicenses)
                {
                    <a href="@Url.Action("Detalhes", "Licencas", new { id = item.Id })"
                       class="group grid gap-4 px-4 py-4 transition hover:bg-blue-50/40 lg:grid-cols-[1.4fr_0.8fr_0.7fr_0.6fr_0.4fr] lg:items-center">
                        <div class="min-w-0">
                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-950 text-sm font-semibold text-white">
                                    @(string.IsNullOrWhiteSpace(item.Nome) ? "L" : item.Nome.Trim()[0].ToString().ToUpper())
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-gray-950">@item.Nome</p>
                                    <p class="mt-0.5 text-xs text-gray-500">Licença operacional</p>
                                </div>
                            </div>
                        </div>

                        <div class="text-sm text-gray-700">
                            <p class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(item.Cidade) ? "-" : item.Cidade)</p>
                            <p class="text-xs text-gray-500">@(string.IsNullOrWhiteSpace(item.Estado) ? "Sem estado" : item.Estado)</p>
                        </div>

                        <div>
                            <span class="inline-flex rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
                                @(string.IsNullOrWhiteSpace(item.Codigo) ? "-" : item.Codigo)
                            </span>
                        </div>

                        <div class="text-sm">
                            <p class="font-semibold text-gray-950">@item.Moradores</p>
                            <p class="text-xs text-gray-500">moradores</p>
                        </div>

                        <div class="flex justify-start lg:justify-end">
                            <span class="inline-flex h-9 items-center justify-center rounded-lg border border-gray-200 bg-white px-3 text-xs font-semibold text-gray-700 transition group-hover:border-blue-200 group-hover:text-blue-700">
                                Abrir
                            </span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }
</div>
