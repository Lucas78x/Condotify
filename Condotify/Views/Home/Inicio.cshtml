@model List<LicenseViewModel>
@{
    ViewData["Title"] = "Licenças";

    var canCreate = true;

    string q = (Context.Request.Query["q"].ToString() ?? "").Trim();
    string status = (Context.Request.Query["status"].ToString() ?? "all").Trim().ToLower();

}

<div class="max-w-[1400px] mx-auto">

    <!-- Top -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div class="flex items-start gap-3">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white grid place-items-center shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M7 4h10a2 2 0 012 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 012-2z" />
                </svg>
            </div>

            <div class="min-w-0">
                <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Licenças</h2>
                <p class="text-sm text-gray-500 mt-0.5">Gerencie as organizações e o status de cada licença</p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (canCreate)
            {
                <a href="/Licencas/Nova"
                   class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white px-4 py-2.5 rounded-2xl shadow-sm transition">
                    <span class="text-lg leading-none">+</span>
                    Nova licença
                </a>
            }
        </div>
    </div>

    <!-- Quick stats (opcional, mas deixa a home/listagem com cara de SaaS) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="bg-white/80 backdrop-blur border border-gray-200/70 rounded-2xl p-4 shadow-sm">
            <p class="text-xs text-gray-500">Total</p>
            <p class="text-2xl font-semibold text-gray-900">@(Model?.Count ?? 0)</p>
        </div>
        <div class="bg-white/80 backdrop-blur border border-gray-200/70 rounded-2xl p-4 shadow-sm">
            <p class="text-xs text-gray-500">Ativas</p>
            <p class="text-2xl font-semibold text-gray-900">
                @{
                    // Ajuste quando tiver o campo de expiração/status no ViewModel
                    var activeCount = Model?.Count ?? 0;
                }
                @activeCount
            </p>
        </div>
        <div class="bg-white/80 backdrop-blur border border-gray-200/70 rounded-2xl p-4 shadow-sm">
            <p class="text-xs text-gray-500">Expiradas</p>
            <p class="text-2xl font-semibold text-gray-900">0</p>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="bg-white/80 backdrop-blur border border-gray-200/70 rounded-2xl p-3 md:p-4 shadow-sm mb-6">
        <div class="flex flex-col lg:flex-row gap-3">
            <div class="flex-1">
                <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-2xl px-4 py-3">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 21l-4.3-4.3" />
                        <circle cx="11" cy="11" r="7" />
                    </svg>

                    <input name="q"
                           value="@q"
                           class="w-full outline-none text-sm"
                           placeholder="Pesquisar nome, código, cidade…" />
                </div>
            </div>

            <div class="w-full lg:w-72">
                <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-2xl px-4 py-3">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>

                    <select name="status" class="w-full outline-none text-sm bg-transparent">
                        <option value="all" selected="@(status == "all")">Todas</option>
                        <option value="full" selected="@(status == "full")">Full</option>
                        <option value="expired" selected="@(status == "expired")">Expiradas</option>
                        <option value="trial" selected="@(status == "trial")">Trial</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-2">
                <button class="flex-1 lg:flex-none px-5 py-3 rounded-2xl bg-blue-600 text-white shadow-sm hover:bg-blue-700 transition">
                    Filtrar
                </button>
                <a href="/Licencas" class="flex-1 lg:flex-none px-5 py-3 rounded-2xl bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 transition text-center">
                    Limpar
                </a>
            </div>
        </div>
    </form>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">

        @if (Model == null || !Model.Any())
        {
            <div class="col-span-full bg-white/80 backdrop-blur border border-gray-200/70 rounded-2xl p-10 text-center shadow-sm">
                <div class="mx-auto w-12 h-12 rounded-2xl bg-blue-600/10 text-blue-700 grid place-items-center mb-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M7 4h10a2 2 0 012 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 012-2z" />
                    </svg>
                </div>
                <p class="font-semibold text-gray-900">Nenhuma licença encontrada</p>
                <p class="text-sm text-gray-500 mt-1">Tente ajustar os filtros ou criar uma nova licença.</p>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                // TODO: troque isso por campos reais do seu ViewModel
                // Ex: bool isExpired = item.ExpiraEm.HasValue && item.ExpiraEm.Value.Date < DateTime.UtcNow.Date;
                bool isExpired = false;
                bool isTrial = false;

                string badgeText = isExpired ? "Expirada" : (isTrial ? "Trial" : "Full");
                string badgeClass = isExpired
                ? "bg-rose-50 text-rose-700 ring-1 ring-rose-600/20"
                : (isTrial ? "bg-amber-50 text-amber-700 ring-1 ring-amber-600/20"
                : "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20");

                <a href="@Url.Action("Detalhes", "Licencas", new { id = item.Id })"
                   class="group bg-white/85 backdrop-blur border border-gray-200/70 rounded-2xl shadow-sm hover:shadow-md transition overflow-hidden">

                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm text-gray-500">Licença</p>
                                <p class="font-semibold text-gray-900 truncate mt-0.5">@item.Nome</p>

                                <div class="flex items-center gap-2 text-xs text-gray-500 mt-2">
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
                                        <span class="truncate">@item.Estado</span>
                                    </span>
                                </div>
                            </div>

                            <div class="text-right">
                                <p class="text-[11px] text-gray-400 font-medium">Código</p>
                                <p class="text-sm font-semibold text-gray-900">@item.Codigo</p>

                                <span class="inline-flex mt-2 px-2.5 py-1 rounded-xl text-[11px] font-semibold @badgeClass">
                                    @badgeText
                                </span>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-t border-gray-100">
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-xs text-gray-500">Cidade</p>
                                    <div class="flex items-center gap-2 text-sm text-gray-800 font-medium mt-1">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M12 21s-7-4.5-7-11a7 7 0 1114 0c0 6.5-7 11-7 11z" />
                                            <circle cx="12" cy="10" r="2.5" />
                                        </svg>
                                        <span class="truncate">@item.Cidade</span>
                                    </div>
                                </div>

                                <div class="shrink-0 text-right">
                                    <p class="text-xs text-gray-500">Moradores</p>
                                    <p class="text-sm font-semibold text-gray-900 mt-1">@item.Moradores</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="h-1 bg-gradient-to-r from-transparent via-blue-600/0 to-transparent group-hover:via-blue-600 transition"></div>
                </a>
            }
        }
    </div>

</div>