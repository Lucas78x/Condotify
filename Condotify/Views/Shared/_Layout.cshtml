@{
    string currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    Func<string, string> isActive = (path) =>
        currentPath.StartsWith(path.ToLower())
            ? "bg-gray-950 text-white"
            : "text-gray-600 hover:bg-gray-100 hover:text-gray-950";

}

<!DOCTYPE html>
<html lang="pt-br" class="h-full">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Condotify</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">

    <style>
        html, body {
            font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-thumb {
            background: #2563eb;
            border-radius: 999px;
        }
    </style>

</head>

<body class="h-full bg-slate-50 text-gray-900 antialiased">

    <div class="fixed inset-0 -z-10 bg-[linear-gradient(180deg,#f8fafc_0%,#eef2f7_100%)]"></div>

    <div class="min-h-screen flex">

        <!-- SIDEBAR -->
        <aside class="w-72 hidden md:flex flex-col fixed left-0 top-0 h-screen border-r border-gray-200 bg-white">
            <!-- Brand -->
            <div class="h-20 px-6 flex items-center gap-3 border-b border-gray-200">
                <div class="w-10 h-10 rounded-lg bg-gray-950 text-white grid place-items-center font-bold shadow-sm">
                    C
                </div>
                <div class="leading-tight">
                    <p class="font-semibold tracking-tight">Condotify</p>
                    <p class="text-xs text-gray-500">Gestão condominial</p>
                </div>
            </div>

            <!-- Nav -->
            <nav class="p-4 space-y-1 overflow-y-auto">
                <p class="text-[11px] text-gray-400 font-semibold uppercase tracking-wider px-3 mt-2 mb-2">
                    Menu
                </p>

                <a href="/Home/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition @isActive("/home")">
                    <span class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M3 10.5L12 3l9 7.5V21a1 1 0 01-1 1h-5v-7H9v7H4a1 1 0 01-1-1v-10.5z" />
                        </svg>
                    </span>
                    <div class="flex-1">
                        <p class="text-sm font-medium">Dashboard</p>
                        <p class="text-xs text-gray-500">Visão geral</p>
                    </div>
                </a>

                <a href="/Licencas" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition @isActive("/licencas")">
                    <span class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M7 4h10a2 2 0 012 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 012-2z" />
                        </svg>
                    </span>
                    <div class="flex-1">
                        <p class="text-sm font-medium">Licenças</p>
                        <p class="text-xs text-gray-500">Planos e organizações</p>
                    </div>
                </a>

                <a href="/Acessos" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition @isActive("/acessos")">
                    <span class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M12 11c1.656 0 3-1.344 3-3V5a3 3 0 10-6 0v3c0 1.656 1.344 3 3 3z" />
                            <path d="M5 20v-1a7 7 0 1114 0v1H5z" />
                        </svg>
                    </span>
                    <div class="flex-1">
                        <p class="text-sm font-medium">Controle de acessos</p>
                        <p class="text-xs text-gray-500">Eventos e regras</p>
                    </div>
                </a>

                <a href="/Cadastros" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition @isActive("/cadastros")">
                    <span class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M19 8v6M22 11h-6" />
                        </svg>
                    </span>
                    <div class="flex-1">
                        <p class="text-sm font-medium">Cadastros</p>
                        <p class="text-xs text-gray-500">Moradores e visitantes</p>
                    </div>
                </a>

                <a href="/Agendamentos" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition @isActive("/agendamentos")">
                    <span class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M8 7V3m8 4V3M3 11h18" />
                            <path d="M5 7h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2z" />
                        </svg>
                    </span>
                    <div class="flex-1">
                        <p class="text-sm font-medium">Agendamentos</p>
                        <p class="text-xs text-gray-500">Convidados e agenda</p>
                    </div>
                </a>

                <div class="mt-4 pt-4 border-t border-gray-200">
                    <p class="text-[11px] text-gray-400 font-semibold uppercase tracking-wider px-3 mb-2">
                        Sistema
                    </p>

                    <a href="/Config" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition @isActive("/config")">
                        <span class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="3" />
                                <path d="M12 1v6m0 6v6M5.64 5.64l4.24 4.24m4.24 4.24l4.24 4.24M1 12h6m6 0h6M5.64 18.36l4.24-4.24m4.24-4.24l4.24-4.24" />
                            </svg>
                        </span>
                        <div class="flex-1">
                            <p class="text-sm font-medium">Configurações</p>
                            <p class="text-xs text-gray-500">Preferências</p>
                        </div>
                    </a>

                    <a href="/Auth/Logout" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-red-600 hover:bg-red-50">
                        <span class="w-9 h-9 rounded-lg bg-red-50 grid place-items-center">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M19 12H9m10 0l-4 4m4-4l-4-4" />
                                <path d="M5 19V5a2 2 0 012-2h4" />
                            </svg>
                        </span>
                        <div class="flex-1">
                            <p class="text-sm font-semibold">Sair</p>
                            <p class="text-xs text-red-500/80">Encerrar sessão</p>
                        </div>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="w-full md:ml-72 min-h-screen">
            <!-- HEADER -->
            <header class="sticky top-0 z-30 border-b border-gray-200 bg-white/90 backdrop-blur">
                <div class="h-20 px-6 md:px-10 flex items-center justify-between">
                    <div class="min-w-0">
                        <h1 class="text-xl md:text-2xl font-semibold tracking-tight truncate">@ViewData["Title"]</h1>
                        <p class="text-xs md:text-sm text-gray-500 -mt-0.5">Gerencie tudo em um só lugar</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="hidden lg:flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-3 py-2 shadow-sm">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M21 21l-4.3-4.3" />
                                <circle cx="11" cy="11" r="7" />
                            </svg>
                            <input class="outline-none text-sm w-64" placeholder="Buscar…" />
                        </div>

                        <div class="relative">
                            <button type="button" onclick="toggleUserMenu()"
                                    class="flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-3 py-2 shadow-sm hover:border-gray-300 transition">
                                <div class="w-9 h-9 rounded-lg bg-gray-100 grid place-items-center text-gray-700 font-semibold">
                                    L
                                </div>
                                <div class="hidden sm:block text-left leading-tight">
                                    <p class="text-sm font-semibold text-gray-800">Lucas</p>
                                    <p class="text-xs text-gray-500">Administrador</p>
                                </div>
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M6 9l6 6 6-6" />
                                </svg>
                            </button>

                            <div id="userMenu"
                                 class="hidden absolute right-0 mt-3 w-56 bg-white border border-gray-200 rounded-lg shadow-xl overflow-hidden">
                                <div class="px-4 py-3 border-b border-gray-100">
                                    <p class="text-sm font-semibold text-gray-800">Lucas Bastos</p>
                                    <p class="text-xs text-gray-500">lucas@email.com</p>
                                </div>
                                <a href="/Perfil" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Meu Perfil</a>
                                <a href="/Config" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Configurações</a>
                                <a href="/Auth/Logout" class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50">Sair</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- CONTENT -->
            <section class="p-5 md:p-8 lg:p-10">
                @RenderBody()
                @RenderSection("Scripts", required: false)
            </section>
        </main>
    </div>

    <script>
        function toggleUserMenu() {
            document.getElementById("userMenu")?.classList.toggle("hidden");
        }
        document.addEventListener("click", function (e) {
            const menu = document.getElementById("userMenu");
            if (!menu) return;

            const button = e.target.closest("button");
            const clickedInside = e.target.closest("#userMenu");
            if (!button && !clickedInside) menu.classList.add("hidden");
        });
    </script>

</body>
</html>
