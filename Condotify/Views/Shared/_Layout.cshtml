@{
    Layout = null;

    string currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    Func<string, string> isActive = (path) =>
        currentPath.StartsWith(path.ToLower())
        ? "bg-blue-50 border-r-4 border-blue-600 text-blue-700 font-semibold"
        : "text-gray-700 hover:bg-gray-100";
}

<!DOCTYPE html>
<html lang="pt-br" class="h-full bg-gray-100">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - FeF Access</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Inter font -->
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">

    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-thumb {
            background: #2563eb;
            border-radius: 8px;
        }

        .glass {
            background: rgba(255,255,255,0.80);
            backdrop-filter: blur(14px);
        }

        .menu-item svg {
            transition: .2s;
        }

        .menu-item:hover svg {
            transform: scale(1.1);
        }
    </style>
</head>

<body class="h-full flex bg-gray-50 font-inter">

    <!-- SIDEBAR -->
    <aside class="w-64 glass border-r h-screen fixed left-0 top-0 shadow-xl">

        <!-- LOGO -->
        <div class="p-6 border-b flex justify-center">
            <img src="/assets/logo/logo.png"
                 class="w-36 max-h-14 object-contain drop-shadow-md select-none"
                 draggable="false" />
        </div>

        <!-- MENU -->
        <nav class="p-4 space-y-2">

            <p class="text-gray-400 text-xs uppercase font-bold px-2 tracking-wider">Menu</p>

            <!-- Licenças -->
            <a href="/Licencas"
               class="menu-item flex items-center gap-3 p-3 rounded-xl transition-all duration-200
               @(currentPath == "/" || currentPath.StartsWith("/home") ?
                "bg-blue-50 border-r-4 border-blue-600 text-blue-700 font-semibold" :
                "text-gray-700 hover:bg-gray-100")">

                <svg class="w-5 h-5 text-blue-600" stroke="currentColor" fill="none" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M3 5h18M3 12h18M3 19h18" />
                </svg>

                <span>Licenças</span>
            </a>

            <!-- Controle de Acessos -->
            <a href="/Acessos"
               class="menu-item flex items-center gap-3 p-3 rounded-xl transition-all duration-200
              @isActive("/acessos")">

                <svg class="w-5 h-5 text-blue-600" stroke="currentColor" fill="none" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M12 11c1.656 0 3-1.344 3-3V5a3 3 0 10-6 0v3c0 1.656 1.344 3 3 3z" />
                    <path d="M5 20v-1a7 7 0 1114 0v1H5z" />
                </svg>

                <span>Controle de Acessos</span>
            </a>

            <!-- Cadastros -->
            <a href="/Cadastros"
               class="menu-item flex items-center gap-3 p-3 rounded-xl transition-all duration-200
              @isActive("/cadastros")">

                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M4 6h16M4 12h16M4 18h7" />
                </svg>

                <span>Cadastros</span>
            </a>

            <!-- Agendamentos -->
            <a href="/Agendamentos"
               class="menu-item flex items-center gap-3 p-3 rounded-xl transition-all duration-200
              @isActive("/agendamentos")">

                <svg class="w-5 h-5 text-blue-600" stroke="currentColor" fill="none" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path d="M12 6v6l4 2" />
                    <circle cx="12" cy="12" r="10" />
                </svg>

                <span>Agendamentos</span>
            </a>

        </nav>
    </aside>

    <!-- MAIN -->
    <main class="ml-64 w-full min-h-screen">

        <!-- HEADER -->
        <header class="glass w-full h-20 border-b shadow-md flex justify-between items-center px-10 sticky top-0 z-20">

            <h1 class="text-2xl font-semibold text-gray-800">@ViewData["Title"]</h1>

            <div class="relative">

                <img src="/assets/home/profile.jpg"
                     onclick="toggleUserMenu()"
                     class="w-11 h-11 rounded-full shadow cursor-pointer hover:ring-2 hover:ring-blue-400 transition" />

                <!-- Dropdown -->
                <div id="userMenu"
                     class="hidden absolute right-0 mt-3 w-48 bg-white border rounded-xl shadow-xl z-50">

                    <div class="px-4 py-3 border-b">
                        <p class="text-sm font-semibold text-gray-800">Lucas Bastos</p>
                        <p class="text-xs text-gray-500">lucas@email.com</p>
                    </div>

                    <a href="/Perfil"
                       class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        Meu Perfil
                    </a>

                    <a href="/Config"
                       class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                        Configurações
                    </a>

                    <a href="/Auth/Logout"
                       class="m-2 px-4 py-2 bg-red-500 hover:bg-red-600 text-white text-sm rounded-xl shadow flex items-center gap-2 transition">

                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M19 12H9m10 0l-4 4m4-4l-4-4" />
                            <path d="M5 19V5a2 2 0 012-2h4" />
                        </svg>

                        Sair
                    </a>
                </div>

            </div>
        </header>

        <!-- CONTENT -->
        <section class="p-10">
            @RenderBody()
            @RenderSection("Scripts", required: false)
        </section>

    </main>

</body>

<script>
    function toggleUserMenu() {
        document.getElementById("userMenu").classList.toggle("hidden");
    }
</script>

</html>
