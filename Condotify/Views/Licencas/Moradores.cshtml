@model ResidentsPageViewModel
@{
    ViewData["Title"] = "Moradores";
}

<div class="max-w-[1400px] mx-auto space-y-6">
    @await Html.PartialAsync("_LicenseModuleHeader", Model)

    <form method="post" class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm overflow-hidden">
        @Html.AntiForgeryToken()
        <div class="px-5 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900">Cadastrar morador</h3>
        </div>
        <div class="p-5 grid grid-cols-1 md:grid-cols-3 gap-4">
            <label class="space-y-1 md:col-span-2">
                <span class="text-sm font-medium text-gray-700">Nome</span>
                <input name="Name" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Unidade</span>
                <select name="UnitId" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15">
                    <option value="">Selecione</option>
                    @foreach (var block in Model.Blocks)
                    {
                        foreach (var unit in block.Units)
                        {
                            <option value="@unit.Id">@block.Name / @unit.Number</option>
                        }
                    }
                </select>
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">E-mail</span>
                <input name="Email" type="email" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Telefone</span>
                <input name="PhoneNumber" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">CPF</span>
                <input name="CPF" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">RG</span>
                <input name="RG" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Tipo</span>
                <select name="AccessType" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15">
                    <option value="0">Responsável</option>
                    <option value="1">Morador</option>
                    <option value="2">Visitante</option>
                    <option value="3">Prestador</option>
                </select>
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Expira em</span>
                <input name="Expire" type="date" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="md:col-span-3 inline-flex items-center gap-2 text-sm text-gray-700">
                <input name="Temporary" type="checkbox" value="true" class="h-4 w-4 rounded border-gray-300 text-blue-600" />
                Acesso temporário
            </label>
        </div>
        <div class="px-5 py-4 border-t border-gray-100 flex justify-end">
            <button class="px-5 py-3 rounded-2xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
                Salvar morador
            </button>
        </div>
    </form>

    <section class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900">Moradores cadastrados</h3>
        </div>
        @{
            var residents = Model.Blocks
                .SelectMany(block => block.Units)
                .SelectMany(unit => unit.Residents)
                .OrderBy(resident => resident.Name)
                .ToList();
        }
        @if (!residents.Any())
        {
            <div class="p-8 text-center text-gray-500">Nenhum morador cadastrado.</div>
        }
        else
        {
            <div class="divide-y divide-gray-100">
                @foreach (var resident in residents)
                {
                    <div class="px-5 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                        <div>
                            <p class="font-medium text-gray-900">@resident.Name</p>
                            <p class="text-sm text-gray-500">@resident.Email · Unidade @resident.UnitNumber</p>
                        </div>
                        <div class="flex flex-wrap gap-2 text-xs">
                            <span class="rounded-full bg-gray-100 px-2.5 py-1 text-gray-700">@resident.AccessType</span>
                            @if (resident.Temporary)
                            {
                                <span class="rounded-full bg-amber-50 px-2.5 py-1 text-amber-700">Temporário</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
