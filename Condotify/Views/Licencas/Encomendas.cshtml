@model DeliveriesPageViewModel
@{
    ViewData["Title"] = "Encomendas";

    var deliveryTypes = new[]
    {
        new { Value = 1, Label = "Correios" },
        new { Value = 2, Label = "SEDEX" },
        new { Value = 3, Label = "PAC" },
        new { Value = 10, Label = "Jadlog" },
        new { Value = 11, Label = "Total Express" },
        new { Value = 30, Label = "Mercado Livre" },
        new { Value = 31, Label = "Amazon" },
        new { Value = 32, Label = "Shopee" },
        new { Value = 60, Label = "iFood" },
        new { Value = 80, Label = "Mercado" },
        new { Value = 81, Label = "Farmacia" },
        new { Value = 100, Label = "Agua" },
        new { Value = 101, Label = "Gas" },
        new { Value = 102, Label = "Documentos" },
        new { Value = 103, Label = "Encomenda Particular" },
        new { Value = 999, Label = "Outros" }
    };

    string StatusClass(int status) => status switch
    {
        2 => "bg-blue-50 text-blue-700 ring-blue-600/20",
        3 => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
        4 => "bg-rose-50 text-rose-700 ring-rose-600/20",
        _ => "bg-amber-50 text-amber-700 ring-amber-600/20"
    };

    string StatusLabel(DeliveryRowViewModel delivery) => delivery.StatusValue switch
    {
        1 => "Pendente",
        2 => "Recebida",
        3 => "Entregue",
        4 => "Cancelada",
        _ => delivery.Status
    };
}

<div class="max-w-[1400px] mx-auto space-y-6">
    @await Html.PartialAsync("_LicenseModuleHeader", Model)

    <div class="grid grid-cols-1 xl:grid-cols-[420px_1fr] gap-4">
        <form method="post" class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm p-5 h-fit">
            @Html.AntiForgeryToken()
            <h3 class="font-semibold text-gray-900">Registrar encomenda</h3>

            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">Tipo</span>
                <select name="Type" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15">
                    @foreach (var type in deliveryTypes)
                    {
                        <option value="@type.Value">@type.Label</option>
                    }
                </select>
            </label>

            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">Nome</span>
                <input name="Name" required class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" placeholder="Ex.: Caixa pequena para unidade 101" />
            </label>

            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">Codigo de rastreio</span>
                <input name="TrackingCode" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>

            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">Recebido por</span>
                <input name="ReceivedBy" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" placeholder="Portaria" />
            </label>

            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">Descricao</span>
                <textarea name="Description" rows="3" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15"></textarea>
            </label>

            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">URL da foto</span>
                <input name="PhotoUrl" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>

            <button class="mt-4 w-full px-5 py-3 rounded-2xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
                Registrar recebimento
            </button>
        </form>

        <section class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                <div>
                    <h3 class="font-semibold text-gray-900">Fila da portaria</h3>
                    <p class="text-sm text-gray-500">@Model.Deliveries.Count encomenda(s) cadastrada(s)</p>
                </div>
            </div>

            @if (!Model.Deliveries.Any())
            {
                <div class="p-8 text-center text-gray-500">Nenhuma encomenda encontrada.</div>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var delivery in Model.Deliveries)
                    {
                        <article class="p-5 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-4">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ring-1 @StatusClass(delivery.StatusValue)">
                                        @StatusLabel(delivery)
                                    </span>
                                    <span class="text-xs text-gray-500">@delivery.Type</span>
                                    @if (!string.IsNullOrWhiteSpace(delivery.TrackingCode))
                                    {
                                        <span class="text-xs text-gray-500">Rastreio: @delivery.TrackingCode</span>
                                    }
                                </div>

                                <h4 class="mt-2 font-semibold text-gray-900">@delivery.Name</h4>
                                @if (!string.IsNullOrWhiteSpace(delivery.Description))
                                {
                                    <p class="mt-1 text-sm text-gray-600">@delivery.Description</p>
                                }

                                <dl class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
                                    <div>
                                        <dt class="text-gray-500">Recebida por</dt>
                                        <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(delivery.ReceivedBy) ? "-" : delivery.ReceivedBy)</dd>
                                    </div>
                                    <div>
                                        <dt class="text-gray-500">Recebida em</dt>
                                        <dd class="font-medium text-gray-900">@(delivery.ReceivedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                                    </div>
                                    <div>
                                        <dt class="text-gray-500">Entregue para</dt>
                                        <dd class="font-medium text-gray-900">@(string.IsNullOrWhiteSpace(delivery.DeliveredTo) ? "-" : delivery.DeliveredTo)</dd>
                                    </div>
                                </dl>
                            </div>

                            <div class="space-y-3">
                                @if (delivery.StatusValue != 3 && delivery.StatusValue != 4)
                                {
                                    <form method="post" action="@Url.Action("AlterarStatusEncomenda", "Licencas", new { id = Model.LicenseId })" class="space-y-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="DeliveryId" value="@delivery.Id" />
                                        <input type="hidden" name="Status" value="3" />
                                        <input name="PersonName" class="w-full rounded-2xl border border-gray-200 px-4 py-2 text-sm outline-none focus:ring-4 focus:ring-emerald-500/15" placeholder="Retirado por" />
                                        <input name="ProofUrl" class="w-full rounded-2xl border border-gray-200 px-4 py-2 text-sm outline-none focus:ring-4 focus:ring-emerald-500/15" placeholder="URL do comprovante" />
                                        <button class="w-full px-4 py-2 rounded-2xl bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition">
                                            Marcar como entregue
                                        </button>
                                    </form>

                                    <form method="post" action="@Url.Action("AlterarStatusEncomenda", "Licencas", new { id = Model.LicenseId })">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="DeliveryId" value="@delivery.Id" />
                                        <input type="hidden" name="Status" value="4" />
                                        <button class="w-full px-4 py-2 rounded-2xl border border-rose-200 bg-rose-50 text-rose-700 text-sm font-semibold hover:bg-rose-100 transition">
                                            Cancelar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="rounded-2xl bg-gray-50 px-4 py-3 text-sm text-gray-500">
                                        Fluxo encerrado.
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>
