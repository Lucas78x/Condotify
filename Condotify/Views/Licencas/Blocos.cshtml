@model BlocksPageViewModel
@{
    ViewData["Title"] = "Blocos";
}

<div class="max-w-[1400px] mx-auto space-y-6">
    @await Html.PartialAsync("_LicenseModuleHeader", Model)

    <div class="grid grid-cols-1 lg:grid-cols-[420px_1fr] gap-4">
        <form method="post" class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm p-5 h-fit">
            @Html.AntiForgeryToken()
            <h3 class="font-semibold text-gray-900">Novo bloco</h3>
            <label class="block mt-4 space-y-1">
                <span class="text-sm font-medium text-gray-700">Nome</span>
                <input name="Name" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <button class="mt-4 w-full px-5 py-3 rounded-2xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
                Salvar bloco
            </button>
        </form>

        <section class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100">
                <h3 class="font-semibold text-gray-900">Blocos cadastrados</h3>
            </div>
            @if (!Model.Blocks.Any())
            {
                <div class="p-8 text-center text-gray-500">Nenhum bloco encontrado.</div>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var block in Model.Blocks)
                    {
                        <div class="px-5 py-4 flex items-center justify-between gap-4">
                            <div>
                                <p class="font-medium text-gray-900">@block.Name</p>
                                <p class="text-sm text-gray-500">@block.Id</p>
                            </div>
                            <div class="flex gap-6 text-right">
                                <div><p class="text-xs text-gray-500">Unidades</p><p class="font-semibold">@block.TotalUnits</p></div>
                                <div><p class="text-xs text-gray-500">Moradores</p><p class="font-semibold">@block.TotalResidents</p></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
