@model UnitsPageViewModel
@{
    ViewData["Title"] = "Unidades";
}

<div class="max-w-[1400px] mx-auto space-y-6">
    @await Html.PartialAsync("_LicenseModuleHeader", Model)

    <form method="post" class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm overflow-hidden">
        @Html.AntiForgeryToken()
        <div class="px-5 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900">Cadastrar unidade</h3>
        </div>
        <div class="p-5 grid grid-cols-1 md:grid-cols-3 gap-4">
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Bloco</span>
                <select name="BlockId" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15">
                    <option value="">Selecione</option>
                    @foreach (var block in Model.Blocks)
                    {
                        <option value="@block.Id">@block.Name</option>
                    }
                </select>
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Número</span>
                <input name="Number" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
            <label class="space-y-1">
                <span class="text-sm font-medium text-gray-700">Andar</span>
                <input name="Floor" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-blue-500/15" />
            </label>
        </div>
        <div class="px-5 py-4 border-t border-gray-100 flex justify-end">
            <button class="px-5 py-3 rounded-2xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
                Salvar unidade
            </button>
        </div>
    </form>

    <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        @foreach (var block in Model.Blocks)
        {
            <article class="bg-white/85 border border-gray-200/70 rounded-2xl shadow-sm p-5">
                <p class="font-semibold text-gray-900">@block.Name</p>
                @if (!block.Units.Any())
                {
                    <p class="mt-4 text-sm text-gray-500">Nenhuma unidade cadastrada.</p>
                }
                else
                {
                    <div class="mt-4 divide-y divide-gray-100">
                        @foreach (var unit in block.Units)
                        {
                            <div class="py-3 flex items-center justify-between gap-3">
                                <div>
                                    <p class="font-medium text-gray-900">@unit.Number</p>
                                    <p class="text-xs text-gray-500">@unit.Floor</p>
                                </div>
                                <span class="text-sm text-gray-600">@unit.TotalResidents morador(es)</span>
                            </div>
                        }
                    </div>
                }
            </article>
        }
    </section>
</div>
