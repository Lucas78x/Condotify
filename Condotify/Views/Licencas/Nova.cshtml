@model CreateLicenseViewModel
@{
    ViewData["Title"] = "Nova licença";
}

<div class="mx-auto max-w-[1180px] space-y-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-2">
            <div class="text-sm text-gray-500">
                <a class="font-medium text-gray-700 hover:text-gray-950" href="@Url.Action("Index", "Licencas")">Licenças</a>
                <span class="mx-1">/</span>
                <span>Nova licença</span>
            </div>
            <div>
                <h2 class="text-2xl font-semibold tracking-tight text-gray-950 md:text-3xl">Nova licença</h2>
                <p class="mt-1 text-sm text-gray-500">Cadastre a operação principal e já deixe a licença pronta para receber módulos.</p>
            </div>
        </div>

        <a href="@Url.Action("Index", "Licencas")"
           class="inline-flex h-10 w-fit items-center justify-center rounded-lg border border-gray-200 bg-white px-4 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50">
            Voltar
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" class="grid gap-5 lg:grid-cols-[1fr_320px]">
        @Html.AntiForgeryToken()

        <section class="rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-5 py-4">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Dados da licença</h3>
            </div>

            <div class="grid grid-cols-1 gap-4 p-5 md:grid-cols-2">
                <label class="block space-y-1 md:col-span-2">
                    <span class="text-sm font-medium text-gray-700">Nome</span>
                    <input asp-for="Name" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" placeholder="Ex.: Condomínio Jardim Central" />
                    <span asp-validation-for="Name" class="text-xs text-rose-600"></span>
                </label>

                <label class="block space-y-1">
                    <span class="text-sm font-medium text-gray-700">CNPJ</span>
                    <input asp-for="CNPJ" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" placeholder="Somente números ou formatado" />
                    <span asp-validation-for="CNPJ" class="text-xs text-rose-600"></span>
                </label>

                <label class="block space-y-1">
                    <span class="text-sm font-medium text-gray-700">Código</span>
                    <input asp-for="Code" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" placeholder="Ex.: COND-001" />
                    <span asp-validation-for="Code" class="text-xs text-rose-600"></span>
                </label>

                <label class="block space-y-1">
                    <span class="text-sm font-medium text-gray-700">Cidade</span>
                    <input asp-for="City" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" />
                    <span asp-validation-for="City" class="text-xs text-rose-600"></span>
                </label>

                <label class="block space-y-1">
                    <span class="text-sm font-medium text-gray-700">País/Estado</span>
                    <input asp-for="Country" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" />
                    <span asp-validation-for="Country" class="text-xs text-rose-600"></span>
                </label>
            </div>
        </section>

        <aside class="space-y-5">
            <section class="rounded-lg border border-gray-200 bg-white shadow-sm">
                <div class="border-b border-gray-200 px-5 py-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Configuração</h3>
                </div>

                <div class="space-y-4 p-5">
                    <label class="block space-y-1">
                        <span class="text-sm font-medium text-gray-700">Organização</span>
                        <select asp-for="Organization" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50">
                            <option value="1">Residencial</option>
                            <option value="3">Corporativo</option>
                            <option value="6">Comercial</option>
                            <option value="2">Institucional</option>
                        </select>
                    </label>

                    <label class="block space-y-1">
                        <span class="text-sm font-medium text-gray-700">Edificação</span>
                        <select asp-for="Building" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50">
                            <option value="2">Vertical</option>
                            <option value="1">Horizontal</option>
                            <option value="3">Uso misto</option>
                            <option value="5">Comercial</option>
                        </select>
                    </label>

                    <label class="block space-y-1">
                        <span class="text-sm font-medium text-gray-700">Tipo</span>
                        <select asp-for="Type" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50">
                            <option value="1">Demo</option>
                            <option value="2">Full</option>
                        </select>
                    </label>

                    <label class="block space-y-1">
                        <span class="text-sm font-medium text-gray-700">Expira em</span>
                        <input asp-for="ExpireDate" type="date" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" />
                        <span asp-validation-for="ExpireDate" class="text-xs text-rose-600"></span>
                    </label>
                </div>
            </section>

            <section class="rounded-lg border border-gray-200 bg-white shadow-sm">
                <div class="border-b border-gray-200 px-5 py-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Localização</h3>
                </div>

                <div class="grid grid-cols-1 gap-4 p-5 sm:grid-cols-2 lg:grid-cols-1">
                    <label class="block space-y-1">
                        <span class="text-sm font-medium text-gray-700">Latitude</span>
                        <input asp-for="LocationX" type="number" step="0.000001" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" />
                    </label>

                    <label class="block space-y-1">
                        <span class="text-sm font-medium text-gray-700">Longitude</span>
                        <input asp-for="LocationY" type="number" step="0.000001" class="h-11 w-full rounded-lg border border-gray-200 px-3 text-sm outline-none transition focus:border-blue-300 focus:ring-4 focus:ring-blue-50" />
                    </label>
                </div>
            </section>

            <div class="flex flex-col gap-3">
                <button class="h-11 rounded-lg bg-gray-950 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800">
                    Criar licença
                </button>
                <a href="@Url.Action("Index", "Licencas")"
                   class="inline-flex h-11 items-center justify-center rounded-lg border border-gray-200 bg-white px-5 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50">
                    Cancelar
                </a>
            </div>
        </aside>
    </form>
</div>
