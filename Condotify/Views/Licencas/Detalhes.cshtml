@using static Condotify.Controllers.HomeController
@model LicencaDetalhesViewModel
@{
    ViewData["Title"] = Model.Nome;
}

<div class="max-w-[1400px] mx-auto">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-6">
        <a href="/Licencas" class="text-gray-500 hover:text-gray-700">
            ←
        </a>
        <h1 class="text-2xl font-semibold">@Model.Nome</h1>
    </div>

    <!-- Tabs -->
    <div class="flex items-center gap-8 border-b mb-6">
        <a class="pb-3 border-b-2 border-blue-600 text-blue-600 font-medium">
            Unidades
        </a>
        <a class="pb-3 text-gray-500 hover:text-gray-700">
            Dados cadastrais
        </a>
        <a class="pb-3 text-gray-500 hover:text-gray-700">
            Recursos
        </a>
        <a class="pb-3 text-gray-500 hover:text-gray-700">
            Equipamentos
        </a>
        <a class="pb-3 text-gray-500 hover:text-gray-700">
            Relatórios
        </a>
    </div>

    <!-- Search + Actions -->
    <div class="flex flex-col lg:flex-row gap-3 mb-6">
        <input class="flex-1 border rounded-xl px-4 py-3 text-sm"
               placeholder="Pesquise um(a) bloco..." />

        <div class="flex gap-2">
            <button class="inline-flex items-center gap-2 bg-emerald-500 text-white px-4 py-3 rounded-xl hover:bg-emerald-600">
                + Incluir bloco
            </button>

            <button class="inline-flex items-center gap-2 border px-4 py-3 rounded-xl hover:bg-gray-50">
                Importar cadastros
            </button>
        </div>
    </div>

    <!-- Blocos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var bloco in Model.Blocos)
        {
            <div class="bg-white border rounded-2xl p-5 hover:shadow-md transition">
                <div class="flex items-center justify-between mb-4">
                    <p class="font-semibold">@bloco.Nome</p>
                    <span class="text-gray-400">▾</span>
                </div>

                <div class="text-sm text-gray-700">
                    <p><strong>@bloco.Unidades</strong> unidades</p>
                    <p><strong>@bloco.Moradores</strong> moradores</p>
                </div>
            </div>
        }
    </div>

</div>
