@model LicenseFullViewModel
@{
    ViewData["Title"] = Model.Name;

    var modules = new[]
    {
        new { Label = "Equipamentos", Action = "Equipamentos", Description = "Leitores, catracas e controladoras" },
        new { Label = "Câmeras", Action = "Cameras", Description = "CFTV, DVR, NVR e canais" },
        new { Label = "Blocos", Action = "Blocos", Description = "Torres, alas e setores" },
        new { Label = "Unidades", Action = "Unidades", Description = "Apartamentos, casas e salas" },
        new { Label = "Moradores", Action = "Moradores", Description = "Responsáveis e usuários" },
        new { Label = "Encomendas", Action = "Encomendas", Description = "Recebimento e retirada" }
    };
}

<div class="mx-auto max-w-[1440px] space-y-5">
    <section class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0 space-y-3">
            <div class="text-sm text-gray-500">
                <a class="font-medium text-gray-700 hover:text-gray-950" href="@Url.Action("Index", "Licencas")">Licenças</a>
                <span class="mx-1">/</span>
                <span>@Model.Name</span>
            </div>

            <div class="flex items-start gap-3">
                <a href="@Url.Action("Index", "Licencas")"
                   class="inline-flex h-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white px-4 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50">
                    Voltar
                </a>

                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="truncate text-2xl font-semibold tracking-tight text-gray-950 md:text-3xl">@Model.Name</h2>
                        <span class="inline-flex rounded-md px-2.5 py-1 text-xs font-semibold @(Model.IsExpired ? "bg-rose-50 text-rose-700 ring-1 ring-rose-200" : "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200")">
                            @Model.Status
                        </span>
                    </div>
                    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
                        <span>Código <strong class="font-semibold text-gray-800">@Model.Code</strong></span>
                        <span>LicenseId <strong class="font-semibold text-gray-800">@Model.Id</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <button type="button"
                onclick="copyToClipboard('@Model.Id')"
                class="inline-flex h-10 items-center justify-center rounded-lg bg-gray-950 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800">
            Copiar LicenseId
        </button>
    </section>

    <section class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Moradores</p>
            <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-950">@Model.TotalResidents</p>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Blocos</p>
            <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-950">@Model.TotalBlocks</p>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Unidades</p>
            <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-950">@Model.TotalUnits</p>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Expira em</p>
            <p class="mt-2 text-xl font-semibold tracking-tight text-gray-950">@Model.ExpireDate.ToString("dd/MM/yyyy")</p>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-6">
        @foreach (var module in modules)
        {
            <a href="@Url.Action(module.Action, "Licencas", new { id = Model.Id })"
               class="group rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:border-blue-200 hover:bg-blue-50/40">
                <div class="flex h-full flex-col justify-between gap-4">
                    <div>
                        <p class="font-semibold text-gray-950">@module.Label</p>
                        <p class="mt-1 text-sm text-gray-500">@module.Description</p>
                    </div>
                    <span class="text-xs font-semibold text-gray-400 transition group-hover:text-blue-700">Abrir módulo</span>
                </div>
            </a>
        }
    </section>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[1fr_340px]">
        <section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-5 py-4">
                <h3 class="font-semibold text-gray-950">Estrutura cadastrada</h3>
                <p class="mt-1 text-sm text-gray-500">Resumo de unidades e moradores por bloco.</p>
            </div>

            @if (Model.Blocks == null || !Model.Blocks.Any())
            {
                <div class="px-6 py-12 text-center">
                    <p class="font-semibold text-gray-950">Nenhum bloco cadastrado</p>
                    <p class="mt-1 text-sm text-gray-500">Comece pelo módulo de blocos para estruturar a licença.</p>
                    <a href="@Url.Action("Blocos", "Licencas", new { id = Model.Id })"
                       class="mt-5 inline-flex h-10 items-center justify-center rounded-lg bg-gray-950 px-4 text-sm font-semibold text-white transition hover:bg-gray-800">
                        Cadastrar bloco
                    </a>
                </div>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var block in Model.Blocks)
                    {
                        <div class="grid gap-4 px-5 py-4 md:grid-cols-[1fr_120px_120px] md:items-center">
                            <div class="min-w-0">
                                <p class="truncate font-medium text-gray-950">@block.Name</p>
                                <p class="mt-0.5 truncate text-xs text-gray-500">@block.Id</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Unidades</p>
                                <p class="font-semibold text-gray-950">@block.TotalUnits</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Moradores</p>
                                <p class="font-semibold text-gray-950">@block.TotalResidents</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <aside class="h-fit rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-5 py-4">
                <h3 class="font-semibold text-gray-950">Informações</h3>
            </div>
            <dl class="divide-y divide-gray-100 text-sm">
                <div class="grid grid-cols-[110px_1fr] gap-3 px-5 py-3">
                    <dt class="text-gray-500">Cidade</dt>
                    <dd class="font-medium text-gray-950">@Model.City</dd>
                </div>
                <div class="grid grid-cols-[110px_1fr] gap-3 px-5 py-3">
                    <dt class="text-gray-500">Estado</dt>
                    <dd class="font-medium text-gray-950">@Model.State</dd>
                </div>
                <div class="grid grid-cols-[110px_1fr] gap-3 px-5 py-3">
                    <dt class="text-gray-500">Tipo</dt>
                    <dd class="font-medium text-gray-950">@Model.Type</dd>
                </div>
                <div class="grid grid-cols-[110px_1fr] gap-3 px-5 py-3">
                    <dt class="text-gray-500">Criada em</dt>
                    <dd class="font-medium text-gray-950">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </div>
            </dl>
        </aside>
    </div>
</div>

<script>
    async function copyToClipboard(text) {
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            const input = document.createElement("input");
            input.value = text;
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            document.body.removeChild(input);
        }
    }
</script>
