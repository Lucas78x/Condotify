@model List<LicenseViewModel>
@{
    ViewData["Title"] = "Licenças";
}

<!-- Título + botão -->
<div class="flex justify-between items-center mb-10">
    <h2 class="text-3xl font-bold text-gray-800 dark:text-gray-100 tracking-tight">
        Licenças Ativas
    </h2>

    <button type="button"
            onclick="openNewLicenseModal()"
            class="px-5 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl shadow-lg
                   hover:shadow-xl hover:scale-105 transition">
        + Nova Licença
    </button>
</div>

<!-- Busca -->
<div class="relative max-w-2xl mb-10">
    <input type="text"
           id="searchInput"
           placeholder="Pesquisar licenças..."
           class="w-full p-4 pl-12 border border-gray-300 dark:border-gray-700 rounded-2xl shadow
                  focus:ring-2 focus:ring-blue-400 dark:bg-gray-800 dark:text-gray-200">

    <svg class="w-6 h-6 text-gray-400 absolute left-4 top-4" fill="none" stroke="currentColor" stroke-width="2"
         viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="M21 21l-4.3-4.3"></path>
    </svg>
</div>

<!-- Cards -->
<div id="licensesGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

    @foreach (var lic in Model)
    {
        <div class="license-card glass p-6 rounded-2xl shadow-lg border hover:shadow-2xl hover:-translate-y-1
                    transition cursor-pointer relative overflow-hidden
                    bg-white/70 dark:bg-slate-800/70 dark:border-gray-700"
             data-search="@($"{lic.Nome} {lic.Cidade} {lic.Estado} {lic.ProjetoId} {lic.Moradores}")"
             data-url="@Url.Action("Detalhes", "Licencas", new { id = lic.ProjetoId })">

            <!-- Badge FULL -->
            <span class="absolute top-4 right-4 bg-blue-600 text-white px-3 py-1 text-xs rounded-full shadow">
                FULL
            </span>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-1">
                @lic.Nome
            </h3>

            <p class="text-sm text-gray-700 dark:text-gray-300 font-medium">Condomínio</p>
            <p class="text-gray-600 dark:text-gray-400 text-sm">@lic.Moradores moradores</p>

            <div class="flex items-center mt-2 text-gray-600 dark:text-gray-400 text-sm">
                <span class="mr-1">📍</span>
                @lic.Cidade - @lic.Estado
            </div>

            <p class="mt-3 text-blue-700 dark:text-blue-300 font-semibold text-sm">
                Condotify
            </p>

            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Código: @lic.ProjetoId</p>

            <!-- gradiente decorativo -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r
                        from-blue-600 to-blue-300 dark:from-blue-500 dark:to-blue-400 opacity-70"></div>

        </div>
    }
</div>

@section Scripts {

    <script>
        // --- BUSCA ---
        const searchInput = document.getElementById("searchInput");
        const cards = document.querySelectorAll(".license-card");

        if (searchInput) {
            searchInput.addEventListener("input", function () {
                const term = this.value.toLowerCase().trim();

                cards.forEach(card => {
                    const content = (card.dataset.search || "").toLowerCase();
                    if (!term || content.includes(term)) {
                        card.classList.remove("hidden");
                    } else {
                        card.classList.add("hidden");
                    }
                });
            });
        }

        // --- CLIQUE NO CARD (DETALHES) ---
        cards.forEach(card => {
            card.addEventListener("click", () => {
                const url = card.dataset.url;
                if (url) {
                    window.location.href = url;
                }
            });
        });
    </script>
}
