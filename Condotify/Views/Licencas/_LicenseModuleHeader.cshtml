@model LicenseModuleViewModel
@{
    string TabClass(string key) =>
        Model.ActiveTab == key
            ? "bg-blue-600 text-white"
            : "bg-white text-gray-700 border border-gray-200 hover:bg-gray-50";
}

<div class="space-y-4">
    <div class="flex flex-col gap-3">
        <div class="text-sm text-gray-600">
            <a class="hover:underline" href="@Url.Action("Index", "Licencas")">Licenças</a>
            <span class="mx-1">/</span>
            <a class="hover:underline" href="@Url.Action("Detalhes", "Licencas", new { id = Model.LicenseId })">@Model.LicenseName</a>
            <span class="mx-1">/</span>
            <span class="font-semibold text-gray-800">@ViewData["Title"]</span>
        </div>

        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
            <div>
                <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-gray-900">@ViewData["Title"]</h2>
                <p class="text-sm text-gray-500 mt-1">@Model.LicenseName</p>
            </div>

            <a href="@Url.Action("Detalhes", "Licencas", new { id = Model.LicenseId })"
               class="w-fit px-4 py-2 rounded-2xl border border-gray-200 bg-white text-gray-800 hover:bg-gray-50 transition">
                Voltar para resumo
            </a>
        </div>
    </div>

    <div class="flex flex-wrap gap-2">
        <a class="px-4 py-2 rounded-2xl text-sm font-medium transition @TabClass("equipamentos")"
           href="@Url.Action("Equipamentos", "Licencas", new { id = Model.LicenseId })">Equipamentos</a>
        <a class="px-4 py-2 rounded-2xl text-sm font-medium transition @TabClass("cameras")"
           href="@Url.Action("Cameras", "Licencas", new { id = Model.LicenseId })">Câmeras</a>
        <a class="px-4 py-2 rounded-2xl text-sm font-medium transition @TabClass("blocos")"
           href="@Url.Action("Blocos", "Licencas", new { id = Model.LicenseId })">Blocos</a>
        <a class="px-4 py-2 rounded-2xl text-sm font-medium transition @TabClass("unidades")"
           href="@Url.Action("Unidades", "Licencas", new { id = Model.LicenseId })">Unidades</a>
        <a class="px-4 py-2 rounded-2xl text-sm font-medium transition @TabClass("moradores")"
           href="@Url.Action("Moradores", "Licencas", new { id = Model.LicenseId })">Moradores</a>
        <a class="px-4 py-2 rounded-2xl text-sm font-medium transition @TabClass("encomendas")"
           href="@Url.Action("Encomendas", "Licencas", new { id = Model.LicenseId })">Encomendas</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            @Model.ErrorMessage
        </div>
    }
</div>
