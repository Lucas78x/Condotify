@model Condotify.Models.LoginViewModel
@{
    Layout = null;
    var errors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(value => value.ErrorMessage)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .ToList();
    var tempError = TempData["LoginError"] as string;
    if (!string.IsNullOrWhiteSpace(tempError)) errors.Add(tempError);
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar | Condotify</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { min-height: 100%; margin: 0; }
        body { font-family: Inter, "Segoe UI", sans-serif; color: #202532; background: #f4f6f8; }
        .login-shell { min-height: 100vh; display: grid; place-items: center; padding: 32px 20px; }
        .login-frame { width: min(100%, 430px); }
        .brand { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 24px; }
        .brand-mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 8px; background: #3156d3; color: white; font-weight: 700; font-size: 18px; }
        .brand-name { margin: 0; font-size: 22px; font-weight: 700; }
        .brand-copy { margin: 2px 0 0; color: #697386; font-size: 12px; }
        .login-card { border: 1px solid #dfe4eb; border-radius: 8px; background: white; box-shadow: 0 14px 36px rgba(32,37,50,.08); overflow: hidden; }
        .card-header { padding: 26px 28px 20px; border-bottom: 1px solid #e7eaf0; }
        .card-header h1 { margin: 0; font-size: 24px; letter-spacing: 0; }
        .card-header p { margin: 7px 0 0; color: #697386; font-size: 14px; line-height: 1.5; }
        .login-form { padding: 24px 28px 28px; }
        .field { margin-bottom: 17px; }
        .field label { display: block; margin-bottom: 7px; font-size: 13px; font-weight: 600; color: #384152; }
        .field input { width: 100%; height: 46px; padding: 0 13px; border: 1px solid #cfd5de; border-radius: 6px; background: white; color: #202532; font: inherit; font-size: 14px; outline: none; transition: border-color .15s, box-shadow .15s; }
        .field input:focus { border-color: #3156d3; box-shadow: 0 0 0 3px rgba(49,86,211,.12); }
        .field input::placeholder { color: #98a1af; }
        .password-wrap { position: relative; }
        .password-wrap input { padding-right: 48px; }
        .password-toggle { position: absolute; right: 5px; top: 5px; width: 36px; height: 36px; display: grid; place-items: center; border: 0; border-radius: 6px; background: transparent; color: #697386; cursor: pointer; }
        .password-toggle:hover { background: #f0f2f5; color: #202532; }
        .form-meta { display: flex; align-items: center; justify-content: space-between; margin: 3px 0 20px; font-size: 13px; color: #697386; }
        .remember { display: inline-flex; align-items: center; gap: 7px; }
        .remember input { accent-color: #3156d3; }
        .login-button { width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-radius: 6px; background: #3156d3; color: white; font: inherit; font-weight: 600; cursor: pointer; transition: background .15s; }
        .login-button:hover { background: #2949b5; }
        .login-button:disabled { opacity: .7; cursor: wait; }
        .error-box { margin-bottom: 18px; padding: 12px 14px; border: 1px solid #efb8bf; border-radius: 6px; background: #fff1f3; color: #9b2634; font-size: 13px; line-height: 1.45; }
        .demo-box { margin-top: 18px; padding: 12px 14px; border: 1px solid #c9ded7; border-radius: 6px; background: #eef8f5; color: #285f50; font-size: 12px; line-height: 1.5; }
        .demo-box strong { display: block; margin-bottom: 2px; color: #174f40; }
        .footer { margin: 22px 0 0; text-align: center; color: #8992a0; font-size: 12px; }
        .spinner { display: none; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.45); border-top-color: white; border-radius: 50%; animation: spin .7s linear infinite; }
        .is-loading .spinner { display: block; }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <main class="login-shell">
        <div class="login-frame">
            <div class="brand">
                <div class="brand-mark">C</div>
                <div><p class="brand-name">Condotify</p><p class="brand-copy">Gestao condominial inteligente</p></div>
            </div>

            <section class="login-card">
                <header class="card-header">
                    <h1>Bem-vindo</h1>
                    <p>Entre com as credenciais da sua empresa para acessar a central de operacoes.</p>
                </header>

                <form id="loginForm" method="post" action="/Login/Login" class="login-form">
                    @Html.AntiForgeryToken()

                    @if (errors.Count > 0)
                    {
                        <div class="error-box" role="alert">@string.Join(" ", errors.Distinct())</div>
                    }

                    <div class="field">
                        <label for="email">E-mail</label>
                        <input id="email" type="email" name="Email" value="@Model?.Email" autocomplete="email" placeholder="nome@empresa.com.br" required autofocus />
                    </div>

                    <div class="field">
                        <label for="password">Senha</label>
                        <div class="password-wrap">
                            <input id="password" type="password" name="Password" autocomplete="current-password" placeholder="Digite sua senha" required />
                            <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Mostrar ou ocultar senha" title="Mostrar ou ocultar senha">
                                <span id="eyeIcon">◉</span>
                            </button>
                        </div>
                    </div>

                    <div class="form-meta">
                        <label class="remember"><input type="checkbox" name="RememberMe" /> Manter conectado</label>
                        <span>Ambiente seguro</span>
                    </div>

                    <button id="submitButton" class="login-button" type="submit"><span class="spinner"></span><span id="buttonText">Entrar</span></button>

                    @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                    {
                        <div class="demo-box"><strong>Acesso de desenvolvimento</strong>teste@condotify.local · Teste@@123</div>
                    }
                </form>
            </section>
            <p class="footer">© @DateTime.Now.Year Condotify. Acesso restrito.</p>
        </div>
    </main>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
        document.getElementById('loginForm').addEventListener('submit', function () {
            const button = document.getElementById('submitButton');
            button.disabled = true;
            button.classList.add('is-loading');
            document.getElementById('buttonText').textContent = 'Entrando...';
        });
    </script>
</body>
</html>
