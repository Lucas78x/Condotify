@model Condotify.Models.LoginViewModel
@{
    Layout = null;
    var isMfa = Model?.MfaRequired == true;
    var errors = ViewData.ModelState.Values
        .SelectMany(x => x.Errors)
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();
    var tempError = TempData["LoginError"] as string;
    if (!string.IsNullOrWhiteSpace(tempError)) errors.Add(tempError);
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#092557" />
    <title>Entrar | F&amp;F Access</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo/ff-access-mark.svg" />
    <link rel="stylesheet" href="/css/brand.css" />
    <style>
        :root {
            color-scheme: light;
            --ink: #182033;
            --muted: #667085;
            --line: #dce2eb;
            --primary: var(--brand-primary);
            --primary-hover: var(--brand-primary-strong);
            --accent: var(--brand-accent);
        }

        * { box-sizing: border-box; }
        html, body { min-height: 100%; margin: 0; }
        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            background: #f5f7fa;
            letter-spacing: 0;
        }

        button, input { font: inherit; }
        .page { min-height: 100vh; display: grid; place-items: center; padding: 32px 20px; }
        .frame { width: min(100%, 420px); }
        .brand { display: flex; align-items: center; justify-content: center; margin-bottom: 26px; }
        .mark {
            width: 178px;
            height: 74px;
            display: block;
            object-fit: contain;
        }
        .brand strong { display: block; font-size: 18px; line-height: 1.2; }
        .brand small { display: block; margin-top: 2px; color: var(--muted); font-size: 11px; }
        .box { padding: 30px; border: 1px solid var(--line); border-radius: 8px; background: #fff; box-shadow: 0 16px 42px rgba(24, 32, 51, .07); }
        .head { margin-bottom: 26px; text-align: center; }
        .head h1 { margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; }
        .head p { margin: 8px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
        .field { margin-bottom: 17px; }
        .field label { display: block; margin-bottom: 7px; color: #344054; font-size: 12px; font-weight: 600; }
        .field input {
            width: 100%;
            height: 46px;
            padding: 0 13px;
            border: 1px solid #cbd3df;
            border-radius: 6px;
            background: #fff;
            color: var(--ink);
            font-size: 14px;
            outline: none;
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .field input::placeholder { color: #98a2b3; }
        .field input:hover { border-color: #aab4c3; }
        .field input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(9, 37, 87, .11); }
        .password { position: relative; }
        .password input { padding-right: 62px; }
        .toggle {
            position: absolute;
            top: 5px;
            right: 5px;
            height: 36px;
            padding: 0 9px;
            border: 0;
            border-radius: 5px;
            background: transparent;
            color: var(--primary);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }
        .toggle:hover { background: #f1f4ff; }
        .meta { min-height: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 20px; color: var(--muted); font-size: 11px; }
        .meta a { color: var(--primary); font-weight: 600; text-decoration: none; }
        .remember { display: flex; align-items: center; gap: 7px; cursor: pointer; }
        .remember input { width: 14px; height: 14px; margin: 0; accent-color: var(--primary); }
        .submit {
            width: 100%;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 0;
            border-radius: 6px;
            background: var(--primary);
            color: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s ease, box-shadow .15s ease;
        }
        .submit:hover { background: var(--primary-hover); box-shadow: 0 7px 18px rgba(9, 37, 87, .18); }
        .submit:disabled { cursor: wait; opacity: .72; }
        .error { margin-bottom: 18px; padding: 11px 12px; border: 1px solid #efb8bf; border-radius: 6px; background: #fff3f4; color: #9b2634; font-size: 12px; line-height: 1.45; }
        .demo { margin-top: 17px; padding: 11px 12px; border-radius: 6px; background: #f0f7f5; color: #306356; font-size: 11px; line-height: 1.45; }
        .demo strong { display: block; margin-bottom: 2px; }
        .footer { margin: 22px 0 0; color: #8a94a3; font-size: 11px; text-align: center; }
        .spinner { display: none; width: 15px; height: 15px; border: 2px solid rgba(255, 255, 255, .45); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
        .loading .spinner { display: block; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        @@media (max-width: 480px) {
            .page { align-items: start; padding: 28px 16px; }
            .frame { width: 100%; max-width: 420px; min-width: 0; }
            .box { padding: 25px 20px; }
            .brand { margin-bottom: 22px; }
            .meta { flex-wrap: wrap; }
        }
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { transition: none !important; animation-duration: .01ms !important; }
        }

        /* F&F Access — conceito aprovado */
        body { background: #f8fafc; }
        .login-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(430px, 46%) minmax(520px, 54%);
        }
        .brand-panel {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            padding: clamp(44px, 7vh, 78px) clamp(42px, 6vw, 92px);
            background:
                radial-gradient(circle at 78% 82%, rgba(40, 112, 184, .24), transparent 34%),
                linear-gradient(145deg, #092557 0%, #061a3d 72%, #04132d 100%);
            color: #fff;
            isolation: isolate;
        }
        .brand-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            opacity: .28;
            background:
                linear-gradient(118deg, transparent 58%, rgba(96, 166, 229, .18) 58.15%, transparent 58.4%),
                linear-gradient(118deg, transparent 67%, rgba(96, 166, 229, .12) 67.15%, transparent 67.4%);
        }
        .brand-panel::after {
            content: "";
            position: absolute;
            z-index: -1;
            top: -35%;
            left: -55%;
            width: 42%;
            height: 175%;
            opacity: 0;
            background: linear-gradient(90deg, transparent, rgba(126, 202, 255, .1), transparent);
            transform: rotate(17deg);
            animation: ambientSweep 8s 1.4s ease-in-out infinite;
        }
        .brand-content {
            position: relative;
            z-index: 2;
            max-width: 610px;
            animation: brandReveal .8s cubic-bezier(.2, .8, .2, 1) both;
        }
        .brand-logo {
            width: clamp(220px, 22vw, 320px);
            height: auto;
            display: block;
            object-fit: contain;
            margin-bottom: clamp(44px, 7vh, 72px);
            animation: logoBreathe 6s 1.2s ease-in-out infinite;
        }
        .brand-copy h1 {
            max-width: 560px;
            margin: 0;
            color: #fff;
            font-size: clamp(38px, 4vw, 64px);
            line-height: 1.04;
            letter-spacing: -.045em;
            font-weight: 780;
            animation: copyReveal .72s .14s cubic-bezier(.2, .8, .2, 1) both;
        }
        .brand-copy p {
            max-width: 520px;
            margin: 25px 0 0;
            color: rgba(255, 255, 255, .76);
            font-size: clamp(16px, 1.25vw, 20px);
            line-height: 1.6;
            animation: copyReveal .72s .25s cubic-bezier(.2, .8, .2, 1) both;
        }
        .access-scene {
            position: absolute;
            z-index: 1;
            left: -4%;
            right: -5%;
            bottom: -3%;
            height: 43%;
            opacity: .82;
            background:
                linear-gradient(90deg, transparent 0 7%, rgba(89, 165, 229, .19) 7.1% 7.25%, transparent 7.35% 31%, rgba(89, 165, 229, .16) 31.1% 31.25%, transparent 31.35% 62%, rgba(89, 165, 229, .17) 62.1% 62.25%, transparent 62.35%),
                linear-gradient(0deg, rgba(42, 118, 183, .15), transparent 72%);
            transform: perspective(850px) rotateX(3deg);
            transform-origin: bottom;
            animation: sceneReveal 1.15s .18s cubic-bezier(.2, .8, .2, 1) both, sceneBreathe 7s 1.4s ease-in-out infinite alternate;
        }
        .access-scene::before {
            content: "";
            position: absolute;
            inset: 15% 0 0;
            background:
                repeating-linear-gradient(90deg, transparent 0 82px, rgba(91, 171, 238, .14) 83px 84px),
                repeating-linear-gradient(0deg, transparent 0 55px, rgba(91, 171, 238, .1) 56px 57px);
            transform: skewY(-7deg);
            mask-image: linear-gradient(to top, #000 22%, transparent 100%);
        }
        .access-scene::after {
            content: "";
            position: absolute;
            left: 10%;
            right: 12%;
            bottom: 7%;
            height: 46%;
            border: 1px solid rgba(121, 194, 255, .36);
            border-bottom-color: rgba(121, 194, 255, .64);
            border-radius: 8px 8px 0 0;
            box-shadow: inset 0 0 30px rgba(41, 127, 204, .1), 0 0 24px rgba(41, 127, 204, .08);
            transform: perspective(700px) rotateX(-2deg) skewX(-7deg);
        }
        .gate {
            position: absolute;
            z-index: 2;
            bottom: 8%;
            width: 22%;
            height: 38%;
            border: 2px solid rgba(162, 215, 255, .72);
            border-radius: 7px 7px 3px 3px;
            box-shadow: inset 0 0 24px rgba(49, 141, 217, .12), 0 8px 28px rgba(0, 0, 0, .2);
        }
        .gate::after {
            content: "";
            position: absolute;
            left: 10%;
            right: 10%;
            top: 13%;
            height: 2px;
            background: rgba(162, 215, 255, .7);
            box-shadow: 0 8px 16px rgba(106, 193, 255, .22);
        }
        .gate-left { left: 20%; transform: skewY(2deg); }
        .gate-right { left: 46%; height: 31%; transform: skewY(-2deg); }
        .gate-left { animation: gatePulse 3.8s 1s ease-in-out infinite; }
        .gate-right { animation: gatePulse 3.8s 1.55s ease-in-out infinite; }
        .reader {
            position: absolute;
            z-index: 3;
            left: 73%;
            bottom: 30%;
            width: 36px;
            height: 72px;
            border: 1px solid rgba(162, 215, 255, .74);
            border-radius: 5px;
            background: rgba(5, 25, 58, .72);
            box-shadow: 0 0 18px rgba(52, 148, 225, .28);
            animation: readerWake 3.2s 1.1s ease-in-out infinite;
        }
        .reader::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: 14px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #7bc053;
            box-shadow: 0 0 10px rgba(123, 192, 83, .8);
            transform: translateX(-50%);
            animation: statusBlink 2.2s ease-in-out infinite;
        }
        .facial-scanner {
            position: absolute;
            z-index: 5;
            left: 72%;
            bottom: 31%;
            width: clamp(104px, 10vw, 148px);
            aspect-ratio: 4 / 5;
            padding: 10px;
            border: 1px solid rgba(156, 216, 255, .52);
            border-radius: 12px;
            background: linear-gradient(160deg, rgba(12, 49, 91, .9), rgba(3, 21, 50, .92));
            box-shadow: 0 18px 42px rgba(0, 0, 0, .3), inset 0 0 24px rgba(61, 156, 224, .09), 0 0 0 1px rgba(71, 166, 229, .08);
            transform: perspective(600px) rotateY(-8deg);
            animation: scannerFloat 4.8s 1s ease-in-out infinite;
        }
        .facial-scanner::before {
            content: "";
            position: absolute;
            inset: -10px;
            z-index: -1;
            border-radius: 17px;
            background: radial-gradient(circle, rgba(83, 180, 244, .2), transparent 68%);
            opacity: .4;
            animation: scannerAura 2.8s ease-in-out infinite;
        }
        .scanner-top {
            height: 12px;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 7px;
        }
        .scanner-top i {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: rgba(137, 201, 244, .35);
        }
        .scanner-top i:first-child { background: #7bc053; box-shadow: 0 0 8px rgba(123, 192, 83, .72); }
        .face-frame {
            position: relative;
            height: calc(100% - 19px);
            overflow: hidden;
            border: 1px solid rgba(104, 190, 247, .28);
            border-radius: 8px;
            background:
                linear-gradient(rgba(90, 176, 236, .045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(90, 176, 236, .045) 1px, transparent 1px),
                rgba(3, 19, 45, .76);
            background-size: 15px 15px;
        }
        .face-head {
            position: absolute;
            left: 50%;
            top: 19%;
            width: 29%;
            height: 31%;
            border: 2px solid rgba(137, 209, 255, .68);
            border-radius: 48% 48% 45% 45%;
            transform: translateX(-50%);
            animation: faceLock 3s ease-in-out infinite;
        }
        .face-head::before, .face-head::after {
            content: "";
            position: absolute;
            top: 42%;
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: rgba(150, 218, 255, .75);
        }
        .face-head::before { left: 25%; }
        .face-head::after { right: 25%; }
        .face-shoulders {
            position: absolute;
            left: 50%;
            bottom: 12%;
            width: 64%;
            height: 34%;
            border: 2px solid rgba(137, 209, 255, .58);
            border-bottom: 0;
            border-radius: 50% 50% 0 0;
            transform: translateX(-50%);
            animation: faceLock 3s .08s ease-in-out infinite;
        }
        .scan-line {
            position: absolute;
            z-index: 3;
            left: 8%;
            right: 8%;
            top: 8%;
            height: 2px;
            border-radius: 999px;
            background: #7bc053;
            box-shadow: 0 0 8px #7bc053, 0 0 22px rgba(123, 192, 83, .55), 0 6px 18px rgba(123, 192, 83, .22);
            animation: faceScan 3s cubic-bezier(.45, 0, .55, 1) infinite;
        }
        .scan-corner {
            position: absolute;
            z-index: 4;
            width: 15px;
            height: 15px;
            border-color: #83c95a;
            border-style: solid;
            animation: cornerPulse 3s ease-in-out infinite;
        }
        .scan-corner.tl { left: 8px; top: 8px; border-width: 2px 0 0 2px; }
        .scan-corner.tr { right: 8px; top: 8px; border-width: 2px 2px 0 0; }
        .scan-corner.bl { left: 8px; bottom: 8px; border-width: 0 0 2px 2px; }
        .scan-corner.br { right: 8px; bottom: 8px; border-width: 0 2px 2px 0; }
        .scan-confirm {
            position: absolute;
            z-index: 6;
            right: -9px;
            bottom: -9px;
            width: 28px;
            height: 28px;
            display: grid;
            place-items: center;
            border: 2px solid #0b2d58;
            border-radius: 50%;
            background: #7bc053;
            color: #092557;
            box-shadow: 0 0 18px rgba(123, 192, 83, .52);
            opacity: 0;
            transform: scale(.5);
            animation: recognitionConfirm 3s ease-in-out infinite;
        }
        .scan-confirm svg { width: 16px; height: 16px; }
        .scan-particle {
            position: absolute;
            z-index: 5;
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #8fd36a;
            box-shadow: 0 0 8px #7bc053;
            opacity: 0;
            animation: particleRise 3s ease-out infinite;
        }
        .scan-particle.p1 { left: 14%; bottom: 8%; animation-delay: 0s; }
        .scan-particle.p2 { right: 17%; bottom: 13%; animation-delay: .35s; }
        .scan-particle.p3 { left: 47%; bottom: 4%; animation-delay: .7s; }
        .login-panel {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 56px clamp(34px, 7vw, 120px);
            background: #f8fafc;
        }
        .login-panel .frame {
            width: min(100%, 510px);
            animation: formReveal .82s .08s cubic-bezier(.2, .8, .2, 1) both;
        }
        .login-panel .box {
            padding: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }
        .eyebrow {
            display: block;
            margin-bottom: 14px;
            color: #5a9e38;
            font-size: 13px;
            line-height: 1;
            font-weight: 800;
            letter-spacing: .11em;
        }
        .login-panel .head { margin-bottom: 34px; text-align: left; }
        .login-panel .head h1 {
            color: #092557;
            font-size: clamp(34px, 3vw, 46px);
            line-height: 1.12;
            letter-spacing: -.035em;
            font-weight: 780;
        }
        .login-panel .head p { margin-top: 12px; font-size: 16px; }
        .login-panel .field { margin-bottom: 22px; }
        .login-panel .field label { margin-bottom: 9px; color: #152642; font-size: 14px; font-weight: 700; }
        .input-wrap { position: relative; }
        .input-icon {
            position: absolute;
            z-index: 1;
            left: 17px;
            top: 50%;
            width: 21px;
            height: 21px;
            color: #718096;
            transform: translateY(-50%);
            pointer-events: none;
        }
        .input-icon svg { width: 100%; height: 100%; display: block; }
        .input-wrap:focus-within .input-icon { color: #5a9e38; transform: translateY(-50%) scale(1.06); }
        .login-panel .field input {
            height: 58px;
            padding: 0 16px 0 52px;
            border-color: #aeb8c7;
            border-radius: 9px;
            background: rgba(255, 255, 255, .6);
            font-size: 16px;
        }
        .login-panel .password input { padding-right: 94px; }
        .login-panel .toggle {
            top: 8px;
            right: 8px;
            height: 42px;
            padding: 0 11px;
            border-radius: 7px;
            color: #5b6678;
            font-size: 13px;
        }
        .login-panel .toggle:hover { background: #edf2f7; color: #092557; }
        .login-panel .meta { min-height: 24px; margin: 4px 0 27px; font-size: 14px; }
        .login-panel .remember { gap: 10px; color: #3c4658; }
        .login-panel .remember input { width: 18px; height: 18px; }
        .login-panel .submit {
            height: 58px;
            position: relative;
            overflow: hidden;
            border-radius: 9px;
            background: #092557;
            font-size: 16px;
            font-weight: 750;
        }
        .login-panel .submit::before {
            content: "";
            position: absolute;
            top: -80%;
            left: -35%;
            width: 24%;
            height: 260%;
            opacity: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .22), transparent);
            transform: rotate(18deg);
        }
        .login-panel .submit:hover::before { animation: buttonShine .85s ease-out; }
        .login-panel .submit::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: 9px;
            width: 46px;
            height: 2px;
            border-radius: 999px;
            background: #7bc053;
            transform: translateX(-50%);
        }
        .login-panel .submit:hover { background: #061a3d; box-shadow: 0 10px 24px rgba(9, 37, 87, .2); }
        .login-panel .footer { margin-top: 62px; color: #687386; font-size: 13px; }
        .login-panel .error { border-radius: 9px; font-size: 13px; }

        @@keyframes brandReveal {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes copyReveal {
            from { opacity: 0; transform: translateX(-18px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @@keyframes formReveal {
            from { opacity: 0; transform: translateY(22px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes logoBreathe {
            0%, 100% { transform: translateY(0); filter: drop-shadow(0 0 0 rgba(123, 192, 83, 0)); }
            50% { transform: translateY(-3px); filter: drop-shadow(0 7px 18px rgba(123, 192, 83, .1)); }
        }
        @@keyframes ambientSweep {
            0%, 18% { left: -55%; opacity: 0; }
            28% { opacity: .75; }
            55% { left: 125%; opacity: .2; }
            56%, 100% { left: 125%; opacity: 0; }
        }
        @@keyframes sceneReveal {
            from { opacity: 0; transform: perspective(850px) rotateX(3deg) translateY(38px); }
            to { opacity: .82; transform: perspective(850px) rotateX(3deg) translateY(0); }
        }
        @@keyframes sceneBreathe {
            from { filter: brightness(.9); }
            to { filter: brightness(1.12); }
        }
        @@keyframes gatePulse {
            0%, 100% { border-color: rgba(162, 215, 255, .48); box-shadow: inset 0 0 24px rgba(49, 141, 217, .08), 0 8px 28px rgba(0, 0, 0, .2); }
            50% { border-color: rgba(162, 215, 255, .82); box-shadow: inset 0 0 28px rgba(49, 141, 217, .18), 0 0 22px rgba(61, 159, 231, .12); }
        }
        @@keyframes readerWake {
            0%, 100% { transform: translateY(0); box-shadow: 0 0 12px rgba(52, 148, 225, .18); }
            50% { transform: translateY(-3px); box-shadow: 0 0 24px rgba(52, 148, 225, .36); }
        }
        @@keyframes statusBlink {
            0%, 100% { opacity: .55; transform: translateX(-50%) scale(.82); }
            50% { opacity: 1; transform: translateX(-50%) scale(1.18); }
        }
        @@keyframes scannerFloat {
            0%, 100% { transform: perspective(600px) rotateY(-8deg) translateY(0); }
            50% { transform: perspective(600px) rotateY(-6deg) translateY(-7px); }
        }
        @@keyframes scannerAura {
            0%, 100% { opacity: .25; transform: scale(.94); }
            50% { opacity: .7; transform: scale(1.06); }
        }
        @@keyframes faceScan {
            0% { top: 9%; opacity: 0; }
            10% { opacity: 1; }
            72% { top: 84%; opacity: 1; }
            82%, 100% { top: 84%; opacity: 0; }
        }
        @@keyframes faceLock {
            0%, 68%, 100% { border-color: rgba(137, 209, 255, .58); filter: drop-shadow(0 0 0 transparent); }
            78%, 92% { border-color: #8bd064; filter: drop-shadow(0 0 5px rgba(123, 192, 83, .55)); }
        }
        @@keyframes cornerPulse {
            0%, 62%, 100% { opacity: .5; }
            76%, 92% { opacity: 1; filter: drop-shadow(0 0 4px rgba(123, 192, 83, .8)); }
        }
        @@keyframes recognitionConfirm {
            0%, 68%, 100% { opacity: 0; transform: scale(.5); }
            78%, 92% { opacity: 1; transform: scale(1); }
        }
        @@keyframes particleRise {
            0%, 68% { opacity: 0; transform: translateY(0) scale(.5); }
            76% { opacity: 1; }
            100% { opacity: 0; transform: translateY(-34px) scale(1.15); }
        }
        @@keyframes buttonShine {
            0% { left: -35%; opacity: 0; }
            24% { opacity: 1; }
            100% { left: 118%; opacity: 0; }
        }

        @@media (max-width: 920px) {
            .login-shell { grid-template-columns: 1fr; }
            .brand-panel { min-height: auto; padding: 28px 24px; }
            .brand-logo { width: 180px; margin: 0; }
            .brand-copy, .access-scene { display: none; }
            .login-panel { min-height: calc(100vh - 119px); padding: 40px 22px; align-items: start; }
            .login-panel .frame { margin-top: clamp(12px, 8vh, 76px); }
            .login-panel .footer { margin-top: 42px; }
        }
        @@media (max-width: 480px) {
            .login-panel { padding: 32px 18px; }
            .login-panel .frame { margin-top: 0; }
            .login-panel .head { margin-bottom: 28px; }
            .login-panel .head h1 { font-size: 32px; }
            .login-panel .head p { font-size: 14px; }
            .login-panel .field input, .login-panel .submit { height: 54px; }
            .login-panel .toggle { top: 6px; }
        }
        @@media (prefers-reduced-motion: reduce) {
            .brand-panel::after,
            .brand-content,
            .brand-logo,
            .brand-copy h1,
            .brand-copy p,
            .access-scene,
            .gate,
            .reader,
            .reader::after,
            .facial-scanner,
            .facial-scanner::before,
            .face-head,
            .face-shoulders,
            .scan-line,
            .scan-corner,
            .scan-confirm,
            .scan-particle,
            .login-panel .frame,
            .login-panel .submit::before {
                animation: none !important;
            }
            .brand-content,
            .brand-copy h1,
            .brand-copy p,
            .login-panel .frame { opacity: 1; transform: none; }
            .scan-confirm { opacity: 1; transform: scale(1); }
        }
    </style>
</head>
<body>
<main class="login-shell">
    <section class="brand-panel" aria-label="F&amp;F Access">
        <div class="brand-content">
            <img class="brand-logo" src="/assets/logo/ff-access-logo-dark.png" alt="F&amp;F Access" />
            <div class="brand-copy">
                <h1>Acesso inteligente.<br />Gestão segura.</h1>
                <p>Controle pessoas, visitantes e operações em um único ambiente.</p>
            </div>
        </div>
        <div class="access-scene" aria-hidden="true">
            <span class="gate gate-left"></span>
            <span class="gate gate-right"></span>
            <span class="reader"></span>
            <div class="facial-scanner">
                <div class="scanner-top"><i></i><i></i><i></i></div>
                <div class="face-frame">
                    <span class="face-head"></span>
                    <span class="face-shoulders"></span>
                    <span class="scan-line"></span>
                    <span class="scan-corner tl"></span>
                    <span class="scan-corner tr"></span>
                    <span class="scan-corner bl"></span>
                    <span class="scan-corner br"></span>
                    <span class="scan-particle p1"></span>
                    <span class="scan-particle p2"></span>
                    <span class="scan-particle p3"></span>
                </div>
                <span class="scan-confirm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12.5l4.2 4.2L19 7" /></svg></span>
            </div>
        </div>
    </section>

    <section class="login-panel">
        <div class="frame">

        <section class="box">
            <header class="head">
                <span class="eyebrow">@(isMfa ? "VERIFICAÇÃO" : "BEM-VINDO")</span>
                <h1>@(isMfa ? "Confirme sua identidade" : "Acesse sua conta")</h1>
                <p>@(isMfa ? "Digite o código do autenticador ou use um código de recuperação." : "Use suas credenciais para continuar.")</p>
            </header>

            <form id="loginForm" method="post" action="/Login/Login">
                @Html.AntiForgeryToken()
                @if (errors.Count > 0)
                {
                    <div class="error" role="alert" aria-live="polite">@string.Join(" ", errors.Distinct())</div>
                }

                @if (isMfa)
                {
                    <input type="hidden" name="MfaRequired" value="true" />
                    <input type="hidden" name="MfaChallengeToken" value="@Model!.MfaChallengeToken" />
                    <input type="hidden" name="Email" value="@Model.Email" />
                    <input type="hidden" name="RememberMe" value="@(Model.RememberMe ? "true" : "false")" />
                    <div class="field">
                        <label for="mfaCode">Código de segurança</label>
                        <div class="input-wrap">
                            <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.6-2.9 8.2-7 10-4.1-1.8-7-5.4-7-10V6l7-3z"/><path d="M9.5 12l1.7 1.7 3.6-3.8"/></svg></span>
                            <input id="mfaCode" type="text" name="MfaCode" autocomplete="one-time-code" inputmode="numeric" maxlength="20" placeholder="000000" required autofocus />
                        </div>
                    </div>
                    <div class="meta"><a href="/Login">Voltar ao login</a><span>Válido por 5 minutos</span></div>
                }
                else
                {
                    <div class="field">
                        <label for="email">E-mail</label>
                        <div class="input-wrap">
                            <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg></span>
                            <input id="email" type="email" name="Email" value="@Model?.Email" autocomplete="email" placeholder="nome@empresa.com.br" required autofocus />
                        </div>
                    </div>
                    <div class="field">
                        <label for="password">Senha</label>
                        <div class="password input-wrap">
                            <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg></span>
                            <input id="password" type="password" name="Password" autocomplete="current-password" placeholder="Digite sua senha" required />
                            <button id="passwordToggle" type="button" class="toggle" onclick="togglePassword()" aria-label="Mostrar senha" aria-pressed="false">Mostrar</button>
                        </div>
                    </div>
                    <div class="meta">
                        <label class="remember">
                            @if (Model?.RememberMe == true)
                            {
                                <input type="checkbox" name="RememberMe" value="true" checked />
                            }
                            else
                            {
                                <input type="checkbox" name="RememberMe" value="true" />
                            }
                            Manter conectado
                        </label>
                    </div>
                }

                <button id="submitButton" class="submit" type="submit">
                    <span class="spinner" aria-hidden="true"></span>
                    <span id="buttonText">@(isMfa ? "Confirmar acesso" : "Entrar")</span>
                </button>

            </form>
        </section>
        <p class="footer">&copy; @DateTime.Now.Year F&amp;F Access. Acesso restrito.</p>
        </div>
    </section>
</main>
<script>
    function togglePassword() {
        const input = document.getElementById('password');
        const button = document.getElementById('passwordToggle');
        if (!input || !button) return;

        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        button.textContent = show ? 'Ocultar' : 'Mostrar';
        button.setAttribute('aria-label', show ? 'Ocultar senha' : 'Mostrar senha');
        button.setAttribute('aria-pressed', show ? 'true' : 'false');
    }

    document.getElementById('loginForm').addEventListener('submit', function () {
        const button = document.getElementById('submitButton');
        button.disabled = true;
        button.classList.add('loading');
        document.getElementById('buttonText').textContent = 'Validando...';
    });
</script>
</body>
</html>
