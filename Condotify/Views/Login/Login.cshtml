@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - F&F Condotify</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-gray-900 to-blue-600 flex items-center justify-center p-6">
    <div class="backdrop-blur-xl bg-white/10 border border-white/20 shadow-2xl rounded-2xl p-10 w-full max-w-sm text-center">
        <h1 class="text-white text-3xl font-bold tracking-wide mb-8">Condotify</h1>

        <form method="post" action="/Account/Login" class="space-y-5">
            <input type="text"
                   name="Username"
                   placeholder="Usuário"
                   required
                   class="w-full px-4 py-3 rounded-xl bg-white/20 text-white placeholder-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-400 transition" />

            <input type="password"
                   name="Password"
                   placeholder="Senha"
                   required
                   class="w-full px-4 py-3 rounded-xl bg-white/20 text-white placeholder-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-400 transition" />

            <button type="submit"
                    class="w-full py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-xl shadow-lg transform hover:-translate-y-1 transition">
                Entrar
            </button>
        </form>

        <div class="mt-6 text-sm text-white/80">
            <a href="#" class="hover:text-blue-300 transition">Esqueceu a senha?</a>
        </div>
    </div>
</body>
</html>
