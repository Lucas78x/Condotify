@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IWebHostEnvironment HostEnvironment

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@VersionedAsset("css/brand.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/portal.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/design-system.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/portal-refinement.css")" />
    <link rel="stylesheet" href="Condotify.styles.css?v=20260815-wallet1" />
    <link rel="icon" type="image/svg+xml" href="assets/logo/ff-access-mark.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" class="components-reconnect-hide reconnect-surface" role="status" aria-live="polite">
        <span class="reconnect-spinner" aria-hidden="true"></span>
        <span class="reconnect-message reconnecting"><strong>Reconectando</strong><small>Restabelecendo a sessão operacional...</small></span>
        <span class="reconnect-message failed"><strong>Conexão interrompida</strong><small>Não foi possível reconectar automaticamente.</small></span>
        <span class="reconnect-message rejected"><strong>Sessão encerrada</strong><small>Recarregue a página para entrar novamente.</small></span>
        <button type="button" onclick="location.reload()">Recarregar</button>
    </div>
    <script src="@VersionedAsset("js/session-keepalive.js")"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/portal-interop.js?v=20260805-ux1"></script>
    <script src="js/portal-motion.js"></script>
    <script src="lib/hls.js/hls.min.js?v=1.6.16"></script>
    <script src="js/cftv-player.js?v=20260818.cameras12"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        window.condotifySessionReady.then(function (ready) {
            if (ready) Blazor.start();
        });
    </script>
</body>

</html>

@code {
    private string VersionedAsset(string relativePath)
    {
        var normalizedPath = relativePath.Replace('/', Path.DirectorySeparatorChar);
        var absolutePath = Path.Combine(HostEnvironment.WebRootPath, normalizedPath);
        var version = File.Exists(absolutePath)
            ? File.GetLastWriteTimeUtc(absolutePath).Ticks.ToString("x")
            : "missing";

        return $"{relativePath}?v={version}";
    }
}
