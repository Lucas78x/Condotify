<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <MudPaper Class="empty-state" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Outlined.ExploreOff" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h5">Página não encontrada</MudText>
                    <MudText Color="Color.Secondary">O endereço informado não existe ou foi movido.</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Home">Ir para o início</MudButton>
                </MudPaper>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
