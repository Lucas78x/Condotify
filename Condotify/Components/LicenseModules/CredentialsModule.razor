@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<section class="module-intro">
    <div>
        <MudText Typo="Typo.h5">Credenciais de acesso</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Administre o cadastro central e a sincronização com cada equipamento.</MudText>
    </div>
    @if (CanManage)
    {
        <div class="module-actions">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.SyncAlt" OnClick="OpenOperationsAsync">Operações</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddCard" Disabled="@(Residents.Count == 0 || !_devices.Any(x => x.IsActive))" OnClick="OpenCreateDialogAsync">Nova credencial</MudButton>
        </div>
    }
</section>

<div class="module-kpis">
    <div class="mini-kpi"><span class="mini-kpi-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Badge" /></span><div><strong>@_credentials.Count</strong><span>Credenciais</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon green"><MudIcon Icon="@Icons.Material.Outlined.Sync" /></span><div><strong>@SyncedCount</strong><span>Vínculos sincronizados</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon amber"><MudIcon Icon="@Icons.Material.Outlined.SyncProblem" /></span><div><strong>@PendingCount</strong><span>Pendências</span></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}
else if (Residents.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Cadastre um morador antes de criar credenciais de acesso.</MudAlert>
}
else if (!_devices.Any(x => x.IsActive))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Teste e ative ao menos um equipamento antes de sincronizar credenciais.</MudAlert>
}

<MudPaper Class="content-panel" Elevation="0">
    <div class="panel-toolbar credential-toolbar">
        <div><MudText Typo="Typo.h6" Class="panel-title">Base de credenciais</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Situação na F&amp;F Access e nos terminais vinculados</MudText></div>
        <div class="toolbar-filters">
            <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar morador, unidade ou credencial" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate />
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" Color="Color.Primary" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (!FilteredCredentials.Any())
    {
        <div class="empty-state compact-empty"><MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Large" Color="Color.Primary" /><MudText Typo="Typo.subtitle1">Nenhuma credencial encontrada</MudText></div>
    }
    else
    {
        <div class="credential-list">
            @foreach (var credential in FilteredCredentials)
            {
                <article class="credential-row">
                    <div class="credential-kind"><MudIcon Icon="@CredentialIcon(credential.Type)" /></div>
                    <div class="credential-person">
                        <MudText Typo="Typo.subtitle2">@credential.ResidentName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Unidade @credential.UnitNumber | @CredentialLabel(credential.Type) @(!credential.Type.Equals("Face", StringComparison.OrdinalIgnoreCase) ? credential.Identifier : string.Empty)</MudText>
                    </div>
                    <div class="credential-validity">
                        <MudChip T="string" Size="Size.Small" Color="@CredentialStatusColor(credential)" Variant="Variant.Outlined">@CredentialStatus(credential)</MudChip>
                        <span>até @credential.ValidTo.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        @if (credential.Type == "QrCode" && credential.MaxRenewals > 0) { <small>@credential.RenewalCount de @credential.MaxRenewals renovações</small> }
                    </div>
                    <div class="credential-bindings">
                        @if (credential.Devices.Count == 0)
                        {
                            <span class="sync-state pending"><MudIcon Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Small" /> Sem equipamento</span>
                        }
                        @foreach (var binding in credential.Devices)
                        {
                            <MudTooltip Text="@binding.Message"><span class="sync-state @(binding.IsSynced ? "ok" : "pending")"><MudIcon Icon="@(binding.IsSynced ? Icons.Material.Outlined.CloudDone : Icons.Material.Outlined.SyncProblem)" Size="Size.Small" /> @binding.DeviceName</span></MudTooltip>
                        }
                    </div>
                    <div class="credential-actions">
                        @if (CanManage) { <MudTooltip Text="@(credential.IsActive ? "Suspender" : "Ativar")"><MudIconButton Icon="@(credential.IsActive ? Icons.Material.Outlined.PauseCircle : Icons.Material.Outlined.PlayCircle)" Color="@(credential.IsActive ? Color.Warning : Color.Success)" Disabled="@IsOperating(credential.Id)" OnClick="@(() => ChangeStatusAsync(credential))" /></MudTooltip> }
                        @if (CanManage) { <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Dense>
                            @if (credential.Type == "QrCode" && credential.CanRenew)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.Update" OnClick="@(() => RenewAsync(credential))">Renovar QR Code</MudMenuItem>
                            }
                            @foreach (var device in _devices.Where(x => x.IsActive))
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.Restore" OnClick="@(() => RestoreAsync(credential, device.Id))">Restaurar em @device.Name</MudMenuItem>
                            }
                            @if (credential.Type.Equals("Face", StringComparison.OrdinalIgnoreCase))
                            {
                                @foreach (var binding in credential.Devices)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.FaceRetouchingNatural" OnClick="@(() => StartEnrollmentAsync(credential, binding.DeviceId))">Capturar em @binding.DeviceName</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Cancel" OnClick="@(() => CancelEnrollmentAsync(credential, binding.DeviceId))">Cancelar captura em @binding.DeviceName</MudMenuItem>
                                }
                            }
                            @foreach (var binding in credential.Devices)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.LinkOff" OnClick="@(() => RemoveBindingAsync(credential, binding.DeviceId))">Remover de @binding.DeviceName</MudMenuItem>
                            }
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline" Class="danger-menu-item" OnClick="@(() => DeleteCredentialAsync(credential))">Excluir credencial</MudMenuItem>
                        </MudMenu> }
                    </div>
                </article>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private LicenseStructureViewModel _structure = new();
    private List<AccessDeviceRowViewModel> _devices = [];
    private List<CredentialRowViewModel> _credentials = [];
    private Guid? _operatingId;
    private bool _loading = true;
    private string? _error;
    private string? _search;

    private List<ResidentRowViewModel> Residents => _structure.Blocks.SelectMany(x => x.Units).SelectMany(x => x.Residents).OrderBy(x => x.Name).ToList();
    private IEnumerable<CredentialRowViewModel> FilteredCredentials => string.IsNullOrWhiteSpace(_search)
        ? _credentials
        : _credentials.Where(x => $"{x.ResidentName} {x.UnitNumber} {x.Identifier} {x.Type}".Contains(_search, StringComparison.OrdinalIgnoreCase));
    private int SyncedCount => _credentials.SelectMany(x => x.Devices).Count(x => x.IsSynced);
    private int PendingCount => _credentials.SelectMany(x => x.Devices).Count(x => !x.IsSynced) + _credentials.Count(x => x.Devices.Count == 0);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var structureTask = CanManage ? Api.GetStructureAsync(LicenseId) : Task.FromResult(ApiResult<LicenseStructureViewModel>.Ok(new()));
        var devicesTask = CanManage ? Api.GetDevicesAsync(LicenseId) : Task.FromResult(ApiResult<List<AccessDeviceRowViewModel>>.Ok([]));
        var credentialsTask = Api.GetCredentialsAsync(LicenseId);
        await Task.WhenAll(structureTask, devicesTask, credentialsTask);
        _loading = false;

        if (structureTask.Result.Success) _structure = structureTask.Result.Value ?? new(); else _error = structureTask.Result.Error;
        if (devicesTask.Result.Success) _devices = devicesTask.Result.Value ?? []; else _error ??= devicesTask.Result.Error;
        if (credentialsTask.Result.Success) _credentials = credentialsTask.Result.Value ?? []; else _error ??= credentialsTask.Result.Error;
    }

    private async Task OpenCreateDialogAsync()
    {
        if (Residents.Count == 0 || !_devices.Any(x => x.IsActive)) return;
        var parameters = new DialogParameters
        {
            [nameof(CredentialFormDialog.LicenseId)] = LicenseId,
            [nameof(CredentialFormDialog.Residents)] = Residents,
            [nameof(CredentialFormDialog.Devices)] = _devices
        };
        var dialog = await DialogService.ShowAsync<CredentialFormDialog>("Nova credencial", parameters, new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var operation = result.Data as CredentialOperationViewModel;
        Snackbar.Add(operation?.Message ?? "Credencial cadastrada.", operation?.Synced == true ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }

    private async Task OpenOperationsAsync()
    {
        var parameters = new DialogParameters { [nameof(AccessOperationsDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<AccessOperationsDialog>("Central de operações", parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task ChangeStatusAsync(CredentialRowViewModel credential) =>
        await OperateAsync(credential.Id, () => Api.SetCredentialStatusAsync(LicenseId, credential.Id, !credential.IsActive));

    private async Task RestoreAsync(CredentialRowViewModel credential, Guid deviceId) =>
        await OperateAsync(credential.Id, () => Api.RestoreCredentialAsync(LicenseId, credential.Id, deviceId, null));

    private async Task RenewAsync(CredentialRowViewModel credential) =>
        await OperateAsync(credential.Id, () => Api.RenewCredentialAsync(LicenseId, credential.Id));

    private async Task OperateAsync(Guid credentialId, Func<Task<ApiResult<CredentialOperationViewModel>>> operation)
    {
        _operatingId = credentialId; _error = null;
        var result = await operation();
        _operatingId = null;
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add(result.Value?.Message ?? "Operação concluída.", result.Value?.Synced == true ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }

    private async Task StartEnrollmentAsync(CredentialRowViewModel credential, Guid deviceId)
    {
        _operatingId = credential.Id; _error = null;
        var result = await Api.StartFaceEnrollmentAsync(LicenseId, credential.Id, deviceId);
        _operatingId = null;
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add("Captura facial iniciada no equipamento.", Severity.Info);
        await LoadAsync();
    }

    private async Task RemoveBindingAsync(CredentialRowViewModel credential, Guid deviceId)
    {
        _operatingId = credential.Id; _error = null;
        var result = await Api.RemoveCredentialFromDeviceAsync(LicenseId, credential.Id, deviceId);
        _operatingId = null;
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add("Vínculo removido do equipamento.", Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteCredentialAsync(CredentialRowViewModel credential)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir credencial",
            $"Excluir {CredentialLabel(credential.Type).ToLowerInvariant()} de {credential.ResidentName}? A F&F Access tentará removê-la de todos os equipamentos antes de apagar o cadastro.",
            yesText: "Excluir credencial",
            cancelText: "Cancelar");
        if (confirmed != true) return;

        _operatingId = credential.Id;
        _error = null;
        var result = await Api.DeleteCredentialAsync(LicenseId, credential.Id);
        _operatingId = null;
        if (!result.Success)
        {
            _error = result.Error;
            Snackbar.Add(result.Error ?? "Não foi possível excluir a credencial.", Severity.Error);
            await LoadAsync();
            return;
        }

        Snackbar.Add(result.Value?.Message ?? "Credencial excluída.", Severity.Success);
        await LoadAsync();
    }

    private async Task CancelEnrollmentAsync(CredentialRowViewModel credential, Guid deviceId)
    {
        _operatingId = credential.Id; _error = null;
        var result = await Api.CancelFaceEnrollmentAsync(LicenseId, deviceId);
        _operatingId = null;
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add("Captura facial cancelada.", Severity.Info);
        await LoadAsync();
    }

    private bool IsOperating(Guid id) => _operatingId == id;
    private static string CredentialIcon(string type) => type switch { "Face" => Icons.Material.Outlined.Face, "QrCode" => Icons.Material.Outlined.QrCode2, "Card" => Icons.Material.Outlined.CreditCard, "Password" => Icons.Material.Outlined.Password, _ => Icons.Material.Outlined.Sensors };
    private static string CredentialLabel(string type) => type switch { "Face" => "Facial", "QrCode" => "QR Code", "Card" => "Cartão", "VehicleTag" => "Tag veicular", "Password" => "Senha / PIN", _ => "Tag" };
    private static string CredentialStatus(CredentialRowViewModel item) => item.ValidTo <= DateTime.UtcNow ? "Expirada" : item.IsActive ? item.IsTemporary ? "Temporária" : "Ativa" : "Suspensa";
    private static Color CredentialStatusColor(CredentialRowViewModel item) => item.ValidTo <= DateTime.UtcNow ? Color.Error : item.IsActive ? item.IsTemporary ? Color.Info : Color.Success : Color.Default;
}
