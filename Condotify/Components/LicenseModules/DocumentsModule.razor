@inject CondotifyApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert> }

@if (_loading)
{
    <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
}
else
{
    <div class="module-page-heading">
        <div class="module-page-heading-copy">
            <span class="module-heading-icon blue"><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" /></span>
            <div>
                <MudText Typo="Typo.h5" HtmlTag="h2">Central de documentos</MudText>
                <MudText Typo="Typo.body2">Organize arquivos importantes e disponibilize-os no aplicativo dos moradores.</MudText>
            </div>
        </div>
        <div class="module-page-heading-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.UploadFile" OnClick="OpenUploadAsync" Disabled="!CanManage">Novo documento</MudButton>
        </div>
    </div>

    <section class="content-panel">
        <div class="panel-heading">
            <div><MudText Typo="Typo.h6">Biblioteca do condomínio</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@(_documents.Count == 0 ? "Nenhum arquivo publicado" : $"{_documents.Count} arquivo(s) publicado(s)")</MudText></div>
            @if (_documents.Count > 0)
            {
                <MudSelect T="string" Label="Categoria" Value="_categoryFilter" ValueChanged="OnCategoryFilterChanged" Class="resource-category-filter" Clearable Dense Variant="Variant.Outlined">
                    @foreach (var option in CategoryOptions)
                    {
                        <MudSelectItem T="string" Value="option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>

        @if (FilteredDocuments.Count == 0)
        {
            <div class="resource-empty-state">
                <div class="resource-empty-visual">
                    <span><MudIcon Icon="@Icons.Material.Outlined.Description" /></span>
                    <i class="resource-sheet sheet-one"></i>
                    <i class="resource-sheet sheet-two"></i>
                </div>
                <div class="resource-empty-copy">
                    <MudText Typo="Typo.overline">BIBLIOTECA DIGITAL</MudText>
                    <MudText Typo="Typo.h5">@EmptyStateTitle</MudText>
                    <MudText Typo="Typo.body2">@EmptyStateHint</MudText>
                    @if (string.IsNullOrWhiteSpace(_categoryFilter))
                    {
                        <div class="documents-empty-legend">
                            @foreach (var option in CategoryOptions.Take(4))
                            {
                                <span class="category-chip @CategoryClass(option.Value)"><MudIcon Icon="@CategoryIcon(option.Value)" Size="Size.Small" />@option.Label</span>
                            }
                        </div>
                        @if (CanManage)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.UploadFile" OnClick="OpenUploadAsync">Publicar primeiro documento</MudButton>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="document-list">
                @foreach (var document in FilteredDocuments)
                {
                    <div class="document-row">
                        <span class="category-badge @CategoryClass(document.Category)"><MudIcon Icon="@CategoryIcon(document.Category)" /></span>
                        <div class="document-row-body">
                            <div class="document-row-top">
                                <span class="document-row-title">@document.Title</span>
                                <span class="category-chip @CategoryClass(document.Category)">@CategoryLabel(document.Category)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(document.Description))
                            {
                                <div class="document-row-desc">@document.Description</div>
                            }
                            <div class="document-row-meta">Publicado em @document.PublishedAt.ToCondotifyTime().ToString("dd/MM/yyyy") · @document.UploadedByName</div>
                        </div>
                        <div class="document-row-actions">
                            <MudTooltip Text="Abrir"><MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" OnClick="() => OpenFileAsync(document.Id)" /></MudTooltip>
                            <MudTooltip Text="Excluir"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" Disabled="!CanManage" OnClick="() => DeleteAsync(document.Id)" /></MudTooltip>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private static readonly (string Value, string Label)[] CategoryOptions =
    [
        ("Minutes", "Ata"),
        ("ByLaws", "Regimento Interno"),
        ("Covenant", "Convenção"),
        ("Announcement", "Comunicado"),
        ("FinancialStatement", "Prestação de Contas"),
        ("Other", "Outro")
    ];

    private List<ResourceDocumentViewModel> _documents = [];
    private string _categoryFilter = string.Empty;
    private bool _loading;
    private string? _error;

    private List<ResourceDocumentViewModel> FilteredDocuments => string.IsNullOrWhiteSpace(_categoryFilter)
        ? _documents
        : _documents.Where(x => x.Category == _categoryFilter).ToList();

    private string EmptyStateTitle => string.IsNullOrWhiteSpace(_categoryFilter)
        ? "Nenhum documento publicado"
        : $"Nenhum documento em \"{CategoryLabel(_categoryFilter)}\"";

    private string EmptyStateHint => string.IsNullOrWhiteSpace(_categoryFilter)
        ? "Atas, regimento, convenção e comunicados publicados aqui ficam visíveis a todos os moradores."
        : "Publique um documento nesta categoria ou troque o filtro para ver as outras.";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetDocumentsAsync(LicenseId);
        _loading = false;
        if (result.Success) _documents = result.Value ?? [];
        else _error = result.Error;
    }

    private void OnCategoryFilterChanged(string value) => _categoryFilter = value;

    private async Task OpenUploadAsync()
    {
        var parameters = new DialogParameters { [nameof(DocumentUploadDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<DocumentUploadDialog>("Novo documento", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    private async Task OpenFileAsync(Guid documentId)
    {
        var result = await Api.GetDocumentFileAsync(LicenseId, documentId);
        if (!result.Success || string.IsNullOrWhiteSpace(result.Value))
        {
            Snackbar.Add(result.Error ?? "Não foi possível abrir o documento.", Severity.Error);
            return;
        }
        var base64 = StripDataUrlPrefix(result.Value!);
        if (base64 is null)
        {
            Snackbar.Add("Não foi possível abrir o documento.", Severity.Error);
            return;
        }
        var document = _documents.FirstOrDefault(x => x.Id == documentId);
        await JS.InvokeVoidAsync("portalInterop.downloadBase64", $"{SanitizeFileName(document?.Title)}.pdf", base64, "application/pdf");
    }

    private async Task DeleteAsync(Guid documentId)
    {
        var document = _documents.FirstOrDefault(x => x.Id == documentId);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir documento",
            $"Excluir \"{document?.Title}\"? O arquivo não poderá ser recuperado.",
            yesText: "Excluir", cancelText: "Cancelar");
        if (confirmed != true) return;

        var result = await Api.DeleteDocumentAsync(LicenseId, documentId);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "Não foi possível excluir o documento.", Severity.Error);
            return;
        }
        await LoadAsync();
    }

    private static string? StripDataUrlPrefix(string dataUrl)
    {
        var separator = dataUrl.IndexOf("base64,", StringComparison.OrdinalIgnoreCase);
        return separator < 0 ? null : dataUrl[(separator + "base64,".Length)..];
    }

    private static string CategoryLabel(string category) => CategoryOptions.FirstOrDefault(x => x.Value == category).Label is { Length: > 0 } label ? label : category;

    private static string CategoryClass(string category) => category switch
    {
        "Minutes" => "category-primary",
        "Covenant" => "category-teal",
        "Announcement" => "category-amber",
        "FinancialStatement" => "category-green",
        _ => "category-neutral"
    };

    private static string CategoryIcon(string category) => category switch
    {
        "Minutes" => Icons.Material.Outlined.Article,
        "ByLaws" => Icons.Material.Outlined.Gavel,
        "Covenant" => Icons.Material.Outlined.Handshake,
        "Announcement" => Icons.Material.Outlined.Campaign,
        "FinancialStatement" => Icons.Material.Outlined.ReceiptLong,
        _ => Icons.Material.Outlined.InsertDriveFile
    };

    private static string SanitizeFileName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "documento";
        var invalid = Path.GetInvalidFileNameChars().Concat(['/', '\\', ':']).ToHashSet();
        var cleaned = new string(value.Select(c => invalid.Contains(c) ? '-' : c).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "documento" : cleaned;
    }
}
