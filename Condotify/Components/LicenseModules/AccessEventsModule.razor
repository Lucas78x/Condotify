@inject CondotifyApiClient Api

<section class="module-intro">
    <div>
        <MudText Typo="Typo.h5">Eventos de acesso</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Consulte autorizações e recusas registradas diretamente nos controladores.</MudText>
    </div>
    <div class="access-log-actions">
        <MudSelect T="Guid" @bind-Value="_deviceId" Label="Equipamento" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var device in _devices.Where(x => x.IsActive))
            {
                <MudSelectItem T="Guid" Value="@device.Id">@device.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="@(_loading || _deviceId == Guid.Empty)" OnClick="LoadEventsAsync">@(_loading ? "Consultando" : "Atualizar")</MudButton>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
        <div class="alert-content">
            <span>@_error</span>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="@_loading" OnClick="LoadEventsAsync">Tentar novamente</MudButton>
        </div>
    </MudAlert>
}

<div class="module-kpis">
    <div class="mini-kpi"><span class="mini-kpi-icon blue"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span><div><strong>@_events.Count</strong><span>Eventos carregados</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon green"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" /></span><div><strong>@_events.Count(x => x.Authorized)</strong><span>Autorizados</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon amber"><MudIcon Icon="@Icons.Material.Outlined.Block" /></span><div><strong>@_events.Count(x => !x.Authorized)</strong><span>Negados ou alertas</span></div></div>
</div>

<MudPaper Class="content-panel" Elevation="0">
    <div class="panel-toolbar">
        <div>
            <MudText Typo="Typo.h6" Class="panel-title">Linha do tempo</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(_lastUpdated.HasValue ? $"Atualizado em {_lastUpdated.Value:dd/MM/yyyy 'as' HH:mm:ss}" : "Consulta sob demanda diretamente no equipamento")
            </MudText>
        </div>
        <div class="access-event-filters">
            <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar pessoa, credencial ou porta" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
            <MudSelect T="string" @bind-Value="_resultFilter" Label="Resultado" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("all")">Todos</MudSelectItem>
                <MudSelectItem T="string" Value="@("authorized")">Autorizados</MudSelectItem>
                <MudSelectItem T="string" Value="@("denied")">Negados e alertas</MudSelectItem>
            </MudSelect>
        </div>
    </div>
    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (!FilteredEvents.Any())
    {
        <div class="empty-state compact-empty"><MudIcon Icon="@Icons.Material.Outlined.EventNote" Size="Size.Large" Color="Color.Primary" /><MudText Typo="Typo.subtitle1">Nenhum evento encontrado</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@(_events.Count == 0 ? "Selecione um equipamento ativo e atualize a consulta." : "Ajuste a busca ou o filtro de resultado.")</MudText></div>
    }
    else
    {
        <div class="table-wrap">
            <MudTable Items="FilteredEvents" Hover Dense Elevation="0">
                <HeaderContent><MudTh>Data e hora</MudTh><MudTh>Resultado</MudTh><MudTh>Pessoa</MudTh><MudTh>Credencial</MudTh><MudTh>Porta</MudTh><MudTh>Equipamento</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Data e hora">@context.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Resultado"><MudChip T="string" Size="Size.Small" Color="@(context.Authorized ? Color.Success : Color.Error)" Variant="Variant.Outlined" Icon="@(context.Authorized ? Icons.Material.Outlined.Check : Icons.Material.Outlined.Close)">@context.Event</MudChip></MudTd>
                    <MudTd DataLabel="Pessoa">@(!string.IsNullOrWhiteSpace(context.PersonName) ? context.PersonName : context.ExternalUserId)</MudTd>
                    <MudTd DataLabel="Credencial">@(!string.IsNullOrWhiteSpace(context.Credential) ? context.Credential : "-")</MudTd>
                    <MudTd DataLabel="Porta">@(!string.IsNullOrWhiteSpace(context.Portal) ? context.Portal : "-")</MudTd>
                    <MudTd DataLabel="Equipamento">@context.DeviceName</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    private List<AccessDeviceRowViewModel> _devices = [];
    private List<AccessEventRowViewModel> _events = [];
    private Guid _deviceId;
    private bool _loading = true;
    private string? _error;
    private string? _search;
    private string _resultFilter = "all";
    private DateTimeOffset? _lastUpdated;

    private IEnumerable<AccessEventRowViewModel> FilteredEvents => _events
        .Where(x => _resultFilter == "all" || (_resultFilter == "authorized" ? x.Authorized : !x.Authorized))
        .Where(x => string.IsNullOrWhiteSpace(_search) ||
            Contains(x.PersonName, _search) ||
            Contains(x.ExternalUserId, _search) ||
            Contains(x.Credential, _search) ||
            Contains(x.Portal, _search) ||
            Contains(x.Event, _search));

    protected override async Task OnInitializedAsync()
    {
        var devices = await Api.GetDevicesAsync(LicenseId);
        if (!devices.Success) { _error = devices.Error; _loading = false; return; }
        _devices = devices.Value ?? [];
        _deviceId = _devices.FirstOrDefault(x => x.IsActive)?.Id ?? Guid.Empty;
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        if (_deviceId == Guid.Empty) { _loading = false; return; }
        _loading = true; _error = null;
        var result = await Api.GetAccessEventsAsync(LicenseId, _deviceId);
        _loading = false;
        if (result.Success)
        {
            _events = result.Value ?? [];
            _lastUpdated = DateTimeOffset.Now;
        }
        else
        {
            _error = result.Error;
        }
    }

    private static bool Contains(string? value, string search) =>
        value?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) == true;
}
