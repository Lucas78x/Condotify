@inject CondotifyApiClient Api
@inject IDialogService DialogService

@if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert> }

<div class="module-page-heading finance-module-heading">
    <div class="module-page-heading-copy">
        <span class="module-heading-icon amber"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span>
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h2">Boletos e cobranças</MudText>
            <MudText Typo="Typo.body2">Distribua boletos por unidade com conferência antes da publicação.</MudText>
        </div>
    </div>
    @if (_batches.Count > 0)
    {
        <div class="module-page-heading-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ReceiptLong" OnClick="OpenSingleUploadAsync" Disabled="!CanManage">Boleto avulso</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.UploadFile" OnClick="OpenUploadAsync" Disabled="!CanManage">Novo lote</MudButton>
        </div>
    }
</div>

@if (_loading)
{
    <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
}
else if (_batches.Count == 0)
{
    <section class="finance-onboarding">
        <div class="finance-onboarding-intro">
            <span class="finance-hero-icon"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span>
            <MudText Typo="Typo.overline">PRIMEIRA PUBLICAÇÃO</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h3">Entregue cada boleto à unidade certa</MudText>
            <MudText Typo="Typo.body2">Envie o PDF completo da administradora. A F&amp;F Access separa as páginas, sugere as unidades e só publica depois da sua revisão.</MudText>
            <div class="finance-trust-list">
                <span><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /> Revisão antes de enviar</span>
                <span><MudIcon Icon="@Icons.Material.Outlined.History" /> Histórico de cada lote</span>
            </div>
            <div class="finance-onboarding-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.UploadFile" OnClick="OpenUploadAsync" Disabled="!CanManage">Enviar primeiro lote</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ReceiptLong" OnClick="OpenSingleUploadAsync" Disabled="!CanManage">Enviar boleto avulso</MudButton>
            </div>
        </div>

        <div class="finance-flow" aria-label="Como publicar um lote de boletos">
            <div class="finance-flow-head">
                <span>Como funciona</span>
                <small>Leva poucos minutos</small>
            </div>
            <ol>
                <li>
                    <span>01</span>
                    <div><strong>Envie o PDF</strong><small>Uma página por unidade, em um único arquivo.</small></div>
                    <MudIcon Icon="@Icons.Material.Outlined.UploadFile" />
                </li>
                <li>
                    <span>02</span>
                    <div><strong>Confira as associações</strong><small>Revise as unidades identificadas automaticamente.</small></div>
                    <MudIcon Icon="@Icons.Material.Outlined.FactCheck" />
                </li>
                <li>
                    <span>03</span>
                    <div><strong>Publique para os moradores</strong><small>Os documentos aparecem no aplicativo imediatamente.</small></div>
                    <MudIcon Icon="@Icons.Material.Outlined.Send" />
                </li>
            </ol>
        </div>
    </section>
}
else
{
    <section class="content-panel">
        <div class="panel-heading">
            <div><MudText Typo="Typo.h5">Lotes de boletos</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Histórico de envios para esta licença</MudText></div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_batches.Count lote(s)</MudChip>
        </div>
        <MudTable Items="_batches" Hover Dense Elevation="0">
            <HeaderContent>
                <MudTh>Referência</MudTh>
                <MudTh>Vencimento</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Páginas</MudTh>
                <MudTh>Enviado por</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Referência">@context.Reference</MudTd>
                <MudTd DataLabel="Vencimento">@context.DueDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)" Variant="Variant.Outlined">@StatusLabel(context.Status)</MudChip></MudTd>
                <MudTd DataLabel="Páginas">@context.MatchedCount / @context.TotalPages casadas</MudTd>
                <MudTd DataLabel="Enviado por">@context.UploadedByName</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => OpenReviewAsync(context.Id)" Disabled="!CanManage">
                        @(context.Status == "PendingReview" ? "Revisar" : "Detalhes")
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </section>
}

@code {
    [Parameter] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private List<BoletoBatchViewModel> _batches = [];
    private bool _loading;
    private string? _error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetBoletoBatchesAsync(LicenseId);
        _loading = false;
        if (result.Success) _batches = result.Value ?? [];
        else _error = result.Error;
    }

    private async Task OpenUploadAsync()
    {
        var parameters = new DialogParameters { [nameof(BoletoUploadDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<BoletoUploadDialog>("Novo lote de boletos", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
            if (result.Data is BoletoBatchDetailViewModel detail)
                await OpenReviewAsync(detail.Batch.Id);
        }
    }

    private async Task OpenSingleUploadAsync()
    {
        var parameters = new DialogParameters { [nameof(BoletoSingleUploadDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<BoletoSingleUploadDialog>("Enviar boleto avulso", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    private async Task OpenReviewAsync(Guid batchId)
    {
        var parameters = new DialogParameters { [nameof(BoletoReviewDialog.LicenseId)] = LicenseId, [nameof(BoletoReviewDialog.BatchId)] = batchId };
        var dialog = await DialogService.ShowAsync<BoletoReviewDialog>("Revisão do lote", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    private static string StatusLabel(string status) => status switch
    {
        "Processing" => "Processando",
        "PendingReview" => "Em revisão",
        "Published" => "Publicado",
        "Cancelled" => "Cancelado",
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        "PendingReview" => Color.Warning,
        "Published" => Color.Success,
        "Cancelled" => Color.Default,
        _ => Color.Info
    };
}
