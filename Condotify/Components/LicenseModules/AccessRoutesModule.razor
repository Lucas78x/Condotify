@inject CondotifyApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<section class="module-intro">
    <div>
        <MudText Typo="Typo.h2">Rotas de acesso</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Distribua credenciais por perfil, equipamentos, portas e horários.</MudText>
    </div>
    @if (CanManage)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddRoad" OnClick="@(() => OpenRouteAsync(null))">Nova rota</MudButton>
    }
</section>

<div class="module-kpis">
    <div class="mini-kpi"><span class="mini-kpi-icon blue"><MudIcon Icon="@Icons.Material.Outlined.AltRoute" /></span><div><strong>@_routes.Count</strong><span>Rotas configuradas</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon green"><MudIcon Icon="@Icons.Material.Outlined.Sensors" /></span><div><strong>@_routes.SelectMany(x => x.Devices).Select(x => x.DeviceId).Distinct().Count()</strong><span>Equipamentos cobertos</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon amber"><MudIcon Icon="@Icons.Material.Outlined.Schedule" /></span><div><strong>@_routes.Count(x => x.AllowTemporary)</strong><span>Permitem temporarios</span></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

<MudPaper Class="content-panel" Elevation="0">
    <div class="panel-toolbar">
        <div><MudText Typo="Typo.h5" Class="panel-title">Políticas de distribuição</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Uma pessoa recebe automaticamente as rotas compatíveis com seu perfil</MudText></div>
        <MudTooltip Text="Atualizar"><MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary" OnClick="LoadAsync" /></MudTooltip>
    </div>

    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (_routes.Count == 0)
    {
        <div class="empty-state compact-empty">
            <MudIcon Icon="@Icons.Material.Outlined.AddRoad" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">Nenhuma rota configurada</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Crie a primeira rota antes de ativar credenciais faciais.</MudText>
            @if (CanManage) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => OpenRouteAsync(null))">Criar primeira rota</MudButton> }
        </div>
    }
    else
    {
        <div class="access-route-list">
            @foreach (var route in _routes)
            {
                <article class="access-route-row">
                    <span class="access-route-icon"><MudIcon Icon="@Icons.Material.Outlined.AltRoute" /></span>
                    <div class="access-route-main"><strong>@route.Name</strong><span>@(string.IsNullOrWhiteSpace(route.Description) ? AudienceSummary(route) : route.Description)</span></div>
                    <div class="access-route-audience"><small>Público</small><strong>@AudienceSummary(route)</strong></div>
                    <div class="access-route-schedule"><small>Horário</small><strong>@ScheduleSummary(route)</strong></div>
                    <div class="access-route-targets"><small>Destinos</small><strong>@route.Devices.Count equipamento(s)</strong><span>@string.Join(" | ", route.Devices.Take(2).Select(DeviceSummary))</span></div>
                    @if (route.AllowTemporary) { <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Temporarios</MudChip> }
                    <MudChip T="string" Size="Size.Small" Color="@(route.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">@(route.IsActive ? "Ativa" : "Inativa")</MudChip>
                    @if (CanManage)
                    {
                        <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => OpenRouteAsync(route))">Editar rota</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline" Class="danger-menu-item" OnClick="@(() => DeleteRouteAsync(route))">Excluir rota</MudMenuItem>
                        </MudMenu>
                    }
                </article>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private List<AccessRouteViewModel> _routes = [];
    private bool _loading = true;
    private Guid _loadedLicenseId;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedLicenseId == LicenseId) return;
        _loadedLicenseId = LicenseId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetAccessRoutesAsync(LicenseId);
        _loading = false;
        if (result.Success && result.Value is not null) _routes = result.Value;
        else _error = result.Error ?? "Não foi possível carregar as rotas.";
    }

    private async Task OpenRouteAsync(AccessRouteViewModel? route)
    {
        var parameters = new DialogParameters { [nameof(AccessRouteFormDialog.LicenseId)] = LicenseId, [nameof(AccessRouteFormDialog.Route)] = route };
        var dialog = await DialogService.ShowAsync<AccessRouteFormDialog>(route is null ? "Nova rota de acesso" : "Editar rota de acesso", parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        Snackbar.Add(route is null ? "Rota criada." : "Rota atualizada.", Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteRouteAsync(AccessRouteViewModel route)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Excluir rota", $"Excluir a rota {route.Name}? As credenciais existentes serão reconciliadas na próxima ativação.", yesText: "Excluir rota", cancelText: "Cancelar");
        if (confirmed != true) return;
        var result = await Api.DeleteAccessRouteAsync(LicenseId, route.Id);
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível excluir a rota.", Severity.Error); return; }
        Snackbar.Add("Rota excluida.", Severity.Success);
        await LoadAsync();
    }

    private static string DeviceSummary(AccessRouteDeviceViewModel item) => $"{item.DeviceName} P{item.PortalNumber}";
    private static string ScheduleSummary(AccessRouteViewModel item) => $"{DaysSummary(item.DaysOfWeekMask)} | {item.StartTime:hh\\:mm}-{item.EndTime:hh\\:mm}";
    private static string DaysSummary(int mask) => mask == 127 ? "Todos os dias" : string.Join(", ", new[] { (1, "Dom"), (2, "Seg"), (4, "Ter"), (8, "Qua"), (16, "Qui"), (32, "Sex"), (64, "Sab") }.Where(x => (mask & x.Item1) != 0).Select(x => x.Item2));
    private static string AudienceSummary(AccessRouteViewModel route)
    {
        var value = (AccessRouteAudience)route.Audience;
        var labels = new List<string>();
        if (value.HasFlag(AccessRouteAudience.OwnerResponsible)) labels.Add("Proprietários");
        if (value.HasFlag(AccessRouteAudience.TenantResponsible)) labels.Add("Locatarios");
        if (value.HasFlag(AccessRouteAudience.Responsible)) labels.Add("Responsaveis");
        if (value.HasFlag(AccessRouteAudience.Resident)) labels.Add("Moradores");
        if (value.HasFlag(AccessRouteAudience.Dependent)) labels.Add("Dependentes");
        if (value.HasFlag(AccessRouteAudience.Visitor)) labels.Add("Visitantes");
        if (value.HasFlag(AccessRouteAudience.ServiceProvider)) labels.Add("Prestadores");
        return string.Join(", ", labels);
    }
}
