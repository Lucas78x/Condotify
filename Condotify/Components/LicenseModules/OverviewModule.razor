<div class="stats-grid workspace-overview-stats">
    <StatTile Label="@License.GroupLabelPlural" Value="@License.TotalBlocks.ToString()" Hint="@(License.TotalBlocks == 0 ? "Estrutura ainda não iniciada" : "Estrutura cadastrada")" Icon="@Icons.Material.Outlined.Apartment" Tone="blue" />
    <StatTile Label="@License.UnitLabelPlural" Value="@License.TotalUnits.ToString()" Hint="@(License.TotalUnits == 0 ? "Aguardando cadastro" : $"{License.UnitLabelPlural} disponíveis")" Icon="@Icons.Material.Outlined.MeetingRoom" Tone="amber" />
    <StatTile Label="Moradores" Value="@License.TotalResidents.ToString()" Hint="@(License.TotalResidents == 0 ? "Nenhum convite concluído" : "Pessoas vinculadas")" Icon="@Icons.Material.Outlined.Groups" Tone="green" />
    <StatTile Label="Validade" Value="@License.ExpireDate.ToString("dd/MM/yyyy")" Hint="@(License.IsExpired ? "Licença expirada" : "Licença ativa")" Icon="@Icons.Material.Outlined.EventAvailable" Tone="red" />
</div>

<section class="overview-next-actions" aria-label="Próximas ações do condomínio">
    <div><span class="overview-action-label">ACOMPANHAMENTO</span><h2>Da visão geral à próxima ação</h2><p>Abra os serviços deste condomínio para acompanhar pendências e agir.</p></div>
    <div class="overview-action-links">
        @if (CanViewCredentials) { <a href="@Url("credenciais")"><MudIcon Icon="@Icons.Material.Outlined.Badge" /><span><strong>Revisar credenciais</strong><small>Cadastro e distribuição por equipamento</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
        @if (CanViewDevices) { <a href="@Url("equipamentos")"><MudIcon Icon="@Icons.Material.Outlined.Sensors" /><span><strong>Ver equipamentos</strong><small>Conexão, terminais e acionamentos</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
        @if (CanViewDocuments) { <a href="@Url("documentos")"><MudIcon Icon="@Icons.Material.Outlined.Description" /><span><strong>Consultar documentos</strong><small>Arquivos disponíveis neste condomínio</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
    </div>
</section>

@if (License.TotalBlocks == 0 || License.TotalUnits == 0 || License.TotalResidents == 0)
{
    <div class="overview-grid overview-onboarding-grid">
        <MudPaper Class="content-panel overview-onboarding-panel" Elevation="0">
            <div class="panel-toolbar overview-onboarding-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Prepare o condomínio para operar</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Uma configuração guiada, sem telas vazias</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@CompletedSteps de 3 etapas</MudChip>
            </div>
            <div class="panel-body overview-onboarding-body">
                <div class="overview-onboarding-visual" aria-hidden="true">
                    <span></span><span></span><span></span>
                    <MudIcon Icon="@Icons.Material.Outlined.Apartment" />
                </div>
                <div class="overview-onboarding-copy">
                    <MudText Typo="Typo.h5" HtmlTag="h2">@NextStepTitle</MudText>
                    <MudText Typo="Typo.body2">@NextStepDescription</MudText>
                    <div class="setup-progress-label"><span>Configuração inicial</span><strong>@Progress%</strong></div>
                    <div class="setup-progress" role="progressbar" aria-label="Configuração inicial" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Progress"><span style="@($"width:{Progress}%")"></span></div>
                    @if (CanManageStructure || CanManagePeople)
                    {
                    <div class="overview-onboarding-actions">
                        <MudButton Href="@Url("estrutura")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">@NextStepAction</MudButton>
                        <MudButton Href="@Url("estrutura")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.UploadFile">Importar planilha</MudButton>
                    </div>
                    }
                </div>
            </div>
        </MudPaper>

        <div class="overview-side overview-guidance-side">
            <MudPaper Class="content-panel" Elevation="0">
                <div class="panel-toolbar">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="panel-title">Próximas ações</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Siga a ordem recomendada</MudText>
                    </div>
                </div>
                <div class="panel-body setup-actions">
                    @if (CanViewStructure) {
                    <a class="setup-action" href="@Url("estrutura")"><span class="setup-action-index">@(License.TotalBlocks > 0 ? "✓" : "01")</span><span><strong>Criar estrutura</strong><small>@License.GroupLabelPlural, andares e @License.UnitLabelPlural.ToLowerInvariant()</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a>
                    }
                    @if (CanViewStructure) {
                    <a class="setup-action" href="@Url("estrutura")"><span class="setup-action-index">@(License.TotalResidents > 0 ? "✓" : "02")</span><span><strong>Convidar moradores</strong><small>Envio seguro por link</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a>
                    }
                    @if (CanViewCredentials) {
                    <a class="setup-action" href="@Url("credenciais")"><span class="setup-action-index">03</span><span><strong>Configurar acessos</strong><small>Credenciais e equipamentos</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a>
                    }
                </div>
            </MudPaper>

            <div class="overview-activity-note">
                <span class="overview-activity-dot"></span>
                <span><strong>Licença criada e pronta para configuração</strong><small>@License.CreatedAt.ToCondotifyTime().ToString("dd/MM/yyyy 'às' HH:mm")</small></span>
            </div>
        </div>
    </div>
}
else
{
    <div class="overview-grid">
        <MudPaper Class="content-panel" Elevation="0">
            <div class="panel-toolbar">
                <div><MudText Typo="Typo.h5" Class="panel-title">Estrutura do condomínio</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Distribuição cadastrada por @License.GroupLabelSingular.ToLowerInvariant()</MudText></div>
                <MudButton Href="@Url("estrutura")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AccountTree">Ver estrutura</MudButton>
            </div>
            <div class="panel-body">
                <div class="hierarchy-grid group-card-grid">
                    @foreach (var block in License.Blocks)
                    {
                        <div class="hierarchy-card group-card">
                            <span class="hierarchy-card-icon"><MudIcon Icon="@Icons.Material.Outlined.Apartment" /></span>
                            <span class="hierarchy-card-main"><strong>@block.Name</strong><small>@License.GroupLabelSingular</small></span>
                            <span class="hierarchy-card-stats"><span><strong>@block.TotalUnits</strong>@(block.TotalUnits == 1 ? License.UnitLabelSingular.ToLowerInvariant() : License.UnitLabelPlural.ToLowerInvariant())</span><span><strong>@block.TotalResidents</strong>pessoas</span></span>
                    @if (CanViewStructure) {
                            <a href="@Url("estrutura")" class="hierarchy-card-action"><span>Ver estrutura</span><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></a>
                    }
                        </div>
                    }
                </div>
            </div>
        </MudPaper>

        <div class="overview-side">
            <MudPaper Class="content-panel" Elevation="0">
                <div class="panel-toolbar"><MudText Typo="Typo.subtitle1" Class="panel-title">Detalhes da licença</MudText></div>
                <div class="panel-body">
                    <div class="info-row"><span>Tipo</span><strong>@License.Type</strong></div>
                    <div class="info-row"><span>Cidade / Estado</span><strong>@License.City / @License.State</strong></div>
                    <div class="info-row"><span>Criada em</span><strong>@License.CreatedAt.ToString("dd/MM/yyyy")</strong></div>
                </div>
            </MudPaper>

            <MudPaper Class="content-panel" Elevation="0">
                <div class="panel-toolbar"><MudText Typo="Typo.subtitle1" Class="panel-title">Ações rápidas</MudText></div>
                <div class="panel-body quick-actions">
                    @if (CanViewStructure) {
                    <a class="qa-item" href="@Url("estrutura")"><MudIcon Icon="@Icons.Material.Outlined.AddHomeWork" />Cadastrar @License.GroupLabelSingular.ToLowerInvariant()<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Class="qa-arrow" /></a>
                    }
                    @if (CanViewStructure) {
                    <a class="qa-item" href="@Url("estrutura")"><MudIcon Icon="@Icons.Material.Outlined.Groups" />Ver moradores<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Class="qa-arrow" /></a>
                    }
                    @if (CanViewCredentials) {
                    <a class="qa-item" href="@Url("credenciais")"><MudIcon Icon="@Icons.Material.Outlined.Badge" />Configurar acessos<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Class="qa-arrow" /></a>
                    }
                    @if (CanViewDocuments)
                    {
                        <a class="qa-item" href="@Url("documentos")"><MudIcon Icon="@Icons.Material.Outlined.Description" />Ver documentos<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Class="qa-arrow" /></a>
                    }
                </div>
            </MudPaper>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public LicenseFullViewModel License { get; set; } = new();
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter, EditorRequired] public string LicenseUrlKey { get; set; } = string.Empty;
    [Parameter] public bool CanViewDocuments { get; set; }
    [Parameter] public bool CanViewStructure { get; set; }
    [Parameter] public bool CanManageStructure { get; set; }
    [Parameter] public bool CanManagePeople { get; set; }
    [Parameter] public bool CanViewCredentials { get; set; }
    [Parameter] public bool CanViewDevices { get; set; }
    private int CompletedSteps => (License.TotalBlocks > 0 ? 1 : 0) + (License.TotalUnits > 0 ? 1 : 0) + (License.TotalResidents > 0 ? 1 : 0);
    private int Progress => CompletedSteps * 100 / 3;
    private string NextStepTitle => License.TotalBlocks == 0 ? "Comece pela estrutura" : License.TotalUnits == 0 ? "Cadastre as unidades" : "Convide os moradores";
    private string NextStepDescription => License.TotalBlocks == 0 ? $"Cadastre o primeiro {License.GroupLabelSingular.ToLowerInvariant()} para organizar o condomínio." : License.TotalUnits == 0 ? $"Adicione as {License.UnitLabelPlural.ToLowerInvariant()} para vincular moradores." : "Envie convites aos responsáveis. As etapas avançam conforme os cadastros são concluídos.";
    private string NextStepAction => License.TotalBlocks == 0 ? "Criar estrutura" : License.TotalUnits == 0 ? "Adicionar unidades" : "Gerenciar moradores";

    private string Url(string section) => LicenseRoutes.Workspace(LicenseUrlKey, section);
}
