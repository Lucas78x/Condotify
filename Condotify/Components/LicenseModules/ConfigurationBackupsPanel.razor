@inject CondotifyApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="backup-management">
    <div class="admin-tab-head">
        <div>
            <strong>Histórico de configurações</strong>
            <span>Snapshots criptografados de equipamentos, rotas, credenciais e políticas. As 50 versões mais recentes são preservadas.</span>
        </div>
        @if (CanManage)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Backup" OnClick="CreateAsync">Novo snapshot</MudButton>
        }
    </div>

    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
    }
    else
    {
        <div class="admin-summary-strip backup-summary">
            <div><strong>@_items.Count</strong><span>versões disponíveis</span></div>
            <div><strong>@(_items.FirstOrDefault()?.Version ?? 0)</strong><span>versão mais recente</span></div>
            <div><strong>@LastRestoreLabel</strong><span>última restauração</span></div>
        </div>

        @if (_items.Count == 0)
        {
            <div class="profile-empty backup-empty">
                <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
                <strong>Nenhum snapshot criado</strong>
                <span>Crie uma versão antes de alterações importantes nos equipamentos ou nas rotas.</span>
            </div>
        }
        else
        {
            <div class="backup-version-list">
                @foreach (var item in _items)
                {
                    <article class="backup-version-row">
                        <span class="backup-version-badge">v@item.Version</span>
                        <div class="backup-version-main">
                            <div><strong>@item.Name</strong>@if (item.Version == _items.Max(x => x.Version)) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Atual</MudChip> }</div>
                            <span>@(string.IsNullOrWhiteSpace(item.Description) ? "Sem observação" : item.Description)</span>
                            <small>Criado por @item.CreatedBy em @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="backup-version-counts">
                            <span><MudIcon Icon="@Icons.Material.Outlined.Sensors" />@item.DeviceCount</span>
                            <span><MudIcon Icon="@Icons.Material.Outlined.AltRoute" />@item.RouteCount</span>
                            <span><MudIcon Icon="@Icons.Material.Outlined.Badge" />@item.CredentialCount</span>
                        </div>
                        <div class="backup-version-status">
                            @if (item.LastRestoredAt.HasValue)
                            {
                                <strong>Restaurado</strong>
                                <span>@item.LastRestoredAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            }
                            else
                            {
                                <strong>Preservado</strong>
                                <span>Nunca restaurado</span>
                            }
                        </div>
                        @if (CanManage)
                        {
                            <div class="backup-version-actions">
                                <MudTooltip Text="Simular e restaurar"><MudIconButton Icon="@Icons.Material.Outlined.SettingsBackupRestore" Color="Color.Primary" OnClick="@(() => RestoreAsync(item))" /></MudTooltip>
                                <MudTooltip Text="Excluir snapshot"><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(item))" /></MudTooltip>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private List<ConfigurationBackupViewModel> _items = [];
    private bool _loading = true;
    private string? _error;
    private string LastRestoreLabel => _items.Where(x => x.LastRestoredAt.HasValue)
        .OrderByDescending(x => x.LastRestoredAt)
        .Select(x => x.LastRestoredAt!.Value.ToLocalTime().ToString("dd/MM/yy"))
        .FirstOrDefault() ?? "Nunca";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetConfigurationBackupsAsync(LicenseId);
        _loading = false;
        if (!result.Success)
        {
            _error = result.Error ?? "Não foi possível carregar os snapshots.";
            return;
        }
        _items = (result.Value ?? []).OrderByDescending(x => x.Version).ToList();
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters { [nameof(ConfigurationBackupCreateDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<ConfigurationBackupCreateDialog>(
            "Novo snapshot",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled == false) await LoadAsync();
    }

    private async Task RestoreAsync(ConfigurationBackupViewModel item)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfigurationRestoreDialog.LicenseId)] = LicenseId,
            [nameof(ConfigurationRestoreDialog.Backup)] = item
        };
        var dialog = await DialogService.ShowAsync<ConfigurationRestoreDialog>(
            $"Restaurar versão {item.Version}",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large, BackdropClick = false });
        var result = await dialog.Result;
        if (result?.Canceled == false) await LoadAsync();
    }

    private async Task DeleteAsync(ConfigurationBackupViewModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir snapshot",
            $"Excluir definitivamente a versão {item.Version}? O conteúdo criptografado não poderá ser recuperado.",
            yesText: "Excluir",
            cancelText: "Cancelar");
        if (confirmed != true) return;
        var result = await Api.DeleteConfigurationBackupAsync(LicenseId, item.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "Não foi possível excluir o snapshot.", Severity.Error);
            return;
        }
        _items.Remove(item);
        Snackbar.Add("Snapshot excluído.", Severity.Success);
    }
}
