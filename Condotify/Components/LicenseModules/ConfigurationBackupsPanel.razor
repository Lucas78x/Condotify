@inject CondotifyApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="backup-management">
    <div class="admin-tab-head">
        <div>
            <strong>Histórico de configurações</strong>
            <span>Versões do condomínio e cópias externas.</span>
        </div>
        @if (CanManage)
        {
            <div class="backup-head-actions">
                <label class="file-button @(_importing ? "disabled" : null)">
                    <MudIcon Icon="@Icons.Material.Outlined.UploadFile" />
                    <span>@(_importing ? "Importando..." : "Importar")</span>
                    <InputFile OnChange="ImportAsync" accept=".cnbak,application/octet-stream" disabled="@_importing" />
                </label>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Backup" OnClick="CreateAsync">Novo snapshot</MudButton>
            </div>
        }
    </div>

    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
    }
    else
    {
        @if (_policy is not null)
        {
            <section class="backup-automation">
                <div class="backup-automation-status">
                    <span class="@(_policy.Enabled ? "active" : null)"><MudIcon Icon="@Icons.Material.Outlined.Schedule" /></span>
                    <div>
                        <strong>@(_policy.Enabled ? "Agendamento ativo" : "Agendamento inativo")</strong>
                        <small>@NextRunLabel</small>
                    </div>
                </div>
                <div class="backup-automation-fields">
                    <MudSelect T="int" @bind-Value="_policy.IntervalHours" Label="Frequência" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!CanManage)">
                        <MudSelectItem Value="6">A cada 6 horas</MudSelectItem>
                        <MudSelectItem Value="12">A cada 12 horas</MudSelectItem>
                        <MudSelectItem Value="24">Diariamente</MudSelectItem>
                        <MudSelectItem Value="72">A cada 3 dias</MudSelectItem>
                        <MudSelectItem Value="168">Semanalmente</MudSelectItem>
                    </MudSelect>
                    <MudNumericField T="int" @bind-Value="_policy.ExternalRetentionDays" Label="Retenção externa" Adornment="Adornment.End" AdornmentText="dias" Min="7" Max="3650" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!CanManage || !_policy.ExportEnabled)" />
                    <MudSwitch T="bool" @bind-Value="_policy.ExportEnabled" Label="Cópia externa" Color="Color.Primary" Disabled="@(!CanManage)" />
                    <MudSwitch T="bool" @bind-Value="_policy.Enabled" Label="Automático" Color="Color.Primary" Disabled="@(!CanManage)" />
                </div>
                <div class="backup-automation-actions">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(_policy.ExternalStorageReady ? Color.Success : Color.Error)" Icon="@(_policy.ExternalStorageReady ? Icons.Material.Outlined.CloudDone : Icons.Material.Outlined.CloudOff)">
                        @_policy.ExternalStorageLabel
                    </MudChip>
                    @if (CanManage)
                    {
                        <MudTooltip Text="Salvar política"><MudIconButton Icon="@Icons.Material.Outlined.Save" Color="Color.Primary" Disabled="@(_savingPolicy || _running)" OnClick="SavePolicyAsync" /></MudTooltip>
                        <MudTooltip Text="Executar agora"><MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Color="Color.Primary" Disabled="@(_savingPolicy || _running)" OnClick="RunNowAsync" /></MudTooltip>
                    }
                </div>
            </section>
            @if (!string.IsNullOrWhiteSpace(_policy.LastError))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">@_policy.LastError</MudAlert>
            }
        }

        <div class="admin-summary-strip backup-summary">
            <div><strong>@_items.Count</strong><span>versões disponíveis</span></div>
            <div><strong>@(_items.FirstOrDefault()?.Version ?? 0)</strong><span>versão mais recente</span></div>
            <div><strong>@LastRestoreLabel</strong><span>última restauração</span></div>
        </div>

        @if (_items.Count == 0)
        {
            <div class="profile-empty backup-empty">
                <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
                <strong>Nenhum snapshot criado</strong>
                <span>O histórico de configurações está vazio.</span>
            </div>
        }
        else
        {
            <div class="backup-version-list">
                @foreach (var item in _items)
                {
                    <article class="backup-version-row">
                        <span class="backup-version-badge">v@item.Version</span>
                        <div class="backup-version-main">
                            <div><strong>@item.Name</strong>@if (item.Version == _items.Max(x => x.Version)) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Atual</MudChip> }</div>
                            <span>@(string.IsNullOrWhiteSpace(item.Description) ? "Sem observação" : item.Description)</span>
                            <small>Criado por @item.CreatedBy em @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="backup-version-counts">
                            <span><MudIcon Icon="@Icons.Material.Outlined.Sensors" />@item.DeviceCount</span>
                            <span><MudIcon Icon="@Icons.Material.Outlined.AltRoute" />@item.RouteCount</span>
                            <span><MudIcon Icon="@Icons.Material.Outlined.Badge" />@item.CredentialCount</span>
                        </div>
                        <div class="backup-version-status">
                            @if (item.LastRestoredAt.HasValue)
                            {
                                <strong>Restaurado</strong>
                                <span>@item.LastRestoredAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            }
                            else
                            {
                                <strong>Preservado</strong>
                                <span>Nunca restaurado</span>
                            }
                        </div>
                        @if (CanManage)
                        {
                            <div class="backup-version-actions">
                                <MudTooltip Text="Baixar arquivo criptografado"><MudIconButton Icon="@Icons.Material.Outlined.Download" Disabled="@(_downloadingId == item.Id)" OnClick="@(() => DownloadAsync(item))" /></MudTooltip>
                                <MudTooltip Text="Simular e restaurar"><MudIconButton Icon="@Icons.Material.Outlined.SettingsBackupRestore" Color="Color.Primary" OnClick="@(() => RestoreAsync(item))" /></MudTooltip>
                                <MudTooltip Text="Excluir snapshot"><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(item))" /></MudTooltip>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private const long MaxArchiveSize = 15_000_000;
    private List<ConfigurationBackupViewModel> _items = [];
    private BackupAutomationPolicyViewModel? _policy;
    private bool _loading = true;
    private bool _savingPolicy;
    private bool _running;
    private bool _importing;
    private Guid? _downloadingId;
    private string? _error;
    private string LastRestoreLabel => _items.Where(x => x.LastRestoredAt.HasValue)
        .OrderByDescending(x => x.LastRestoredAt)
        .Select(x => x.LastRestoredAt!.Value.ToLocalTime().ToString("dd/MM/yy"))
        .FirstOrDefault() ?? "Nunca";
    private string NextRunLabel => _policy?.NextRunAt is { } next
        ? $"Próxima execução em {next.ToLocalTime():dd/MM/yyyy HH:mm}"
        : _policy?.LastSuccessAt is { } success
            ? $"Último sucesso em {success.ToLocalTime():dd/MM/yyyy HH:mm}"
            : "Sem execução registrada";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var backupsTask = Api.GetConfigurationBackupsAsync(LicenseId);
        var policyTask = Api.GetBackupAutomationAsync(LicenseId);
        await Task.WhenAll(backupsTask, policyTask);
        var backups = await backupsTask;
        var policy = await policyTask;
        _loading = false;
        if (!backups.Success || !policy.Success)
        {
            _error = backups.Error ?? policy.Error ?? "Não foi possível carregar os backups.";
            return;
        }
        _items = (backups.Value ?? []).OrderByDescending(x => x.Version).ToList();
        _policy = policy.Value;
    }

    private async Task SavePolicyAsync()
    {
        if (_policy is null || !CanManage) return;
        _savingPolicy = true;
        var result = await Api.UpdateBackupAutomationAsync(LicenseId, _policy);
        _savingPolicy = false;
        if (!result.Success || result.Value is null)
        {
            Snackbar.Add(result.Error ?? "Não foi possível salvar o agendamento.", Severity.Error);
            return;
        }
        _policy = result.Value;
        Snackbar.Add("Política de backup atualizada.", Severity.Success);
    }

    private async Task RunNowAsync()
    {
        if (!CanManage) return;
        _running = true;
        var result = await Api.RunBackupNowAsync(LicenseId);
        _running = false;
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "Não foi possível executar o backup.", Severity.Error);
            return;
        }
        Snackbar.Add(result.Value?.Message ?? "Backup concluído.", Severity.Success);
        await LoadAsync();
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        if (!CanManage) return;
        _importing = true;
        try
        {
            var file = args.File;
            if (file.Size > MaxArchiveSize)
            {
                Snackbar.Add("O arquivo excede o limite de 15 MB.", Severity.Error);
                return;
            }
            await using var stream = file.OpenReadStream(MaxArchiveSize);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var content = memory.ToArray();
            try
            {
                var result = await Api.ImportBackupArchiveAsync(
                    LicenseId,
                    file.Name,
                    Convert.ToBase64String(content));
                if (!result.Success)
                {
                    Snackbar.Add(result.Error ?? "Não foi possível importar o backup.", Severity.Error);
                    return;
                }
                Snackbar.Add($"Arquivo importado como versão {result.Value?.Version}.", Severity.Success);
                await LoadAsync();
            }
            finally
            {
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(content);
            }
        }
        catch (IOException)
        {
            Snackbar.Add("Não foi possível ler o arquivo selecionado.", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task DownloadAsync(ConfigurationBackupViewModel item)
    {
        _downloadingId = item.Id;
        var result = await Api.BuildBackupArchiveAsync(LicenseId, item.Id);
        _downloadingId = null;
        if (!result.Success || result.Value is null)
        {
            Snackbar.Add(result.Error ?? "Não foi possível gerar o arquivo.", Severity.Error);
            return;
        }
        await JS.InvokeVoidAsync(
            "portalInterop.downloadBase64",
            result.Value.FileName,
            result.Value.ContentBase64,
            "application/octet-stream");
        Snackbar.Add($"Arquivo gerado. SHA-256: {result.Value.Sha256[..12]}...", Severity.Success);
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters { [nameof(ConfigurationBackupCreateDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<ConfigurationBackupCreateDialog>(
            "Novo snapshot",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled == false) await LoadAsync();
    }

    private async Task RestoreAsync(ConfigurationBackupViewModel item)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfigurationRestoreDialog.LicenseId)] = LicenseId,
            [nameof(ConfigurationRestoreDialog.Backup)] = item
        };
        var dialog = await DialogService.ShowAsync<ConfigurationRestoreDialog>(
            $"Restaurar versão {item.Version}",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large, BackdropClick = false });
        var result = await dialog.Result;
        if (result?.Canceled == false) await LoadAsync();
    }

    private async Task DeleteAsync(ConfigurationBackupViewModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir snapshot",
            $"Excluir definitivamente a versão {item.Version}? O conteúdo criptografado não poderá ser recuperado.",
            yesText: "Excluir",
            cancelText: "Cancelar");
        if (confirmed != true) return;
        var result = await Api.DeleteConfigurationBackupAsync(LicenseId, item.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "Não foi possível excluir o snapshot.", Severity.Error);
            return;
        }
        _items.Remove(item);
        Snackbar.Add("Snapshot excluído.", Severity.Success);
    }
}
