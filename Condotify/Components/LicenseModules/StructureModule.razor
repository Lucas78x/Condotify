    private bool MatchesPerson(PersonSummaryViewModel person)
    {
        var categoryMatches = _peopleFilter switch { "visitors" => person.Category == "Guest", "providers" => person.Category == "ServiceProvider", "residents" => person.Category is not "Guest" and not "ServiceProvider", _ => true };
        if (!categoryMatches) return false;
        if (string.IsNullOrWhiteSpace(_personSearch)) return true;
        var term = _personSearch.Trim();
        return person.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || person.Document.Contains(term, StringComparison.OrdinalIgnoreCase) || person.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase) || person.Email.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string PrimaryContact(PersonSummaryViewModel person) => !string.IsNullOrWhiteSpace(person.PhoneNumber) ? person.PhoneNumber : !string.IsNullOrWhiteSpace(person.Email) ? person.Email : "Sem contato";
    private static string PersonKindLabel(PersonSummaryViewModel person) => person.Category switch
    {
        "Guest" => "Visitante",
        "ServiceProvider" => "Prestador de serviço",
        _ => RelationshipLabel(person.Relationship)
    };
    private static string RelationshipLabel(string relationship) => relationship switch { "OwnerResponsible" => "Proprietário responsável", "TenantResponsible" => "Locatário responsável", "Responsible" => "Responsável", "Dependent" => "Dependente", _ => "Morador" };
    private bool FaceActionDisabled(PersonSummaryViewModel person) => !CanManageCredentials || !HasPreparedFacePhoto(person);
    private string FaceActionTooltip(PersonSummaryViewModel person) => !CanManageCredentials
        ? "Sem permissão para gerenciar credenciais"
        : !HasPreparedFacePhoto(person)
            ? "Adicione uma foto para ativar a facial"
            : person.HasActiveFaceCredential ? "Gerenciar facial ativa" : "Ativar reconhecimento facial";
    private static bool HasPreparedFacePhoto(PersonSummaryViewModel person) =>
        person.ImageUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase) ||
        person.ImageUrl.StartsWith("/private-media/", StringComparison.OrdinalIgnoreCase);
}
