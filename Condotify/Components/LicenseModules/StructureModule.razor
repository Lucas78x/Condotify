@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
}
else
{
    <section class="structure-shell">
        <nav class="hierarchy-breadcrumb" aria-label="Localização na estrutura">
            <button type="button" class="breadcrumb-home @(_selectedBlockId is null ? "current" : null)" @onclick="GoToRoot">
                <MudIcon Icon="@Icons.Material.Outlined.AccountTree" />
                <span>Estrutura</span>
            </button>
            @if (SelectedBlock is not null)
            {
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                <button type="button" class="@(_selectedUnitId is null ? "current" : null)" @onclick="GoToBlock">@SelectedBlock.Name</button>
            }
            @if (_unit is not null)
            {
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                <span class="current">@_structure.UnitLabelSingular @_unit.Number</span>
            }
        </nav>

        @if (_selectedBlockId is null)
        {
            <div class="structure-level-head">
                <div>
                    <MudText Typo="Typo.h5">Estrutura da propriedade</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Organize @_structure.GroupLabelPlural.ToLowerInvariant() e entre em cada área para administrar @_structure.UnitLabelPlural.ToLowerInvariant().</MudText>
                </div>
                @if (CanViewPeople || CanManageStructure)
                {
                    <div class="structure-actions">
                        @if (CanViewPeople)
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Schedule" OnClick="OpenTemporaryAccessAsync">Temporários e convites</MudButton>
                        }
                        @if (CanManagePeople)
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.MoveDown" OnClick="OpenImportAsync">Migrar dados</MudButton>
                        }
                        @if (CanManageStructure || CanManagePeople || CanManageDevices)
                        {
                            <MudTooltip Text="Abrir lixeira"><MudIconButton Icon="@Icons.Material.Outlined.RestoreFromTrash" Variant="Variant.Outlined" OnClick="OpenRecycleBinAsync" /></MudTooltip>
                        }
                        <MudTooltip Text="Configurar nomenclatura"><MudIconButton Icon="@Icons.Material.Outlined.Tune" Variant="Variant.Outlined" OnClick="OpenSettingsAsync" /></MudTooltip>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddBusiness" OnClick="@(() => OpenCreateAsync("blocos"))">Cadastrar @_structure.GroupLabelSingular.ToLowerInvariant()</MudButton>
                    </div>
                }
            </div>

            <div class="structure-overview-strip">
                <div><span class="overview-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Apartment" /></span><span><strong>@Blocks.Count</strong><small>@_structure.GroupLabelPlural</small></span></div>
                <div><span class="overview-icon green"><MudIcon Icon="@Icons.Material.Outlined.DoorFront" /></span><span><strong>@Units.Count</strong><small>@_structure.UnitLabelPlural</small></span></div>
                <div><span class="overview-icon amber"><MudIcon Icon="@Icons.Material.Outlined.Groups" /></span><span><strong>@Residents.Count</strong><small>Pessoas vinculadas</small></span></div>
            </div>

            @if (Blocks.Count == 0)
            {
                <div class="structure-empty"><span><MudIcon Icon="@Icons.Material.Outlined.DomainAdd" /></span><MudText Typo="Typo.h6">Ainda não há @_structure.GroupLabelPlural.ToLowerInvariant()</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">A estrutura física ainda não foi configurada.</MudText>@if (CanManageStructure) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => OpenCreateAsync("blocos"))">Começar cadastro</MudButton> }</div>
            }
            else
            {
                <div class="hierarchy-grid group-card-grid">
                    @foreach (var block in Blocks)
                    {
                        <button type="button" class="hierarchy-card group-card" @onclick="@(() => SelectBlock(block.Id))">
                            <span class="hierarchy-card-icon"><MudIcon Icon="@Icons.Material.Outlined.Apartment" /></span>
                            <span class="hierarchy-card-main"><strong>@block.Name</strong><small>@_structure.GroupLabelSingular</small></span>
                            <span class="hierarchy-card-stats"><span><strong>@block.TotalUnits</strong>@_structure.UnitLabelPlural.ToLowerInvariant()</span><span><strong>@block.TotalResidents</strong>pessoas</span></span>
                            <span class="hierarchy-card-action"><span>Acessar</span><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></span>
                        </button>
                    }
                </div>
            }
        }
        else if (_selectedUnitId is null && SelectedBlock is not null)
        {
            <div class="structure-level-head">
                <div>
                    <MudText Typo="Typo.h5">@SelectedBlock.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Selecione uma @_structure.UnitLabelSingular.ToLowerInvariant() para acessar pessoas, veículos e credenciais.</MudText>
                </div>
                @if (CanManageStructure)
                {
                    <div class="structure-actions">
                        <MudTooltip Text="Editar agrupamento"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Outlined" OnClick="OpenEditBlockAsync" /></MudTooltip>
                        <MudTooltip Text="Excluir agrupamento"><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Variant="Variant.Outlined" OnClick="DeleteBlockAsync" /></MudTooltip>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddHomeWork" OnClick="@(() => OpenCreateAsync("unidades"))">Cadastrar @_structure.UnitLabelSingular.ToLowerInvariant()</MudButton>
                    </div>
                }
            </div>

            <div class="level-context-bar">
                <span class="context-icon"><MudIcon Icon="@Icons.Material.Outlined.Apartment" /></span>
                <div><strong>@SelectedBlock.TotalUnits @_structure.UnitLabelPlural.ToLowerInvariant()</strong><span>@SelectedBlock.TotalResidents pessoa(s) vinculada(s)</span></div>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack" OnClick="GoToRoot">Voltar para @_structure.GroupLabelPlural.ToLowerInvariant()</MudButton>
            </div>

            @if (SelectedBlock.Units.Count == 0)
            {
                <div class="structure-empty"><span><MudIcon Icon="@Icons.Material.Outlined.OtherHouses" /></span><MudText Typo="Typo.h6">Ainda não há @_structure.UnitLabelPlural.ToLowerInvariant()</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Cadastre o primeiro local desta área.</MudText>@if (CanManageStructure) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => OpenCreateAsync("unidades"))">Cadastrar @_structure.UnitLabelSingular.ToLowerInvariant()</MudButton> }</div>
            }
            else
            {
                <div class="hierarchy-grid unit-card-grid">
                    @foreach (var unit in SelectedBlock.Units.OrderBy(x => x.Number))
                    {
                        <button type="button" class="hierarchy-card unit-card" @onclick="@(() => SelectUnitAsync(unit.Id))">
                            <span class="unit-number-icon"><MudIcon Icon="@Icons.Material.Outlined.DoorFront" /></span>
                            <span class="hierarchy-card-main"><strong>@_structure.UnitLabelSingular @unit.Number</strong><small>@(string.IsNullOrWhiteSpace(unit.Floor) ? SelectedBlock.Name : $"{SelectedBlock.Name} | {unit.Floor}")</small></span>
                            <span class="unit-card-count"><MudIcon Icon="@Icons.Material.Outlined.Groups" /> @unit.TotalResidents</span>
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" />
                        </button>
                    }
                </div>
            }
        }
        else if (_loadingUnit)
        {
            <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
        }
        else if (_unit is not null)
        {
            <div class="unit-detail-head">
                <div class="unit-detail-identity">
                    <span class="unit-detail-icon"><MudIcon Icon="@Icons.Material.Outlined.DoorFront" /></span>
                    <div><MudText Typo="Typo.h5">@_structure.UnitLabelSingular @_unit.Number</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@_unit.BlockName@(string.IsNullOrWhiteSpace(_unit.Floor) ? string.Empty : $" | {_unit.Floor}")</MudText></div>
                </div>
                <div class="structure-actions">
                    @if (CanViewPeople)
                    {
                        <MudTooltip Text="Abrir temporários e convites"><MudIconButton Icon="@Icons.Material.Outlined.Schedule" Variant="Variant.Outlined" OnClick="OpenTemporaryAccessAsync" /></MudTooltip>
                    }
                    @if (CanManageStructure)
                    {
                        <MudTooltip Text="@($"Editar {_structure.UnitLabelSingular.ToLowerInvariant()}")"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Outlined" OnClick="OpenEditUnitAsync" /></MudTooltip>
                        <MudTooltip Text="@($"Excluir {_structure.UnitLabelSingular.ToLowerInvariant()}")"><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Variant="Variant.Outlined" OnClick="DeleteUnitAsync" /></MudTooltip>
                    }
                    @if (CanManagePeople)
                    {
                        <MudMenu Label="Nova pessoa" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd" EndIcon="@Icons.Material.Outlined.ExpandMore" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Home" OnClick="@(() => OpenCreateAsync("moradores", 1))">Morador</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.PersonPin" OnClick="@(() => OpenCreateAsync("moradores", 3))">Visitante</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Engineering" OnClick="@(() => OpenCreateAsync("moradores", 4))">Prestador de serviço</MudMenuItem>
                        </MudMenu>
                    }
                </div>
            </div>

            <div class="unit-detail-kpis">
                <div><span class="overview-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Groups" /></span><span><strong>@_unit.People.Count</strong><small>Pessoas</small></span></div>
                <div><span class="overview-icon green"><MudIcon Icon="@Icons.Material.Outlined.Badge" /></span><span><strong>@_unit.People.Sum(x => x.CredentialCount)</strong><small>Credenciais</small></span></div>
                <div><span class="overview-icon amber"><MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" /></span><span><strong>@_unit.Vehicles.Count</strong><small>Veículos</small></span></div>
            </div>

            <MudPaper Class="unit-detail-panel" Elevation="0">
                <MudTabs Elevation="0" Class="unit-tabs">
                    <MudTabPanel Text="Pessoas" Icon="@Icons.Material.Outlined.Groups">
                        <div class="unit-toolbar">
                            <MudTextField T="string" @bind-Value="_personSearch" Placeholder="Buscar nome, documento ou contato" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Immediate Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudSelect T="string" @bind-Value="_peopleFilter" Label="Exibicao" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value='@("all")'>Todas as pessoas</MudSelectItem><MudSelectItem Value='@("residents")'>Moradores</MudSelectItem><MudSelectItem Value='@("visitors")'>Visitantes</MudSelectItem><MudSelectItem Value='@("providers")'>Prestadores</MudSelectItem></MudSelect>
                        </div>
                        @if (FilteredPeople.Count == 0)
                        {
                            <div class="profile-empty"><MudIcon Icon="@Icons.Material.Outlined.PersonSearch" /><span>Nenhuma pessoa encontrada nesta @_structure.UnitLabelSingular.ToLowerInvariant().</span></div>
                        }
                        else
                        {
                            <div class="people-list">
                                @foreach (var person in FilteredPeople)
                                {
                                    <div class="person-row" role="button" tabindex="0" @onclick="@(() => OpenProfileAsync(person.Id))" @onkeydown="@(args => HandlePersonRowKeyDownAsync(args, person.Id))">
                                        @if (!string.IsNullOrWhiteSpace(person.ImageUrl)) { <span class="person-list-photo"><img src="@person.ImageUrl" alt="Foto de @person.Name" /></span> } else { <MudAvatar Color="Color.Primary" Size="Size.Medium">@Initials(person.Name)</MudAvatar> }
                                        <span class="person-row-main"><strong>@person.Name</strong><small>@PersonKindLabel(person)@(!string.IsNullOrWhiteSpace(person.Description) ? $" | {person.Description}" : string.Empty)</small></span>
                                        <span class="person-row-contact">@PrimaryContact(person)</span>
                                        <span class="person-row-assets"><MudIcon Icon="@Icons.Material.Outlined.Badge" /> @person.CredentialCount <MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" /> @person.VehicleCount</span>
                                        <MudChip T="string" Size="Size.Small" Color="@(person.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">@(person.IsActive ? "Ativo" : "Inativo")</MudChip>
                                        <span class="person-row-actions">
                                            <MudTooltip Text="@FaceActionTooltip(person)">
                                                <span class="person-face-action" @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.FaceRetouchingNatural"
                                                                   Size="Size.Small"
                                                                   Color="@(person.HasActiveFaceCredential ? Color.Success : Color.Primary)"
                                                                   Disabled="@FaceActionDisabled(person)"
                                                                   aria-label="@FaceActionTooltip(person)"
                                                                   OnClick="@(() => OpenProfileAsync(person.Id, 1))" />
                                                </span>
                                            </MudTooltip>
                                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="Veículos" Icon="@Icons.Material.Outlined.DirectionsCar">
                        @if (_unit.Vehicles.Count == 0) { <div class="profile-empty"><MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" /><span>Nenhum veículo cadastrado nesta @_structure.UnitLabelSingular.ToLowerInvariant(). Abra uma pessoa para vincular o primeiro.</span></div> }
                        else { <div class="profile-list">@foreach (var vehicle in _unit.Vehicles) { <div class="profile-list-row"><div class="profile-row-icon"><MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" /></div><div class="profile-row-main"><strong>@vehicle.Plate</strong><span>@vehicle.Brand @vehicle.Model | @vehicle.OwnerName</span></div><div class="profile-row-meta">@(!string.IsNullOrWhiteSpace(vehicle.TagIdentifier) ? $"Tag {vehicle.TagIdentifier}" : "Sem tag")</div><MudChip T="string" Size="Size.Small" Color="@(vehicle.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">@(vehicle.IsActive ? "Ativo" : "Inativo")</MudChip></div> }</div> }
                    </MudTabPanel>
                    <MudTabPanel Text="Credenciais" Icon="@Icons.Material.Outlined.Badge">
                        @if (_unit.People.All(x => x.CredentialCount == 0)) { <div class="profile-empty"><MudIcon Icon="@Icons.Material.Outlined.Badge" /><span>Nenhuma credencial vinculada nesta @_structure.UnitLabelSingular.ToLowerInvariant().</span></div> }
                        else { <div class="people-list">@foreach (var person in _unit.People.Where(x => x.CredentialCount > 0)) { <button type="button" class="person-row compact-person-row" @onclick="@(() => OpenProfileAsync(person.Id))">@if (!string.IsNullOrWhiteSpace(person.ImageUrl)) { <span class="person-list-photo"><img src="@person.ImageUrl" alt="Foto de @person.Name" /></span> } else { <MudAvatar Color="Color.Primary" Size="Size.Medium">@Initials(person.Name)</MudAvatar> }<span class="person-row-main"><strong>@person.Name</strong><small>@person.CredentialCount credencial(is)</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></button> }</div> }
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public string ActiveSection { get; set; } = "estrutura";
    [Parameter] public bool CanViewPeople { get; set; }
    [Parameter] public bool CanManageStructure { get; set; }
    [Parameter] public bool CanManagePeople { get; set; }
    [Parameter] public bool CanManageCredentials { get; set; }
    [Parameter] public bool CanManageDevices { get; set; }
    private LicenseStructureViewModel _structure = new();
    private UnitDetailViewModel? _unit;
    private Guid? _selectedBlockId;
    private Guid? _selectedUnitId;
    private Guid _loadedLicenseId;
    private bool _loading = true;
    private bool _loadingUnit;
    private string? _error;
    private string _personSearch = string.Empty;
    private string _peopleFilter = "all";
    private List<BlockRowViewModel> Blocks => _structure.Blocks;
    private List<UnitRowViewModel> Units => Blocks.SelectMany(x => x.Units).ToList();
    private List<ResidentRowViewModel> Residents => Units.SelectMany(x => x.Residents).ToList();
    private BlockRowViewModel? SelectedBlock => Blocks.FirstOrDefault(x => x.Id == _selectedBlockId);
    private List<PersonSummaryViewModel> FilteredPeople => (_unit?.People ?? []).Where(MatchesPerson).OrderBy(x => x.Name).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedLicenseId == LicenseId) return;
        _loadedLicenseId = LicenseId;
        await LoadAsync();
    }

    private async Task LoadAsync(Guid? preferredBlock = null, Guid? preferredUnit = null)
    {
        _loading = true; _error = null;
        var result = await Api.GetStructureAsync(LicenseId);
        _loading = false;
        if (!result.Success || result.Value is null) { _error = result.Error; return; }
        _structure = result.Value;
        _selectedBlockId = preferredBlock is { } blockId && Blocks.Any(x => x.Id == blockId) ? blockId : null;
        _selectedUnitId = preferredUnit is { } unitId && SelectedBlock?.Units.Any(x => x.Id == unitId) == true ? unitId : null;
        if (_selectedUnitId is not null) await LoadUnitAsync(); else _unit = null;
    }

    private void SelectBlock(Guid blockId) { _selectedBlockId = blockId; _selectedUnitId = null; _unit = null; }
    private async Task SelectUnitAsync(Guid unitId) { _selectedUnitId = unitId; _personSearch = string.Empty; await LoadUnitAsync(); }
    private void GoToRoot() { _selectedBlockId = null; _selectedUnitId = null; _unit = null; _personSearch = string.Empty; }
    private void GoToBlock() { _selectedUnitId = null; _unit = null; _personSearch = string.Empty; }

    private async Task LoadUnitAsync()
    {
        _unit = null;
        if (_selectedUnitId is not { } unitId) return;
        _loadingUnit = true;
        var result = await Api.GetUnitDetailsAsync(LicenseId, unitId);
        _loadingUnit = false;
        if (result.Success) _unit = result.Value; else _error = result.Error;
    }

    private async Task OpenCreateAsync(string section, int initialAccessType = 1)
    {
        var parameters = new DialogParameters
        {
            [nameof(StructureFormDialog.LicenseId)] = LicenseId, [nameof(StructureFormDialog.ActiveSection)] = section,
            [nameof(StructureFormDialog.Blocks)] = Blocks, [nameof(StructureFormDialog.InitialBlockId)] = _selectedBlockId,
            [nameof(StructureFormDialog.InitialUnitId)] = _selectedUnitId, [nameof(StructureFormDialog.GroupLabelSingular)] = _structure.GroupLabelSingular,
            [nameof(StructureFormDialog.UnitLabelSingular)] = _structure.UnitLabelSingular,
            [nameof(StructureFormDialog.InitialAccessType)] = initialAccessType
        };
        var title = section switch { "unidades" => $"Cadastrar {_structure.UnitLabelSingular.ToLowerInvariant()}", "moradores" => "Nova pessoa", _ => $"Cadastrar {_structure.GroupLabelSingular.ToLowerInvariant()}" };
        var dialog = await DialogService.ShowAsync<StructureFormDialog>(title, parameters, new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = section == "moradores" ? MaxWidth.Medium : MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        Snackbar.Add("Cadastro concluído com sucesso.", Severity.Success);
        await LoadAsync(_selectedBlockId, _selectedUnitId);
    }

    private async Task OpenEditBlockAsync()
    {
        if (SelectedBlock is null) return;
        var parameters = StructureDialogParameters("blocos");
        parameters[nameof(StructureFormDialog.ExistingBlock)] = SelectedBlock;
        var dialog = await DialogService.ShowAsync<StructureFormDialog>(
            $"Editar {_structure.GroupLabelSingular.ToLowerInvariant()}",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        Snackbar.Add("Agrupamento atualizado.", Severity.Success);
        await LoadAsync(_selectedBlockId);
    }

    private async Task DeleteBlockAsync()
    {
        if (SelectedBlock is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Mover para a lixeira",
            $"Mover {SelectedBlock.Name} para a lixeira? O item poderá ser restaurado por 30 dias e não pode possuir {_structure.UnitLabelPlural.ToLowerInvariant()} vinculadas.",
            yesText: "Mover para a lixeira",
            cancelText: "Cancelar");
        if (confirmed != true) return;
        var result = await Api.DeleteBlockAsync(LicenseId, SelectedBlock.Id);
        if (!result.Success) { _error = result.Error; Snackbar.Add(result.Error ?? "Não foi possível excluir.", Severity.Error); return; }
        Snackbar.Add("Agrupamento movido para a lixeira.", Severity.Success);
        await LoadAsync();
    }

    private async Task OpenEditUnitAsync()
    {
        var current = SelectedBlock?.Units.FirstOrDefault(x => x.Id == _selectedUnitId);
        if (current is null) return;
        var parameters = StructureDialogParameters("unidades");
        parameters[nameof(StructureFormDialog.ExistingUnit)] = current;
        var dialog = await DialogService.ShowAsync<StructureFormDialog>(
            $"Editar {_structure.UnitLabelSingular.ToLowerInvariant()}",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        Snackbar.Add($"Cadastro de {_structure.UnitLabelSingular.ToLowerInvariant()} atualizado.", Severity.Success);
        await LoadAsync(current.BlockId, current.Id);
    }

    private async Task DeleteUnitAsync()
    {
        if (_unit is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Mover para a lixeira",
            $"Mover {_structure.UnitLabelSingular.ToLowerInvariant()} {_unit.Number} para a lixeira? Pessoas e veículos impedem a operação para preservar os vínculos.",
            yesText: "Mover para a lixeira",
            cancelText: "Cancelar");
        if (confirmed != true) return;
        var blockId = _unit.BlockId;
        var result = await Api.DeleteUnitAsync(LicenseId, _unit.Id);
        if (!result.Success) { _error = result.Error; Snackbar.Add(result.Error ?? "Não foi possível excluir.", Severity.Error); return; }
        Snackbar.Add($"Cadastro de {_structure.UnitLabelSingular.ToLowerInvariant()} movido para a lixeira.", Severity.Success);
        await LoadAsync(blockId);
    }

    private DialogParameters StructureDialogParameters(string section) => new()
    {
        [nameof(StructureFormDialog.LicenseId)] = LicenseId,
        [nameof(StructureFormDialog.ActiveSection)] = section,
        [nameof(StructureFormDialog.Blocks)] = Blocks,
        [nameof(StructureFormDialog.InitialBlockId)] = _selectedBlockId,
        [nameof(StructureFormDialog.InitialUnitId)] = _selectedUnitId,
        [nameof(StructureFormDialog.GroupLabelSingular)] = _structure.GroupLabelSingular,
        [nameof(StructureFormDialog.UnitLabelSingular)] = _structure.UnitLabelSingular
    };

    private async Task OpenSettingsAsync()
    {
        var model = new StructureSettingsViewModel { GroupLabelSingular = _structure.GroupLabelSingular, GroupLabelPlural = _structure.GroupLabelPlural, UnitLabelSingular = _structure.UnitLabelSingular, UnitLabelPlural = _structure.UnitLabelPlural };
        var parameters = new DialogParameters { [nameof(StructureSettingsDialog.LicenseId)] = LicenseId, [nameof(StructureSettingsDialog.Model)] = model };
        var dialog = await DialogService.ShowAsync<StructureSettingsDialog>("Configurar estrutura", parameters, new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        Snackbar.Add("Nomenclatura atualizada.", Severity.Success); await LoadAsync();
    }

    private async Task OpenImportAsync()
    {
        var parameters = new DialogParameters { [nameof(StructureImportDialog.LicenseId)] = LicenseId };
        parameters[nameof(StructureImportDialog.GroupLabelSingular)] = _structure.GroupLabelSingular;
        parameters[nameof(StructureImportDialog.GroupLabelPlural)] = _structure.GroupLabelPlural;
        parameters[nameof(StructureImportDialog.UnitLabelSingular)] = _structure.UnitLabelSingular;
        parameters[nameof(StructureImportDialog.UnitLabelPlural)] = _structure.UnitLabelPlural;
        var dialog = await DialogService.ShowAsync<StructureImportDialog>(
            "Centro de migração",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.ExtraLarge });
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not StructureImportExecutionViewModel execution) return;
        Snackbar.Add(
            $"{execution.CreatedPeople} pessoa(s) e {execution.CreatedVehicles} veículo(s) importados.",
            Severity.Success);
        await LoadAsync();
    }

