@using System.Text.Json
@using System.Globalization
@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<section class="module-intro">
    <div>
        <MudText Typo="Typo.h2">Controle de acesso</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Monitore os terminais e execute acionamentos remotos com rastreabilidade.</MudText>
    </div>
    @if (CanManage) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreateDialogAsync">Novo equipamento</MudButton> }
</section>

<div class="module-kpis">
    <div class="mini-kpi"><span class="mini-kpi-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Sensors" /></span><div><strong>@_devices.Count</strong><span>Equipamentos</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon green"><MudIcon Icon="@Icons.Material.Outlined.Wifi" /></span><div><strong>@_devices.Count(x => x.IsActive)</strong><span>Online</span></div></div>
    <div class="mini-kpi"><span class="mini-kpi-icon amber"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /></span><div><strong>@_devices.Count(x => !x.IsActive)</strong><span>Requerem teste</span></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" CloseIcon="@Icons.Material.Outlined.Close" OnClick="ClearError" Class="mb-4">@_error</MudAlert>
}

<MudPaper Class="content-panel" Elevation="0">
    <div class="panel-toolbar device-toolbar">
        <div><MudText Typo="Typo.h5" Class="panel-title">Equipamentos instalados</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Acione, teste e acompanhe cada ponto de acesso</MudText></div>
        <div class="toolbar-filters">
            <MudTextField T="string" @bind-Value="_search" Immediate Placeholder="Buscar equipamento" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
            <MudSelect T="string" @bind-Value="_status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px">
                <MudSelectItem Value="@("todos")">Todos</MudSelectItem>
                <MudSelectItem Value="@("online")">Online</MudSelectItem>
                <MudSelectItem Value="@("offline")">Offline</MudSelectItem>
            </MudSelect>
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" Color="Color.Primary" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (!FilteredDevices.Any())
    {
        <div class="empty-state compact-empty">
            <MudIcon Icon="@Icons.Material.Outlined.SensorsOff" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">Nenhum equipamento encontrado</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Cadastre um terminal ou ajuste os filtros.</MudText>
        </div>
    }
    else
    {
        <div class="device-grid">
            @foreach (var device in FilteredDevices)
            {
                <article class="device-card">
                    <div class="device-card-head">
                        <span class="device-type-icon"><MudIcon Icon="@DeviceIcon(device.Type)" /></span>
                        <div class="device-identity">
                            <MudText Typo="Typo.subtitle1">@device.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@device.Model</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="@(device.IsActive ? Color.Success : Color.Warning)" Variant="Variant.Outlined" Icon="@(device.IsActive ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.ErrorOutline)">
                            @(device.IsActive ? "Online" : "Não testado")
                        </MudChip>
                    </div>

                    <div class="device-network">
                        <span><MudIcon Icon="@Icons.Material.Outlined.Lan" Size="Size.Small" /> @device.IPAddress:@device.Port</span>
                        @if (!string.IsNullOrWhiteSpace(device.MACAddress))
                        {
                            <span><MudIcon Icon="@Icons.Material.Outlined.Fingerprint" Size="Size.Small" /> @device.MACAddress</span>
                        }
                        @if (device.LastResponseTimeMs.HasValue)
                        {
                            <span><MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" /> @device.LastResponseTimeMs ms</span>
                        }
                    </div>

                    <div class="device-health-line">
                        <span>@(string.IsNullOrWhiteSpace(device.HealthMessage) ? "Diagnóstico ainda não executado" : device.HealthMessage)</span>
                        @if (!string.IsNullOrWhiteSpace(device.FirmwareVersion)) { <small>@ShortFirmware(device.FirmwareVersion)</small> }
                    </div>

                    <div class="device-card-actions">
                        <MudTooltip Text="Abrir detalhes do equipamento"><MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Color="Color.Primary" OnClick="@(() => OpenDetailsAsync(device))" /></MudTooltip>
                        @if (device.IsActive && CanOperate)
                        {
                            <MudMenu Label="Abrir porta" StartIcon="@Icons.Material.Outlined.SensorDoor" Variant="Variant.Filled" Color="Color.Success" Disabled="@(_operatingDeviceId == device.Id)">
                                @foreach (var portal in DevicePortals(device))
                                {
                                    <MudMenuItem OnClick="@(() => OpenDoorAsync(device, portal.Number))" Icon="@Icons.Material.Outlined.MeetingRoom">@portal.Name</MudMenuItem>
                                }
                            </MudMenu>
                            @if (CanManage) { <MudTooltip Text="Atualizar diagnóstico e portas"><MudIconButton Icon="@Icons.Material.Outlined.MonitorHeart" Color="Color.Primary" OnClick="@(() => InspectDeviceAsync(device))" Disabled="@(_operatingDeviceId == device.Id)" /></MudTooltip> }
                        }
                        @if (CanManage && !device.IsActive)
                        {
                            <MudTooltip Text="Executar diagnóstico detalhado"><MudIconButton Icon="@Icons.Material.Outlined.MonitorHeart" Color="Color.Primary" OnClick="@(() => InspectDeviceAsync(device))" Disabled="@(_operatingDeviceId == device.Id)" /></MudTooltip>
                        }
                        else if (!device.IsActive && CanManage)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.WifiTethering" OnClick="@(() => TestConnectionAsync(device))" Disabled="@(_operatingDeviceId == device.Id)">
                                @(_operatingDeviceId == device.Id ? "Testando..." : "Testar conexão")
                            </MudButton>
                        }
                    </div>
                </article>
            }
        </div>
    }
</MudPaper>

<MudPaper Class="content-panel action-history" Elevation="0">
    <div class="panel-toolbar">
        <div><MudText Typo="Typo.h5" Class="panel-title">Atividade recente</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Testes e acionamentos registrados pela operação</MudText></div>
    </div>
    @if (_actions.Count == 0)
    {
        <div class="panel-body"><MudText Typo="Typo.body2" Color="Color.Secondary">Ainda não há acionamentos registrados.</MudText></div>
    }
    else
    {
        <MudTable Items="_actions" Hover Dense Elevation="0">
            <HeaderContent><MudTh>Horário</MudTh><MudTh>Equipamento</MudTh><MudTh>Operação</MudTh><MudTh>Detalhes</MudTh><MudTh>Usuário</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Horário">@context.Timestamp.ToCondotifyTime().ToString("dd/MM HH:mm")</MudTd>
                <MudTd DataLabel="Equipamento">@context.DeviceName</MudTd>
                <MudTd DataLabel="Operação"><MudChip T="string" Size="Size.Small" Color="@ActionColor(context.Action)" Variant="Variant.Outlined">@ActionLabel(context.Action)</MudChip></MudTd>
                <MudTd DataLabel="Detalhes">@context.Details</MudTd>
                <MudTd DataLabel="Usuário">@context.UserName</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public bool CanOperate { get; set; }

    private List<AccessDeviceRowViewModel> _devices = [];
    private List<DeviceActionRowViewModel> _actions = [];
    private string _search = string.Empty;
    private string _status = "todos";
    private string? _error;
    private Guid? _operatingDeviceId;
    private bool _loading = true;
    private IEnumerable<AccessDeviceRowViewModel> FilteredDevices => _devices
        .Where(x => string.IsNullOrWhiteSpace(_search) || $"{x.Name} {x.Model} {x.IPAddress}".Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(x => _status == "todos" || (_status == "online" && x.IsActive) || (_status == "offline" && !x.IsActive));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var devicesTask = Api.GetDevicesAsync(LicenseId);
        var actionsTask = Api.GetDeviceActionsAsync(LicenseId);
        await Task.WhenAll(devicesTask, actionsTask);
        _loading = false;

        if (devicesTask.Result.Success) _devices = devicesTask.Result.Value ?? [];
        else _error = devicesTask.Result.Error;

        if (actionsTask.Result.Success) _actions = actionsTask.Result.Value ?? [];
    }

    private void ClearError() => _error = null;

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters { [nameof(DeviceFormDialog.LicenseId)] = LicenseId };
        var dialog = await DialogService.ShowAsync<DeviceFormDialog>("Novo equipamento", parameters, new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var creation = result.Data as AccessDeviceCreationViewModel;
        var severity = creation is { ConnectionTested: true, ConnectionSucceeded: false }
            ? Severity.Warning
            : Severity.Success;
        Snackbar.Add(creation?.Message ?? "Equipamento cadastrado com sucesso.", severity);
        await LoadAsync();
    }

    private async Task OpenDetailsAsync(AccessDeviceRowViewModel device)
    {
        var parameters = new DialogParameters
        {
            [nameof(DeviceDetailDialog.LicenseId)] = LicenseId,
            [nameof(DeviceDetailDialog.Device)] = device,
            [nameof(DeviceDetailDialog.CanManage)] = CanManage
        };
        var dialog = await DialogService.ShowAsync<DeviceDetailDialog>(device.Name, parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.ExtraLarge });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task TestConnectionAsync(AccessDeviceRowViewModel device)
    {
        _operatingDeviceId = device.Id;
        _error = null;
        var result = await Api.TestDeviceConnectionAsync(LicenseId, device.Id);
        _operatingDeviceId = null;
        if (!result.Success) { _error = result.Error; return; }

        Snackbar.Add($"{device.Name} conectado e ativado.", Severity.Success);
        await LoadAsync();
    }

    private async Task InspectDeviceAsync(AccessDeviceRowViewModel device)
    {
        _operatingDeviceId = device.Id;
        _error = null;
        var result = await Api.InspectDeviceAsync(LicenseId, device.Id);
        _operatingDeviceId = null;
        if (!result.Success || result.Value is null)
        {
            _error = result.Error ?? "Não foi possível concluir o diagnóstico.";
            return;
        }
        Snackbar.Add(result.Value.Message, result.Value.Online ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }

    private async Task OpenDoorAsync(AccessDeviceRowViewModel device, int channel)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirmar acionamento",
            $"Abrir a porta {channel} pelo equipamento {device.Name}? Esta operação ficará registrada no histórico.",
            yesText: "Abrir porta",
            cancelText: "Cancelar");
        if (confirmed != true) return;

        _operatingDeviceId = device.Id;
        _error = null;
        var result = await Api.OpenDoorAsync(LicenseId, device.Id, channel, "Acionamento manual pelo portal");
        _operatingDeviceId = null;
        if (!result.Success) { _error = result.Error; await LoadAsync(); return; }

        Snackbar.Add($"Porta {channel} acionada em {device.Name}.", Severity.Success);
        await LoadAsync();
    }

    private static string DeviceIcon(string type) => type.Contains("UHF", StringComparison.OrdinalIgnoreCase)
        ? Icons.Material.Outlined.Contactless
        : type.Contains("Face", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Outlined.Face
            : Icons.Material.Outlined.SensorDoor;

    private static List<DevicePortalCapabilityViewModel> DevicePortals(
     AccessDeviceRowViewModel device)
    {
        var fallback = new List<DevicePortalCapabilityViewModel>
    {
        new()
        {
            Number = 1,
            Name = "Porta 1",
            Direction = string.Empty,
            Discovered = false
        }
    };

        if (string.IsNullOrWhiteSpace(device.DiscoveredPortalsJson))
            return fallback;

        try
        {
            using var document = JsonDocument.Parse(device.DiscoveredPortalsJson);

            var root = document.RootElement;

            // Algumas integrações podem salvar diretamente um array.
            if (root.ValueKind == JsonValueKind.Array)
                return ParseDevicePortalsArray(root, fallback);

            /*
             * Também suporta formatos envelopados, por exemplo:
             *
             * {
             *   "items": [...]
             * }
             *
             * {
             *   "portals": [...]
             * }
             *
             * {
             *   "data": [...]
             * }
             */
            if (root.ValueKind == JsonValueKind.Object)
            {
                var possibleArrayNames = new[]
                {
                "items",
                "portals",
                "doors",
                "channels",
                "data",
                "result"
            };

                foreach (var propertyName in possibleArrayNames)
                {
                    if (TryGetPropertyIgnoreCase(root, propertyName, out var arrayElement) &&
                        arrayElement.ValueKind == JsonValueKind.Array)
                    {
                        return ParseDevicePortalsArray(arrayElement, fallback);
                    }
                }

                /*
                 * Caso o JSON contenha apenas uma porta como objeto:
                 *
                 * {
                 *   "number": 1,
                 *   "name": "Porta 1"
                 * }
                 */
                var singlePortal = ParseDevicePortal(root, 1);

                if (singlePortal is not null)
                    return [singlePortal];
            }
        }
        catch (JsonException)
        {
            // JSON inválido: utiliza o fallback sem quebrar a tela.
        }
        catch (InvalidOperationException)
        {
            // Tipo inesperado dentro do JsonElement.
        }
        catch (NotSupportedException)
        {
            // Formato não suportado pelo System.Text.Json.
        }

        return fallback;
    }

    private static List<DevicePortalCapabilityViewModel> ParseDevicePortalsArray(
        JsonElement arrayElement,
        List<DevicePortalCapabilityViewModel> fallback)
    {
        var portals = new List<DevicePortalCapabilityViewModel>();
        var position = 1;

        foreach (var item in arrayElement.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
            {
                position++;
                continue;
            }

            var portal = ParseDevicePortal(item, position);

            if (portal is not null)
                portals.Add(portal);

            position++;
        }

        return portals.Count > 0
            ? portals
                .GroupBy(x => x.Number)
                .Select(x => x.First())
                .OrderBy(x => x.Number)
                .ToList()
            : fallback;
    }

    private static DevicePortalCapabilityViewModel? ParseDevicePortal(
        JsonElement item,
        int fallbackNumber)
    {
        if (item.ValueKind != JsonValueKind.Object)
            return null;

        /*
         * Suporta nomes utilizados por diferentes fabricantes:
         *
         * Number:
         * number, doorNo, doorNumber, channel, channelNo, id, index
         *
         * Name:
         * name, doorName, channelName, description
         *
         * Direction:
         * direction, doorDirection, accessDirection
         *
         * Discovered:
         * discovered, enabled, active, available
         */

        var number =
            GetFlexibleInt32(item, "number") ??
            GetFlexibleInt32(item, "doorNo") ??
            GetFlexibleInt32(item, "doorNumber") ??
            GetFlexibleInt32(item, "channel") ??
            GetFlexibleInt32(item, "channelNo") ??
            GetFlexibleInt32(item, "index") ??
            GetFlexibleInt32(item, "id") ??
            fallbackNumber;

        if (number <= 0)
            number = fallbackNumber;

        var name =
            GetFlexibleString(item, "name") ??
            GetFlexibleString(item, "doorName") ??
            GetFlexibleString(item, "channelName") ??
            GetFlexibleString(item, "description");

        if (string.IsNullOrWhiteSpace(name))
            name = $"Porta {number}";

        var direction =
            GetFlexibleString(item, "direction") ??
            GetFlexibleString(item, "doorDirection") ??
            GetFlexibleString(item, "accessDirection") ??
            string.Empty;

        var discovered =
            GetFlexibleBoolean(item, "discovered") ??
            GetFlexibleBoolean(item, "enabled") ??
            GetFlexibleBoolean(item, "active") ??
            GetFlexibleBoolean(item, "available") ??
            true;

        return new DevicePortalCapabilityViewModel
        {
            Number = number,
            Name = name.Trim(),
            Direction = NormalizeDirection(direction),
            Discovered = discovered
        };
    }

    private static int? GetFlexibleInt32(JsonElement item, string propertyName)
    {
        if (!TryGetPropertyIgnoreCase(item, propertyName, out var value))
            return null;

        return value.ValueKind switch
        {
            JsonValueKind.Number when value.TryGetInt32(out var result) =>
                result,

            JsonValueKind.Number when value.TryGetInt64(out var longResult) &&
                                      longResult is >= int.MinValue and <= int.MaxValue =>
                (int)longResult,

            JsonValueKind.String when int.TryParse(
                value.GetString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out var stringResult) =>
                stringResult,

            JsonValueKind.True => 1,
            JsonValueKind.False => 0,

            _ => null
        };
    }

    private static string? GetFlexibleString(
        JsonElement item,
        string propertyName)
    {
        if (!TryGetPropertyIgnoreCase(item, propertyName, out var value))
            return null;

        return JsonElementToString(value);
    }

    private static string? JsonElementToString(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String =>
                value.GetString(),

            JsonValueKind.Number =>
                value.GetRawText(),

            JsonValueKind.True =>
                "true",

            JsonValueKind.False =>
                "false",

            JsonValueKind.Null =>
                null,

            JsonValueKind.Undefined =>
                null,

            /*
             * Evita chamar GetString() em objetos ou arrays, que é justamente
             * uma das causas do InvalidOperationException.
             */
            JsonValueKind.Object =>
                TryReadObjectValue(value),

            JsonValueKind.Array =>
                TryReadArrayValue(value),

            _ =>
                null
        };
    }

    private static string? TryReadObjectValue(JsonElement value)
    {
        /*
         * Alguns dispositivos retornam algo como:
         *
         * "direction": {
         *   "value": "in"
         * }
         *
         * ou:
         *
         * "direction": {
         *   "name": "Entrada"
         * }
         */

        var possibleProperties = new[]
        {
        "value",
        "name",
        "description",
        "type",
        "code"
    };

        foreach (var propertyName in possibleProperties)
        {
            if (!TryGetPropertyIgnoreCase(value, propertyName, out var nestedValue))
                continue;

            var result = JsonElementToString(nestedValue);

            if (!string.IsNullOrWhiteSpace(result))
                return result;
        }

        return null;
    }

    private static string? TryReadArrayValue(JsonElement value)
    {
        foreach (var arrayItem in value.EnumerateArray())
        {
            var result = JsonElementToString(arrayItem);

            if (!string.IsNullOrWhiteSpace(result))
                return result;
        }

        return null;
    }

    private static bool? GetFlexibleBoolean(
        JsonElement item,
        string propertyName)
    {
        if (!TryGetPropertyIgnoreCase(item, propertyName, out var value))
            return null;

        switch (value.ValueKind)
        {
            case JsonValueKind.True:
                return true;

            case JsonValueKind.False:
                return false;

            case JsonValueKind.Number:
                if (value.TryGetInt64(out var number))
                    return number != 0;

                return null;

            case JsonValueKind.String:
                {
                    var text = value.GetString()?.Trim();

                    if (string.IsNullOrWhiteSpace(text))
                        return null;

                    if (bool.TryParse(text, out var booleanResult))
                        return booleanResult;

                    if (long.TryParse(
                            text,
                            NumberStyles.Integer,
                            CultureInfo.InvariantCulture,
                            out var numericResult))
                    {
                        return numericResult != 0;
                    }

                    return text.ToLowerInvariant() switch
                    {
                        "yes" => true,
                        "no" => false,
                        "sim" => true,
                        "não" => false,
                        "nao" => false,
                        "enabled" => true,
                        "disabled" => false,
                        "active" => true,
                        "inactive" => false,
                        "on" => true,
                        "off" => false,
                        _ => null
                    };
                }

            default:
                return null;
        }
    }

    private static bool TryGetPropertyIgnoreCase(
        JsonElement item,
        string propertyName,
        out JsonElement value)
    {
        value = default;

        if (item.ValueKind != JsonValueKind.Object)
            return false;

        if (item.TryGetProperty(propertyName, out value))
            return true;

        foreach (var property in item.EnumerateObject())
        {
            if (string.Equals(
                    property.Name,
                    propertyName,
                    StringComparison.OrdinalIgnoreCase))
            {
                value = property.Value;
                return true;
            }
        }

        return false;
    }

    private static string NormalizeDirection(string? direction)
    {
        if (string.IsNullOrWhiteSpace(direction))
            return string.Empty;

        var normalized = direction.Trim();

        return normalized.ToLowerInvariant() switch
        {
            "in" => "Entrada",
            "entry" => "Entrada",
            "entrance" => "Entrada",
            "entrada" => "Entrada",
            "1" => "Entrada",

            "out" => "Saída",
            "exit" => "Saída",
            "saida" => "Saída",
            "saída" => "Saída",
            "2" => "Saída",

            "both" => "Bidirecional",
            "bidirectional" => "Bidirecional",
            "bothway" => "Bidirecional",
            "3" => "Bidirecional",

            /*
             * Não descarta valores desconhecidos de outras marcas.
             * Dessa forma, Intelbras, Control iD ou novos fabricantes
             * continuam exibindo o valor original.
             */
            _ => normalized
        };
    }

    private static string ShortFirmware(string value) => value.Length <= 42 ? value : $"{value[..39]}...";

    private static string ActionLabel(string action) => action switch
    {
        "OpenDoor" => "Abrir porta",
        "ProvisionCredential" => "Provisionar",
        "ActivateCredential" => "Ativar credencial",
        "DeactivateCredential" => "Suspender credencial",
        "RestoreCredential" => "Restaurar",
        "RenewCredential" => "Renovar QR Code",
        "RemoveCredential" => "Remover vínculo",
        "FaceEnrollment" => "Cadastro facial",
        "ReadAccessLogs" => "Consultar acessos",
        _ => "Teste de conexão"
    };

    private static Color ActionColor(string action) => action switch
    {
        "OpenDoor" or "ActivateCredential" or "RestoreCredential" or "RenewCredential" => Color.Success,
        "DeactivateCredential" or "RemoveCredential" => Color.Warning,
        _ => Color.Info
    };
}
