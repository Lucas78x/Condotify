<div class="empty-state operational-empty @Class" role="status">
    <span class="operational-empty-icon" aria-hidden="true"><MudIcon Icon="@Icon" /></span>
    <MudText Typo="Typo.h5" HtmlTag="h3">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2">@Description</MudText>
    }
    @if (Action is not null)
    {
        <div class="operational-empty-action">@Action</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Action { get; set; }
}
