<div class="page-header">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <MudText Typo="Typo.overline" Class="page-eyebrow">@Eyebrow</MudText>
        }
        <MudText Typo="Typo.h1" HtmlTag="h1">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="page-subtitle">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Eyebrow { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
}
