@inject NavigationManager Navigation
@inject IJSRuntime Js

@if (Open)
{
    <div class="command-palette-backdrop" role="presentation" @onclick="CloseAsync">
        <section class="command-palette" role="dialog" aria-modal="true" aria-labelledby="command-palette-title" @onclick:stopPropagation="true" @onkeydown="HandleKeyDownAsync">
            <header>
                <MudIcon Icon="@Icons.Material.Outlined.Search" />
                <input @ref="_searchInput" value="@_query" @oninput="UpdateQuery" placeholder="Buscar página ou ação" aria-label="Buscar página ou ação" autocomplete="off" />
                <button type="button" @onclick="CloseAsync" aria-label="Fechar busca"><MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" /></button>
            </header>
            <div class="command-palette-heading" id="command-palette-title">Acesso rápido</div>
            <div class="command-palette-results">
                @foreach (var command in FilteredCommands)
                {
                    <button type="button" @onclick="@(() => NavigateAsync(command.Url))">
                        <span class="command-palette-icon"><MudIcon Icon="@command.Icon" /></span>
                        <span><strong>@command.Label</strong><small>@command.Description</small></span>
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
                    </button>
                }
                @if (!FilteredCommands.Any())
                {
                    <div class="command-palette-empty"><MudIcon Icon="@Icons.Material.Outlined.SearchOff" /><span>Nenhum destino encontrado.</span></div>
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private ElementReference _searchInput;
    private string _query = string.Empty;
    private bool _focusPending;

    private static readonly CommandItem[] Commands =
    [
        new("Visão geral", "Indicadores principais da operação", "/", Icons.Material.Outlined.SpaceDashboard),
        new("Central de operações", "Alertas, filas e saúde da plataforma", "/operacoes", Icons.Material.Outlined.MonitorHeart),
        new("Condomínios", "Ambientes e licenças administradas", "/licencas", Icons.Material.Outlined.Domain),
        new("Portaria", "Visitantes, acessos e encomendas", "/portaria", Icons.Material.Outlined.AssistantDirection),
        new("Pesquisa de pessoas", "Moradores, visitantes e credenciais", "/pesquisa", Icons.Material.Outlined.PersonSearch),
        new("Cadastros", "Pessoas e vínculos da operação", "/cadastros", Icons.Material.Outlined.PersonAdd),
        new("Credenciais", "Faciais, cartões, tags e QR Codes", "/credenciais", Icons.Material.Outlined.Badge),
        new("Equipamentos", "Terminais e pontos de acesso", "/equipamentos", Icons.Material.Outlined.Sensors),
        new("Câmeras", "Monitoramento e dispositivos de vídeo", "/licencas", Icons.Material.Outlined.Videocam),
        new("Segurança da conta", "Senha, sessão e acesso", "/seguranca", Icons.Material.Outlined.Security)
    ];

    private IEnumerable<CommandItem> FilteredCommands => string.IsNullOrWhiteSpace(_query)
        ? Commands
        : Commands.Where(x => $"{x.Label} {x.Description}".Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (Open) _focusPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        await Js.InvokeVoidAsync("portalInterop.focusElement", _searchInput);
    }

    private void UpdateQuery(ChangeEventArgs args) => _query = args.Value?.ToString() ?? string.Empty;

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseAsync();
        else if (args.Key == "Enter" && FilteredCommands.FirstOrDefault() is { } command) await NavigateAsync(command.Url);
    }

    private async Task NavigateAsync(string url)
    {
        await CloseAsync();
        Navigation.NavigateTo(url);
    }

    private async Task CloseAsync()
    {
        _query = string.Empty;
        await OpenChanged.InvokeAsync(false);
    }

    private sealed record CommandItem(string Label, string Description, string Url, string Icon);
}
