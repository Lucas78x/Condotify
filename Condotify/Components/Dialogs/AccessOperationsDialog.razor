@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IDialogService DialogService

<MudDialog Class="entity-dialog access-operations-dialog">
    <DialogContent>
        <div class="operations-command-bar">
            <div><strong>Sincronização e recuperação</strong><span>Revise o impacto antes de distribuir credenciais para os terminais.</span></div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Visibility" Disabled="_busy" OnClick="PreviewAsync">Previa</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AltRoute" Disabled="_busy" OnClick="OpenSimulatorAsync">Simular rota</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sync" Disabled="_busy" OnClick="QueueAsync">Reconciliar base</MudButton>
            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Outlined.Download" OnClick="ExportBackupAsync">Exportar backup</MudMenuItem>
                <label class="mud-menu-item backup-upload-item"><MudIcon Icon="@Icons.Material.Outlined.UploadFile" /><span>Restaurar backup</span><InputFile OnChange="RestoreBackupAsync" accept="application/json,.json" /></label>
            </MudMenu>
        </div>

        @if (_preview is not null)
        {
            <div class="operation-preview-grid">
                <div><strong>@_preview.CredentialCount</strong><span>Credenciais</span></div>
                <div><strong>@_preview.ResidentCount</strong><span>Pessoas</span></div>
                <div><strong>@_preview.TargetCount</strong><span>Destinos</span></div>
                <div><strong>@_preview.PendingCount</strong><span>Pendências atuais</span></div>
            </div>
            @if (_preview.Warnings.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense Class="mb-4">@string.Join(" | ", _preview.Warnings.Take(5))</MudAlert>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }

        <MudTabs Elevation="0" Class="operations-tabs">
            <MudTabPanel Text="Processamentos" Icon="@Icons.Material.Outlined.Sync">
                @if (_batches.Count == 0)
                {
                    <div class="profile-empty profile-empty-compact"><MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" /><span>Nenhum processamento solicitado.</span></div>
                }
                else
                {
                    <div class="operation-batch-list">
                        @foreach (var batch in _batches)
                        {
                            <div class="operation-batch-row @batch.Status.ToLowerInvariant()">
                                <span class="operation-status-icon @batch.Status.ToLowerInvariant()"><MudIcon Icon="@BatchIcon(batch.Status)" /></span>
                                <div class="operation-batch-main"><strong>@BatchLabel(batch.Status)</strong><span>Solicitado por @batch.RequestedBy em @batch.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span><small>@AttemptLabel(batch)</small></div>
                                <div class="operation-progress"><MudProgressLinear Value="@BatchProgress(batch)" Color="@BatchColor(batch.Status)" Rounded="false" /><small>@batch.ProcessedItems de @batch.TotalItems | @batch.FailedItems falha(s)</small></div>
                                @if (batch.Status == "Queued")
                                {
                                    <MudTooltip Text="Cancelar processamento"><MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Error" OnClick="@(() => CancelBatchAsync(batch))" /></MudTooltip>
                                }
                                else if (batch.Status is "DeadLetter" or "Failed" or "CompletedWithErrors")
                                {
                                    <MudTooltip Text="Reprocessar pendências"><MudIconButton Icon="@Icons.Material.Outlined.Replay" Color="Color.Primary" OnClick="@(() => RetryBatchAsync(batch))" /></MudTooltip>
                                }
                            </div>
                            @if (batch.Items.Count > 0)
                            {
                                <details class="operation-items">
                                    <summary>@batch.Items.Count destino(s) - ver detalhes</summary>
                                    @foreach (var item in batch.Items)
                                    {
                                        <div class="operation-item-row">
                                            <MudIcon Icon="@ItemIcon(item.Status)" Color="@ItemColor(item.Status)" Size="Size.Small" />
                                            <div><strong>@(!string.IsNullOrWhiteSpace(item.CredentialName) ? item.CredentialName : "Credencial")</strong><span>@item.DeviceName</span></div>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ItemColor(item.Status)">@ItemLabel(item.Status)</MudChip>
                                            <small>@(string.IsNullOrWhiteSpace(item.Error) ? $"{item.AttemptCount} tentativa(s)" : item.Error)</small>
                                        </div>
                                    }
                                </details>
                            }
                        }
                    </div>
                }
            </MudTabPanel>
            <MudTabPanel Text="Auditoria" Icon="@Icons.Material.Outlined.History">
                <div class="unit-toolbar mb-4">
                    <MudTextField T="string" @bind-Value="_auditSearch" Immediate Placeholder="Buscar alteração ou responsável" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="string" @bind-Value="_auditEntity" Label="Entidade" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("all")">Todas</MudSelectItem>
                        @foreach (var entity in _audits.Select(x => x.EntityType).Distinct().OrderBy(x => x))
                        {
                            <MudSelectItem Value="@entity">@EntityLabel(entity)</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                @if (_audits.Count == 0)
                {
                    <div class="profile-empty profile-empty-compact"><MudIcon Icon="@Icons.Material.Outlined.History" /><span>Nenhuma alteração registrada.</span></div>
                }
                else
                {
                    <MudTable Items="FilteredAudits" Hover Dense Elevation="0">
                        <HeaderContent><MudTh>Quando</MudTh><MudTh>Entidade</MudTh><MudTh>Operação</MudTh><MudTh>Resultado</MudTh><MudTh>Responsável</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Quando">@context.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</MudTd>
                            <MudTd DataLabel="Entidade">@EntityLabel(context.EntityType)</MudTd>
                            <MudTd DataLabel="Operação"><strong>@AuditActionLabel(context.Action)</strong><small class="audit-summary">@context.Summary</small>@if (AuditDetails(context) is { Length: > 0 } details) { <small class="audit-summary">@details</small> }</MudTd>
                            <MudTd DataLabel="Resultado"><MudChip T="string" Size="Size.Small" Color="@AuditColor(context.Status)" Variant="Variant.Outlined">@AuditLabel(context.Status)</MudChip></MudTd>
                            <MudTd DataLabel="Responsável">@context.UserName</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Close">Fechar</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }

    private List<AccessBatchOperationViewModel> _batches = [];
    private List<AccessAuditViewModel> _audits = [];
    private string _auditSearch = string.Empty;
    private string _auditEntity = "all";
    private ReconciliationPreviewViewModel? _preview;
    private bool _busy;
    private string? _error;
    private IEnumerable<AccessAuditViewModel> FilteredAudits => _audits
        .Where(x => _auditEntity == "all" || x.EntityType == _auditEntity)
        .Where(x => string.IsNullOrWhiteSpace(_auditSearch) ||
            $"{x.Action} {x.Summary} {x.UserName} {x.EntityType}".Contains(_auditSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var batchesTask = Api.GetReconciliationBatchesAsync(LicenseId);
        var auditsTask = Api.GetAccessAuditsAsync(LicenseId);
        await Task.WhenAll(batchesTask, auditsTask);
        if (batchesTask.Result.Success) _batches = batchesTask.Result.Value ?? [];
        if (auditsTask.Result.Success) _audits = auditsTask.Result.Value ?? [];
        _error = batchesTask.Result.Error ?? auditsTask.Result.Error;
    }

    private async Task PreviewAsync()
    {
        _busy = true; _error = null;
        var result = await Api.PreviewReconciliationAsync(LicenseId);
        _busy = false;
        if (!result.Success) { _error = result.Error; return; }
        _preview = result.Value;
    }

    private async Task QueueAsync()
    {
        await PreviewAsync();
        if (_preview is null) return;
        _busy = true;
        var result = await Api.QueueReconciliationAsync(LicenseId);
        _busy = false;
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add("Reconciliação adicionada à fila.", Severity.Success);
        await LoadAsync();
    }

    private async Task OpenSimulatorAsync()
    {
        var parameters = new DialogParameters<RouteSimulatorDialog> { { x => x.LicenseId, LicenseId } };
        await DialogService.ShowAsync<RouteSimulatorDialog>("", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task CancelBatchAsync(AccessBatchOperationViewModel batch)
    {
        var result = await Api.CancelReconciliationBatchAsync(LicenseId, batch.Id);
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add("Processamento cancelado.", Severity.Info);
        await LoadAsync();
    }

    private async Task RetryBatchAsync(AccessBatchOperationViewModel batch)
    {
        _busy = true; _error = null;
        var result = await Api.RetryReconciliationBatchAsync(LicenseId, batch.Id);
        _busy = false;
        if (!result.Success) { _error = result.Error; return; }
        Snackbar.Add("Pendências reenviadas para processamento.", Severity.Success);
        await LoadAsync();
    }

    private async Task ExportBackupAsync()
    {
        _busy = true;
        var result = await Api.ExportCredentialBackupAsync(LicenseId);
        _busy = false;
        if (!result.Success || result.Value is null) { _error = result.Error; return; }
        var json = System.Text.Json.JsonSerializer.Serialize(result.Value, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web) { WriteIndented = true });
        await JS.InvokeVoidAsync("portalInterop.downloadText", $"condotify-credenciais-{DateTime.Now:yyyyMMdd-HHmm}.json", json, "application/json");
        Snackbar.Add("Backup exportado.", Severity.Success);
    }

    private async Task RestoreBackupAsync(InputFileChangeEventArgs args)
    {
        _busy = true; _error = null;
        try
        {
            await using var stream = args.File.OpenReadStream(5_000_000);
            var backup = await System.Text.Json.JsonSerializer.DeserializeAsync<CredentialBackupViewModel>(stream, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            if (backup is null) { _error = "O arquivo não possui um backup válido."; return; }
            var result = await Api.RestoreCredentialBackupAsync(LicenseId, backup);
            if (!result.Success) { _error = result.Error; return; }
            Snackbar.Add("Backup restaurado e enviado para reconciliação.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private void Close() => Dialog.Close(DialogResult.Ok(true));
    private static double BatchProgress(AccessBatchOperationViewModel x) => x.TotalItems <= 0 ? 0 : x.ProcessedItems * 100d / x.TotalItems;
    private static string BatchIcon(string status) => status switch { "Completed" => Icons.Material.Outlined.CheckCircle, "CompletedWithErrors" => Icons.Material.Outlined.WarningAmber, "Failed" or "DeadLetter" => Icons.Material.Outlined.ReportProblem, "Running" => Icons.Material.Outlined.Sync, "Canceled" => Icons.Material.Outlined.Cancel, _ => Icons.Material.Outlined.Schedule };
    private static string BatchLabel(string status) => status switch { "Completed" => "Concluído", "CompletedWithErrors" => "Concluído com pendências", "Failed" => "Falhou", "DeadLetter" => "Requer intervenção", "Running" => "Em processamento", "Canceled" => "Cancelado", _ => "Na fila" };
    private static Color BatchColor(string status) => status switch { "Completed" => Color.Success, "CompletedWithErrors" => Color.Warning, "Failed" or "DeadLetter" => Color.Error, "Running" => Color.Info, _ => Color.Default };
    private static string AttemptLabel(AccessBatchOperationViewModel batch) => batch.NextAttemptAt.HasValue ? $"Nova tentativa {batch.NextAttemptAt.Value.ToLocalTime():dd/MM HH:mm}" : $"Tentativa {batch.AttemptCount} de {batch.MaxAttempts}";
    private static string AuditLabel(string status) => status switch { "Success" => "Sucesso", "Pending" or "Queued" => "Pendente", "Failed" or "Error" => "Falha", "Completed" => "Concluído", "NoRoute" => "Sem rota", _ => "Registrado" };
    private static Color AuditColor(string status) => status switch { "Success" => Color.Success, "Pending" or "Queued" => Color.Warning, "NoRoute" => Color.Error, _ => Color.Default };
    private static string AuditActionLabel(string action) => action switch
    {
        "Created" => "Criado",
        "Updated" or "ProfileUpdated" => "Atualizado",
        "Activated" => "Ativado",
        "Deactivated" => "Desativado",
        "Trashed" => "Movido para a lixeira",
        "Restored" => "Restaurado",
        "Purged" => "Excluído definitivamente",
        "Imported" => "Importado",
        "Exported" => "Exportado",
        "ExportFailed" => "Falha na exportação",
        "ArchiveGenerated" => "Arquivo gerado",
        "Completed" => "Concluído",
        "Deleted" => "Excluído",
        "Resolved" => "Resolvido",
        "Closed" => "Encerrado",
        "Commented" => "Comentário adicionado",
        "Assigned" => "Responsável atualizado",
        "Acknowledged" => "Reconhecido",
        "Reopened" or "Open" => "Reaberto",
        "Snoozed" => "Silenciado",
        "Unsnoozed" => "Silêncio removido",
        "Inspect" => "Verificação do equipamento",
        "RouteSimulation" => "Simulação de rotas",
        "Retry" => "Reprocessamento",
        "Restore" => "Restauração",
        "RouteOverride" => "Exceção de rota",
        "NotificationPolicyUpdated" => "Notificações atualizadas",
        "SmtpSettingsUpdated" => "E-mail atualizado",
        "SmtpSettingsRemoved" => "E-mail removido",
        "OpenDoor" => "Porta acionada",
        "ProvisionCredential" => "Credencial enviada",
        "ActivateCredential" => "Credencial ativada",
        "DeactivateCredential" => "Credencial suspensa",
        "RestoreCredential" => "Credencial restaurada",
        "RemoveCredential" => "Credencial removida",
        "FaceEnrollment" => "Cadastro facial",
        "ReadAccessLogs" => "Consulta de acessos",
        "RenewCredential" => "Credencial renovada",
        _ => "Atividade registrada"
    };
    private static string EntityLabel(string entity) => entity switch
    {
        "Block" => "Agrupamento",
        "Unit" => "Unidade",
        "Resident" => "Pessoa",
        "Vehicle" => "Veículo",
        "Device" => "Equipamento",
        "Credential" => "Credencial",
        "AccessRoute" => "Rota",
        "ConfigurationBackup" => "Backup de configuração",
        "BackupAutomation" => "Agendamento de backup",
        _ => "Registro"
    };
    private static string AuditDetails(AccessAuditViewModel audit)
    {
        if (string.IsNullOrWhiteSpace(audit.DetailsJson) || audit.DetailsJson == "{}") return string.Empty;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(audit.DetailsJson);
            if (document.RootElement.TryGetProperty("changedFields", out var fields) && fields.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var names = fields.EnumerateArray().Select(x => FieldLabel(x.GetString() ?? string.Empty)).Where(x => x.Length > 0);
                return $"Campos alterados: {string.Join(", ", names)}";
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }
        return string.Empty;
    }
    private static string FieldLabel(string field) => field switch
    {
        "Name" => "nome",
        "Email" => "e-mail",
        "PhoneNumber" => "celular",
        "CommercialPhone" => "telefone comercial",
        "CPF" => "CPF",
        "RG" => "RG",
        "BirthDate" => "data de nascimento",
        "Description" => "observações",
        "NotifyAccess" => "notificações",
        "IsActive" => "estado",
        "HasPhoto" => "foto",
        "Relationship" => "vínculo",
        _ => string.Empty
    };
    private static string ItemLabel(string status) => status switch { "Completed" => "Concluído", "Running" => "Executando", "WaitingDevice" => "Aguardando terminal", "Failed" => "Falhou", "DeadLetter" => "Intervenção", "Canceled" => "Cancelado", _ => "Na fila" };
    private static string ItemIcon(string status) => status switch { "Completed" => Icons.Material.Outlined.CheckCircle, "Running" => Icons.Material.Outlined.Sync, "WaitingDevice" => Icons.Material.Outlined.CloudOff, "Failed" or "DeadLetter" => Icons.Material.Outlined.Error, _ => Icons.Material.Outlined.Schedule };
    private static Color ItemColor(string status) => status switch { "Completed" => Color.Success, "Running" => Color.Info, "WaitingDevice" => Color.Warning, "Failed" or "DeadLetter" => Color.Error, _ => Color.Default };
}
