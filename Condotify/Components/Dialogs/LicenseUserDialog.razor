@inject CondotifyApiClient Api

<MudDialog Class="entity-dialog entity-dialog-wide access-user-dialog">
    <DialogContent>
        <div class="dialog-description"><MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" /><div><strong>@(Existing is null ? "Novo usuário da operação" : "Acesso de usuário")</strong><span>O acesso vale somente para este condomínio.</span></div></div>
        @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert> }
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-validation-summary" />
            <div class="form-grid">
                <MudTextField T="string" @bind-Value="_form.Name" Label="Nome completo" Required Immediate Disabled="@(Existing is not null)" Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_form.Email" Label="E-mail de acesso" Required Immediate Disabled="@(Existing is not null)" Variant="Variant.Outlined" />
                @if (Existing is null)
                {
                    <MudTextField T="string" @bind-Value="_form.PhoneNumber" Label="Celular" Immediate Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_form.Password" Label="Senha temporária" Required Immediate InputType="InputType.Password" Variant="Variant.Outlined" HelperText="Mínimo de 8 caracteres; a troca será solicitada no primeiro acesso." />
                }
                <MudSelect T="int" Value="_form.Role" ValueChanged="RoleChanged" Label="Perfil inicial" Variant="Variant.Outlined" Class="full">
                    <MudSelectItem Value="0">Administrador da licença</MudSelectItem>
                    <MudSelectItem Value="1">Síndico / gestor</MudSelectItem>
                    <MudSelectItem Value="2">Portaria</MudSelectItem>
                    <MudSelectItem Value="3">Operador</MudSelectItem>
                    <MudSelectItem Value="4">Somente leitura</MudSelectItem>
                </MudSelect>
            </div>

            <div class="permission-editor">
                <div class="permission-editor-head">
                    <div><strong>Permissões deste usuário</strong><span>Ajuste exceções ao perfil selecionado.</span></div>
                    <div class="permission-editor-summary"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(HasCustomPermissions ? Color.Warning : Color.Info)">@PermissionProfileLabel</MudChip><strong>@SelectedPermissionCount de @LicensePermissionCatalog.Options.Count</strong><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ResetPermissions">Restaurar perfil</MudButton></div>
                </div>
                <MudTextField T="string" @bind-Value="_permissionSearch" Placeholder="Buscar permissão" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate Class="permission-search" />
                @foreach (var group in FilteredPermissionGroups)
                {
                    <section class="permission-group"><div class="permission-group-head"><h4>@group.Key</h4><button type="button" @onclick="@(() => SetGroupPermissions(group, !IsGroupSelected(group)))">@(IsGroupSelected(group) ? "Limpar grupo" : "Selecionar grupo")</button></div><div class="permission-grid">
                        @foreach (var option in group)
                        {
                            <label class="permission-option"><MudCheckBox T="bool" Value="@HasPermission(option.Permission)" ValueChanged="@(value => SetPermission(option.Permission, value))" Color="Color.Primary" /><span><strong>@option.Name</strong><small>@option.Description</small></span></label>
                        }
                    </div></section>
                }
            </div>

            @if (Existing is not null)
            {
                <MudSwitch T="bool" @bind-Value="_form.IsActive" Label="Acesso ativo para esta licença" Color="Color.Success" Class="mt-3" />
            }
            <div class="form-actions dialog-form-actions"><MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancelar</MudButton><MudButton ButtonType="ButtonType.Button" OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_saving">@(_saving ? "Salvando..." : "Salvar acesso")</MudButton></div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public LicenseUserAccessViewModel? Existing { get; set; }
    private readonly LicenseUserFormViewModel _form = new();
    private EditContext _editContext = null!;
    private bool _saving;
    private string? _error;
    private string? _permissionSearch;
    private IEnumerable<IGrouping<string, LicensePermissionOption>> FilteredPermissionGroups => LicensePermissionCatalog.Options
        .Where(x => string.IsNullOrWhiteSpace(_permissionSearch) || $"{x.Group} {x.Name} {x.Description}".Contains(_permissionSearch, StringComparison.OrdinalIgnoreCase))
        .GroupBy(x => x.Group);
    private int SelectedPermissionCount => LicensePermissionCatalog.Options.Count(x => HasPermission(x.Permission));
    private bool HasCustomPermissions => LicensePermissionCatalog.Normalize(_form.Permissions) != LicensePermissionCatalog.Normalize(LicensePermissionCatalog.Defaults(_form.Role));
    private string PermissionProfileLabel => HasCustomPermissions ? "Acesso personalizado" : "Perfil padrão";

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_form);
        if (Existing is null) { _form.Permissions = LicensePermissionCatalog.Defaults(_form.Role); return; }
        _form.Name = Existing.Name; _form.Email = Existing.Email; _form.PhoneNumber = Existing.PhoneNumber;
        _form.Role = RoleValue(Existing.Role); _form.Permissions = Existing.Permissions; _form.IsActive = Existing.IsActive;
    }

    private void Cancel() => Dialog.Cancel();
    private void RoleChanged(int role) { _form.Role = role; _form.Permissions = LicensePermissionCatalog.Defaults(role); }
    private void ResetPermissions() => _form.Permissions = LicensePermissionCatalog.Defaults(_form.Role);
    private bool HasPermission(LicensePermission permission) => (_form.Permissions & (long)permission) == (long)permission;
    private bool IsGroupSelected(IEnumerable<LicensePermissionOption> options) => options.All(x => HasPermission(x.Permission));
    private void SetGroupPermissions(IEnumerable<LicensePermissionOption> options, bool enabled)
    {
        var group = options.ToList();
        if (enabled)
        {
            _form.Permissions = LicensePermissionCatalog.Normalize(group.Aggregate(_form.Permissions, (value, option) => value | (long)option.Permission));
            return;
        }

        foreach (var option in group)
            _form.Permissions = LicensePermissionCatalog.RemoveDependents(_form.Permissions, option.Permission);
    }
    private void SetPermission(LicensePermission permission, bool enabled) => _form.Permissions = enabled
        ? LicensePermissionCatalog.Normalize(_form.Permissions | (long)permission)
        : LicensePermissionCatalog.RemoveDependents(_form.Permissions, permission);
    private async Task SaveAsync()
    {
        _error = null;
        if (!_editContext.Validate()) { _error = "Revise os campos destacados antes de salvar."; return; }
        if (Existing is null && string.IsNullOrWhiteSpace(_form.Password)) { _error = "Informe uma senha temporária."; return; }
        if (Existing is null && _form.Password.Length < 8) { _error = "A senha temporária deve ter pelo menos 8 caracteres."; return; }
        _saving = true; _error = null;
        var result = Existing is null ? await Api.CreateLicenseUserAsync(LicenseId, _form) : await Api.UpdateLicenseUserAsync(LicenseId, Existing.Id, _form);
        _saving = false;
        if (!result.Success) { _error = result.Error; return; }
        Dialog.Close(DialogResult.Ok(result.Value));
    }
    private static int RoleValue(string role) => role switch { "Administrator" => 0, "Manager" => 1, "Concierge" => 2, "Operator" => 3, _ => 4 };
}
