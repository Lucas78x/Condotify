@using System.Text
@inject CondotifyApiClient Api
@inject Microsoft.JSInterop.IJSRuntime JS

<MudDialog Class="entity-dialog entity-dialog-wide structure-import-dialog">
    <DialogContent>
        <section class="migration-hero">
            <span class="migration-hero-icon"><MudIcon Icon="@Icons.Material.Outlined.MoveDown" /></span>
            <div>
                <small>CENTRO DE MIGRAÇÃO ASSISTIDA</small>
                <strong>Traga os cadastros sem depender do fornecedor anterior</strong>
                <p>Use uma exportação ou planilha entregue pelo condomínio. O Condotify valida tudo antes de criar qualquer registro.</p>
            </div>
            <span class="migration-boundary-chip"><MudIcon Icon="@Icons.Material.Outlined.GppGood" /> Limite seguro</span>
        </section>

        <div class="migration-flow" aria-label="Etapas da migração">
            <span class="active"><b>1</b><small>Autorizar</small></span><i></i>
            <span class="@(_content.Length > 0 ? "active" : null)"><b>2</b><small>Carregar</small></span><i></i>
            <span class="@(_preview is not null ? "active" : null)"><b>3</b><small>Validar</small></span><i></i>
            <span class="@(_preview?.CanExecute == true ? "active" : null)"><b>4</b><small>Confirmar</small></span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }

        <section class="migration-policy-card">
            <div class="migration-section-heading">
                <span><MudIcon Icon="@Icons.Material.Outlined.AssignmentInd" /></span>
                <div><strong>Origem e autorização</strong><small>Registre as instruções fornecidas pelo controlador responsável por esta operação.</small></div>
            </div>
            <div class="migration-context-grid">
                <MudSelect T="string" @bind-Value="_migration.SourceSystem" Label="Sistema ou formato de origem" Variant="Variant.Outlined" Required>
                    <MudSelectItem Value="@("Situator")">Situator</MudSelectItem>
                    <MudSelectItem Value="@("Condfy")">Condfy</MudSelectItem>
                    <MudSelectItem Value="@("HikCentral")">HikCentral</MudSelectItem>
                    <MudSelectItem Value="@("iVMS4200")">iVMS-4200</MudSelectItem>
                    <MudSelectItem Value="@("InControl")">InControl</MudSelectItem>
                    <MudSelectItem Value="@("CondoMOB")">CondoMOB</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Outro sistema ou planilha</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" @bind-Value="_migration.ProcessingBasis" Label="Base definida pelo condomínio" Variant="Variant.Outlined" Required>
                    <MudSelectItem Value="@("Contract")">Execução de contrato ou implantação</MudSelectItem>
                    <MudSelectItem Value="@("LegalObligation")">Obrigação legal ou regulatória</MudSelectItem>
                    <MudSelectItem Value="@("LegitimateInterest")">Legítimo interesse documentado</MudSelectItem>
                    <MudSelectItem Value="@("RegularExercise")">Exercício regular de direitos</MudSelectItem>
                    <MudSelectItem Value="@("Consent")">Consentimento documentado</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_migration.AuthorizedBy" Label="Responsável que autorizou" Placeholder="Ex.: síndico ou administrador" Variant="Variant.Outlined" MaxLength="150" Required />
                <MudTextField @bind-Value="_migration.AuthorizationReference" Label="Referência da autorização" Placeholder="Ex.: ata, contrato ou chamado" Variant="Variant.Outlined" MaxLength="180" Required />
            </div>
            <div class="migration-confirmations">
                <label><MudCheckBox T="bool" @bind-Value="_migration.ControllerAuthorizationConfirmed" Color="Color.Primary" /><span><strong>Origem autorizada</strong><small>O controlador declarou estar autorizado a fornecer e migrar estes dados.</small></span></label>
                <label><MudCheckBox T="bool" @bind-Value="_migration.PurposeLimitationConfirmed" Color="Color.Primary" /><span><strong>Finalidade limitada</strong><small>Os dados serão usados somente na implantação e continuidade da operação.</small></span></label>
                <label><MudCheckBox T="bool" @bind-Value="_migration.NoRestrictedDataConfirmed" Color="Color.Primary" /><span><strong>Sem segredos ou biometria</strong><small>O arquivo não contém senhas, PINs, digitais ou templates/fotos faciais.</small></span></label>
            </div>
        </section>

        <section class="migration-safety-strip">
            <div><MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" /><span><strong>O que o Condotify não faz</strong><small>Não quebra banco, não contorna login, não acessa servidor concorrente e não importa biometria neste fluxo.</small></span></div>
            <div><MudIcon Icon="@Icons.Material.Outlined.FactCheck" /><span><strong>Rastreabilidade</strong><small>Origem, autorização e hash do arquivo ficam na auditoria; o conteúdo bruto não é armazenado.</small></span></div>
        </section>

        <section class="import-source @(!MigrationContextComplete ? "locked" : null)">
            <div class="import-source-copy">
                <MudIcon Icon="@Icons.Material.Outlined.TableView" />
                <div>
                    <strong>@(string.IsNullOrWhiteSpace(_fileName) ? "Selecione um arquivo CSV" : _fileName)</strong>
                    <span>@(MigrationContextComplete ? "Limite de 2 MB e 1.000 registros. Separadores ; e , são aceitos." : "Preencha e confirme a autorização antes de selecionar o arquivo.")</span>
                </div>
            </div>
            <div class="import-source-actions">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Download" OnClick="DownloadTemplateAsync">Baixar modelo</MudButton>
                <label class="file-button @(_loading || !MigrationContextComplete ? "disabled" : null)">
                    <MudIcon Icon="@Icons.Material.Outlined.UploadFile" />
                    <span>@(_preview is null ? "Selecionar CSV" : "Trocar arquivo")</span>
                    <InputFile OnChange="ReadFileAsync" accept=".csv,.txt,text/csv,text/plain" disabled="@(_loading || !MigrationContextComplete)" />
                </label>
            </div>
        </section>

        @if (_loading)
        {
            <div class="loading-state import-loading">
                <MudProgressCircular Indeterminate Color="Color.Primary" />
                <MudText Typo="Typo.body2">Validando arquivo...</MudText>
            </div>
        }
        else if (_preview is not null)
        {
            <div class="migration-receipt">
                <span><MudIcon Icon="@Icons.Material.Outlined.Verified" /></span>
                <div><strong>Prévia registrada</strong><small>Protocolo @_preview.PreviewId.ToString("N")[..12] · SHA-256 @_preview.FileSha256[..12]… · O arquivo ainda não foi importado.</small></div>
            </div>
            <div class="import-summary-grid">
                <div><span class="overview-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Apartment" /></span><span><strong>@_preview.NewBlocks</strong><small>Agrupamentos novos</small></span></div>
                <div><span class="overview-icon green"><MudIcon Icon="@Icons.Material.Outlined.DoorFront" /></span><span><strong>@_preview.NewUnits</strong><small>Unidades novas</small></span></div>
                <div><span class="overview-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Groups" /></span><span><strong>@_preview.NewPeople</strong><small>Pessoas novas</small></span></div>
                <div><span class="overview-icon amber"><MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" /></span><span><strong>@_preview.NewVehicles</strong><small>Veículos novos</small></span></div>
            </div>

            @if (_preview.Errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                    @foreach (var error in _preview.Errors) { <div>@error</div> }
                </MudAlert>
            }
            else
            {
                <div class="import-validation-head">
                    <div>
                        <strong>Pré-validação</strong>
                        <span>@_preview.ValidRows válidos de @_preview.TotalRows registros</span>
                    </div>
                    <MudChip T="string" Color="@(_preview.CanExecute ? Color.Success : Color.Error)" Variant="Variant.Outlined" Icon="@(_preview.CanExecute ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.ErrorOutline)">
                        @(_preview.CanExecute ? "Pronto para migrar" : $"{_preview.InvalidRows} com erro")
                    </MudChip>
                </div>

                <MudTable Items="_preview.Rows" Hover Dense Elevation="0" Class="import-preview-table">
                    <HeaderContent>
                        <MudTh>Linha</MudTh>
                        <MudTh>Agrupamento / unidade</MudTh>
                        <MudTh>Pessoa</MudTh>
                        <MudTh>Veículo</MudTh>
                        <MudTh>Validação</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Linha">@context.RowNumber</MudTd>
                        <MudTd DataLabel="Estrutura"><strong>@context.Block</strong><small class="audit-summary">@context.Unit</small></MudTd>
                        <MudTd DataLabel="Pessoa">@(!string.IsNullOrWhiteSpace(context.PersonName) ? context.PersonName : "-")</MudTd>
                        <MudTd DataLabel="Veículo">@(!string.IsNullOrWhiteSpace(context.VehiclePlate) ? context.VehiclePlate : "-")</MudTd>
                        <MudTd DataLabel="Validação">
                            @if (context.IsValid)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Válido</MudChip>
                            }
                            else
                            {
                                <MudTooltip Text="@string.Join(" ", context.Messages)">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@context.Messages.Count erro(s)</MudChip>
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" RowsPerPageString="Itens por página" InfoFormat="{first_item}-{last_item} de {all_items}" AllItemsText="Todos" /></PagerContent>
                </MudTable>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_executing" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PlaylistAddCheck" Disabled="@(_preview?.CanExecute != true || _executing)" OnClick="ExecuteAsync">
            @(_executing ? "Migrando..." : "Confirmar migração")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }

    private const long MaxFileSize = 2_000_000;
    private string _fileName = string.Empty;
    private string _content = string.Empty;
    private string _idempotencyKey = Guid.NewGuid().ToString("N");
    private StructureImportPreviewViewModel? _preview;
    private readonly AssistedMigrationContextViewModel _migration = new();
    private bool _loading;
    private bool _executing;
    private string? _error;

    private bool MigrationContextComplete =>
        !string.IsNullOrWhiteSpace(_migration.SourceSystem) &&
        !string.IsNullOrWhiteSpace(_migration.ProcessingBasis) &&
        (_migration.AuthorizedBy?.Trim().Length ?? 0) >= 3 &&
        (_migration.AuthorizationReference?.Trim().Length ?? 0) >= 3 &&
        _migration.ControllerAuthorizationConfirmed &&
        _migration.PurposeLimitationConfirmed &&
        _migration.NoRestrictedDataConfirmed;

    private void Cancel() => Dialog.Cancel();

    private async Task ReadFileAsync(InputFileChangeEventArgs args)
    {
        _loading = true;
        _error = null;
        _preview = null;
        try
        {
            var file = args.File;
            _fileName = file.Name;
            if (file.Size > MaxFileSize)
            {
                _error = "O arquivo excede o limite de 2 MB.";
                return;
            }

            await using var stream = file.OpenReadStream(MaxFileSize);
            using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            _content = await reader.ReadToEndAsync();
            _idempotencyKey = Guid.NewGuid().ToString("N");
            var result = await Api.PreviewStructureImportAsync(LicenseId, _fileName, _content, _idempotencyKey, _migration);
            if (!result.Success || result.Value is null)
            {
                _error = result.Error ?? "Não foi possível validar o arquivo.";
                return;
            }
            _preview = result.Value;
        }
        catch (IOException)
        {
            _error = "Não foi possível ler o arquivo selecionado.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExecuteAsync()
    {
        if (_preview?.CanExecute != true) return;
        _executing = true;
        _error = null;
        try
        {
            var result = await Api.ExecuteStructureImportAsync(
                LicenseId, _fileName, _content, _idempotencyKey,
                _preview.PreviewId, _preview.FileSha256, _migration);
            if (!result.Success || result.Value is null)
            {
                _error = result.Error ?? "Não foi possível concluir a importação.";
                return;
            }
            Dialog.Close(DialogResult.Ok(result.Value));
        }
        finally
        {
            _executing = false;
        }
    }

    private Task DownloadTemplateAsync() => JS.InvokeVoidAsync(
        "portalInterop.downloadText",
        "modelo-importacao-condotify.csv",
        "\uFEFFAgrupamento;Unidade;Andar;Nome;Categoria;Vinculo;CPF;RG;Email;Telefone;Placa;MarcaVeiculo;ModeloVeiculo;CorVeiculo;TipoVeiculo;Tag\nBloco A;101;1;Maria Silva;Responsavel;Proprietario;12345678901;;maria@exemplo.com;71999999999;ABC1D23;Honda;Civic;Prata;Carro;TAG-001\nBloco A;102;1;Joao Souza;Morador;Dependente;98765432100;;;71988888888;;;;;;",
        "text/csv;charset=utf-8").AsTask();
}
