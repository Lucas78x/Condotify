@inject CondotifyApiClient Api

<MudDialog Class="entity-dialog">
    <DialogContent>
        <div class="dialog-description">
            <MudIcon Icon="@Icons.Material.Outlined.Tune" />
            <div><strong>Nomenclatura da propriedade</strong><span>Adapte a estrutura para condominios, loteamentos, clubes e empresas.</span></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <div class="form-grid">
                <MudTextField T="string" @bind-Value="_model.GroupLabelSingular" Label="Agrupamento no singular" Placeholder="Bloco, Quadra, Torre" Required Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_model.GroupLabelPlural" Label="Agrupamento no plural" Placeholder="Blocos, Quadras, Torres" Required Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_model.UnitLabelSingular" Label="Unidade no singular" Placeholder="Unidade, Lote, Sala" Required Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_model.UnitLabelPlural" Label="Unidade no plural" Placeholder="Unidades, Lotes, Salas" Required Variant="Variant.Outlined" />
            </div>
            <div class="form-actions dialog-form-actions">
                <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_saving" OnClick="SaveAsync">@(_saving ? "Salvando..." : "Salvar configuracao")</MudButton>
            </div>
        </MudForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter, EditorRequired] public StructureSettingsViewModel Model { get; set; } = new();
    private readonly StructureSettingsViewModel _model = new();
    private MudForm? _form;
    private bool _isValid;
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        _model.GroupLabelSingular = Model.GroupLabelSingular;
        _model.GroupLabelPlural = Model.GroupLabelPlural;
        _model.UnitLabelSingular = Model.UnitLabelSingular;
        _model.UnitLabelPlural = Model.UnitLabelPlural;
    }

    private void Cancel() => Dialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is not null) await _form.ValidateAsync();
        if (!_isValid) { _error = "Preencha as quatro nomenclaturas."; return; }
        _saving = true;
        var result = await Api.UpdateStructureSettingsAsync(LicenseId, _model);
        _saving = false;
        if (!result.Success) { _error = result.Error; return; }
        Dialog.Close(DialogResult.Ok(_model));
    }
}
