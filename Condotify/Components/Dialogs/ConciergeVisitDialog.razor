@inject CondotifyApiClient Api

<MudDialog Class="entity-dialog concierge-visit-dialog">
    <TitleContent>
        <div class="dialog-title-block">
            <MudIcon Icon="@Icons.Material.Outlined.PersonAddAlt1" />
            <div><MudText Typo="Typo.h6">Autorizar acesso temporário</MudText><MudText Typo="Typo.caption">Defina quem, quando e por onde a pessoa poderá acessar.</MudText></div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <div class="visit-form-section">
                <div class="form-section-heading"><span>1</span><div><strong>Destino</strong><small>Localize o morador que receberá a visita.</small></div></div>
                <MudAutocomplete T="GlobalResidentSearchViewModel" @bind-Value="_host" SearchFunc="SearchHostsAsync"
                                 ToStringFunc="@(x => x is null ? string.Empty : $"{x.Name} - {x.BlockName} / {x.UnitNumber}")"
                                 Label="Morador ou unidade" Placeholder="Digite pelo menos 2 caracteres" Variant="Variant.Outlined"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
            </div>

            <div class="visit-form-section">
                <div class="form-section-heading"><span>2</span><div><strong>Tipo de acesso</strong><small>As rotas disponíveis respeitam a finalidade da autorização.</small></div></div>
                <div class="credential-segment" role="radiogroup" aria-label="Tipo de pessoa">
                    <button type="button" role="radio" aria-checked="@(_form.AccessType == GuestAccessType)" class="@AccessTypeClass(GuestAccessType)" @onclick="() => SelectAccessType(GuestAccessType)"><MudIcon Icon="@Icons.Material.Outlined.Person" /><span><strong>Visitante</strong><small>Acesso eventual ou convite</small></span></button>
                    <button type="button" role="radio" aria-checked="@(_form.AccessType == ServiceProviderAccessType)" class="@AccessTypeClass(ServiceProviderAccessType)" @onclick="() => SelectAccessType(ServiceProviderAccessType)"><MudIcon Icon="@Icons.Material.Outlined.Engineering" /><span><strong>Prestador de serviço</strong><small>Autorização única ou recorrente</small></span></button>
                </div>
                <div class="form-section-heading form-section-subheading"><div><strong>@PersonTypeTitle</strong><small>Dados para identificação na portaria.</small></div></div>
                <div class="form-grid form-grid-two">
                    <MudTextField T="string" @bind-Value="_form.VisitorName" Label="Nome completo" Required MaxLength="150" Immediate="true" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_form.Document" Label="CPF, RG ou documento" MaxLength="20" Immediate="true" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_form.PhoneNumber" Label="Telefone" MaxLength="20" Immediate="true" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_form.Company" Label="Empresa" MaxLength="150" Immediate="true" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_form.Purpose" Label="Motivo da visita" MaxLength="200" Immediate="true" Variant="Variant.Outlined" />
                    <MudAutocomplete T="string" @bind-Value="_form.VehiclePlate" SearchFunc="SearchPlatesAsync"
                                     ToStringFunc="@(x => x ?? string.Empty)" CoerceText="true" CoerceValue="true" Immediate="true"
                                     Label="Placa do veículo" Placeholder="Digite ao menos 2 caracteres" MaxLength="20" Variant="Variant.Outlined"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.DirectionsCar" Clearable="true">
                        <ItemTemplate Context="plateResult">
                            <div><strong>@plateResult</strong><br /><small>@_plateOwnerByValue.GetValueOrDefault(plateResult)</small></div>
                        </ItemTemplate>
                        <NoItemsTemplate><MudText Typo="Typo.body2" Class="pa-2">Nenhum veículo encontrado — pode digitar a placa manualmente.</MudText></NoItemsTemplate>
                    </MudAutocomplete>
                </div>
            </div>

            <div class="visit-form-section">
                <div class="form-section-heading"><span>3</span><div><strong>Credencial temporária</strong><small>Escolha a forma de identificação e a validade.</small></div></div>
                <div class="credential-segment" role="radiogroup" aria-label="Tipo de credencial">
                    <button type="button" role="radio" aria-checked="@(_form.CredentialType == 2)" class="@SegmentClass(2)" @onclick="() => SelectCredential(2)"><MudIcon Icon="@Icons.Material.Outlined.QrCode2" /><span><strong>QR Code</strong><small>Envio rápido e uso controlado</small></span></button>
                    <button type="button" role="radio" aria-checked="@(_form.CredentialType == 1)" class="@SegmentClass(1)" @onclick="() => SelectCredential(1)"><MudIcon Icon="@Icons.Material.Outlined.Face" /><span><strong>Facial temporária</strong><small>Distribuída aos terminais da rota</small></span></button>
                </div>
                @if (_form.CredentialType == 1)
                {
                    <div class="credential-segment facial-delivery-segment" role="radiogroup" aria-label="Forma de cadastro facial">
                        <button type="button" role="radio" aria-checked="@(!_form.CreateFacialInvite)" class="@FacialModeClass(false)" @onclick="() => SelectFacialMode(false)"><MudIcon Icon="@Icons.Material.Outlined.AddAPhoto" /><span><strong>Foto pela portaria</strong><small>Cadastre a imagem agora</small></span></button>
                        <button type="button" role="radio" aria-checked="@_form.CreateFacialInvite" class="@FacialModeClass(true)" @onclick="() => SelectFacialMode(true)"><MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" /><span><strong>Convite facial</strong><small>O visitante cadastra a própria foto</small></span></button>
                    </div>
                    @if (_form.CreateFacialInvite)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.AutoAwesome" Class="facial-invite-hint">
                            Após autorizar, será criado um link seguro e temporário para o visitante concluir o cadastro facial.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="visitor-photo-field">
                            @if (string.IsNullOrWhiteSpace(_form.ImageBase64))
                            {
                                <div class="visitor-photo-placeholder"><MudIcon Icon="@Icons.Material.Outlined.Person" /></div>
                            }
                            else
                            {
                                <img src="@_form.ImageBase64" alt="Pré-visualização da foto do visitante" />
                            }
                            <div><strong>@(_photoName ?? "Foto frontal obrigatória")</strong><small>JPG ou PNG, rosto centralizado e bem iluminado.</small></div>
                            <label class="file-button"><MudIcon Icon="@Icons.Material.Outlined.AddAPhoto" Size="Size.Small" /> Selecionar foto<InputFile OnChange="ReadPhotoAsync" accept="image/jpeg,image/png" /></label>
                        </div>
                    }
                }
                <div class="form-grid form-grid-three visit-validity-grid">
                    <MudDatePicker @bind-Date="_fromDate" Label="Data inicial" Variant="Variant.Outlined" />
                    <MudTimePicker @bind-Time="_fromTime" Label="Hora inicial" Variant="Variant.Outlined" />
                    <MudNumericField T="int?" @bind-Value="_form.MaxUses" Label="Limite de acessos" Min="1" Max="100" Variant="Variant.Outlined" />
                    <MudDatePicker @bind-Date="_toDate" Label="Data final" Variant="Variant.Outlined" />
                    <MudTimePicker @bind-Time="_toTime" Label="Hora final" Variant="Variant.Outlined" />
                </div>
                <div class="visit-policy-options">
                    <MudSwitch T="bool" @bind-Value="_form.RequireApproval" Color="Color.Primary" Label="Exigir aprovação antes de liberar" Disabled="@_form.CreateFacialInvite" />
                    <MudSwitch T="bool" @bind-Value="_recurring" Color="Color.Primary" Label="Repetir esta autorização" Disabled="@_form.CreateFacialInvite" />
                </div>
                @if (_recurring)
                {
                    <div class="form-grid form-grid-two">
                        <MudNumericField T="int" @bind-Value="_form.RepeatCount" Label="Quantidade de ocorrências" Min="2" Max="30" Variant="Variant.Outlined" />
                        <MudSelect T="int" @bind-Value="_form.RepeatEveryDays" Label="Frequência" Variant="Variant.Outlined"><MudSelectItem Value="1">Todos os dias</MudSelectItem><MudSelectItem Value="7">Toda semana</MudSelectItem><MudSelectItem Value="15">A cada 15 dias</MudSelectItem><MudSelectItem Value="30">Todo mês</MudSelectItem></MudSelect>
                    </div>
                }
            </div>

            <div class="visit-form-section">
                <div class="form-section-heading"><span>4</span><div><strong>Rotas permitidas</strong><small>Somente os terminais destas rotas receberão a credencial.</small></div></div>
                @if (Routes.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Nenhuma rota para @AudienceLabel está configurada. Solicite ao síndico ou administrador a configuração antes de liberar o acesso.</MudAlert>
                }
                else
                {
                    <div class="visit-route-grid">
                        @foreach (var route in Routes)
                        {
                            <label class="visit-route-option">
                                <MudCheckBox T="bool" Value="@IsRouteSelected(route.Id)" ValueChanged="@(value => SetRoute(route.Id, value))" Color="Color.Primary" />
                                <span><strong>@route.Name</strong><small>@RouteSummary(route)</small></span>
                            </label>
                        }
                    </div>
                }
            </div>

            <div class="form-actions dialog-form-actions">
                <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancelar</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.VerifiedUser" Disabled="@(_saving || Routes.Count == 0)">@(_saving ? "Autorizando..." : "Autorizar acesso")</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public List<AccessRouteViewModel> Routes { get; set; } = [];

    private readonly ConciergeVisitFormViewModel _form = new();
    private GlobalResidentSearchViewModel? _host;
    private DateTime? _fromDate;
    private TimeSpan? _fromTime;
    private DateTime? _toDate;
    private TimeSpan? _toTime;
    private bool _saving;
    private string? _error;
    private string? _photoName;
    private bool _recurring;
    private List<AccessRouteViewModel> _availableRoutes = [];
    private const int GuestAccessType = 3;
    private const int ServiceProviderAccessType = 4;

    protected override void OnInitialized()
    {
        var now = CondotifyTime.Now;
        var suggestedEnd = now.AddHours(4);
        _fromDate = now.Date;
        _fromTime = now.TimeOfDay;
        _toDate = suggestedEnd.Date;
        _toTime = suggestedEnd.TimeOfDay;
        _availableRoutes = Routes.Where(x => x.IsActive && x.AllowTemporary).ToList();
        SelectAccessType(GuestAccessType);
    }

    private async Task<IEnumerable<GlobalResidentSearchViewModel>> SearchHostsAsync(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2) return [];
        var result = await Api.SearchResidentsAsync(value, null, null, null, null, LicenseId.ToString(), cancellationToken);
        return result.Success ? (result.Value ?? []).Where(x => !x.Temporary).Take(15) : [];
    }

    private readonly Dictionary<string, string> _plateOwnerByValue = new();

    private async Task<IEnumerable<string>> SearchPlatesAsync(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2) return [];
        var result = await Api.SearchVehiclesByPlateAsync(LicenseId, value, cancellationToken);
        if (!result.Success) return [];
        _plateOwnerByValue.Clear();
        foreach (var vehicle in result.Value ?? [])
            _plateOwnerByValue[vehicle.Plate] = $"{vehicle.ResidentName} - {vehicle.UnitLabel}";
        return (result.Value ?? []).Select(x => x.Plate);
    }

    private void SelectCredential(int type)
    {
        _form.CredentialType = type;
        if (type != 1)
        {
            _form.CreateFacialInvite = false;
            _form.ImageBase64 = string.Empty;
            _photoName = null;
        }
        _error = null;
    }

    private string SegmentClass(int type) => _form.CredentialType == type ? "credential-segment-option selected" : "credential-segment-option";
    private string AccessTypeClass(int type) => _form.AccessType == type ? "credential-segment-option selected" : "credential-segment-option";
    private string PersonTypeTitle => _form.AccessType == ServiceProviderAccessType ? "Prestador" : "Visitante";
    private string AudienceLabel => _form.AccessType == ServiceProviderAccessType ? "prestadores de serviço" : "visitantes";
    private void SelectAccessType(int accessType)
    {
        _form.AccessType = accessType;
        var audience = accessType == ServiceProviderAccessType ? AccessRouteAudience.ServiceProvider : AccessRouteAudience.Visitor;
        Routes = _availableRoutes.Where(x => ((AccessRouteAudience)x.Audience).HasFlag(audience)).ToList();
        _form.RouteIds = Routes.Select(x => x.Id).ToList();
        if (accessType == ServiceProviderAccessType && !_form.CreateFacialInvite)
        {
            _recurring = true;
            _form.RepeatCount = Math.Max(2, _form.RepeatCount);
        }
        _error = null;
    }
    private string FacialModeClass(bool invite) => _form.CreateFacialInvite == invite ? "credential-segment-option selected" : "credential-segment-option";
    private void SelectFacialMode(bool invite)
    {
        _form.CreateFacialInvite = invite;
        if (invite)
        {
            _form.ImageBase64 = string.Empty;
            _photoName = null;
            _form.RequireApproval = false;
            _recurring = false;
            _form.RepeatCount = 1;
        }
        _error = null;
    }
    private bool IsRouteSelected(Guid routeId) => _form.RouteIds.Contains(routeId);
    private void SetRoute(Guid routeId, bool selected)
    {
        if (selected && !_form.RouteIds.Contains(routeId)) _form.RouteIds.Add(routeId);
        if (!selected) _form.RouteIds.Remove(routeId);
    }
    private static string RouteSummary(AccessRouteViewModel route) => route.Devices.Count == 0 ? "Sem terminais vinculados" : $"{route.Devices.Count} terminal(is) - {route.StartTime:hh\\:mm} às {route.EndTime:hh\\:mm}";

    private async Task ReadPhotoAsync(InputFileChangeEventArgs args)
    {
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            _form.ImageBase64 = await FacePhotoProcessor.PrepareAsync(args.File, timeout.Token).WaitAsync(timeout.Token);
            _photoName = args.File.Name;
            _error = null;
        }
        catch (OperationCanceledException) { _error = "O processamento da foto demorou demais. Tente uma imagem menor."; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        if (_host is null) { _error = "Selecione o morador que receberá a visita."; return; }
        if (_form.CredentialType == 1 && !_form.CreateFacialInvite && string.IsNullOrWhiteSpace(_form.ImageBase64)) { _error = "Selecione uma foto para a credencial facial temporária."; return; }
        if (_form.RouteIds.Count == 0) { _error = "Selecione ao menos uma rota de acesso."; return; }
        if (!_fromDate.HasValue || !_toDate.HasValue) { _error = "Informe o início e o término da visita."; return; }
        _form.HostResidentId = _host.Id;
        _form.ValidFrom = _fromDate.Value.Date.Add(_fromTime ?? TimeSpan.Zero);
        _form.ValidTo = _toDate.Value.Date.Add(_toTime ?? TimeSpan.Zero);
        if (!_recurring) _form.RepeatCount = 1;
        if (_form.ValidTo <= _form.ValidFrom) { _error = "O término deve ser posterior ao início da visita."; return; }

        _saving = true;
        _error = null;
        var result = await Api.CreateConciergeVisitAsync(LicenseId, _form);
        _saving = false;
        if (!result.Success) { _error = result.Error; return; }
        Dialog.Close(DialogResult.Ok(result.Value));
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        var messages = context.GetValidationMessages().Distinct().ToList();
        _error = messages.Count == 0
            ? $"Revise os dados do {PersonTypeTitle.ToLowerInvariant()} antes de autorizar o acesso."
            : string.Join(" ", messages);
    }

    private void Cancel() => Dialog.Cancel();
}
