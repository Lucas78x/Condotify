@inject CondotifyApiClient Api
@inject ISnackbar Snackbar

<MudDialog Class="entity-dialog automation-dialog">
    <TitleContent><div class="dialog-title-block"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /><div><MudText Typo="Typo.h6">@(Rule is null ? "Nova automação" : "Editar automação")</MudText><MudText Typo="Typo.caption">Quando o gatilho acontecer, a F&amp;F Access executará as ações selecionadas.</MudText></div></div></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_form.Name" Label="Nome da regra" Variant="Variant.Outlined" Required />
            <MudTextField @bind-Value="_form.Description" Label="Descrição" Variant="Variant.Outlined" Lines="2" />
            <MudSelect T="int" Value="_form.TriggerType" ValueChanged="ChangeTrigger" Label="Quando acontecer" Variant="Variant.Outlined">
                <MudSelectItem Value="0">Equipamento ficar offline</MudSelectItem><MudSelectItem Value="1">Muitas recusas de acesso</MudSelectItem><MudSelectItem Value="2">Visitante exceder permanência</MudSelectItem><MudSelectItem Value="3">Encomenda demorar para retirada</MudSelectItem>
            </MudSelect>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense Icon="@Icons.Material.Outlined.TipsAndUpdates">@TriggerHelp</MudAlert>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_form.Threshold" Label="@ThresholdLabel" Variant="Variant.Outlined" Min="1" Max="10000" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_form.WindowMinutes" Label="Janela (minutos)" Variant="Variant.Outlined" Min="1" Max="10080" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_form.CooldownMinutes" Label="Não repetir por (min)" Variant="Variant.Outlined" Min="5" Max="43200" /></MudItem>
            </MudGrid>
            <MudSelect T="int" @bind-Value="_form.Severity" Label="Gravidade gerada" Variant="Variant.Outlined"><MudSelectItem Value="0">Baixa</MudSelectItem><MudSelectItem Value="1">Média</MudSelectItem><MudSelectItem Value="2">Alta</MudSelectItem><MudSelectItem Value="3">Crítica</MudSelectItem></MudSelect>
            <MudPaper Class="automation-actions-box" Elevation="0"><MudText Typo="Typo.subtitle2">Ações</MudText><MudCheckBox T="bool" @bind-Value="_createIncident" Label="Abrir uma ocorrência com linha do tempo" Color="Color.Primary" /><MudCheckBox T="bool" @bind-Value="_createAlert" Label="Gerar alerta e usar a política de notificações" Color="Color.Primary" /></MudPaper>
            <MudSwitch T="bool" @bind-Value="_form.IsEnabled" Label="Regra ativa" Color="Color.Primary" />
        </MudStack>
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_saving" OnClick="SaveAsync">@(_saving ? "Salvando..." : "Salvar automação")</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public AutomationRuleViewModel? Rule { get; set; }
    private AutomationRuleFormViewModel _form = new(); private bool _createIncident = true; private bool _createAlert = true; private bool _saving;
    private string ThresholdLabel => _form.TriggerType switch { 0 => "Offline por (min)", 1 => "Número de recusas", 2 => "Tolerância (min)", _ => "Limite" };
    private string TriggerHelp => _form.TriggerType switch { 0 => "Detecta terminais sem comunicação pelo tempo informado.", 1 => "Conta recusas por equipamento dentro da janela configurada.", 2 => "Compara o horário previsto de saída com a permanência atual.", _ => "Detecta encomendas recebidas que continuam na portaria além da janela." };
    protected override void OnInitialized()
    {
        if (Rule is null) return;
        _form = new AutomationRuleFormViewModel { Name = Rule.Name, Description = Rule.Description, TriggerType = TriggerValue(Rule.TriggerType), Threshold = Rule.Threshold, WindowMinutes = Rule.WindowMinutes, Severity = SeverityValue(Rule.Severity), Actions = Rule.Actions, IsEnabled = Rule.IsEnabled, CooldownMinutes = Rule.CooldownMinutes };
        _createIncident = (Rule.Actions & 1) != 0; _createAlert = (Rule.Actions & 2) != 0;
    }
    private void ChangeTrigger(int value) { _form.TriggerType = value; if (value == 3 && _form.WindowMinutes < 60) _form.WindowMinutes = 1440; }
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) { Snackbar.Add("Informe o nome da regra.", Severity.Warning); return; }
        _form.Actions = (_createIncident ? 1 : 0) | (_createAlert ? 2 : 0); if (_form.Actions == 0) { Snackbar.Add("Selecione ao menos uma ação.", Severity.Warning); return; }
        _saving = true; var result = await Api.SaveAutomationRuleAsync(LicenseId, Rule?.Id, _form); _saving = false;
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível salvar a regra.", Severity.Error); return; }
        Snackbar.Add("Automação salva.", Severity.Success); Dialog.Close(DialogResult.Ok(result.Value));
    }
    private void Cancel() => Dialog.Cancel();
    private static int TriggerValue(string value) => value switch { "DeviceOffline" => 0, "AccessDeniedThreshold" => 1, "VisitorOverstay" => 2, "DeliveryOverdue" => 3, _ => 0 };
    private static int SeverityValue(string value) => value switch { "Low" => 0, "Medium" => 1, "High" => 2, "Critical" => 3, _ => 2 };
}
