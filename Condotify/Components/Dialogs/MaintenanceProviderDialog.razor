@inject CondotifyApiClient Api
@inject ISnackbar Snackbar

<MudDialog Class="entity-dialog">
    <TitleContent><div class="dialog-title-block"><MudIcon Icon="@Icons.Material.Outlined.Handyman" /><div><MudText Typo="Typo.h6">@(_provider is null ? "Novo prestador" : "Editar prestador")</MudText><MudText Typo="Typo.caption">Contato operacional e especialidade, sem vínculo financeiro.</MudText></div></div></TitleContent>
    <DialogContent><MudGrid Spacing="2">
        <MudItem xs="12"><MudTextField @bind-Value="_form.Name" Label="Empresa ou profissional" Variant="Variant.Outlined" Immediate Required /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.Specialty" Label="Especialidade" Variant="Variant.Outlined" Immediate /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.ContactName" Label="Pessoa de contato" Variant="Variant.Outlined" Immediate /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.Phone" Label="Telefone" Variant="Variant.Outlined" Immediate /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.Email" Label="E-mail" Variant="Variant.Outlined" Immediate /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_form.Notes" Label="Observações" Variant="Variant.Outlined" Immediate Lines="3" /></MudItem>
        <MudItem xs="12"><MudSwitch T="bool" @bind-Value="_form.IsActive" Color="Color.Success">Disponível para novas ordens</MudSwitch></MudItem>
    </MudGrid></DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">Salvar prestador</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public MaintenanceProviderViewModel? Value { get; set; }
    private MaintenanceProviderViewModel? _provider;
    private readonly MaintenanceProviderFormViewModel _form = new(); private bool _saving;
    protected override void OnInitialized() { _provider = Value; if (Value is not null) { _form.Name = Value.Name; _form.Specialty = Value.Specialty; _form.ContactName = Value.ContactName; _form.Phone = Value.Phone; _form.Email = Value.Email; _form.Notes = Value.Notes; _form.IsActive = Value.IsActive; } }
    private async Task SaveAsync() { if (string.IsNullOrWhiteSpace(_form.Name)) { Snackbar.Add("Informe o nome do prestador.", Severity.Warning); return; } _saving = true; var result = await Api.SaveMaintenanceProviderAsync(LicenseId, _provider?.Id, _form); _saving = false; if (!result.Success) { Snackbar.Add(result.Error ?? "Falha ao salvar prestador.", Severity.Error); return; } Snackbar.Add("Prestador salvo.", Severity.Success); Dialog.Close(DialogResult.Ok(result.Value)); }
    private void Cancel() => Dialog.Cancel();
}
