@inject CondotifyApiClient Api

<MudDialog Class="entity-dialog entity-dialog-wide">
    <DialogContent>
        <div class="dialog-description">
            <MudIcon Icon="@Icons.Material.Outlined.Badge" />
            <div><strong>Vincular credencial</strong><span>O cadastro fica salvo mesmo se o equipamento estiver temporariamente offline.</span></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert> }
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="form-grid form-grid-three">
                <MudSelect T="Guid" @bind-Value="_form.ResidentId" Label="Morador" Required Variant="Variant.Outlined">
                    @foreach (var resident in Residents) { <MudSelectItem T="Guid" Value="@resident.Id">@resident.Name - @resident.UnitNumber</MudSelectItem> }
                </MudSelect>
                <MudSelect T="Guid" @bind-Value="_form.DeviceId" Label="Equipamento" Required Variant="Variant.Outlined">
                    @foreach (var device in Devices.Where(x => x.IsActive)) { <MudSelectItem T="Guid" Value="@device.Id">@device.Name - @device.Model</MudSelectItem> }
                </MudSelect>
                <MudSelect T="int" @bind-Value="_form.Type" Label="Tipo" Variant="Variant.Outlined"><MudSelectItem Value="1">Facial</MudSelectItem><MudSelectItem Value="2">QR Code</MudSelectItem><MudSelectItem Value="3">Cartão</MudSelectItem><MudSelectItem Value="4">Tag</MudSelectItem><MudSelectItem Value="5">Tag veicular</MudSelectItem><MudSelectItem Value="6">Senha / PIN</MudSelectItem></MudSelect>

                @if (_form.Type is not (1 or 2))
                {
                    <MudTextField T="string" @bind-Value="_form.Identifier" Label="Número ou identificador" Required Variant="Variant.Outlined" Class="full" />
                }
                else if (_form.Type == 1)
                {
                    <div class="credential-upload full">
                        <div><MudIcon Icon="@Icons.Material.Outlined.AddAPhoto" /><span><strong>@(_photoName ?? "Foto facial opcional")</strong><small>Control iD aceita captura no terminal; Intelbras exige JPG com até 100 KB.</small></span></div>
                        <label class="file-button">Selecionar foto<InputFile OnChange="ReadPhotoAsync" accept="image/jpeg,image/png" /></label>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="full">O código será gerado com segurança pela API. Validade e renovações seguem a política configurada nesta licença.</MudAlert>
                }
                @if (_form.Type == 1)
                {
                    <MudSwitch T="bool" @bind-Value="_form.IsTemporary" Label="Facial temporária" Color="Color.Primary" Class="full" />
                }
                <MudDatePicker @bind-Date="_form.ValidFrom" Label="Valida a partir de" Variant="Variant.Outlined" />
                <MudDatePicker @bind-Date="_form.ValidTo" Label="Válida até" Variant="Variant.Outlined" Disabled="@(_form.Type == 2)" />
                @if (_form.IsTemporary || _form.Type == 2)
                {
                    <MudNumericField T="int?" @bind-Value="_form.MaxUses" Label="Limite de acessos" Min="1" HelperText="Vazio permite acessos ilimitados durante a validade." Variant="Variant.Outlined" />
                }
                @if (_form.Type == 2)
                {
                    <MudNumericField T="int?" @bind-Value="_form.MaxRenewals" Label="Renovações permitidas" Min="0" HelperText="Respeita o limite definido para esta licença." Variant="Variant.Outlined" />
                }
            </div>
            <div class="form-actions dialog-form-actions">
                <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancelar</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sync" Disabled="_saving">@(_saving ? "Sincronizando..." : "Salvar e sincronizar")</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter] public List<ResidentRowViewModel> Residents { get; set; } = [];
    [Parameter] public List<AccessDeviceRowViewModel> Devices { get; set; } = [];
    private readonly CredentialFormViewModel _form = new();
    private bool _saving;
    private string? _error;
    private string? _photoName;

    protected override void OnInitialized()
    {
        _form.ResidentId = Residents.FirstOrDefault()?.Id ?? Guid.Empty;
        _form.DeviceId = Devices.FirstOrDefault(x => x.IsActive)?.Id ?? Guid.Empty;
    }
    private void Cancel() => Dialog.Cancel();
    private async Task ReadPhotoAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            _form.ImageBase64 = await FacePhotoProcessor.PrepareAsync(file, timeout.Token).WaitAsync(timeout.Token);
            _photoName = file.Name; _error = null;
        }
        catch (OperationCanceledException)
        {
            _error = "O processamento da foto demorou demais. Tente uma imagem menor.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
    private async Task SaveAsync()
    {
        _saving = true; _error = null;
        var result = await Api.CreateCredentialAsync(LicenseId, _form);
        _saving = false;
        if (!result.Success) { _error = result.Error; return; }
        Dialog.Close(DialogResult.Ok(result.Value));
    }
}
