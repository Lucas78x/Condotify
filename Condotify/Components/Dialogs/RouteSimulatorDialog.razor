@inject CondotifyApiClient Api

<MudDialog Class="entity-dialog route-simulator-dialog">
    <TitleContent><div class="dialog-title-block"><MudIcon Icon="@Icons.Material.Outlined.AltRoute" /><div><MudText Typo="Typo.h6">Simulador de acesso</MudText><MudText Typo="Typo.caption">Confira rotas, terminais e portas sem alterar o equipamento.</MudText></div></div></TitleContent>
    <DialogContent>
        <div class="route-simulator-form"><MudAutocomplete T="GlobalResidentSearchViewModel" @bind-Value="_resident" SearchFunc="SearchAsync" ToStringFunc="@(x => x is null ? string.Empty : $"{x.Name} - {x.BlockName} / {x.UnitNumber}")" Label="Pessoa" Placeholder="Busque por nome, documento ou unidade" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.PersonSearch" Clearable /><MudSelect T="int" @bind-Value="_credentialType" Label="Credencial" Variant="Variant.Outlined"><MudSelectItem Value="1">Facial</MudSelectItem><MudSelectItem Value="2">QR Code</MudSelectItem><MudSelectItem Value="3">Cartao</MudSelectItem><MudSelectItem Value="4">Tag veicular</MudSelectItem><MudSelectItem Value="5">Senha</MudSelectItem></MudSelect><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PlayArrow" Disabled="@(_busy || _resident is null)" OnClick="SimulateAsync">Simular</MudButton></div>
        @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert> }
        @if (_result is not null)
        {
            <div class="route-simulation-summary"><span><small>Perfil resolvido</small><strong>@AudienceLabel(_result.Audience)</strong></span><span><small>Rotas elegiveis</small><strong>@_result.Routes.Count</strong></span><span><small>Terminais</small><strong>@_result.Targets.Count</strong></span></div>
            @foreach (var warning in _result.Warnings) { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense Class="mt-3">@warning</MudAlert> }
            <div class="route-simulation-targets">@foreach (var target in _result.Targets) { <article><span class="device-health @(target.Online ? "online" : "offline")"><MudIcon Icon="@Icons.Material.Outlined.Sensors" /></span><div><strong>@target.DeviceName</strong><small>@target.DeviceType</small><div>@foreach (var portal in target.Portals) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@portal</MudChip> }</div></div><MudChip T="string" Size="Size.Small" Color="@(target.Online ? Color.Success : Color.Error)" Variant="Variant.Outlined">@(target.Online ? "Online" : "Offline")</MudChip></article> }</div>
        }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Close">Fechar</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    private GlobalResidentSearchViewModel? _resident; private int _credentialType = 1; private bool _busy; private string? _error; private RouteSimulationViewModel? _result;
    private async Task<IEnumerable<GlobalResidentSearchViewModel>> SearchAsync(string value, CancellationToken token) { if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2) return []; var result = await Api.SearchResidentsAsync(value, null, null, null, null, LicenseId.ToString(), token); return result.Success ? result.Value ?? [] : []; }
    private async Task SimulateAsync() { if (_resident is null) return; _busy = true; _error = null; var result = await Api.SimulateRouteAsync(LicenseId, _resident.Id, _credentialType); _busy = false; if (!result.Success) { _error = result.Error; return; } _result = result.Value; }
    private void Close() => Dialog.Close();
    private static string AudienceLabel(string value) => value switch { "OwnerResponsible" => "Proprietario responsavel", "TenantResponsible" => "Inquilino responsavel", "Responsible" => "Responsavel", "Dependent" => "Dependente", "Resident" => "Morador", "Visitor" => "Visitante", "ServiceProvider" => "Prestador", _ => value };
}
