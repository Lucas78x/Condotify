@inject CondotifyApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog Class="entity-dialog entity-dialog-wide recycle-bin-dialog">
    <DialogContent>
        <div class="dialog-description">
            <MudIcon Icon="@Icons.Material.Outlined.RestoreFromTrash" />
            <div>
                <strong>Lixeira da propriedade</strong>
                <span>Itens excluidos permanecem protegidos por 30 dias antes da remocao automatica.</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }

        <div class="unit-toolbar recycle-toolbar">
            <MudTextField T="string" @bind-Value="_search" Immediate Placeholder="Buscar item excluido" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSelect T="string" @bind-Value="_type" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">Todos</MudSelectItem>
                @foreach (var type in _items.Select(x => x.EntityType).Distinct().OrderBy(EntityLabel))
                {
                    <MudSelectItem Value="@type">@EntityLabel(type)</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="Atualizar lixeira"><MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary" OnClick="LoadAsync" /></MudTooltip>
        </div>

        @if (_loading)
        {
            <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
        }
        else if (!FilteredItems.Any())
        {
            <div class="profile-empty recycle-empty">
                <MudIcon Icon="@Icons.Material.Outlined.DeleteSweep" />
                <strong>Lixeira vazia</strong>
                <span>Nenhum item excluido corresponde aos filtros atuais.</span>
            </div>
        }
        else
        {
            <div class="recycle-list">
                @foreach (var item in FilteredItems)
                {
                    <article class="recycle-row">
                        <span class="recycle-icon"><MudIcon Icon="@EntityIcon(item.EntityType)" /></span>
                        <div class="recycle-main">
                            <div><strong>@item.DisplayName</strong><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@EntityLabel(item.EntityType)</MudChip></div>
                            <span>Excluido por @DisplayActor(item.DeletedBy) em @item.DeletedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="recycle-expiry @(item.DaysRemaining <= 7 ? "urgent" : null)">
                            <strong>@item.DaysRemaining</strong>
                            <span>@(item.DaysRemaining == 1 ? "dia restante" : "dias restantes")</span>
                        </div>
                        <div class="recycle-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Restore" Disabled="@(_busyItemId == item.Id)" OnClick="@(() => RestoreAsync(item))">Restaurar</MudButton>
                            <MudTooltip Text="Excluir definitivamente"><MudIconButton Icon="@Icons.Material.Outlined.DeleteForever" Color="Color.Error" Disabled="@(_busyItemId == item.Id)" OnClick="@(() => PurgeAsync(item))" /></MudTooltip>
                        </div>
                    </article>
                }
            </div>
        }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Close">Fechar</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }

    private List<RecycleBinItemViewModel> _items = [];
    private string _search = string.Empty;
    private string _type = "all";
    private string? _error;
    private Guid? _busyItemId;
    private bool _loading = true;
    private IEnumerable<RecycleBinItemViewModel> FilteredItems => _items
        .Where(x => _type == "all" || x.EntityType == _type)
        .Where(x => string.IsNullOrWhiteSpace(_search) ||
            $"{x.DisplayName} {EntityLabel(x.EntityType)} {x.DeletedBy}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();
    private void Close() => Dialog.Close(DialogResult.Ok(true));

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetRecycleBinAsync(LicenseId);
        _loading = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _items = result.Value ?? [];
    }

    private async Task RestoreAsync(RecycleBinItemViewModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Restaurar item",
            $"Restaurar {item.DisplayName}? A operacao sera bloqueada se o local original nao existir ou houver um cadastro conflitante.",
            yesText: "Restaurar",
            cancelText: "Cancelar");
        if (confirmed != true) return;

        _busyItemId = item.Id;
        _error = null;
        var result = await Api.RestoreRecycleBinItemAsync(LicenseId, item.Id);
        _busyItemId = null;
        if (!result.Success)
        {
            _error = result.Error;
            Snackbar.Add(result.Error ?? "Nao foi possivel restaurar o item.", Severity.Error);
            return;
        }
        _items.Remove(item);
        Snackbar.Add(result.Value?.Message ?? "Item restaurado.", Severity.Success);
    }

    private async Task PurgeAsync(RecycleBinItemViewModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir definitivamente",
            $"Excluir {item.DisplayName} definitivamente? Esta acao remove o snapshot e nao podera ser desfeita.",
            yesText: "Excluir definitivamente",
            cancelText: "Cancelar");
        if (confirmed != true) return;

        _busyItemId = item.Id;
        _error = null;
        var result = await Api.PurgeRecycleBinItemAsync(LicenseId, item.Id);
        _busyItemId = null;
        if (!result.Success)
        {
            _error = result.Error;
            Snackbar.Add(result.Error ?? "Nao foi possivel excluir o item.", Severity.Error);
            return;
        }
        _items.Remove(item);
        Snackbar.Add("Item excluido definitivamente.", Severity.Success);
    }

    private static string DisplayActor(string value) => string.IsNullOrWhiteSpace(value) ? "usuario nao identificado" : value;
    private static string EntityLabel(string type) => type switch
    {
        "Block" => "Agrupamento",
        "Unit" => "Unidade",
        "Resident" => "Pessoa",
        "Vehicle" => "Veiculo",
        "Device" => "Equipamento",
        _ => type
    };
    private static string EntityIcon(string type) => type switch
    {
        "Block" => Icons.Material.Outlined.Apartment,
        "Unit" => Icons.Material.Outlined.DoorFront,
        "Resident" => Icons.Material.Outlined.Person,
        "Vehicle" => Icons.Material.Outlined.DirectionsCar,
        "Device" => Icons.Material.Outlined.Sensors,
        _ => Icons.Material.Outlined.Inventory2
    };
}
