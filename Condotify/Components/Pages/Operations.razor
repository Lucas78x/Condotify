    private static string ActivitySummary(OperationalActivityViewModel activity)
    {
        var summary = activity.Summary?.Trim() ?? string.Empty;
        var rawSuffix = $": {activity.Action}";
        return summary.EndsWith(rawSuffix, StringComparison.Ordinal)
            ? $"{summary[..^rawSuffix.Length]}: {ActivityLabel(activity.Action).ToLowerInvariant()}"
            : summary;
    }

    private static string RelativeTime(DateTime value)
    {
        var elapsed = DateTime.UtcNow - (value.Kind == DateTimeKind.Utc ? value : value.ToUniversalTime());
        if (elapsed.TotalMinutes < 1) return "agora";
        if (elapsed.TotalHours < 1) return $"há {(int)elapsed.TotalMinutes} min";
        if (elapsed.TotalDays < 1) return $"há {(int)elapsed.TotalHours} h";
        return value.ToCondotifyTime().ToString("dd/MM");
    }

    private RenderFragment HealthMetric(string label, int value, int total, string icon, string tone) => @<div class="health-metric">
        <span class="overview-icon @tone"><MudIcon Icon="@icon" /></span>
        <span class="health-metric-copy"><strong>@label</strong><small>@value de @total em condição esperada</small></span>
        <span class="health-metric-value">@Percentage(value, total).ToString("N0", CultureInfo.GetCultureInfo("pt-BR"))%</span>
        <MudProgressLinear Value="@Percentage(value, total)" Color="@(tone == "green" ? Color.Success : Color.Primary)" Rounded="false" />
    </div>;

    private static double Percentage(int value, int total) => total <= 0 ? 100 : Math.Clamp(value * 100d / total, 0, 100);
}
