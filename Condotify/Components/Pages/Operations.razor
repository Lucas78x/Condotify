@page "/operacoes"
@attribute [Authorize]
@implements IAsyncDisposable
@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@using System.Globalization

<PageTitle>Operações | F&amp;F Access</PageTitle>

<PageHeader Title="Central de operações" Subtitle="Monitore acessos, sincronizações, equipamentos e reservas que exigem atenção." Eyebrow="SAÚDE DA PLATAFORMA">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="_loading" OnClick="LoadAsync">Atualizar</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="operations-loading">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="84px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="340px" />
    </div>
}
else if (_dashboard is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@(_error ?? "Não foi possível carregar os dados operacionais.")</MudAlert>
}
else
{
    <div class="stats-grid operations-stats">
        <StatTile Label="Equipamentos" Value="@($"{_dashboard.OnlineDeviceCount}/{_dashboard.DeviceCount}")" Icon="@Icons.Material.Outlined.Sensors" Hint="terminais online" Tone="blue" />
        <StatTile Label="Sincronização" Value="@($"{_dashboard.SynchronizationRate:N1}%")" Icon="@Icons.Material.Outlined.Sync" Hint="@($"{_dashboard.PendingCredentialCount} pendência(s)")" Tone="green" />
        <StatTile Label="Acessos" Value="@_dashboard.AccessEventCount.ToString()" Icon="@Icons.Material.Outlined.FactCheck" Hint="@AccessRateHint" Tone="amber" />
        <StatTile Label="Requer atenção" Value="@AttentionCount.ToString()" Icon="@Icons.Material.Outlined.NotificationImportant" Hint="alertas operacionais" Tone="red" />
    </div>

    <div class="operations-grid">
        <MudPaper Class="content-panel operations-trend-panel" Elevation="0">
            <div class="panel-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Fluxo de acessos</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Autorizações e recusas nos últimos 14 dias</MudText>
                </div>
                <div class="trend-legend">
                    <span><i class="authorized"></i>Autorizados</span>
                    <span><i class="denied"></i>Negados</span>
                </div>
            </div>
            @if (HasAccessTrend)
            {
                <div class="access-trend-chart" role="img" aria-label="Gráfico de acessos dos últimos 14 dias">
                    @foreach (var point in _dashboard.AccessTrend)
                    {
                        <div class="trend-column">
                            <div class="trend-bars">
                                <span class="authorized" style="@BarHeight(point.Authorized)" title="@($"{point.Authorized} autorizado(s)")"></span>
                                <span class="denied" style="@BarHeight(point.Denied)" title="@($"{point.Denied} negado(s)")"></span>
                            </div>
                            <small>@point.Date.ToString("dd/MM")</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="trend-empty-state">
                    <span><MudIcon Icon="@Icons.Material.Outlined.Insights" /></span>
                    <strong>O gráfico começa com o primeiro acesso</strong>
                    <small>Autorizações e recusas aparecerão aqui automaticamente durante os próximos 14 dias.</small>
                    <div class="trend-empty-baseline"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                </div>
            }
        </MudPaper>

        <MudPaper Class="content-panel operations-health-panel" Elevation="0">
            <div class="panel-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Resumo operacional</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Situação atual da plataforma</MudText>
                </div>
            </div>
            <div class="health-metric-list">
                @HealthMetric("Credenciais", _dashboard.CredentialCount - _dashboard.PendingCredentialCount, _dashboard.CredentialCount, Icons.Material.Outlined.Badge, "green")
                @HealthMetric("Equipamentos", _dashboard.OnlineDeviceCount, _dashboard.DeviceCount, Icons.Material.Outlined.Sensors, "blue")
                @HealthMetric("Reservas de hoje", _dashboard.TodayBookingCount, Math.Max(_dashboard.TodayBookingCount, 1), Icons.Material.Outlined.EventAvailable, "violet")
            </div>
            <div class="operations-queue-strip">
                <span><strong>@_dashboard.PendingBatchCount</strong><small>Na fila</small></span>
                <span><strong>@_dashboard.FailedBatchCount</strong><small>Com falha</small></span>
                <span><strong>@_dashboard.PendingBookingCount</strong><small>Reservas pendentes</small></span>
            </div>
        </MudPaper>
    </div>

    <MudPaper Class="content-panel operations-jobs-panel" Elevation="0">
        <div class="operations-jobs-toolbar">
            <div class="operations-jobs-heading">
                <span class="overview-icon violet"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /></span>
                <span>
                    <MudText Typo="Typo.h5" Class="panel-title">Fila de operações</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Acompanhe cada sincronização até o equipamento e intervenha somente quando necessário.</MudText>
                </span>
            </div>
            <div class="operations-live-state"><i></i><span>Atualização automática</span></div>
            <div class="operations-job-filters" role="group" aria-label="Filtrar processamentos">
                @JobFilterButton("all", "Todas", _jobs.Count)
                @JobFilterButton("active", "Em andamento", ActiveJobCount)
                @JobFilterButton("attention", "Atenção", AttentionJobCount)
                @JobFilterButton("completed", "Finalizadas", FinishedJobCount)
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Disabled="_jobsBusy" OnClick="RefreshJobsAsync" aria-label="Atualizar fila" />
        </div>

        @if (_jobsBusy && _jobs.Count == 0)
        {
            <div class="operations-jobs-skeleton"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="118px" /><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="118px" /></div>
        }
        else if (!string.IsNullOrWhiteSpace(_jobsError) && _jobs.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="ma-4">@_jobsError</MudAlert>
        }
        else if (!FilteredJobs.Any())
        {
            <div class="operations-empty compact operations-jobs-empty">
                <span class="operations-empty-orbit"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></span>
                <strong>@(_jobFilter == "all" ? "Nenhuma operação solicitada" : "Nenhuma operação neste filtro")</strong>
                <span>As próximas sincronizações aparecerão aqui com o progresso em tempo real.</span>
            </div>
        }
        else
        {
            <div class="operations-job-list">
                @foreach (var job in VisibleJobs)
                {
                    <article class="operations-job-card @JobTone(job.Status)">
                        <header>
                            <span class="operations-job-icon"><MudIcon Icon="@JobIcon(job.Status)" /></span>
                            <div class="operations-job-title">
                                <span><strong>@OperationLabel(job.Operation)</strong><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@JobColor(job.Status)">@JobStatusLabel(job.Status)</MudChip></span>
                                <a href="@LicenseTarget(job.LicenseId)">@(string.IsNullOrWhiteSpace(job.LicenseName) ? "Condomínio" : job.LicenseName)</a>
                                <small>Solicitado por @(string.IsNullOrWhiteSpace(job.RequestedBy) ? "Sistema" : job.RequestedBy) · @RelativeTime(job.CreatedAt)</small>
                            </div>
                            <div class="operations-job-actions">
                                @if (CanCancelJob(job.Status))
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Close" Disabled="@IsJobBusy(job)" OnClick="@(() => CancelJobAsync(job))">Cancelar</MudButton>
                                }
                                else if (CanRetryJob(job.Status))
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Replay" Disabled="@IsJobBusy(job)" OnClick="@(() => RetryJobAsync(job))">Reprocessar</MudButton>
                                }
                            </div>
                        </header>
                        <div class="operations-job-progress">
                            <div><span>Progresso</span><strong>@JobProgress(job).ToString("N0")%</strong></div>
                            <MudProgressLinear Value="@JobProgress(job)" Color="@JobColor(job.Status)" Rounded="true" />
                        </div>
                        <div class="operations-job-metrics">
                            <span><strong>@job.SuccessfulItems</strong><small>concluídos</small></span>
                            <span><strong>@PendingItemCount(job)</strong><small>pendentes</small></span>
                            <span class="@(job.FailedItems > 0 ? "has-error" : null)"><strong>@job.FailedItems</strong><small>com atenção</small></span>
                            <span><strong>@job.AttemptCount/@job.MaxAttempts</strong><small>tentativas</small></span>
                            <span><strong>@DeviceCount(job)</strong><small>equipamentos</small></span>
                        </div>
                        @if (job.NextAttemptAt.HasValue && CanCancelJob(job.Status))
                        {
                            <div class="operations-next-attempt"><MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />Nova tentativa prevista para @job.NextAttemptAt.Value.ToCondotifyTime().ToString("dd/MM 'às' HH:mm")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(job.Error))
                        {
                            <div class="operations-job-error"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />@job.Error</div>
                        }
                        @if (job.Items.Count > 0)
                        {
                            <details class="operations-job-details">
                                <summary><span>Ver progresso por equipamento</span><MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" /></summary>
                                <div class="operations-device-list">
                                    @foreach (var deviceGroup in JobDevices(job))
                                    {
                                        <section class="operations-device-group">
                                            <div class="operations-device-heading">
                                                <span class="operations-device-icon"><MudIcon Icon="@Icons.Material.Outlined.Sensors" Size="Size.Small" /></span>
                                                <span><strong>@deviceGroup.Key.Name</strong><small>@deviceGroup.Count() credencial(is)</small></span>
                                                <div><MudProgressLinear Value="@DeviceProgress(deviceGroup)" Color="@DeviceColor(deviceGroup)" Rounded="true" /><small>@DeviceProgress(deviceGroup).ToString("N0")%</small></div>
                                            </div>
                                            @foreach (var item in deviceGroup.OrderByDescending(x => ItemPriority(x.Status)).ThenBy(x => x.CredentialName))
                                            {
                                                <div class="operations-device-item">
                                                    <span class="operations-item-state @JobTone(item.Status)"><MudIcon Icon="@ItemIcon(item.Status)" Size="Size.Small" /></span>
                                                    <span><strong>@(string.IsNullOrWhiteSpace(item.CredentialName) ? "Credencial" : item.CredentialName)</strong><small>@ItemFeedback(item)</small></span>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ItemColor(item.Status)">@ItemStatusLabel(item.Status)</MudChip>
                                                    <span class="operations-item-actions">
                                                        @if (CanCancelItem(item.Status))
                                                        {
                                                            <MudTooltip Text="Cancelar próximas tentativas"><MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Color="Color.Error" Disabled="@IsJobBusy(job)" OnClick="@(() => CancelItemAsync(job, item))" /></MudTooltip>
                                                        }
                                                        @if (CanRetryItem(item.Status))
                                                        {
                                                            <MudTooltip Text="Reprocessar este item"><MudIconButton Icon="@Icons.Material.Outlined.Replay" Size="Size.Small" Color="Color.Primary" Disabled="@IsJobBusy(job)" OnClick="@(() => RetryItemAsync(job, item))" /></MudTooltip>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                            </details>
                        }
                    </article>
                }
            </div>
            @if (HiddenJobCount > 0)
            {
                <button type="button" class="operations-list-more" @onclick="ShowAllJobs">
                    <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" />
                    Ver mais @HiddenJobCount operações
                </button>
            }
        }
    </MudPaper>

    <div class="operations-grid operations-lower-grid">
        <MudPaper Class="content-panel" Elevation="0">
            <div class="panel-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Central de alertas</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Itens priorizados para intervenção</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(AttentionCount > 0 ? Color.Warning : Color.Success)">
                    @(AttentionCount > 0 ? $"{AttentionCount} alerta(s)" : "Tudo em ordem")
                </MudChip>
            </div>
            <OperationalAlertCenter />
        </MudPaper>

        <MudPaper Class="content-panel" Elevation="0">
            <div class="panel-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Atividade recente</MudText>
                </div>
            </div>
            @if (_dashboard.RecentActivities.Count == 0)
            {
                <div class="operations-empty compact">
                    <MudIcon Icon="@Icons.Material.Outlined.History" />
                    <strong>Nenhuma atividade registrada</strong>
                </div>
            }
            else
            {
                <div class="operations-activity-list">
                    @foreach (var activity in VisibleActivities)
                    {
                        <a href="@LicenseTarget(activity.LicenseId)" class="operations-activity-row">
                            <span class="activity-status @ActivityTone(activity.Status)"></span>
                            <span>
                                <strong>@ActivityLabel(activity.Action)</strong>
                                <small>@ActivitySummary(activity)</small>
                                <em>@activity.LicenseName · @(string.IsNullOrWhiteSpace(activity.UserName) ? "Sistema" : activity.UserName)</em>
                            </span>
                            <time>@activity.CreatedAt.ToCondotifyTime().ToString("dd/MM HH:mm")</time>
                        </a>
                    }
                </div>
                @if (HiddenActivityCount > 0)
                {
                    <button type="button" class="operations-list-more is-flush" @onclick="ShowAllActivities">
                        <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" />
                        Ver mais @HiddenActivityCount atividades
                    </button>
                }
            }
        </MudPaper>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string? _jobsError;
    private OperationalDashboardViewModel? _dashboard;
    private OperationalAlertSummaryViewModel? _alertSummary;
    private List<AccessBatchOperationViewModel> _jobs = [];
    private List<LicenseViewModel> _licenses = [];
    private readonly CancellationTokenSource _refreshCancellation = new();
    private string _jobFilter = "all";
    private bool _showAllJobs;
    private bool _showAllActivities;
    private bool _jobsBusy;
    private Guid? _busyJobId;
    private int AttentionCount => _alertSummary?.Active ?? 0;
    private int ActiveJobCount => _jobs.Count(x => x.Status is "Queued" or "Running");
    private int AttentionJobCount => _jobs.Count(x => x.Status is "CompletedWithErrors" or "Failed" or "DeadLetter");
    private int FinishedJobCount => _jobs.Count(x => x.Status is "Completed" or "Canceled");
    private IEnumerable<AccessBatchOperationViewModel> FilteredJobs => _jobFilter switch
    {
        "active" => _jobs.Where(x => x.Status is "Queued" or "Running"),
        "attention" => _jobs.Where(x => x.Status is "CompletedWithErrors" or "Failed" or "DeadLetter"),
        "completed" => _jobs.Where(x => x.Status is "Completed" or "Canceled"),
        _ => _jobs
    };
    private IEnumerable<AccessBatchOperationViewModel> VisibleJobs => _showAllJobs ? FilteredJobs : FilteredJobs.Take(4);
    private int HiddenJobCount => _showAllJobs ? 0 : Math.Max(0, FilteredJobs.Count() - 4);
    private IEnumerable<OperationalActivityViewModel> VisibleActivities => _showAllActivities
        ? _dashboard?.RecentActivities ?? []
        : (_dashboard?.RecentActivities ?? []).Take(6);
    private int HiddenActivityCount => _showAllActivities
        ? 0
        : Math.Max(0, (_dashboard?.RecentActivities.Count ?? 0) - 6);
    private string AccessRateHint => _dashboard?.AccessEventCount > 0
        ? $"{_dashboard.AuthorizationRate:N1}% autorizados"
        : "Sem eventos no período";
    private int TrendMaximum => Math.Max(1, _dashboard?.AccessTrend.Max(x => Math.Max(x.Authorized, x.Denied)) ?? 1);
    private bool HasAccessTrend => _dashboard?.AccessTrend.Any(x => x.Authorized > 0 || x.Denied > 0) == true;

    protected override async Task OnInitializedAsync()
    {
        var cancellationToken = _refreshCancellation.Token;
        await LoadAsync();
        if (!cancellationToken.IsCancellationRequested)
            _ = AutoRefreshAsync(cancellationToken);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var dashboardTask = Api.GetOperationalDashboardAsync();
        var alertsTask = Api.GetOperationalAlertSummaryAsync();
        var jobsTask = Api.GetOperationalAccessJobsAsync(take: 50);
        var licensesTask = Api.GetLicensesAsync();
        await Task.WhenAll(dashboardTask, alertsTask, jobsTask, licensesTask);
        var result = await dashboardTask;
        var alerts = await alertsTask;
        var jobs = await jobsTask;
        var licenses = await licensesTask;
        _loading = false;
        if (result.Success)
            _dashboard = result.Value;
        else
            _error = result.Error;
        if (alerts.Success)
            _alertSummary = alerts.Value;
        if (jobs.Success)
            _jobs = jobs.Value ?? [];
        else
            _jobsError = jobs.Error;
        if (licenses.Success)
            _licenses = licenses.Value ?? [];
    }

    private string LicenseTarget(Guid licenseId)
    {
        var license = _licenses.FirstOrDefault(x => Guid.TryParse(x.Id, out var id) && id == licenseId);
        return license is null ? LicenseRoutes.Legacy(licenseId) : LicenseRoutes.Workspace(license);
    }

    private async Task RefreshJobsAsync()
    {
        if (_jobsBusy) return;
        _jobsBusy = true;
        _jobsError = null;
        try
        {
            var result = await Api.GetOperationalAccessJobsAsync(take: 50);
            if (result.Success)
                _jobs = result.Value ?? [];
            else
                _jobsError = result.Error;
        }
        finally
        {
            _jobsBusy = false;
        }
    }

    private async Task AutoRefreshAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (!_loading && !_jobsBusy)
                    {
                        await RefreshJobsAsync();
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task CancelJobAsync(AccessBatchOperationViewModel job)
    {
        _busyJobId = job.Id;
        var result = await Api.CancelReconciliationBatchAsync(job.LicenseId, job.Id);
        _busyJobId = null;
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível cancelar o processamento.", Severity.Error); return; }
        Snackbar.Add("Processamento cancelado.", Severity.Info);
        await RefreshJobsAsync();
    }

    private async Task RetryJobAsync(AccessBatchOperationViewModel job)
    {
        _busyJobId = job.Id;
        var result = await Api.RetryReconciliationBatchAsync(job.LicenseId, job.Id);
        _busyJobId = null;
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível reprocessar as pendências.", Severity.Error); return; }
        Snackbar.Add("Pendências reenviadas para processamento.", Severity.Success);
        await RefreshJobsAsync();
    }

    private async Task CancelItemAsync(AccessBatchOperationViewModel job, AccessOperationItemViewModel item)
    {
        _busyJobId = job.Id;
        var result = await Api.CancelReconciliationItemAsync(job.LicenseId, job.Id, item.Id);
        _busyJobId = null;
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível cancelar o item.", Severity.Error); return; }
        Snackbar.Add("Item removido das próximas tentativas.", Severity.Info);
        await RefreshJobsAsync();
    }

    private async Task RetryItemAsync(AccessBatchOperationViewModel job, AccessOperationItemViewModel item)
    {
        _busyJobId = job.Id;
        var result = await Api.RetryReconciliationItemAsync(job.LicenseId, job.Id, item.Id);
        _busyJobId = null;
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível reprocessar o item.", Severity.Error); return; }
        Snackbar.Add("Item reenviado para processamento.", Severity.Success);
        await RefreshJobsAsync();
    }

    private void SetJobFilter(string filter)
    {
        _jobFilter = filter;
        _showAllJobs = false;
    }

    private void ShowAllJobs() => _showAllJobs = true;
    private void ShowAllActivities() => _showAllActivities = true;
    private bool IsJobBusy(AccessBatchOperationViewModel job) => _busyJobId == job.Id;
    private static bool CanCancelJob(string status) => status is "Queued" or "Running";
    private static bool CanRetryJob(string status) => status is "CompletedWithErrors" or "Failed" or "DeadLetter";
    private static bool CanCancelItem(string status) => status is "Queued" or "WaitingDevice" or "Failed";
    private static bool CanRetryItem(string status) => status is "WaitingDevice" or "Failed" or "DeadLetter";
    private static int PendingItemCount(AccessBatchOperationViewModel job) => job.Items.Count(x => x.Status is "Queued" or "Running" or "WaitingDevice" or "Failed");
    private static int DeviceCount(AccessBatchOperationViewModel job) => job.Items.Select(x => x.DeviceId).Distinct().Count();
    private static double JobProgress(AccessBatchOperationViewModel job) => job.TotalItems <= 0 ? 0 : Math.Clamp(job.ProcessedItems * 100d / job.TotalItems, 0, 100);
    private static IEnumerable<IGrouping<(Guid? Id, string Name), AccessOperationItemViewModel>> JobDevices(AccessBatchOperationViewModel job) => job.Items
        .GroupBy(x => (Id: x.DeviceId, Name: string.IsNullOrWhiteSpace(x.DeviceName) ? "Equipamento não identificado" : x.DeviceName))
        .OrderBy(x => x.Key.Name);
    private static double DeviceProgress(IEnumerable<AccessOperationItemViewModel> items)
    {
        var list = items as ICollection<AccessOperationItemViewModel> ?? items.ToList();
        return list.Count == 0 ? 0 : list.Count(x => x.Status is "Completed" or "Canceled" or "DeadLetter") * 100d / list.Count;
    }
    private static Color DeviceColor(IEnumerable<AccessOperationItemViewModel> items) => items.Any(x => x.Status is "Failed" or "DeadLetter") ? Color.Error : items.Any(x => x.Status == "WaitingDevice") ? Color.Warning : Color.Success;
    private static int ItemPriority(string status) => status switch { "DeadLetter" => 5, "Failed" => 4, "WaitingDevice" => 3, "Running" => 2, "Queued" => 1, _ => 0 };
    private static string JobTone(string status) => status switch { "Completed" => "success", "CompletedWithErrors" or "WaitingDevice" => "warning", "Failed" or "DeadLetter" => "error", "Running" => "running", "Canceled" => "neutral", _ => "queued" };
    private static string JobIcon(string status) => status switch { "Completed" => Icons.Material.Outlined.CheckCircle, "CompletedWithErrors" => Icons.Material.Outlined.WarningAmber, "Failed" or "DeadLetter" => Icons.Material.Outlined.ReportProblem, "Running" => Icons.Material.Outlined.Sync, "Canceled" => Icons.Material.Outlined.Cancel, _ => Icons.Material.Outlined.Schedule };
    private static string ItemIcon(string status) => status switch { "Completed" => Icons.Material.Outlined.CheckCircle, "Running" => Icons.Material.Outlined.Sync, "WaitingDevice" => Icons.Material.Outlined.CloudOff, "Failed" or "DeadLetter" => Icons.Material.Outlined.Error, "Canceled" => Icons.Material.Outlined.Cancel, _ => Icons.Material.Outlined.Schedule };
    private static Color JobColor(string status) => status switch { "Completed" => Color.Success, "CompletedWithErrors" => Color.Warning, "Failed" or "DeadLetter" => Color.Error, "Running" => Color.Info, _ => Color.Default };
    private static Color ItemColor(string status) => status switch { "Completed" => Color.Success, "Running" => Color.Info, "WaitingDevice" => Color.Warning, "Failed" or "DeadLetter" => Color.Error, _ => Color.Default };
    private static string JobStatusLabel(string status) => status switch { "Completed" => "Concluída", "CompletedWithErrors" => "Concluída com pendências", "Failed" => "Falhou", "DeadLetter" => "Requer intervenção", "Running" => "Executando", "Canceled" => "Cancelada", _ => "Na fila" };
    private static string ItemStatusLabel(string status) => status switch { "Completed" => "Concluído", "Running" => "Executando", "WaitingDevice" => "Aguardando terminal", "Failed" => "Falhou", "DeadLetter" => "Intervenção", "Canceled" => "Cancelado", _ => "Na fila" };
