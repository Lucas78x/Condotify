@page "/condominios/{LicenseUrlKey}"
@page "/condominios/{LicenseUrlKey}/{Section}"
@attribute [Authorize]
@inject CondotifyApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(_license?.Name ?? "Condomínio") | F&amp;F Access</PageTitle>

@if (_loading)
{
    <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
}
else if (_license is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@(_error ?? "Licença não encontrada.")</MudAlert>
}
else
{
    <nav class="workspace-breadcrumbs" aria-label="Navegação estrutural">
        <a href="/licencas">Condomínios</a>
        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
        <span>@_license.Name</span>
    </nav>

    <section class="@WorkspaceHeroCss">
        <div class="workspace-hero-top">
            <div class="workspace-hero-copy">
                <span class="workspace-property-mark" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.Apartment" />
                </span>
                <div class="workspace-hero-copy-text">
                    <MudText Typo="Typo.overline" Class="workspace-eyebrow">AMBIENTE DO CONDOMÍNIO</MudText>
                    <MudText Typo="Typo.h1" HtmlTag="h1" Class="workspace-title">@_license.Name</MudText>
                    <div class="workspace-metadata">
                        <span>@_license.Code</span>
                        <span aria-hidden="true">•</span>
                        <span>@LocationLabel</span>
                        <span aria-hidden="true">•</span>
                        <span>Válido até @_license.ExpireDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
            <div class="workspace-hero-controls">
                <div class="workspace-hero-status">
                    <MudChip T="string" Color="@(_license.IsExpired ? Color.Error : Color.Success)" Variant="Variant.Outlined" Icon="@(_license.IsExpired ? Icons.Material.Outlined.EventBusy : Icons.Material.Outlined.Verified)">@_license.Status</MudChip>
                    <MudButton Href="/licencas" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack">Condomínios</MudButton>
                </div>
                <div class="workspace-hero-actions">
                    @if (Has(LicensePermission.ViewStructure))
                    {
                        <MudButton Href="@WorkspaceUrl("estrutura")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AutoAwesome">@(_license.TotalBlocks == 0 ? "Configurar condomínio" : "Abrir estrutura")</MudButton>
                    }
                    @if (AdministracaoVisible)
                    {
                        <MudButton Href="@WorkspaceUrl("administracao")" Variant="Variant.Outlined" Color="@(CurrentSection == "administracao" ? Color.Primary : Color.Default)" StartIcon="@Icons.Material.Outlined.Tune">Administrar</MudButton>
                    }
                </div>
            </div>
        </div>

        <nav class="workspace-area-nav" aria-label="Áreas do condomínio">
            @foreach (var area in VisibleAreas)
            {
                <button type="button" class="@AreaCss(area)" aria-current="@(IsAreaActive(area) ? "page" : null)" @onclick="@(() => NavigateToArea(area))">
                    <span class="workspace-area-icon" aria-hidden="true">
                        <MudIcon Icon="@area.Icon" Size="Size.Small" />
                    </span>
                    <span class="workspace-area-label">@area.Label</span>
                </button>
            }
        </nav>

        @if (CurrentAreaTabs.Count > 1)
        {
            <nav class="workspace-subnav" aria-label="Módulos de @CurrentArea?.Label">
                @foreach (var tab in CurrentAreaTabs)
                {
                    <button type="button" class="@(CurrentSection == tab.Section ? "workspace-subnav-item is-active" : "workspace-subnav-item")" aria-current="@(CurrentSection == tab.Section ? "page" : null)" @onclick="@(() => NavigateTo(tab.Section))">
                        <MudIcon Icon="@tab.Icon" Size="Size.Small" />
                        <span>@tab.Label</span>
                    </button>
                }
            </nav>
        }
    </section>

    @if (!IsModuleEnabled(ModuleFor(CurrentSection)))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.ToggleOff">Este módulo está desativado neste condomínio. Os dados permanecem preservados e voltarão a aparecer quando ele for reativado.</MudAlert>
    }
    else if (!SectionAllowed(CurrentSection))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Lock">Seu perfil não possui permissão para acessar este módulo.</MudAlert>
    }
    else
    {
        @switch (CurrentSection)
        {
            case "relatorios":
                <ReportsModule LicenseId="LicenseId" LicenseUrlKey="@_license.UrlKey" />
                break;
            case "equipamentos":
                <DevicesModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageDevices)" CanOperate="@Has(LicensePermission.OperateDevices)" />
                break;
            case "cameras":
                <CamerasModule LicenseId="LicenseId" LicenseUrlKey="@_license.UrlKey" CanManage="@Has(LicensePermission.ManageDevices)" CanOperate="@Has(LicensePermission.OperateDevices)" />
                break;
            case "rotas":
                <AccessRoutesModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageDevices)" />
                break;
            case "estrutura":
                <StructureModule LicenseId="LicenseId" ActiveSection="estrutura" CanViewPeople="@Has(LicensePermission.ViewPeople)" CanManageStructure="@Has(LicensePermission.ManageStructure)" CanManagePeople="@Has(LicensePermission.ManagePeople)" CanManageCredentials="@Has(LicensePermission.ManageCredentials)" CanManageDevices="@Has(LicensePermission.ManageDevices)" />
                break;
            case "agendamento":
                <AgendamentoModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageBookings)" />
                break;
            case "comunicados":
                <AnnouncementsModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageAnnouncements)" />
                break;
            case "assembleias":
                <AssembliesModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageAssemblies)" />
                break;
            case "boletos":
                <BoletosModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageFinance)" />
                break;
            case "financeiro":
                <FinancialManagementModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageFinance)" />
                break;
            case "documentos":
                <DocumentsModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageDocuments)" />
                break;
            case "credenciais":
                <CredentialsModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageCredentials)" />
                break;
            case "ocorrencias":
                <IncidentsModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageIncidents)" />
                break;
            case "automacoes":
                <AutomationsModule LicenseId="LicenseId" CanManage="@Has(LicensePermission.ManageAutomations)" />
                break;
            case "emergencia":
                <EmergencyModule LicenseId="LicenseId" LicenseUrlKey="@_license.UrlKey" LicenseCode="@_license.Code" CanManage="@Has(LicensePermission.ManageEmergency)" />
                break;
            case "administracao":
                <AdministrationModule LicenseId="LicenseId" InitialData="_administration" EnabledModules="_license.EnabledModules" OnModulesChanged="@(value => _license.EnabledModules = value)" />
                break;
            default:
                <OverviewModule License="_license" LicenseId="LicenseId" LicenseUrlKey="@_license.UrlKey" CanViewDocuments="@(Has(LicensePermission.ViewDocuments) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Documents))" />
                break;
        }
    }
}

@code {
    [Parameter] public string LicenseUrlKey { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }

    private Guid LicenseId => _license?.Id ?? Guid.Empty;

    private sealed record WorkspaceTab(string Section, string Label, string Icon, LicensePermission Permission, Condotify.Models.LicenseModuleEnum? Module = null);
    private sealed record WorkspaceArea(string Label, string Icon, WorkspaceTab[] Tabs);

    private static readonly WorkspaceArea[] WorkspaceAreas =
    [
        new("Visão geral", Icons.Material.Outlined.Dashboard, [
            new("visao-geral", "Visão geral", Icons.Material.Outlined.Dashboard, LicensePermission.ViewDashboard),
            new("relatorios", "Relatórios", Icons.Material.Outlined.Insights, LicensePermission.ViewDashboard),
        ]),
        new("Estrutura", Icons.Material.Outlined.AccountTree, [
            new("estrutura", "Estrutura", Icons.Material.Outlined.AccountTree, LicensePermission.ViewStructure),
        ]),
        new("Acessos", Icons.Material.Outlined.Fingerprint, [
            new("credenciais", "Credenciais", Icons.Material.Outlined.Badge, LicensePermission.ViewCredentials),
            new("equipamentos", "Equipamentos", Icons.Material.Outlined.Sensors, LicensePermission.ViewDevices, Condotify.Models.LicenseModuleEnum.Devices),
            new("rotas", "Rotas", Icons.Material.Outlined.AltRoute, LicensePermission.ViewDevices, Condotify.Models.LicenseModuleEnum.Routes),
        ]),
        new("Segurança", Icons.Material.Outlined.Shield, [
            new("cameras", "Câmeras", Icons.Material.Outlined.Videocam, LicensePermission.ViewDevices, Condotify.Models.LicenseModuleEnum.Cameras),
            new("ocorrencias", "Manutenção", Icons.Material.Outlined.HomeRepairService, LicensePermission.ViewIncidents, Condotify.Models.LicenseModuleEnum.Incidents),
            new("automacoes", "Automações", Icons.Material.Outlined.AutoAwesome, LicensePermission.ViewAutomations, Condotify.Models.LicenseModuleEnum.Automations),
            new("emergencia", "Emergência", Icons.Material.Outlined.HealthAndSafety, LicensePermission.ViewEmergency, Condotify.Models.LicenseModuleEnum.Emergency),
        ]),
        new("Comunidade", Icons.Material.Outlined.Forum, [
            new("agendamento", "Agendamento", Icons.Material.Outlined.Deck, LicensePermission.ViewBookings, Condotify.Models.LicenseModuleEnum.Bookings),
            new("comunicados", "Comunicados", Icons.Material.Outlined.Campaign, LicensePermission.ManageAnnouncements, Condotify.Models.LicenseModuleEnum.Announcements),
            new("assembleias", "Assembleias", Icons.Material.Outlined.HowToVote, LicensePermission.ViewAssemblies, Condotify.Models.LicenseModuleEnum.Assemblies),
        ]),
        new("Financeiro", Icons.Material.Outlined.AccountBalanceWallet, [
            new("financeiro", "Gestão", Icons.Material.Outlined.AccountBalanceWallet, LicensePermission.ViewFinance, Condotify.Models.LicenseModuleEnum.Finance),
            new("boletos", "Boletos", Icons.Material.Outlined.ReceiptLong, LicensePermission.ViewFinance, Condotify.Models.LicenseModuleEnum.Finance),
            new("documentos", "Documentos", Icons.Material.Outlined.Description, LicensePermission.ViewDocuments, Condotify.Models.LicenseModuleEnum.Documents),
        ]),
    ];

    private bool _loading = true;
    private string? _error;
    private LicenseFullViewModel? _license;
    private LicenseAdministrationViewModel? _administration;
    private string CurrentSection => string.IsNullOrWhiteSpace(Section)
        ? DefaultSection
        : Section.ToLowerInvariant() is "blocos" or "unidades" or "moradores" ? "estrutura" : Section.ToLowerInvariant();
    private string DefaultSection => Has(LicensePermission.ViewDashboard) ? "visao-geral"
        : Has(LicensePermission.ViewStructure) ? "estrutura"
        : Has(LicensePermission.ViewDevices) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Devices) ? "equipamentos"
        : Has(LicensePermission.ViewDevices) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Cameras) ? "cameras"
        : Has(LicensePermission.ViewDevices) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Routes) ? "rotas"
        : Has(LicensePermission.ViewCredentials) ? "credenciais"
        : Has(LicensePermission.ViewIncidents) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Incidents) ? "ocorrencias"
        : Has(LicensePermission.ViewAutomations) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Automations) ? "automacoes"
        : Has(LicensePermission.ViewEmergency) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Emergency) ? "emergencia"
        : Has(LicensePermission.ViewBookings) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Bookings) ? "agendamento"
        : Has(LicensePermission.ViewFinance) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Finance) ? "financeiro"
        : Has(LicensePermission.ViewDocuments) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Documents) ? "documentos"
        : Has(LicensePermission.ManageAnnouncements) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Announcements) ? "comunicados"
        : Has(LicensePermission.ViewAssemblies) && IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Assemblies) ? "assembleias"
        : Has(LicensePermission.ViewUsers) || Has(LicensePermission.ViewSettings) || Has(LicensePermission.ViewBackups) ? "administracao"
        : "sem-acesso";

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_license?.UrlKey, LicenseUrlKey, StringComparison.OrdinalIgnoreCase)) return;
        _loading = true;
        _error = null;
        _license = null;
        _administration = null;
        var result = await Api.GetLicenseByUrlKeyAsync(LicenseUrlKey);
        ApiResult<LicenseAdministrationViewModel>? administration = null;
        if (result.Success && result.Value is not null)
            administration = await Api.GetLicenseAdministrationAsync(result.Value.Id);
        _loading = false;
        if (result.Success) _license = result.Value;
        else _error = result.Error;
        if (administration?.Success == true) _administration = administration.Value;

        if (_license is not null && !string.Equals(LicenseUrlKey, _license.UrlKey, StringComparison.Ordinal))
            Navigation.NavigateTo(LicenseRoutes.Workspace(_license.UrlKey, Section), replace: true);
    }

    private bool Has(LicensePermission permission) => _administration?.CurrentAccess.Has(permission) == true;

    private bool IsModuleEnabled(Condotify.Models.LicenseModuleEnum? module) =>
        module is null || (_license?.EnabledModules & (long)module.Value) != 0;

    private bool AdministracaoVisible =>
        Has(LicensePermission.ViewUsers) || Has(LicensePermission.ViewSettings) ||
        Has(LicensePermission.ViewBackups);

    private string LocationLabel => string.IsNullOrWhiteSpace(_license?.City)
        ? "Localização não informada"
        : string.IsNullOrWhiteSpace(_license.State) ? _license.City : $"{_license.City}, {_license.State}";

    private IEnumerable<WorkspaceArea> VisibleAreas => WorkspaceAreas.Where(area => VisibleTabs(area).Count > 0);

    private WorkspaceArea? CurrentArea => WorkspaceAreas.FirstOrDefault(IsAreaActive);

    private string WorkspaceHeroCss => CurrentSection == "visao-geral"
        ? "workspace-hero"
        : "workspace-hero workspace-hero-compact";

    private IReadOnlyList<WorkspaceTab> CurrentAreaTabs => CurrentArea is null ? [] : VisibleTabs(CurrentArea);

    private IReadOnlyList<WorkspaceTab> VisibleTabs(WorkspaceArea area) => area.Tabs
        .Where(tab => Has(tab.Permission) && IsModuleEnabled(tab.Module))
        .ToList();

    private bool IsAreaActive(WorkspaceArea area) => area.Tabs.Any(tab => tab.Section == CurrentSection);

    private string AreaCss(WorkspaceArea area) => IsAreaActive(area)
        ? "workspace-area-item is-active"
        : "workspace-area-item";

    private void NavigateToArea(WorkspaceArea area)
    {
        var target = VisibleTabs(area).FirstOrDefault()?.Section;
        if (!string.IsNullOrWhiteSpace(target)) NavigateTo(target);
    }

    private string WorkspaceUrl(string? section = null) => LicenseRoutes.Workspace(_license?.UrlKey ?? LicenseUrlKey, section);

    private void NavigateTo(string section) => Navigation.NavigateTo(WorkspaceUrl(section));

    private bool SectionAllowed(string section) => IsModuleEnabled(ModuleFor(section)) && section switch
    {
        "visao-geral" or "relatorios" => Has(LicensePermission.ViewDashboard),
        "equipamentos" or "rotas" or "cameras" => Has(LicensePermission.ViewDevices),
        "estrutura" => Has(LicensePermission.ViewStructure),
        "credenciais" => Has(LicensePermission.ViewCredentials),
        "ocorrencias" => Has(LicensePermission.ViewIncidents),
        "automacoes" => Has(LicensePermission.ViewAutomations),
        "emergencia" => Has(LicensePermission.ViewEmergency),
        "agendamento" => Has(LicensePermission.ViewBookings),
        "financeiro" or "boletos" => Has(LicensePermission.ViewFinance),
        "documentos" => Has(LicensePermission.ViewDocuments),
        "comunicados" => Has(LicensePermission.ManageAnnouncements),
        "assembleias" => Has(LicensePermission.ViewAssemblies),
        "administracao" => Has(LicensePermission.ViewUsers) || Has(LicensePermission.ViewSettings) || Has(LicensePermission.ViewBackups),
        _ => false
    };

    private static Condotify.Models.LicenseModuleEnum? ModuleFor(string section) => section switch
    {
        "cameras" => Condotify.Models.LicenseModuleEnum.Cameras,
        "equipamentos" => Condotify.Models.LicenseModuleEnum.Devices,
        "rotas" => Condotify.Models.LicenseModuleEnum.Routes,
        "ocorrencias" => Condotify.Models.LicenseModuleEnum.Incidents,
        "automacoes" => Condotify.Models.LicenseModuleEnum.Automations,
        "emergencia" => Condotify.Models.LicenseModuleEnum.Emergency,
        "agendamento" => Condotify.Models.LicenseModuleEnum.Bookings,
        "financeiro" or "boletos" => Condotify.Models.LicenseModuleEnum.Finance,
        "documentos" => Condotify.Models.LicenseModuleEnum.Documents,
        "comunicados" => Condotify.Models.LicenseModuleEnum.Announcements,
        "assembleias" => Condotify.Models.LicenseModuleEnum.Assemblies,
        _ => null
    };
}
