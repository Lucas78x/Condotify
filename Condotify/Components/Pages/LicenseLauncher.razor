@page "/cadastros"
@page "/credenciais"
@page "/equipamentos"
@attribute [Authorize]
@inject CondotifyApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Title | F&amp;F Access</PageTitle>

<PageHeader Title="@Title" Subtitle="@Subtitle" Eyebrow="ACESSO RÁPIDO" />

<MudPaper Class="content-panel" Elevation="0">
    <div class="panel-toolbar launcher-toolbar">
        <div><MudText Typo="Typo.h6" Class="panel-title">Selecione um condomínio</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">A seleção mantém cada operação no ambiente correto.</MudText></div>
        <MudTextField T="string" @bind-Value="_search" Immediate Placeholder="Filtrar por nome, código ou cidade" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
    </div>
    @if (_loading)
    {
        <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="panel-body"><MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert></div>
    }
    else if (!Filtered.Any())
    {
        <div class="empty-state compact-empty"><MudIcon Icon="@Icons.Material.Outlined.DomainDisabled" Size="Size.Large" Color="Color.Primary" /><MudText Typo="Typo.subtitle1">Nenhum condomínio encontrado</MudText></div>
    }
    else
    {
        <div class="launcher-list">
            @foreach (var license in Filtered)
            {
                <a class="launcher-row" href="@Target(license)">
                    <span class="license-monogram">@Monogram(license.Nome)</span>
                    <span class="launcher-code">@license.Codigo</span>
                    <span class="launcher-name">@license.Nome</span>
                    <span class="launcher-residents"><MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Small" /> @license.Moradores moradores</span>
                    <span class="launcher-location"><MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" /> @Location(license)</span>
                    <span class="launcher-arrow"><MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></span>
                </a>
            }
        </div>
    }
</MudPaper>

@code {
    private List<LicenseViewModel> _licenses = [];
    private string _search = string.Empty;
    private string? _error;
    private bool _loading = true;
    private string Mode => new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    private string Title => Mode switch { "credenciais" => "Credenciais", "equipamentos" => "Equipamentos", _ => "Cadastros" };
    private string Subtitle => Mode switch { "credenciais" => "Gerencie identificadores e sincronização com os equipamentos.", "equipamentos" => "Configure terminais, conexões e acionamentos de cada condomínio.", _ => "Administre blocos, unidades e moradores." };
    private string Section => Mode switch { "credenciais" => "credenciais", "equipamentos" => "equipamentos", _ => "moradores" };
    private IEnumerable<LicenseViewModel> Filtered => string.IsNullOrWhiteSpace(_search) ? _licenses : _licenses.Where(x => $"{x.Nome} {x.Codigo} {x.Cidade} {x.Estado}".Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetLicensesAsync(); _loading = false;
        if (result.Success) _licenses = result.Value ?? []; else _error = result.Error;
    }
    private string Target(LicenseViewModel license) => LicenseRoutes.Workspace(license, Section);
    private static string Location(LicenseViewModel license) => string.IsNullOrWhiteSpace(license.Cidade) ? "Localização não informada" : $"{license.Cidade}{(string.IsNullOrWhiteSpace(license.Estado) ? string.Empty : $" - {license.Estado}")}";
    private static string Monogram(string name) => string.IsNullOrWhiteSpace(name) ? "C" : name.Trim()[0].ToString().ToUpperInvariant();
}
