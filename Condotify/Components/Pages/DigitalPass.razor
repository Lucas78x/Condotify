@page "/passe/{Token}"
@attribute [AllowAnonymous]
@layout PublicLayout
@inject CondotifyApiClient Api
@inject IJSRuntime Js

<PageTitle>Passe digital | Condotify</PageTitle>

<main class="public-pass-page">
    @if (_loading)
    {
        <div class="public-pass-loading"><BrandMark Compact="true" /><MudProgressCircular Indeterminate Color="Color.Primary" /><span>Validando autorização...</span></div>
    }
    else if (_pass is null)
    {
        <MudPaper Class="public-pass-invalid" Elevation="0"><BrandMark Compact="true" /><span><MudIcon Icon="@Icons.Material.Outlined.LinkOff" /></span><MudText Typo="Typo.h5">Passe indisponível</MudText><MudText Typo="Typo.body2">@(_error ?? "Este passe não existe, expirou ou foi revogado.")</MudText></MudPaper>
    }
    else
    {
        <article class="public-pass-card">
            <header><BrandMark Compact="true" /><span class="public-pass-valid"><i></i> AUTORIZAÇÃO VÁLIDA</span></header>
            <div class="public-pass-hero"><span>ACESSO DE VISITANTE</span><h1>@_pass.VisitorName</h1><p>@_pass.LicenseName</p></div>
            <div class="public-pass-qr"><img src="@QrCodeRenderer.ToPngDataUri(_pass.CredentialCode)" alt="QR Code de acesso" /><span>Apresente este código no leitor da portaria</span><code>@_pass.CredentialCode</code></div>
            <dl><div><dt>Anfitrião</dt><dd>@_pass.HostName</dd></div><div><dt>Destino</dt><dd>@_pass.UnitLabel</dd></div><div><dt>Motivo</dt><dd>@(string.IsNullOrWhiteSpace(_pass.Purpose) ? "Visita" : _pass.Purpose)</dd></div><div><dt>Válido de</dt><dd>@_pass.ValidFrom.ToLocalTime().ToString("dd/MM HH:mm")</dd></div><div><dt>Válido até</dt><dd>@_pass.ValidTo.ToLocalTime().ToString("dd/MM HH:mm")</dd></div></dl>
            <div class="public-pass-wallets">@if (_pass.GoogleWalletConfigured) { <MudButton Href="@_pass.GoogleWalletUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Outlined.Wallet">Adicionar ao Google Wallet</MudButton> }@if (_pass.AppleWalletConfigured) { <MudButton Href="@_pass.AppleWalletUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Outlined.PhoneIphone">Adicionar ao Apple Wallet</MudButton> }<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyAsync">Copiar código</MudButton></div>
            <footer><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /><span>Este passe é pessoal, temporário e protegido por um link aleatório. Não compartilhe fora da visita.</span></footer>
        </article>
    }
</main>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    private DigitalPassViewModel? _pass; private bool _loading = true; private string? _error;
    protected override async Task OnParametersSetAsync() { _loading = true; var result = await Api.GetPublicDigitalPassAsync(Token); _loading = false; if (result.Success) _pass = result.Value; else _error = result.Error; }
    private async Task CopyAsync() { if (_pass is not null) await Js.InvokeVoidAsync("navigator.clipboard.writeText", _pass.CredentialCode); }
}
