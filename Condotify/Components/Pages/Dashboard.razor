@page "/"
@page "/Home/Index"
@attribute [Authorize]
@inject CondotifyApiClient Api

<PageTitle>Visão geral | F&amp;F Access</PageTitle>

<PageHeader Title="Visão geral" Subtitle="Acompanhe a operação dos seus condomínios em um único lugar." Eyebrow="PAINEL OPERACIONAL">
    <Actions>
        <MudButton Href="/operacoes" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.MonitorHeart">Central de operações</MudButton>
        <AuthorizeView Context="dashboardAuth">
            <Authorized>
                @if (CanCreateLicense(dashboardAuth.User))
                {
                    <MudButton Href="/licencas/nova" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddBusiness">Nova licença</MudButton>
                }
            </Authorized>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="dashboard-skeleton">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="86px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="330px" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_operationsError))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense Class="dashboard-telemetry-alert">
            Os dados de monitoramento estão temporariamente indisponíveis. Os condomínios continuam acessíveis normalmente.
        </MudAlert>
    }

    <div class="stats-grid">
        <StatTile Label="Condomínios" Value="@_licenses.Count.ToString()" Icon="@Icons.Material.Outlined.Domain" Hint="ambientes administrados" Tone="blue" />
        <StatTile Label="Moradores" Value="@(_operations?.ResidentCount.ToString() ?? _licenses.Sum(x => x.Moradores).ToString())" Icon="@Icons.Material.Outlined.Groups" Hint="pessoas vinculadas" Tone="green" />
        <StatTile Label="Equipamentos" Value="@($"{_operations?.OnlineDeviceCount ?? 0}/{_operations?.DeviceCount ?? 0}")" Icon="@Icons.Material.Outlined.Sensors" Hint="terminais online" Tone="amber" />
        <StatTile Label="Atenção" Value="@AttentionCount.ToString()" Icon="@Icons.Material.Outlined.NotificationImportant" Hint="pendências prioritárias" Tone="red" />
    </div>

    <div class="dashboard-pulse-strip">
        <div>
            <span class="pulse-icon green"><MudIcon Icon="@Icons.Material.Outlined.Sync" /></span>
            <span><strong>@(_operations?.SynchronizationRate.ToString("N1") ?? "100,0")%</strong><small>Credenciais sincronizadas</small></span>
        </div>
        <div>
            <span class="pulse-icon blue"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" /></span>
            <span><strong>@(_operations?.Last24HourAccessCount ?? 0)</strong><small>Acessos nas últimas 24 horas</small></span>
        </div>
        <div>
            <span class="pulse-icon violet"><MudIcon Icon="@Icons.Material.Outlined.EventAvailable" /></span>
            <span><strong>@(_operations?.TodayBookingCount ?? 0)</strong><small>Reservas para hoje</small></span>
        </div>
        <div>
            <span class="pulse-icon amber"><MudIcon Icon="@Icons.Material.Outlined.PendingActions" /></span>
            <span><strong>@((_operations?.PendingBatchCount ?? 0) + (_operations?.PendingBookingCount ?? 0))</strong><small>Itens aguardando processamento</small></span>
        </div>
    </div>

    <div class="dashboard-main-grid">
        <MudPaper Class="content-panel" Elevation="0">
            <div class="panel-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Condomínios recentes</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Acesso rápido aos ambientes administrados</MudText>
                </div>
                <MudButton Href="/licencas" Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.ArrowForward">Ver todos</MudButton>
            </div>
            @if (_licenses.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.DomainAdd" Title="Nenhum condomínio cadastrado" Description="Cadastre o primeiro ambiente para iniciar a operação.">
                    <Action><MudButton Href="/licencas/nova" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddBusiness">Cadastrar condomínio</MudButton></Action>
                </EmptyState>
            }
            else
            {
                <div class="dashboard-license-list">
                    @foreach (var license in _licenses.Take(6))
                    {
                        <a href="@LicenseRoutes.Workspace(license)" class="dashboard-license-row">
                            <span class="license-monogram">@Monogram(license.Nome)</span>
                            <span class="license-meta">
                                <span class="license-title">@license.Nome</span>
                                <span class="license-code">@license.Codigo · @Location(license)</span>
                            </span>
                            <span class="dashboard-license-residents"><strong>@license.Moradores</strong><small>moradores</small></span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                        </a>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Class="content-panel dashboard-attention-panel" Elevation="0">
            <div class="panel-toolbar">
                <div>
                    <MudText Typo="Typo.h5" Class="panel-title">Precisa de atenção</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Prioridades identificadas automaticamente</MudText>
                </div>
                <MudButton Href="/operacoes" Variant="Variant.Text">Abrir central</MudButton>
            </div>
            @if (_operations?.Alerts.Count > 0)
            {
                <div class="dashboard-alert-list">
                    @foreach (var alert in _operations.Alerts.Take(5))
                    {
                        <a href="@alert.TargetUrl" class="dashboard-alert-row @alert.Severity.ToLowerInvariant()">
                            <span><MudIcon Icon="@AlertIcon(alert.Type)" /></span>
                            <span><strong>@alert.Title</strong><small>@alert.Message</small></span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dashboard-all-clear">
                    <span><MudIcon Icon="@Icons.Material.Outlined.Verified" /></span>
                    <strong>Operação saudável</strong>
                    <small>Nenhuma pendência prioritária foi identificada.</small>
                </div>
            }
        </MudPaper>
    </div>

    <div class="dashboard-insight-grid">
        <section class="dashboard-access-panel" aria-labelledby="dashboard-access-title">
            <header>
                <div>
                    <span class="dashboard-section-kicker">MOVIMENTO</span>
                    <h2 id="dashboard-access-title">Acessos e recusas</h2>
                    <p>Comportamento dos últimos 14 dias e recorte das últimas 24 horas.</p>
                </div>
                <div class="dashboard-access-summary">
                    <span><i class="authorized"></i><strong>@(_operations?.Last24HourAuthorizedCount ?? 0)</strong><small>autorizados</small></span>
                    <span><i class="denied"></i><strong>@(_operations?.Last24HourDeniedCount ?? 0)</strong><small>negados</small></span>
                </div>
            </header>
            @if (HasAccessTrend)
            {
                <div class="dashboard-access-chart" role="img" aria-label="Acessos autorizados e negados nos últimos 14 dias">
                    @foreach (var point in _operations!.AccessTrend)
                    {
                        <div class="dashboard-chart-column" title="@($"{point.Date:dd/MM}: {point.Authorized} autorizados e {point.Denied} negados")">
                            <div><span class="authorized" style="@ChartHeight(point.Authorized)"></span><span class="denied" style="@ChartHeight(point.Denied)"></span></div>
                            <small>@point.Date.ToString("dd/MM")</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <EmptyState Class="dashboard-chart-empty" Icon="@Icons.Material.Outlined.QueryStats" Title="O gráfico começa com o primeiro acesso" Description="As autorizações e recusas aparecerão aqui automaticamente." />
            }
        </section>

        <section class="dashboard-activity-panel" aria-labelledby="dashboard-activity-title">
            <header>
                <div><span class="dashboard-section-kicker">RASTREABILIDADE</span><h2 id="dashboard-activity-title">Atividade recente</h2></div>
                <MudTooltip Text="Abrir central de operações"><MudIconButton Href="/operacoes" Icon="@Icons.Material.Outlined.ArrowForward" aria-label="Abrir central de operações" /></MudTooltip>
            </header>
            @if (_operations?.RecentActivities.Count > 0)
            {
                <div class="dashboard-activity-list">
                    @foreach (var activity in _operations.RecentActivities.Take(6))
                    {
                        <a href="@LicenseTarget(activity.LicenseId)">
                            <StatusIndicator Tone="@ActivityTone(activity.Status)" />
                            <span><strong>@ActivityLabel(activity.Action)</strong><small>@activity.LicenseName · @activity.CreatedAt.ToCondotifyTime().ToString("dd/MM HH:mm")</small></span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                        </a>
                    }
                </div>
            }
            else
            {
                <EmptyState Class="dashboard-activity-empty" Icon="@Icons.Material.Outlined.History" Title="Nenhuma atividade recente" Description="As ações operacionais aparecerão aqui." />
            }
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string? _operationsError;
    private List<LicenseViewModel> _licenses = [];
    private OperationalDashboardViewModel? _operations;
    private int AttentionCount => _operations?.Alerts.Count(x => x.Severity is "Critical" or "Warning") ?? 0;
    private bool HasAccessTrend => _operations?.AccessTrend.Any(x => x.Authorized > 0 || x.Denied > 0) == true;
    private int TrendMaximum => Math.Max(1, _operations?.AccessTrend.Max(x => Math.Max(x.Authorized, x.Denied)) ?? 1);

    protected override async Task OnInitializedAsync()
    {
        var licensesTask = Api.GetLicensesAsync();
        var operationsTask = Api.GetOperationalDashboardAsync();
        await Task.WhenAll(licensesTask, operationsTask);

        var licenses = await licensesTask;
        var operations = await operationsTask;
        _loading = false;

        if (licenses.Success)
            _licenses = licenses.Value ?? [];
        else
            _error = licenses.Error;

        if (operations.Success)
            _operations = operations.Value;
        else
            _operationsError = operations.Error;
    }

    private static string Monogram(string name) =>
        string.IsNullOrWhiteSpace(name) ? "C" : name.Trim()[0].ToString().ToUpperInvariant();

    private static string Location(LicenseViewModel license) =>
        string.IsNullOrWhiteSpace(license.Cidade)
            ? "Localização não informada"
            : $"{license.Cidade}{(string.IsNullOrWhiteSpace(license.Estado) ? string.Empty : $" - {license.Estado}")}";

    private static bool CanCreateLicense(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("access_type")?.Value is "Admin" or "Developer";

    private string LicenseTarget(Guid licenseId)
    {
        var license = _licenses.FirstOrDefault(x => Guid.TryParse(x.Id, out var id) && id == licenseId);
        return license is null ? LicenseRoutes.Legacy(licenseId) : LicenseRoutes.Workspace(license);
    }

    private string ChartHeight(int value) => $"height:{Math.Max(value > 0 ? 7 : 0, value * 100d / TrendMaximum):0.#}%";

    private static string ActivityTone(string status) => status switch
    {
        "Success" or "Completed" => "operational",
        "Pending" or "Queued" or "Running" => "syncing",
        "Warning" or "CompletedWithErrors" => "attention",
        "Failed" or "Error" or "DeadLetter" => "failure",
        _ => "inactive"
    };

    private static string ActivityLabel(string action) => action switch
    {
        "OpenDoor" => "Porta acionada",
        "Inspect" => "Equipamento verificado",
        "Created" => "Cadastro criado",
        "Updated" => "Cadastro atualizado",
        "Activated" => "Credencial ativada",
        "Deactivated" => "Credencial suspensa",
        "Restore" => "Restauração solicitada",
        _ => "Operação registrada"
    };

    private static string AlertIcon(string type) => type switch
    {
        "DeviceOffline" => Icons.Material.Outlined.PortableWifiOff,
        "DeviceSlow" => Icons.Material.Outlined.Speed,
        "BatchFailure" => Icons.Material.Outlined.SyncProblem,
        "CredentialSyncFailure" => Icons.Material.Outlined.SyncProblem,
        "CredentialRemovalOffline" => Icons.Material.Outlined.PersonOff,
        "BackupFailure" => Icons.Material.Outlined.Backup,
        "BackupOverdue" => Icons.Material.Outlined.Schedule,
        "CredentialExpired" => Icons.Material.Outlined.Badge,
        "BookingApproval" => Icons.Material.Outlined.EventAvailable,
        _ => Icons.Material.Outlined.NotificationImportant
    };
}
