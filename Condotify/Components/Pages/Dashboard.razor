@page "/"
@page "/Home/Index"
@attribute [Authorize]
@inject CondotifyApiClient Api

<PageTitle>Visao geral | Condotify</PageTitle>

<PageHeader Title="Visao geral" Subtitle="Acompanhe a operacao dos seus condominios em um unico lugar." Eyebrow="PAINEL OPERACIONAL">
    <Actions>
        <MudButton Href="/licencas/nova" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddBusiness">Nova licenca</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="loading-state"><MudProgressCircular Indeterminate Color="Color.Primary" /></div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    <div class="stats-grid">
        <StatTile Label="Condominios" Value="@_licenses.Count.ToString()" Icon="@Icons.Material.Outlined.Domain" Hint="licencas cadastradas" Tone="blue" />
        <StatTile Label="Moradores" Value="@_licenses.Sum(x => x.Moradores).ToString()" Icon="@Icons.Material.Outlined.Groups" Hint="vinculados as unidades" Tone="green" />
        <StatTile Label="Cidades" Value="@_licenses.Select(x => x.Cidade).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count().ToString()" Icon="@Icons.Material.Outlined.LocationCity" Hint="operacoes ativas" Tone="amber" />
        <StatTile Label="Atencao" Value="0" Icon="@Icons.Material.Outlined.ReportProblem" Hint="nenhuma pendencia critica" Tone="red" />
    </div>

    <MudPaper Class="content-panel" Elevation="0">
        <div class="panel-toolbar">
            <div>
                <MudText Typo="Typo.h5" Class="panel-title">Condominios recentes</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Acesso rapido aos ambientes administrados</MudText>
            </div>
            <MudButton Href="/licencas" Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.ArrowForward">Ver todos</MudButton>
        </div>
        @if (_licenses.Count == 0)
        {
            <div class="panel-body">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Nenhuma licenca encontrada. Cadastre o primeiro condominio para iniciar a operacao.</MudAlert>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <MudTable Items="_licenses.Take(6)" Hover Dense Elevation="0">
                    <HeaderContent>
                        <MudTh>Condominio</MudTh><MudTh>Localizacao</MudTh><MudTh>Moradores</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Condominio">
                            <div class="license-name-cell">
                                <span class="license-monogram">@Monogram(context.Nome)</span>
                                <span class="license-meta"><span class="license-title">@context.Nome</span><span class="license-code">@context.Codigo</span></span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Localizacao">@context.Cidade @(!string.IsNullOrWhiteSpace(context.Estado) ? $"- {context.Estado}" : "")</MudTd>
                        <MudTd DataLabel="Moradores">@context.Moradores</MudTd>
                        <MudTd><MudIconButton Href="@($"/licencas/{context.Id}")" Icon="@Icons.Material.Outlined.ArrowForward" Color="Color.Primary" /></MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<LicenseViewModel> _licenses = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetLicensesAsync();
        _loading = false;
        if (result.Success)
            _licenses = result.Value ?? [];
        else
            _error = result.Error;
    }

    private static string Monogram(string name) => string.IsNullOrWhiteSpace(name) ? "C" : name.Trim()[0].ToString().ToUpperInvariant();
}
