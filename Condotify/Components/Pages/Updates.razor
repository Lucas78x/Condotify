@page "/atualizacoes"
@attribute [Authorize]
@using System.Reflection

<PageTitle>Atualizações | F&amp;F Access</PageTitle>

<div class="updates-page">
    <section class="updates-hero" aria-labelledby="updates-title">
        <div class="updates-hero-copy">
            <span class="updates-live-badge"><i aria-hidden="true"></i> F&amp;F Access @PlatformVersion</span>
            <MudText Typo="Typo.h1" HtmlTag="h1" id="updates-title" Class="updates-title">
                Novidades que deixam a rotina <span>mais simples.</span>
            </MudText>
            <MudText Typo="Typo.body1" Class="updates-subtitle">
                Acompanhe as melhorias do portal e do aplicativo, entenda o que mudou e descubra novas formas de cuidar do condomínio.
            </MudText>
            <div class="updates-hero-actions">
                <a class="updates-primary-action" href="#historico">
                    <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" />
                    Explorar novidades
                </a>
                <span class="updates-version-badge"><MudIcon Icon="@Icons.Material.Outlined.Verified" Size="Size.Small" /> Versão @PlatformVersion</span>
                <span class="updates-release-meta"><MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" /> Atualizado em 24/08/2026</span>
            </div>
        </div>

        <div class="updates-visual" aria-hidden="true">
            <span class="updates-orbit updates-orbit-outer"></span>
            <span class="updates-orbit updates-orbit-inner"></span>
            <span class="updates-core"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /></span>
            <span class="updates-float-card updates-float-card-a"><MudIcon Icon="@Icons.Material.Outlined.PhoneAndroid" /><small>Aplicativo</small></span>
            <span class="updates-float-card updates-float-card-b"><MudIcon Icon="@Icons.Material.Outlined.Security" /><small>Segurança</small></span>
            <span class="updates-float-card updates-float-card-c"><MudIcon Icon="@Icons.Material.Outlined.Speed" /><small>Agilidade</small></span>
        </div>
    </section>

    <section class="updates-pillars" aria-label="Compromissos das atualizações">
        <article>
            <span class="updates-pillar-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Devices" /></span>
            <div><strong>Web e mobile</strong><small>Uma experiência consistente em todos os dispositivos.</small></div>
        </article>
        <article>
            <span class="updates-pillar-icon teal"><MudIcon Icon="@Icons.Material.Outlined.Sync" /></span>
            <div><strong>Evolução contínua</strong><small>Melhorias entregues em ciclos curtos e seguros.</small></div>
        </article>
        <article>
            <span class="updates-pillar-icon amber"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /></span>
            <div><strong>Operação confiável</strong><small>Mais clareza, velocidade e proteção para a equipe.</small></div>
        </article>
    </section>

    <section class="updates-feed" id="historico" aria-labelledby="updates-feed-title">
        <header class="updates-feed-header">
            <div>
                <span class="updates-section-kicker">HISTÓRICO DE EVOLUÇÃO</span>
                <MudText Typo="Typo.h4" HtmlTag="h2" id="updates-feed-title">O que há de novo</MudText>
                <MudText Typo="Typo.body2">Mudanças importantes, explicadas de forma simples.</MudText>
            </div>
            <div class="updates-filters" role="group" aria-label="Filtrar atualizações">
                @foreach (var filter in Filters)
                {
                    <button type="button" class="@FilterCss(filter)" aria-pressed="@(_activeFilter == filter)" @onclick="@(() => SetFilter(filter))">@filter</button>
                }
            </div>
        </header>

        <div class="updates-timeline">
            @foreach (var pair in VisibleUpdates.Select((update, index) => (update, index)))
            {
                var update = pair.update;
                <article class="update-release-card tone-@update.Tone" style="--update-index:@pair.index" @key="update">
                    <div class="update-release-date">
                        <strong>@update.DateLabel</strong>
                        <span>@update.Year</span>
                    </div>
                    <span class="update-release-marker"><MudIcon Icon="@update.Icon" /></span>
                    <div class="update-release-content">
                        <div class="update-release-heading">
                            <span class="update-category">@update.Category</span>
                            @if (pair.index == 0 && _activeFilter == "Todas")
                            {
                                <span class="update-latest"><i></i> Mais recente</span>
                            }
                        </div>
                        <MudText Typo="Typo.h5" HtmlTag="h3">@update.Title</MudText>
                        <MudText Typo="Typo.body2" Class="update-release-description">@update.Description</MudText>
                        <div class="update-highlights">
                            @foreach (var highlight in update.Highlights)
                            {
                                <span><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /> @highlight</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
        @if (HiddenUpdatesCount > 0)
        {
            <button type="button" class="updates-more" @onclick="ShowAllUpdates">
                <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" />
                Ver mais @HiddenUpdatesCount atualizações
            </button>
        }
    </section>
</div>

@code {
    private sealed record ReleaseUpdate(
        string DateLabel,
        string Year,
        string Category,
        string Title,
        string Description,
        string Icon,
        string Tone,
        string[] Highlights);

    private static readonly string[] Filters = ["Todas", "Novidade", "Melhoria", "Correção"];

    private static readonly ReleaseUpdate[] Releases =
    [
        new("24 AGO", "2026", "Novidade", "Uma conta para todos os condomínios e imóveis",
            "O morador agora usa uma única conta para acessar diferentes condomínios, apartamentos e perfis, sem precisar entrar novamente a cada troca.",
            Icons.Material.Outlined.SwitchAccount, "primary",
            ["Troca de condomínio e unidade sem novo login", "Convites vinculados a contas já existentes", "Morador pode convidar outros moradores pelo aplicativo"]),
        new("24 AGO", "2026", "Correção", "Credenciais expiradas com histórico preservado",
            "A remoção de uma credencial de visitante agora mantém o histórico necessário para auditoria e retira a credencial da operação sem gerar erro.",
            Icons.Material.Outlined.History, "neutral",
            ["Exclusão segura de credenciais expiradas", "Histórico de visitas preservado", "Credenciais removidas deixam de aparecer na gestão"]),
        new("23 AGO", "2026", "Novidade", "Assembleias e votações seguras",
            "Síndicos podem organizar assembleias e enquetes por pauta, enquanto moradores participam pelo aplicativo usando as unidades em que possuem direito a voto.",
            Icons.Material.Outlined.HowToVote, "violet",
            ["Quórum e aprovação configuráveis por pauta", "Voto aberto ou secreto com trilha auditável", "Participação, quórum e apuração acompanhados pela gestão"]),
        new("22 AGO", "2026", "Melhoria", "Aplicativo preparado para o uso diário",
            "Os fluxos essenciais do aplicativo foram reforçados para funcionar com mais previsibilidade no aparelho, inclusive em redes instáveis.",
            Icons.Material.Outlined.PhoneAndroid, "amber",
            ["Notificações e links internos mais confiáveis", "Leitura de QR Code revisada", "Convites, documentos, câmeras e boletos aprimorados"]),
        new("21 AGO", "2026", "Novidade", "Portaria como central operacional",
            "A equipe da portaria ganhou ferramentas para entender rapidamente cada evento e agir sem perder o contexto do atendimento.",
            Icons.Material.Outlined.AssistantDirection, "teal",
            ["Foto da pessoa vinculada ao evento", "Filtros, resolução e histórico de ocorrências", "Agenda enxuta com ações operacionais prioritárias"]),
        new("21 AGO", "2026", "Correção", "Sessões web recuperadas com segurança",
            "Quando a sessão expira, o portal agora tenta renová-la de forma segura e encerra o acesso corretamente quando a recuperação não é possível.",
            Icons.Material.Outlined.Security, "neutral",
            ["Renovação antes da abertura do portal", "Logout consistente após expiração", "Menos estados divergentes entre tela e API"]),
        new("18 AGO", "2026", "Melhoria", "F&F Access pronta para produção",
            "A identidade visual foi consolidada e a publicação passou a contar com verificações automáticas, HTTPS e entregas versionadas.",
            Icons.Material.Outlined.VerifiedUser, "primary",
            ["Branding F&F Access em portal e aplicativo", "Deploy com backup e verificação de saúde", "Imagens imutáveis e ambiente protegido na VPS"]),
        new("17 AGO", "2026", "Novidade", "Relatórios, carteiras e gestão ampliados",
            "A administração recebeu novas opções para analisar a operação, configurar integrações e organizar a rotina financeira e de manutenção.",
            Icons.Material.Outlined.Insights, "violet",
            ["Relatórios exportáveis com novos filtros", "Integrações com Google e Apple Wallet", "Gestão financeira e manutenção centralizadas"]),
        new("10 AGO", "2026", "Novidade", "Comunicados e operação offline segura",
            "Avisos oficiais passaram a chegar ao morador no aplicativo, enquanto a portaria ganhou uma base local protegida para contingências de conexão.",
            Icons.Material.Outlined.Campaign, "amber",
            ["Publicação de comunicados com notificações", "Consulta offline com dados protegidos", "Sincronização auditável após o retorno da conexão"]),
    ];

    private static readonly string PlatformVersion =
        Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion.Split('+', 2)[0]
        ?? Assembly.GetExecutingAssembly().GetName().Version?.ToString(3)
        ?? "indisponível";

    private string _activeFilter = "Todas";
    private bool _showAll;

    private IEnumerable<ReleaseUpdate> FilteredUpdates => _activeFilter == "Todas"
        ? Releases
        : Releases.Where(update => update.Category == _activeFilter);

    private IEnumerable<ReleaseUpdate> VisibleUpdates => _showAll
        ? FilteredUpdates
        : FilteredUpdates.Take(4);

    private int HiddenUpdatesCount => _showAll
        ? 0
        : Math.Max(0, FilteredUpdates.Count() - 4);

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
        _showAll = false;
    }

    private void ShowAllUpdates() => _showAll = true;

    private string FilterCss(string filter) => _activeFilter == filter
        ? "updates-filter is-active"
        : "updates-filter";
}
