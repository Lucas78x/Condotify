    private async Task OpenEventAsync(ConciergeEventViewModel accessEvent)
    {
        if (!_licenseId.HasValue || _dashboard is null) return;
        var (device, portal) = FindEventPortal(accessEvent);
        var visit = accessEvent.VisitId.HasValue ? _dashboard.Visits.FirstOrDefault(x => x.Id == accessEvent.VisitId.Value) : null;
        var parameters = new DialogParameters<ConciergeEventDialog>
        {
            { x => x.LicenseId, _licenseId.Value }, { x => x.Event, accessEvent },
            { x => x.Device, device }, { x => x.Channel, portal?.Number },
            { x => x.PortalName, portal?.Name ?? accessEvent.Portal }, { x => x.Visit, visit },
            { x => x.CanOperate, Has(LicensePermission.OperateDevices) },
            { x => x.CanViewPeople, Has(LicensePermission.ViewPeople) },
            { x => x.CanManagePeople, Has(LicensePermission.ManagePeople) },
            { x => x.CanManageCredentials, Has(LicensePermission.ManageCredentials) }
        };
        var dialog = await DialogService.ShowAsync<ConciergeEventDialog>("", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false }) return;
        if (result.Data is ConciergeEventViewModel updated) MergeEvent(updated);
        else if (result.Data is string action && action == "create-visit") await OpenVisitDialogAsync();
    }

    private (ConciergeDeviceViewModel? Device, DevicePortalCapabilityViewModel? Portal) FindEventPortal(ConciergeEventViewModel accessEvent)
    {
        var device = _dashboard?.Devices.FirstOrDefault(x => x.Id == accessEvent.DeviceId);
        if (device is null) return (null, null);
        var portals = DevicePortals(device).Where(x => x.Discovered).ToList();
        if (portals.Count == 1) return (device, portals[0]);
        var eventPortal = NormalizePortal(accessEvent.Portal);
        var match = portals.FirstOrDefault(x => NormalizePortal(x.Name) == eventPortal);
        if (match is null && int.TryParse(new string(accessEvent.Portal.Where(char.IsDigit).ToArray()), out var channel))
            match = portals.FirstOrDefault(x => x.Number == channel);
        return (device, match);
    }

    private void MergeEvent(ConciergeEventViewModel updated)
    {
        _eventsTab?.UpdateEvent(updated);
        if (_dashboard is null) return;
        var index = _dashboard.Events.FindIndex(x => x.Id == updated.Id);
        if (index >= 0) _dashboard.Events[index] = updated; else _dashboard.Events.Insert(0, updated);
    }

