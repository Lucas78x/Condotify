    {
        if (!_licenseId.HasValue) return;
        var confirmed = await DialogService.ShowMessageBoxAsync("Acionamento remoto", $"Abrir {portalName} em {device.Name}? O acionamento será registrado na auditoria.", yesText: "Abrir porta", cancelText: "Cancelar");
        if (confirmed != true) return;
        var result = await Api.OpenDoorAsync(_licenseId.Value, device.Id, channel, "Acionamento pela central de portaria");
        Snackbar.Add(result.Success ? $"{portalName} acionada." : result.Error ?? "Falha no acionamento.", result.Success ? Severity.Success : Severity.Error);
        await LoadDashboardAsync();
    }

    private void StartRefreshLoop()
    {
        _refreshCancellation = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RefreshLoopAsync(_refreshCancellation.Token);
    }
    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try { while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken)) await InvokeAsync(LoadDashboardAsync); }
        catch (OperationCanceledException) { }
    }
    private void StopRefreshLoop() { _refreshCancellation?.Cancel(); _refreshCancellation?.Dispose(); _refreshCancellation = null; _timer?.Dispose(); _timer = null; }
    public async ValueTask DisposeAsync() { StopRefreshLoop(); await DisconnectHubAsync(); }

    private static string Initials(string name) => string.Join(string.Empty, name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string StatusLabel(string status) => status switch { "Scheduled" => "Agendada", "CheckedIn" => "No local", "CheckedOut" => "Finalizada", "Canceled" => "Cancelada", "Expired" => "Expirada", "Denied" => "Negada", "PendingApproval" => "Aguardando aprovação", "PendingEnrollment" => "Aguardando cadastro facial", _ => "Em processamento" };
    private static string StatusClass(string status) => status.ToLowerInvariant();
    private static string StatusDot(string status) => status is "Scheduled" or "CheckedIn" or "PendingApproval" or "PendingEnrollment" ? "active" : "inactive";
    private static string VisitWindow(ConciergeVisitViewModel visit) => visit.ValidFrom.ToCondotifyTime().Date == visit.ValidTo.ToCondotifyTime().Date ? $"{visit.ValidFrom.ToCondotifyTime():dd/MM, HH:mm} - {visit.ValidTo.ToCondotifyTime():HH:mm}" : $"{visit.ValidFrom.ToCondotifyTime():dd/MM HH:mm} - {visit.ValidTo.ToCondotifyTime():dd/MM HH:mm}";
    private static string CredentialLabel(ConciergeVisitViewModel visit) => visit.CredentialType == "Face" ? "Facial" : visit.MaxUses.HasValue ? $"QR - {visit.UseCount}/{visit.MaxUses}" : "QR Code";
    private static string AttentionReason(ConciergeEventViewModel accessEvent)
    {
        var text = $"{accessEvent.Event} {accessEvent.Details}";
        if (text.Contains("expir", StringComparison.OrdinalIgnoreCase)) return "Credencial expirada";
        if (text.Contains("susp", StringComparison.OrdinalIgnoreCase) || text.Contains("inativ", StringComparison.OrdinalIgnoreCase)) return "Credencial suspensa ou inativa";
        if (text.Contains("watch", StringComparison.OrdinalIgnoreCase) || text.Contains("restri", StringComparison.OrdinalIgnoreCase)) return "Possível correspondência com restrição";
        return "Acesso negado aguardando verificação";
    }
    private static string NormalizePortal(string value) => new(value.Where(char.IsLetterOrDigit).Select(char.ToUpperInvariant).ToArray());
    private static List<DevicePortalCapabilityViewModel> DevicePortals(
      ConciergeDeviceViewModel device)
    {
        var fallback = new List<DevicePortalCapabilityViewModel>
    {
        new()
        {
            Number = 1,
            Name = "Porta 1",
            Direction = string.Empty,
            Discovered = false
        }
    };

        if (string.IsNullOrWhiteSpace(device.DiscoveredPortalsJson))
            return fallback;

        try
        {
            using var document = JsonDocument.Parse(device.DiscoveredPortalsJson);

            var root = document.RootElement;

            if (root.ValueKind == JsonValueKind.Array)
                return ParseDevicePortalsArray(root, fallback);

            if (root.ValueKind == JsonValueKind.Object)
            {
                var possibleArrayNames = new[]
                {
                "items",
                "portals",
                "doors",
                "channels",
                "data",
                "result"
            };

                foreach (var propertyName in possibleArrayNames)
                {
                    if (TryGetPropertyIgnoreCase(
                            root,
                            propertyName,
                            out var arrayElement) &&
                        arrayElement.ValueKind == JsonValueKind.Array)
                    {
                        return ParseDevicePortalsArray(arrayElement, fallback);
                    }
                }

                var singlePortal = ParseDevicePortal(root, 1);

                if (singlePortal is not null)
                    return [singlePortal];
            }
        }
        catch (JsonException)
        {
            // JSON inválido ou incompatível.
        }
        catch (InvalidOperationException)
        {
            // Algum campo veio com tipo inesperado.
        }
        catch (NotSupportedException)
        {
            // Estrutura não suportada.
        }

        return fallback;
    }
    private static List<DevicePortalCapabilityViewModel> ParseDevicePortalsArray(
     JsonElement arrayElement,
     List<DevicePortalCapabilityViewModel> fallback)
    {
        var portals = new List<DevicePortalCapabilityViewModel>();
        var position = 1;

        foreach (var item in arrayElement.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
            {
                position++;
                continue;
            }

            var portal = ParseDevicePortal(item, position);

            if (portal is not null)
                portals.Add(portal);

            position++;
        }

        return portals.Count > 0
            ? portals
                .GroupBy(x => x.Number)
                .Select(x => x.First())
                .OrderBy(x => x.Number)
                .ToList()
            : fallback;
    }

    private static DevicePortalCapabilityViewModel? ParseDevicePortal(
        JsonElement item,
        int fallbackNumber)
    {
        if (item.ValueKind != JsonValueKind.Object)
            return null;

        /*
         * Suporta nomes utilizados por diferentes fabricantes:
         *
         * Number:
         * number, doorNo, doorNumber, channel, channelNo, id, index
         *
         * Name:
         * name, doorName, channelName, description
         *
         * Direction:
         * direction, doorDirection, accessDirection
         *
         * Discovered:
         * discovered, enabled, active, available
         */

        var number =
            GetFlexibleInt32(item, "number") ??
            GetFlexibleInt32(item, "doorNo") ??
            GetFlexibleInt32(item, "doorNumber") ??
            GetFlexibleInt32(item, "channel") ??
            GetFlexibleInt32(item, "channelNo") ??
            GetFlexibleInt32(item, "index") ??
            GetFlexibleInt32(item, "id") ??
            fallbackNumber;

        if (number <= 0)
            number = fallbackNumber;

        var name =
            GetFlexibleString(item, "name") ??
            GetFlexibleString(item, "doorName") ??
            GetFlexibleString(item, "channelName") ??
            GetFlexibleString(item, "description");

        if (string.IsNullOrWhiteSpace(name))
            name = $"Porta {number}";

        var direction =
            GetFlexibleString(item, "direction") ??
            GetFlexibleString(item, "doorDirection") ??
            GetFlexibleString(item, "accessDirection") ??
            string.Empty;

        var discovered =
            GetFlexibleBoolean(item, "discovered") ??
            GetFlexibleBoolean(item, "enabled") ??
            GetFlexibleBoolean(item, "active") ??
            GetFlexibleBoolean(item, "available") ??
            true;

        return new DevicePortalCapabilityViewModel
        {
            Number = number,
            Name = name.Trim(),
            Direction = NormalizeDirection(direction),
            Discovered = discovered
        };
    }

    private static int? GetFlexibleInt32(JsonElement item, string propertyName)
    {
        if (!TryGetPropertyIgnoreCase(item, propertyName, out var value))
            return null;

        return value.ValueKind switch
        {
            JsonValueKind.Number when value.TryGetInt32(out var result) =>
                result,

            JsonValueKind.Number when value.TryGetInt64(out var longResult) &&
                                      longResult is >= int.MinValue and <= int.MaxValue =>
                (int)longResult,

            JsonValueKind.String when int.TryParse(
                value.GetString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out var stringResult) =>
                stringResult,

            JsonValueKind.True => 1,
            JsonValueKind.False => 0,

            _ => null
        };
    }

    private static string? GetFlexibleString(
        JsonElement item,
        string propertyName)
    {
        if (!TryGetPropertyIgnoreCase(item, propertyName, out var value))
            return null;

        return JsonElementToString(value);
    }

    private static string? JsonElementToString(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String =>
                value.GetString(),

            JsonValueKind.Number =>
                value.GetRawText(),

            JsonValueKind.True =>
                "true",

            JsonValueKind.False =>
                "false",

            JsonValueKind.Null =>
                null,

            JsonValueKind.Undefined =>
                null,

            /*
             * Evita chamar GetString() em objetos ou arrays, que é justamente
             * uma das causas do InvalidOperationException.
             */
            JsonValueKind.Object =>
                TryReadObjectValue(value),

            JsonValueKind.Array =>
                TryReadArrayValue(value),

            _ =>
                null
        };
    }

    private static string? TryReadObjectValue(JsonElement value)
    {
        /*
         * Alguns dispositivos retornam algo como:
         *
         * "direction": {
         *   "value": "in"
         * }
         *
         * ou:
         *
         * "direction": {
         *   "name": "Entrada"
         * }
         */

        var possibleProperties = new[]
        {
        "value",
        "name",
        "description",
        "type",
        "code"
    };

        foreach (var propertyName in possibleProperties)
        {
            if (!TryGetPropertyIgnoreCase(value, propertyName, out var nestedValue))
                continue;

            var result = JsonElementToString(nestedValue);

            if (!string.IsNullOrWhiteSpace(result))
                return result;
        }

        return null;
    }

    private static string? TryReadArrayValue(JsonElement value)
    {
        foreach (var arrayItem in value.EnumerateArray())
        {
            var result = JsonElementToString(arrayItem);

            if (!string.IsNullOrWhiteSpace(result))
                return result;
        }

        return null;
    }

    private static bool? GetFlexibleBoolean(
        JsonElement item,
        string propertyName)
    {
        if (!TryGetPropertyIgnoreCase(item, propertyName, out var value))
            return null;

        switch (value.ValueKind)
        {
            case JsonValueKind.True:
                return true;

            case JsonValueKind.False:
                return false;

            case JsonValueKind.Number:
                if (value.TryGetInt64(out var number))
                    return number != 0;

                return null;

            case JsonValueKind.String:
                {
                    var text = value.GetString()?.Trim();

                    if (string.IsNullOrWhiteSpace(text))
                        return null;

                    if (bool.TryParse(text, out var booleanResult))
                        return booleanResult;

                    if (long.TryParse(
                            text,
                            NumberStyles.Integer,
                            CultureInfo.InvariantCulture,
                            out var numericResult))
                    {
                        return numericResult != 0;
                    }

                    return text.ToLowerInvariant() switch
                    {
                        "yes" => true,
                        "no" => false,
                        "sim" => true,
                        "não" => false,
                        "nao" => false,
                        "enabled" => true,
                        "disabled" => false,
                        "active" => true,
                        "inactive" => false,
                        "on" => true,
                        "off" => false,
                        _ => null
                    };
                }

            default:
                return null;
        }
    }

    private static bool TryGetPropertyIgnoreCase(
        JsonElement item,
        string propertyName,
        out JsonElement value)
    {
        value = default;

        if (item.ValueKind != JsonValueKind.Object)
            return false;

        if (item.TryGetProperty(propertyName, out value))
            return true;

        foreach (var property in item.EnumerateObject())
        {
            if (string.Equals(
                    property.Name,
                    propertyName,
                    StringComparison.OrdinalIgnoreCase))
            {
                value = property.Value;
                return true;
            }
        }

        return false;
    }

    private static string NormalizeDirection(string? direction)
    {
        if (string.IsNullOrWhiteSpace(direction))
            return string.Empty;

        var normalized = direction.Trim();

        return normalized.ToLowerInvariant() switch
        {
            "in" => "Entrada",
            "entry" => "Entrada",
            "entrance" => "Entrada",
            "entrada" => "Entrada",
            "1" => "Entrada",

            "out" => "Saída",
            "exit" => "Saída",
            "saida" => "Saída",
            "saída" => "Saída",
            "2" => "Saída",

            "both" => "Bidirecional",
            "bidirectional" => "Bidirecional",
            "bothway" => "Bidirecional",
            "3" => "Bidirecional",

            /*
             * Não descarta valores desconhecidos de outras marcas.
             * Dessa forma, Intelbras, Control iD ou novos fabricantes
             * continuam exibindo o valor original.
             */
            _ => normalized
        };
    }
