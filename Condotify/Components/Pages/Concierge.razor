@page "/portaria"
@using System.Text.Json
@using System.Globalization
@using Microsoft.AspNetCore.SignalR.Client
@attribute [Authorize]
@implements IAsyncDisposable
@inject CondotifyApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ISessionContextProvider SessionContext
@inject IConfiguration Configuration

<PageTitle>Portaria | F&amp;F Access</PageTitle>

<PageHeader Title="Central de portaria" Subtitle="Visitantes, acessos e acionamentos em uma única operação." Eyebrow="OPERAÇÃO AO VIVO" />

<div class="concierge-license-bar">
    <div class="concierge-license-selector">
        <MudSelect T="Guid?" Value="@_licenseId" ValueChanged="@SelectLicenseAsync" Label="Condomínio em operação" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Apartment">
            @foreach (var license in _licenses)
            {
                <MudSelectItem T="Guid?" Value="@(Guid.TryParse(license.Id, out var parsedId) ? parsedId : null)">@license.Nome - @license.Codigo</MudSelectItem>
            }
        </MudSelect>
        @if (_dashboard is not null)
        {
            @if (_reconnecting)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Outlined.SyncProblem">Reconectando…</MudChip>
            }
            else
            {
                <span class="live-indicator"><i></i> Operação sincronizada</span>
            }
        }
    </div>
    <div class="concierge-command-actions">
        <MudTooltip Text="Atualizar agora"><MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary" Disabled="@(_loading || !_licenseId.HasValue)" OnClick="LoadDashboardAsync" /></MudTooltip>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.GppBad" Disabled="@(!_licenseId.HasValue)" OnClick="OpenWatchlistDialogAsync">Restrições</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAddAlt1" Disabled="@(!_licenseId.HasValue)" OnClick="OpenVisitDialogAsync">Nova visita</MudButton>
    </div>
</div>

@if (_loading && _dashboard is null)
{
    <div class="loading-state concierge-loading"><MudProgressCircular Indeterminate Color="Color.Primary" /><MudText Typo="Typo.body2">Preparando a operação...</MudText></div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}
else if (!_licenseId.HasValue)
{
    <MudPaper Class="content-panel concierge-welcome" Elevation="0"><MudIcon Icon="@Icons.Material.Outlined.AssistantDirection" /><MudText Typo="Typo.h6">Selecione um condomínio</MudText><MudText Typo="Typo.body2">A portaria será carregada com visitas, terminais e eventos daquele ambiente.</MudText></MudPaper>
}
else if (_dashboard is not null)
{
    <div class="concierge-kpis">
        <div class="concierge-kpi"><span class="kpi-icon blue"><MudIcon Icon="@Icons.Material.Outlined.EventAvailable" /></span><div><strong>@_dashboard.ExpectedToday</strong><small>Esperados hoje</small></div></div>
        <div class="concierge-kpi"><span class="kpi-icon green"><MudIcon Icon="@Icons.Material.Outlined.Login" /></span><div><strong>@_dashboard.InsideNow</strong><small>Dentro agora</small></div></div>
        <div class="concierge-kpi"><span class="kpi-icon red"><MudIcon Icon="@Icons.Material.Outlined.GppBad" /></span><div><strong>@_dashboard.DeniedToday</strong><small>Negados hoje</small></div></div>
        <div class="concierge-kpi"><span class="kpi-icon amber"><MudIcon Icon="@Icons.Material.Outlined.Router" /></span><div><strong>@_dashboard.OfflineDevices</strong><small>Terminais offline</small></div></div>
        <div class="concierge-kpi"><span class="kpi-icon blue"><MudIcon Icon="@Icons.Material.Outlined.Approval" /></span><div><strong>@_dashboard.PendingApprovals</strong><small>Aguardando aprovação</small></div></div>
        <div class="concierge-kpi"><span class="kpi-icon red"><MudIcon Icon="@Icons.Material.Outlined.TimerOff" /></span><div><strong>@_dashboard.Overstays</strong><small>Permanência excedida</small></div></div>
    </div>

    <MudPaper Class="content-panel concierge-attention-panel" Elevation="0">
        <div class="panel-toolbar">
            <div><MudText Typo="Typo.h6" Class="panel-title">Precisa de atenção</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Pendências operacionais que ainda exigem uma decisão da portaria</MudText></div>
            <MudChip T="string" Size="Size.Small" Color="@(AttentionCount > 0 ? Color.Error : Color.Success)" Icon="@(AttentionCount > 0 ? Icons.Material.Outlined.NotificationImportant : Icons.Material.Outlined.TaskAlt)">@AttentionCount</MudChip>
        </div>
        @if (AttentionCount == 0)
        {
            <div class="concierge-attention-empty"><MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Color="Color.Success" /><span>Nenhuma pendência operacional no momento.</span></div>
        }
        else
        {
            <div class="concierge-attention-list">
                @foreach (var accessEvent in AttentionEvents.Take(5))
                {
                    <button type="button" @onclick="@(() => OpenEventAsync(accessEvent))">
                        <MudIcon Icon="@Icons.Material.Outlined.GppBad" Color="Color.Error" />
                        <span><strong>@(string.IsNullOrWhiteSpace(accessEvent.PersonName) ? accessEvent.Event : accessEvent.PersonName)</strong><small>@AttentionReason(accessEvent) · @accessEvent.DeviceName @accessEvent.Portal</small></span>
                        <time>@accessEvent.OccurredAt.ToCondotifyTime().ToString("HH:mm")</time><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                    </button>
                }
                @foreach (var visit in AttentionVisits.Take(4))
                {
                    <button type="button" @onclick="@(() => OpenVisitDetailsAsync(visit))">
                        <MudIcon Icon="@Icons.Material.Outlined.PersonPinCircle" Color="Color.Warning" />
                        <span><strong>@visit.VisitorName</strong><small>@StatusLabel(visit.Status) · @visit.HostName — @visit.BlockName / @visit.UnitNumber</small></span>
                        <time>@visit.ValidFrom.ToCondotifyTime().ToString("HH:mm")</time><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                    </button>
                }
                @foreach (var device in OfflineDevices.Take(3))
                {
                    <div class="concierge-attention-device"><MudIcon Icon="@Icons.Material.Outlined.Router" Color="Color.Warning" /><span><strong>@device.Name sem comunicação</strong><small>@(string.IsNullOrWhiteSpace(device.HealthMessage) ? "Verifique a conexão do equipamento." : device.HealthMessage)</small></span></div>
                }
            </div>
        }
    </MudPaper>

    <MudTabs Elevation="0" Rounded TabPanelsClass="pa-0" Class="concierge-tabs">
        <MudTabPanel Text="Agenda de acessos" Icon="@Icons.Material.Outlined.EventNote">
            <div class="concierge-workspace">
                <MudPaper Class="content-panel concierge-visits-panel" Elevation="0">
                    <div class="panel-toolbar">
                        <div><MudText Typo="Typo.h6" Class="panel-title">Agenda de acessos</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Visitas de hoje e dos próximos dias</MudText></div>
                        <div class="concierge-filters">
                            <MudTextField T="string" @bind-Value="_visitSearch" Immediate Placeholder="Buscar visitante, morador ou unidade" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                            <MudSelect T="string" @bind-Value="_visitFilter" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem><MudSelectItem T="string" Value="@("Scheduled")">Agendadas</MudSelectItem><MudSelectItem T="string" Value="@("CheckedIn")">No local</MudSelectItem><MudSelectItem T="string" Value="@("finished")">Finalizadas</MudSelectItem></MudSelect>
                        </div>
                    </div>
                    @if (!FilteredVisits.Any())
                    {
                        <div class="empty-state compact-empty"><MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Color="Color.Primary" /><MudText Typo="Typo.subtitle1">Nenhuma visita neste filtro</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">As próximas autorizações aparecerão aqui.</MudText></div>
                    }
                    else
                    {
                        <div class="concierge-visit-list">
                            @foreach (var visit in FilteredVisits)
                            {
                                <article class="concierge-visit-row">
                                    <div class="visit-avatar">
                                        @if (!string.IsNullOrWhiteSpace(visit.PhotoUrl)) { <img src="@visit.PhotoUrl" alt="" /> }
                                        else { <span>@Initials(visit.VisitorName)</span> }
                                        <i class="@StatusDot(visit.Status)"></i>
                                    </div>
                                    <div class="visit-main"><div><strong>@visit.VisitorName</strong><span class="status-chip @StatusClass(visit.Status)">@StatusLabel(visit.Status)</span></div><small><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Size="Size.Small" /> @visit.HostName - @visit.BlockName / @visit.UnitNumber</small></div>
                                    <div class="visit-purpose"><small>Motivo</small><span>@(string.IsNullOrWhiteSpace(visit.Purpose) ? "Visita" : visit.Purpose)</span></div>
                                    <div class="visit-window"><small>Janela de acesso</small><span>@VisitWindow(visit)</span></div>
                                    <div class="visit-credential"><MudIcon Icon="@(visit.CredentialType == "Face" ? Icons.Material.Outlined.Face : Icons.Material.Outlined.QrCode2)" /><span>@CredentialLabel(visit)</span></div>
                                    <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AriaLabel="Ações da visita" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Visibility" OnClick="@(() => OpenVisitDetailsAsync(visit))">Ver autorização</MudMenuItem>
                                        @if (visit.Status == "PendingApproval")
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.CheckCircle" OnClick="@(() => DecideVisitAsync(visit, true))">Aprovar visita</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Cancel" OnClick="@(() => DecideVisitAsync(visit, false))">Recusar visita</MudMenuItem>
                                        }
                                        @if (visit.Status == "Scheduled")
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Login" OnClick="@(() => ChangeVisitStatusAsync(visit, 1, "Entrada confirmada na portaria"))">Registrar entrada</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Block" OnClick="@(() => ChangeVisitStatusAsync(visit, 5, "Acesso negado pela portaria"))">Negar acesso</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.EventBusy" OnClick="@(() => ChangeVisitStatusAsync(visit, 3, "Visita cancelada"))">Cancelar visita</MudMenuItem>
                                        }
                                        @if (visit.Status == "PendingEnrollment")
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.EventBusy" OnClick="@(() => ChangeVisitStatusAsync(visit, 3, "Convite facial cancelado"))">Cancelar convite facial</MudMenuItem>
                                        }
                                        @if (visit.Status == "CheckedIn")
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="@(() => ChangeVisitStatusAsync(visit, 2, "Saída confirmada na portaria"))">Registrar saída</MudMenuItem>
                                        }
                                    </MudMenu>
                                </article>
                            }
                        </div>
                    }
                </MudPaper>

                <div class="concierge-side-column">
                    <MudPaper Class="content-panel concierge-devices-panel" Elevation="0">
                        <div class="panel-toolbar"><div><MudText Typo="Typo.h6" Class="panel-title">Acionamentos</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Portas e terminais</MudText></div></div>
                        <div class="concierge-device-list">
                            @foreach (var device in _dashboard.Devices)
                            {
                                <div class="concierge-device-row">
                                    <span class="device-health @(device.Online ? "online" : "offline")"><MudIcon Icon="@Icons.Material.Outlined.SensorDoor" /></span>
                                    <div><strong>@device.Name</strong><small>@(device.Online ? "Online" : "Sem comunicação") - @device.Model</small></div>
                                    <MudMenu Icon="@Icons.Material.Outlined.MeetingRoom" AriaLabel="Abrir porta" Disabled="@(!device.Online)">
                                        @foreach (var portal in DevicePortals(device))
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.LockOpen" OnClick="@(() => OpenDoorAsync(device, portal.Number, portal.Name))">@portal.Name</MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>
                            }
                        </div>
                    </MudPaper>

                    <MudPaper Class="content-panel concierge-events-panel" Elevation="0">
                        <div class="panel-toolbar"><div><MudText Typo="Typo.h6" Class="panel-title">Eventos recentes</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Leitura dos controladores</MudText></div></div>
                        <div class="concierge-event-list">
                            @foreach (var accessEvent in _dashboard.Events.Take(12))
                            {
                                var eventPersonName = string.IsNullOrWhiteSpace(accessEvent.PersonName) ? accessEvent.Event : accessEvent.PersonName;
                                <button type="button" class="concierge-event-row" @onclick="@(() => OpenEventAsync(accessEvent))">
                                    <div class="concierge-event-avatar">
                                        @if (!string.IsNullOrWhiteSpace(accessEvent.PhotoUrl))
                                        {
                                            <img src="@accessEvent.PhotoUrl" alt="Foto de @eventPersonName" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span>@Initials(eventPersonName)</span>
                                        }
                                        <i class="event-result @(accessEvent.Authorized ? "allowed" : "denied")" aria-label="@(accessEvent.Authorized ? "Acesso autorizado" : "Acesso negado")"><MudIcon Icon="@(accessEvent.Authorized ? Icons.Material.Outlined.Check : Icons.Material.Outlined.Close)" /></i>
                                    </div>
                                    <div><strong>@eventPersonName</strong><small>@accessEvent.DeviceName @(!string.IsNullOrWhiteSpace(accessEvent.Portal) ? $"- {accessEvent.Portal}" : string.Empty)</small></div>
                                    <time>@accessEvent.OccurredAt.ToCondotifyTime().ToString("HH:mm")</time>
                                </button>
                            }
                        </div>
                    </MudPaper>
                    @if (_dashboard.Watchlist.Count > 0)
                    {
                        <MudPaper Class="content-panel concierge-watchlist-panel" Elevation="0"><div class="panel-toolbar"><div><MudText Typo="Typo.h6" Class="panel-title">Restrições ativas</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Documentos e veículos monitorados</MudText></div><MudChip T="string" Size="Size.Small" Color="Color.Error">@_dashboard.Watchlist.Count</MudChip></div><div class="concierge-watchlist-list">@foreach (var entry in _dashboard.Watchlist.Take(5)) { <div><MudIcon Icon="@Icons.Material.Outlined.Report" Color="Color.Error" /><span><strong>@(string.IsNullOrWhiteSpace(entry.Name) ? entry.Document : entry.Name)</strong><small>@entry.Reason</small></span><MudTooltip Text="Remover restrição"><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveWatchlistAsync(entry))" /></MudTooltip></div> }</div></MudPaper>
                    }
                </div>
            </div>
        </MudTabPanel>
        @if (IsModuleEnabled(Condotify.Models.LicenseModuleEnum.Deliveries) && Has(LicensePermission.ViewDeliveries))
        {
            <MudTabPanel Text="Encomendas" Icon="@Icons.Material.Outlined.Inventory2">
                <ConciergePackagesTab @ref="_packagesTab" LicenseId="_licenseId!.Value" CanManage="@Has(LicensePermission.ManageDeliveries)" />
            </MudTabPanel>
        }
        <MudTabPanel Text="Eventos" Icon="@Icons.Material.Outlined.FactCheck">
            <ConciergeEventsTab @ref="_eventsTab" LicenseId="_licenseId!.Value" OnEventSelected="OpenEventAsync" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    private List<LicenseViewModel> _licenses = [];
    private List<AccessRouteViewModel> _routes = [];
    private ConciergeDashboardViewModel? _dashboard;
    private Guid? _licenseId;
    private string _visitSearch = string.Empty;
    private string _visitFilter = "all";
    private string? _error;
    private bool _loading = true;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _refreshCancellation;
    private ConciergePackagesTab? _packagesTab;
    private ConciergeEventsTab? _eventsTab;
    private HubConnection? _hubConnection;
    private bool _reconnecting;
    private LicenseAdministrationViewModel? _administration;

    private bool IsModuleEnabled(Condotify.Models.LicenseModuleEnum module) =>
        _licenses.FirstOrDefault(x => Guid.TryParse(x.Id, out var id) && id == _licenseId)?.EnabledModules is not { } enabled || (enabled & (long)module) != 0;

    private bool Has(LicensePermission permission) => _administration?.CurrentAccess.Has(permission) == true;

    private IEnumerable<ConciergeVisitViewModel> FilteredVisits => (_dashboard?.Visits ?? [])
        .Where(x => _visitFilter == "all" || (_visitFilter == "finished" ? x.Status is "CheckedOut" or "Canceled" or "Expired" or "Denied" : x.Status == _visitFilter))
        .Where(x => string.IsNullOrWhiteSpace(_visitSearch) || $"{x.VisitorName} {x.HostName} {x.BlockName} {x.UnitNumber} {x.Document} {x.VehiclePlate}".Contains(_visitSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.Status == "CheckedIn" ? 0 : x.Status == "Scheduled" ? 1 : 2).ThenBy(x => x.ValidFrom);
    private IEnumerable<ConciergeEventViewModel> AttentionEvents => (_dashboard?.Events ?? []).Where(x => x.RequiresAttention);
    private IEnumerable<ConciergeVisitViewModel> AttentionVisits => (_dashboard?.Visits ?? []).Where(x => x.Status is "PendingApproval" or "PendingEnrollment");
    private IEnumerable<ConciergeDeviceViewModel> OfflineDevices => (_dashboard?.Devices ?? []).Where(x => !x.Online);
    private int AttentionCount => AttentionEvents.Count() + AttentionVisits.Count() + OfflineDevices.Count();

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetLicensesAsync();
        _loading = false;
        if (!result.Success) { _error = result.Error; return; }
        _licenses = result.Value ?? [];
        if (_licenses.Count == 1 && Guid.TryParse(_licenses[0].Id, out var onlyLicenseId)) await SelectLicenseAsync(onlyLicenseId);
    }

    private async Task SelectLicenseAsync(Guid? licenseId)
    {
        _licenseId = licenseId;
        _dashboard = null;
        _error = null;
        _administration = null;
        StopRefreshLoop();
        await DisconnectHubAsync();
        if (!licenseId.HasValue) return;
        _loading = true;
        var routesResult = await Api.GetAccessRoutesAsync(licenseId.Value);
        _routes = routesResult.Success ? routesResult.Value ?? [] : [];
        var administrationResult = await Api.GetLicenseAdministrationAsync(licenseId.Value);
        _administration = administrationResult.Success ? administrationResult.Value : null;
        await LoadDashboardAsync();
        StartRefreshLoop();
        await ConnectHubAsync(licenseId.Value);
    }

    // A conexao SignalR do Blazor Server e feita pelo processo do servidor do
    // portal, nao pelo navegador (o @code roda inteiramente no servidor sob o
    // circuito do Blazor Server). O hub /hubs/concierge esta hospedado no
    // processo da CondotifyAPI, um servico separado (containers/portas
    // distintos, ver docker-compose.yml) -- por isso a URL do hub precisa ser
    // resolvida a partir de CondotifyApi:BaseUrl (a mesma configuracao que
    // CondotifyApiClient usa para toda chamada HTTP), e nao a partir de
    // NavigationManager, que resolveria para o endereco do proprio portal e
    // nunca encontraria o hub.
    private string BuildHubUrl()
    {
        var baseUrl = (Configuration["CondotifyApi:BaseUrl"] ?? "https://localhost:7118").TrimEnd('/');
        return $"{baseUrl}/hubs/concierge";
    }

    private async Task ConnectHubAsync(Guid licenseId)
    {
        await DisconnectHubAsync();
        var token = await SessionContext.GetAccessTokenAsync();
        if (string.IsNullOrWhiteSpace(token)) return;

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(BuildHubUrl(), options => options.AccessTokenProvider = () => SessionContext.GetAccessTokenAsync().AsTask())
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.Reconnecting += _ => { _reconnecting = true; return InvokeAsync(StateHasChanged); };
        _hubConnection.Reconnected += async _ => { _reconnecting = false; await _hubConnection.InvokeAsync("JoinLicenseGroup", licenseId); await InvokeAsync(StateHasChanged); };
        _hubConnection.Closed += async _ => { _reconnecting = false; await InvokeAsync(StateHasChanged); };

        // VisitStatusChanged/DeliveryUpdated disparam um recarregamento local (chamada HTTP
        // ja existente, GetConciergeDashboardAsync/GetDeliveriesAsync) em vez de mesclar o
        // payload recebido diretamente no estado -- e uma simplificacao deliberada (evita bugs
        // sutis de merge de estado parcial) que ainda cumpre o resultado pedido pela spec
        // ("atualiza a linha e os KPIs"): a diferenca pratica e uma chamada HTTP extra e quase
        // instantanea, sem esperar o ciclo de polling. So o
        // AccessEventRecorded (abaixo) faz merge local de verdade, via ConciergeEventsTab.PrependEvent,
        // porque inserir uma linha no topo de uma lista e trivial e nao tem risco de
        // inconsistencia como mesclar uma visita/entrega inteira.
        _hubConnection.On<ConciergeVisitViewModel>("VisitStatusChanged", async _ => await InvokeAsync(LoadDashboardAsync));
        _hubConnection.On<DeliveryRowViewModel>("DeliveryUpdated", async _ => { if (_packagesTab is not null) await InvokeAsync(_packagesTab.ReloadAsync); });
        _hubConnection.On<ConciergeEventViewModel>("AccessEventRecorded", async accessEvent =>
        {
            await InvokeAsync(() =>
            {
                _eventsTab?.PrependEvent(accessEvent);
                if (_dashboard is not null)
                {
                    _dashboard.Events.Insert(0, accessEvent);
                    if (_dashboard.Events.Count > 80) _dashboard.Events.RemoveAt(_dashboard.Events.Count - 1);
                    StateHasChanged();
                }
                return Task.CompletedTask;
            });
        });
        _hubConnection.On<ConciergeEventViewModel>("AccessEventResolved", async accessEvent =>
        {
            await InvokeAsync(() =>
            {
                MergeEvent(accessEvent);
                StateHasChanged();
            });
        });

        try
        {
            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("JoinLicenseGroup", licenseId);
        }
        catch (Exception)
        {
            // Falha ao conectar nao bloqueia a tela -- o polling de 15s (fallback) continua funcionando.
        }
    }

    private async Task DisconnectHubAsync()
    {
        if (_hubConnection is null) return;
        await _hubConnection.DisposeAsync();
        _hubConnection = null;
    }

    private async Task LoadDashboardAsync()
    {
        if (!_licenseId.HasValue) return;
        var result = await Api.GetConciergeDashboardAsync(_licenseId.Value);
        _loading = false;
        if (!result.Success) { _error = result.Error; StateHasChanged(); return; }
        _dashboard = result.Value;
        _error = null;
        StateHasChanged();
    }

    private async Task OpenVisitDialogAsync()
    {
        if (!_licenseId.HasValue) return;
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var parameters = new DialogParameters<ConciergeVisitDialog> { { x => x.LicenseId, _licenseId.Value }, { x => x.Routes, _routes } };
        var dialog = await DialogService.ShowAsync<ConciergeVisitDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false }) return;
        if (result.Data is ConciergeVisitViewModel createdVisit && createdVisit.Status == "PendingEnrollment")
        {
            Snackbar.Add("Convite facial criado. Compartilhe o link com o visitante.", Severity.Success);
            await LoadDashboardAsync();
            await OpenVisitDetailsAsync(createdVisit);
            return;
        }
        Snackbar.Add("Visita autorizada e enviada para conciliação.", Severity.Success);
        await LoadDashboardAsync();
    }

    private async Task ChangeVisitStatusAsync(ConciergeVisitViewModel visit, int status, string reason)
    {
        if (!_licenseId.HasValue) return;
        var action = status switch { 1 => "registrar a entrada", 2 => "registrar a saída", 3 => "cancelar esta visita", 5 => "negar o acesso", _ => "alterar o status" };
        var confirmed = await DialogService.ShowMessageBoxAsync("Confirmar operação", $"Deseja {action} de {visit.VisitorName}?", yesText: "Confirmar", cancelText: "Voltar");
        if (confirmed != true) return;
        var result = await Api.UpdateConciergeVisitStatusAsync(_licenseId.Value, visit.Id, status, reason);
        if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível atualizar a visita.", Severity.Error); return; }
        Snackbar.Add("Operação registrada.", Severity.Success);
        await LoadDashboardAsync();
    }

    private async Task DecideVisitAsync(ConciergeVisitViewModel visit, bool approved)
    {
        if (!_licenseId.HasValue) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(approved ? "Aprovar visita" : "Recusar visita", $"Confirmar a decisao para {visit.VisitorName}?", yesText: approved ? "Aprovar" : "Recusar", cancelText: "Voltar");
        if (confirmed != true) return;
        var result = await Api.DecideConciergeVisitAsync(_licenseId.Value, visit.Id, approved, approved ? "Aprovada pela central de portaria" : "Recusada pela central de portaria");
        Snackbar.Add(result.Success ? (approved ? "Visita aprovada e enviada aos terminais." : "Visita recusada.") : result.Error ?? "Não foi possível registrar a decisão.", result.Success ? Severity.Success : Severity.Error);
        if (result.Success) await LoadDashboardAsync();
    }

