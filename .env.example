POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-64-random-characters
EQUIPMENT_SECRET=use-a-different-random-secret-for-device-passwords
MEDIA_SECRET=use-a-different-random-secret-for-private-media
BACKUP_EXPORT_SECRET=use-a-different-random-secret-for-portable-backups
BACKUP_EXPORT_PATH=./backups
CONDOTIFY_SMTP_HOST=
CONDOTIFY_SMTP_PORT=587
CONDOTIFY_SMTP_USERNAME=
CONDOTIFY_SMTP_PASSWORD=
CONDOTIFY_SMTP_FROM_EMAIL=
CONDOTIFY_SMTP_FROM_NAME=Condotify
CONDOTIFY_SMTP_ENABLE_SSL=true
CONDOTIFY_API_KEY=replace-with-a-private-integration-key
CONDOTIFY_TIME_ZONE=America/Sao_Paulo

# Endereco publico pelo qual o aplicativo alcanca o gateway de video.
# Em producao, aponte para o host/proxy que expoe as portas 8888 (HLS) e
# 8889 (WebRTC) -- um unico proxy pode fazer frente as duas.
CONDOTIFY_MEDIA_HLS_BASEURL=http://localhost:8888
CONDOTIFY_MEDIA_WEBRTC_BASEURL=http://localhost:8889
CONDOTIFY_MEDIA_WEBRTC_HOSTS=localhost

# Limite de visualizadores simultaneos por licenca no gateway de video.
CONDOTIFY_MEDIA_MAX_VIEWERS_PER_LICENSE=24
CONDOTIFY_MEDIA_TRANSCODE_AUDIO=true

# Push mobile (arquivo de service account fora do repositorio)
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/condotify-firebase-service-account.json
# CONDOTIFY_FCM_PROJECT_ID=<firebase-project-id-real>

# App Links / Universal Links (use apenas identidades reais de assinatura)
# MobileLinks__AndroidPackageName=br.com.condotify.app
# MobileLinks__AndroidSha256Fingerprints__0=<sha256-real-do-certificado>
# MobileLinks__AppleTeamId=<apple-team-id-real>
# MobileLinks__AppleBundleId=br.com.condotify.app
