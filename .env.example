POSTGRES_PASSWORD=replace-with-a-strong-database-password
PGADMIN_PASSWORD=replace-with-a-different-strong-password
JWT_SECRET=replace-with-at-least-64-random-characters
EQUIPMENT_SECRET=use-a-different-random-secret-for-device-passwords
MEDIA_SECRET=use-a-different-random-secret-for-private-media
CONDOTIFY_WALLET_SECRET=use-a-different-random-secret-with-at-least-32-characters
BACKUP_EXPORT_SECRET=use-a-different-random-secret-for-portable-backups
BACKUP_EXPORT_PATH=./backups
CONDOTIFY_POSTGRES_BACKUP_PATH=./backups/postgres
CONDOTIFY_BACKUP_DAILY_RETENTION_DAYS=7
CONDOTIFY_BACKUP_WEEKLY_RETENTION_DAYS=35
CONDOTIFY_BACKUP_MONTHLY_RETENTION_DAYS=400
# Exemplo rclone: s3:meu-bucket/condotify ou b2:meu-bucket/condotify
CONDOTIFY_BACKUP_OFFSITE_REMOTE=
CONDOTIFY_REQUIRE_OFFSITE_BACKUP=false
CONDOTIFY_API_IMAGE=condotify-api:local
CONDOTIFY_PORTAL_IMAGE=condotify-portal:local
CONDOTIFY_LPR_IMAGE=condotify-lpr-ocr:local
CONDOTIFY_IMAGE_REGISTRY=ghcr.io/lucas78x
CONDOTIFY_SMTP_HOST=
CONDOTIFY_SMTP_PORT=587
CONDOTIFY_SMTP_USERNAME=
CONDOTIFY_SMTP_PASSWORD=
CONDOTIFY_SMTP_FROM_EMAIL=
CONDOTIFY_SMTP_FROM_NAME=Condotify
CONDOTIFY_SMTP_ENABLE_SSL=true
CONDOTIFY_API_KEY=replace-with-a-private-integration-key
CONDOTIFY_TIME_ZONE=America/Bahia
CONDOTIFY_PUBLIC_HOST=fefaccess.grupoff.net.br
CONDOTIFY_PUBLIC_PORTAL_URL=https://fefaccess.grupoff.net.br
CONDOTIFY_PUBLIC_APP_URL=https://fefaccess.grupoff.net.br
# Frequencia normal de coleta dos eventos dos controladores (falhas usam backoff automatico).
CONDOTIFY_ACCESS_EVENT_POLL_SECONDS=15

# Endereco publico pelo qual o aplicativo alcanca o gateway de video.
# Em producao, o proxy publica HLS e o sinalizador WebRTC sob a mesma porta 443.
CONDOTIFY_MEDIA_HLS_BASEURL=https://fefaccess.grupoff.net.br/media/hls
CONDOTIFY_MEDIA_WEBRTC_BASEURL=https://fefaccess.grupoff.net.br/media/webrtc
# Se o DNS estiver atras de um proxy, use aqui o IP publico direto da VPS para ICE.
CONDOTIFY_MEDIA_WEBRTC_HOSTS=fefaccess.grupoff.net.br

# Redes externas compartilhadas pelo Caddy e pelas stacks publicadas. O
# bootstrap cria ambas; novas aplicacoes web podem reutilizar condotify-web.
CONDOTIFY_WEB_NETWORK=condotify-web
CONDOTIFY_MEDIA_PROXY_NETWORK=condotify-media-proxy

# Limite de visualizadores simultaneos por licenca no gateway de video.
CONDOTIFY_MEDIA_MAX_VIEWERS_PER_LICENSE=24
CONDOTIFY_MEDIA_TRANSCODE_AUDIO=true

# Push mobile (JSON de conta de servico do Firebase Admin; nao use o
# google-services.json do aplicativo Android)
# Caminho no host; o Compose monta o arquivo como somente leitura na API.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/condotify-firebase-service-account.json
# Opcional: quando omitido, a API usa o project_id da propria conta de servico.
# CONDOTIFY_FCM_PROJECT_ID=<firebase-project-id-real>

# App Links / Universal Links (use apenas identidades reais de assinatura)
MOBILE_LINKS_ANDROID_PACKAGE_NAME=br.com.condotify.app
# Preencha com o SHA-256 do certificado "App signing key" exibido no Play Console.
MOBILE_LINKS_ANDROID_SHA256_FINGERPRINT_0=
# Preencha quando o aplicativo iOS estiver configurado.
MOBILE_LINKS_APPLE_TEAM_ID=
MOBILE_LINKS_APPLE_BUNDLE_ID=br.com.condotify.app
