@inherits LayoutComponentBase
@implements IDisposable
@inject MobileSessionCoordinator Session
@inject MobileAppState AppState
@inject MobilePushLifecycle Push
@inject MobileConnectivityState NetworkState
@inject MobileAppearanceState Appearance
@inject MobileAppLockService AppLock
@inject MobileBiometricService Biometrics
@inject NavigationManager Navigation
@inject MobilePullToRefreshState PullToRefresh
@inject IJSRuntime JS

<MudThemeProvider Theme="@Condotify.UI.CondotifyTheme.Default" IsDarkMode="@Appearance.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!Session.IsAuthenticated || IsLoginRoute)
{
    <main class="public-shell">@Body</main>
}
else
{
    <MudLayout Class="@($"mobile-shell {(Appearance.IsDarkMode ? "dark-mode" : "light-mode")}")">
        <MudAppBar Class="mobile-appbar" Elevation="0" Dense="true">
            <BrandMark Class="appbar-mobile-brand" />
            <div class="appbar-context">
                <MudText Typo="Typo.subtitle2">@TopbarTitle</MudText>
                <MudText Typo="Typo.caption">@ContextLabel</MudText>
            </div>
            <MudSpacer />
            @if (Session.Current?.Principal == MobilePrincipalKind.Staff)
            {
                <MudTooltip Text="Trocar condomínio">
                    <MudIconButton Icon="@Icons.Material.Outlined.Apartment" Color="Color.Inherit" OnClick="OpenLicenses" aria-label="Trocar condomínio" />
                </MudTooltip>
            }
            <MudTooltip Text="Notificações">
                <MudIconButton Icon="@Icons.Material.Outlined.NotificationsNone" Color="Color.Inherit" OnClick="OpenNotifications" aria-label="Notificações" />
            </MudTooltip>
            <MudMenu Icon="@Icons.Material.Outlined.PersonOutline" Class="account-menu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Conta">
                <MudMenuItem OnClick="OpenProfile" Icon="@Icons.Material.Outlined.PersonOutline">Minha conta</MudMenuItem>
                <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Outlined.Logout">Sair</MudMenuItem>
            </MudMenu>
        </MudAppBar>

        <MudDrawer Class="desktop-rail" Open="true" Variant="DrawerVariant.Persistent" Elevation="0">
            <div class="desktop-brand">
                <BrandMark Class="desktop-brand-mark" />
                <div>
                    <MudText Typo="Typo.subtitle1">Condotify</MudText>
                    <MudText Typo="Typo.caption">Controle de acesso</MudText>
                </div>
            </div>
            <MudText Typo="Typo.overline" Class="rail-label">Operação</MudText>
            <MudNavMenu>
                @foreach (var item in NavigationItems)
                {
                    <MudNavLink Href="@item.Route" Match="NavLinkMatch.Prefix" Icon="@Icon(item.IconKey)">@item.Label</MudNavLink>
                }
            </MudNavMenu>
            <button type="button" class="rail-footer" @onclick="OpenProfile">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">@Initials(Session.Current?.Name)</MudAvatar>
                <div><strong>@(Session.Current?.Name ?? "Usuário")</strong><span>@PrincipalLabel</span></div>
            </button>
        </MudDrawer>

        @if (!NetworkState.IsOnline)
        {
            <div class="connectivity-banner" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.WifiOff" Size="Size.Small" />
                <span>Sem conexão. Alguns dados podem estar desatualizados.</span>
            </div>
        }

        <div id="ptr-indicator" class="ptr-indicator" aria-hidden="true"><span class="ptr-icon">&#8635;</span></div>

        <MudMainContent Class="app-content">
            <div class="page-frame">
                <div class="page-transition" @key="@Navigation.Uri">
                    @Body
                </div>
            </div>
        </MudMainContent>

        <nav class="mobile-bottom-nav" aria-label="Navegação principal">
            @foreach (var item in NavigationItems)
            {
                <NavLink href="@item.Route" class="bottom-nav-link" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icon(item.IconKey)" Size="Size.Medium" />
                    <span>@item.Label</span>
                </NavLink>
            }
        </nav>
        @if (_locked)
        {
            <div class="app-lock-screen" role="dialog" aria-modal="true" aria-label="Aplicativo bloqueado">
                <div class="app-lock-card">
                    <BrandMark Class="app-lock-mark" />
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="app-lock-icon" />
                    <MudText Typo="Typo.h5">Condotify protegido</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Confirme sua biometria ou o bloqueio do aparelho para continuar.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Fingerprint" Disabled="_unlocking" OnClick="UnlockAsync">@(_unlocking ? "Aguardando confirmação..." : "Desbloquear")</MudButton>
                </div>
            </div>
        }
    </MudLayout>
}

@code {
    private IReadOnlyList<MobileNavigationItem> NavigationItems => MobileNavigation.For(Session.Current?.Principal ?? MobilePrincipalKind.Staff);
    private string TopbarTitle => Session.Current?.Principal == MobilePrincipalKind.Resident
        ? Session.Current?.LicenseName ?? "Meu condomínio"
        : AppState.SelectedLicense?.Nome ?? "Central operacional";
    private string ContextLabel => Session.Current?.Principal == MobilePrincipalKind.Resident
        ? "Conta de morador"
        : "Central operacional";
    private bool IsLoginRoute => Navigation.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase);
    private string PrincipalLabel => Session.Current?.Principal == MobilePrincipalKind.Resident ? "Morador" : "Operação";
    private bool _locked;
    private bool _unlocking;
    private bool _lockChecked;
    private static string Initials(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? "?"
            : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));

    protected override void OnInitialized()
    {
        Session.Changed += Refresh;
        AppState.Changed += Refresh;
        NetworkState.Changed += Refresh;
        Appearance.Changed += Refresh;
        AppLock.Changed += RefreshLock;
        Navigation.LocationChanged += OnLocationChanged;
        _ = MonitorLockAsync(_lockMonitorCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pullToRefreshRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("condotifyPullToRefresh.attach", _pullToRefreshRef);
        }

        if (_lockChecked || !Session.IsAuthenticated || !AppLock.NeedsUnlock) return;
        _lockChecked = true;
        _locked = true;
        await InvokeAsync(StateHasChanged);
        await UnlockAsync();
    }

    private DotNetObjectReference<MainLayout>? _pullToRefreshRef;

    [JSInvokable]
    public async Task OnPullToRefreshAsync() => await PullToRefresh.RefreshAsync();

    private async Task UnlockAsync()
    {
        if (_unlocking) return;
        _unlocking = true;
        var success = await Biometrics.AuthenticateAsync("Proteja os dados e acessos do seu condomínio");
        _unlocking = false;
        if (success) { AppLock.MarkUnlocked(); _locked = false; }
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshLock()
    {
        if (!AppLock.Enabled) _locked = false;
        InvokeAsync(StateHasChanged);
    }

    private readonly CancellationTokenSource _lockMonitorCts = new();
    private async Task MonitorLockAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (Session.IsAuthenticated && AppLock.NeedsUnlock && !_locked)
                {
                    _locked = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (Session.IsAuthenticated && AppLock.NeedsUnlock) _locked = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        try { await Push.UnregisterAsync(); } catch { }
        await Session.LogoutAsync();
        AppState.Clear();
        Navigation.NavigateTo("/login", replace: true);
    }

    private void OpenLicenses() => Navigation.NavigateTo("/licenses");
    private void OpenNotifications() => Navigation.NavigateTo("/notifications");
    private void OpenProfile() => Navigation.NavigateTo("/profile");
    private void Refresh() => InvokeAsync(StateHasChanged);

    private static string Icon(string key) => key switch
    {
        "home" => Icons.Material.Outlined.Home,
        "concierge" => Icons.Material.Outlined.SensorDoor,
        "camera" => Icons.Material.Outlined.Videocam,
        "visitors" => Icons.Material.Outlined.Group,
        "calendar" => Icons.Material.Outlined.CalendarMonth,
        _ => Icons.Material.Outlined.GridView
    };

    public void Dispose()
    {
        Session.Changed -= Refresh;
        AppState.Changed -= Refresh;
        NetworkState.Changed -= Refresh;
        Appearance.Changed -= Refresh;
        AppLock.Changed -= RefreshLock;
        Navigation.LocationChanged -= OnLocationChanged;
        _lockMonitorCts.Cancel();
        _lockMonitorCts.Dispose();
        _ = JS.InvokeVoidAsync("condotifyPullToRefresh.detach");
        _pullToRefreshRef?.Dispose();
    }
}
