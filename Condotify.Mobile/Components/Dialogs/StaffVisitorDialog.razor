@inject CondotifyApiClient Api

<MudDialog Class="mobile-dialog visitor-create-dialog">
    <TitleContent>
        <div class="mobile-dialog-title">
            <MudIcon Icon="@Icons.Material.Outlined.PersonAddAlt1" Color="Color.Primary" />
            <div><MudText Typo="Typo.h6">Entrada rápida</MudText><MudText Typo="Typo.caption">Autorize a visita e escolha a identificação na portaria.</MudText></div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">@_error</MudAlert>
        }

        @if (_loading)
        {
            <div class="dialog-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mobile-section-label first">Tipo de convite</MudText>
            <div class="visitor-access-picker">
                <button type="button" class="visitor-access-choice @(!_facialInvite ? "active" : "")" @onclick="() => SelectAccess(false)">
                    <span class="visitor-access-choice-icon qr"><MudIcon Icon="@Icons.Material.Outlined.QrCode2" /></span>
                    <span><strong>QR Code</strong><small>Entrada rápida e compartilhável</small></span>
                    <MudIcon Icon="@(!_facialInvite ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                </button>
                <button type="button" class="visitor-access-choice @(_facialInvite ? "active face" : "")" disabled="@(!_facialAvailable)" @onclick="() => SelectAccess(true)">
                    <span class="visitor-access-choice-icon face"><MudIcon Icon="@Icons.Material.Outlined.FaceRetouchingNatural" /></span>
                    <span><strong>Convite facial</strong><small>@(_facialAvailable ? "Visitante cadastra a foto pelo link" : "Sem rota facial disponível")</small></span>
                    <MudIcon Icon="@(_facialInvite ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                </button>
            </div>

            @if (_facialInvite)
            {
                <div class="facial-invite-explainer compact">
                    <div class="facial-invite-mini-phone" aria-hidden="true"><span class="facial-invite-mini-face"><MudIcon Icon="@Icons.Material.Outlined.Face" /><i></i></span><b><MudIcon Icon="@Icons.Material.Outlined.Check" /></b></div>
                    <div><strong>Sem foto na portaria</strong><span>O visitante recebe um link seguro, segue o guia animado e envia a própria foto antes de chegar.</span></div>
                </div>
            }

            <div class="mobile-form-grid visitor-form-fields">
                <MudSelect T="Guid" @bind-Value="_form.HostResidentId" Label="Morador anfitrião" Variant="Variant.Outlined" Required="true">
                    @foreach (var host in _hosts)
                    {
                        <MudSelectItem T="Guid" Value="@host.Id">@host.Name · @host.Location</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_form.VisitorName" Label="Nome do visitante" Variant="Variant.Outlined" Required="true" />
                <MudTextField T="string" @bind-Value="_form.Document" Label="CPF, RG ou documento" Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_form.PhoneNumber" Label="Telefone" Variant="Variant.Outlined" InputType="InputType.Telephone" />
                <MudTextField T="string" @bind-Value="_form.VehiclePlate" Label="Placa do veículo" Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_form.Purpose" Label="Motivo da visita" Variant="Variant.Outlined" />
            </div>

            <MudText Typo="Typo.subtitle2" Class="mobile-section-label">Validade do acesso</MudText>
            <div class="mobile-date-grid">
                <MudDatePicker @bind-Date="_fromDate" Label="Data inicial" Variant="Variant.Outlined" MinDate="DateTime.Today" />
                <MudTimePicker @bind-Time="_fromTime" Label="Hora inicial" Variant="Variant.Outlined" />
                <MudDatePicker @bind-Date="_toDate" Label="Data final" Variant="Variant.Outlined" MinDate="DateTime.Today" />
                <MudTimePicker @bind-Time="_toTime" Label="Hora final" Variant="Variant.Outlined" />
            </div>
            <MudNumericField T="int?" @bind-Value="_form.MaxUses" Label="Limite de utilizações" Variant="Variant.Outlined" Min="1" Max="100" Class="mt-3" />

            @if (_routes.Count > 0)
            {
                <div class="visitor-route-heading"><div><MudText Typo="Typo.subtitle2">Rotas e horários</MudText><small>O convite só funcionará nos acessos selecionados.</small></div></div>
                <div class="visitor-route-list">
                    @foreach (var route in EligibleRoutes)
                    {
                        var selected = _selectedRoutes.Contains(route.Id);
                        <button type="button" class="visitor-route-option @(selected ? "active" : "")" @onclick="() => ToggleRoute(route.Id)">
                            <span class="visitor-route-check"><MudIcon Icon="@(selected ? Icons.Material.Filled.Check : Icons.Material.Outlined.Add)" /></span>
                            <span><strong>@route.Name</strong><small>@DaysLabel(route.DaysOfWeekMask) · @route.StartTime.ToString(@"hh\:mm")–@route.EndTime.ToString(@"hh\:mm")</small></span>
                            <em><MudIcon Icon="@Icons.Material.Outlined.SensorDoor" /> @route.Devices.Count</em>
                        </button>
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_facialInvite ? Icons.Material.Outlined.Send : Icons.Material.Outlined.QrCode2)"
                   Disabled="@(_loading || _saving)" OnClick="SaveAsync">@(_saving ? "Criando..." : _facialInvite ? "Criar convite facial" : "Gerar QR Code")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }

    private readonly ConciergeVisitFormViewModel _form = new() { CredentialType = 2, MaxUses = 1 };
    private readonly HashSet<Guid> _selectedRoutes = [];
    private List<HostOption> _hosts = [];
    private List<AccessRouteViewModel> _routes = [];
    private DateTime? _fromDate = DateTime.Today;
    private TimeSpan? _fromTime = DateTime.Now.AddMinutes(5).TimeOfDay;
    private DateTime? _toDate = DateTime.Today;
    private TimeSpan? _toTime = DateTime.Now.AddHours(4).TimeOfDay;
    private bool _facialAvailable;
    private bool _facialInvite;
    private bool _loading;
    private bool _saving;
    private string _error = string.Empty;
    private List<AccessRouteViewModel> EligibleRoutes => _routes.Where(route => !_facialInvite || RouteSupportsFace(route)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var structureTask = Api.GetStructureAsync(LicenseId);
        var routesTask = Api.GetAccessRoutesAsync(LicenseId);
        await Task.WhenAll(structureTask, routesTask);
        _loading = false;
        var structure = await structureTask;
        var routes = await routesTask;
        if (!structure.Success || structure.Value is null)
        {
            _error = structure.Error ?? "Não foi possível carregar os moradores.";
            return;
        }

        _hosts = structure.Value.Blocks
            .SelectMany(block => block.Units.SelectMany(unit => unit.Residents.Select(resident =>
                new HostOption(resident.Id, resident.Name, $"{block.Name}/{unit.Number}"))))
            .Where(host => host.Id != Guid.Empty)
            .OrderBy(host => host.Name)
            .ToList();
        _form.HostResidentId = MobileVisitorSelection.ResolveHost(_hosts.Select(host => host.Id));
        _routes = routes.Value?.Where(route => route.IsActive && route.AllowTemporary).OrderBy(route => route.Name).ToList() ?? [];
        _facialAvailable = _routes.Any(RouteSupportsFace);
        foreach (var route in _routes) _selectedRoutes.Add(route.Id);
        if (_hosts.Count == 0) _error = "Cadastre um morador antes de criar a visita.";
        else if (!routes.Success) _error = routes.Error ?? "Não foi possível carregar as rotas de acesso.";
    }

    private void SelectAccess(bool facial)
    {
        if (facial && !_facialAvailable) return;
        _facialInvite = facial;
        _selectedRoutes.RemoveWhere(id => !EligibleRoutes.Any(route => route.Id == id));
        if (_selectedRoutes.Count == 0)
            foreach (var route in EligibleRoutes) _selectedRoutes.Add(route.Id);
    }

    private void ToggleRoute(Guid routeId)
    {
        if (!_selectedRoutes.Add(routeId)) _selectedRoutes.Remove(routeId);
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _error = Validate();
        if (!string.IsNullOrWhiteSpace(_error)) return;

        _form.ValidFrom = _fromDate!.Value.Date.Add(_fromTime ?? TimeSpan.Zero);
        _form.ValidTo = _toDate!.Value.Date.Add(_toTime ?? TimeSpan.Zero);
        _form.VehiclePlate = _form.VehiclePlate.Trim().ToUpperInvariant();
        _form.CredentialType = _facialInvite ? 1 : 2;
        _form.CreateFacialInvite = _facialInvite;
        _form.RouteIds = _selectedRoutes.ToList();
        _saving = true;
        var result = await Api.CreateConciergeVisitAsync(LicenseId, _form);
        _saving = false;
        if (!result.Success)
        {
            _error = result.Error ?? "Não foi possível autorizar a visita.";
            return;
        }
        Dialog.Close(DialogResult.Ok(result.Value));
    }

    private string Validate()
    {
        if (_form.HostResidentId == Guid.Empty) return "Selecione o morador anfitrião.";
        if (string.IsNullOrWhiteSpace(_form.VisitorName)) return "Informe o nome do visitante.";
        if (_facialInvite && !_facialAvailable) return "Nenhuma rota com reconhecimento facial está disponível.";
        if (EligibleRoutes.Count > 0 && _selectedRoutes.Count == 0) return "Selecione pelo menos uma rota permitida.";
        if (!_fromDate.HasValue || !_toDate.HasValue) return "Informe o início e o fim da autorização.";
        var from = _fromDate.Value.Date.Add(_fromTime ?? TimeSpan.Zero);
        var to = _toDate.Value.Date.Add(_toTime ?? TimeSpan.Zero);
        if (to <= from) return "O término deve ser posterior ao início.";
        if (to <= DateTime.Now) return "A autorização precisa terminar no futuro.";
        if (to > from.AddDays(30)) return "A validade máxima de uma visita é de 30 dias.";
        if (_form.MaxUses is <= 0 or > 100) return "O limite deve ficar entre 1 e 100 utilizações.";
        return string.Empty;
    }

    private static bool RouteSupportsFace(AccessRouteViewModel route) => route.Devices.Any(device =>
        device.IsActive && DeviceCatalog.FindByApiModel(device.DeviceType)?.Category.Contains("fac", StringComparison.OrdinalIgnoreCase) == true);

    private static string DaysLabel(int mask)
    {
        if (mask == 127) return "Todos os dias";
        var days = new[] { "dom", "seg", "ter", "qua", "qui", "sex", "sáb" };
        return string.Join(", ", days.Where((_, index) => (mask & (1 << index)) != 0));
    }

    private void Cancel() => Dialog.Cancel();
    private sealed record HostOption(Guid Id, string Name, string Location);
}
