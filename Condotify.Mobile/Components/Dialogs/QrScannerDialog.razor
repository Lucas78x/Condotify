@implements IAsyncDisposable
@inject MobileOfflineOperationsService OfflineOperations
@inject MobileDeviceActions DeviceActions
@inject MobileQrScanner Scanner

<MudDialog Class="mobile-dialog qr-scanner-dialog">
    <TitleContent>
        <div class="mobile-dialog-title">
            <MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner" Color="Color.Primary" />
            <div><MudText Typo="Typo.h6">Ler convite</MudText><MudText Typo="Typo.caption">Aponte a câmera para o QR Code do visitante.</MudText></div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="qr-camera-shell">
            <div class="qr-scan-frame"><span></span><span></span><span></span><span></span></div>
            <div class="qr-camera-state">
                @if (_starting)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Inherit" />
                    <span>Abrindo câmera segura...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" Size="Size.Large" />
                    <span>Use a câmera nativa para ler o convite.</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.QrCodeScanner" OnClick="StartScannerAsync">Abrir câmera</MudButton>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="@(_error ? Severity.Warning : Severity.Info)" Variant="Variant.Outlined" Dense="true" Class="mt-3">@_message</MudAlert>
        }

        <div class="qr-manual-entry">
            <MudText Typo="Typo.subtitle2">Código manual</MudText>
            <MudText Typo="Typo.caption">Use quando a câmera não conseguir reconhecer o convite.</MudText>
            <MudTextField T="string" @bind-Value="_manualCode" Placeholder="VIS-... ou link do convite" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Password" Immediate="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_processing" OnClick="CancelAsync">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Login"
                   Disabled="@(_processing || string.IsNullOrWhiteSpace(_manualCode))" OnClick="SubmitManualAsync">
            @(_processing ? "Validando..." : "Registrar entrada")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }

    private bool _starting;
    private bool _processing;
    private bool _error;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetimeCts = new();
    private string _message = string.Empty;
    private string _manualCode = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await StartScannerAsync();
    }

    private async Task StartScannerAsync()
    {
        if (_disposed || _starting) return;
        _starting = true;
        _error = false;
        _message = string.Empty;
        await InvokeAsync(StateHasChanged);

        var permission = await DeviceActions.RequestCameraAsync();
        if (!permission)
        {
            _starting = false;
            _error = true;
            _message = "Permissão da câmera negada. Você ainda pode digitar o código do convite.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var result = await Scanner.ScanAsync(_lifetimeCts.Token);
        if (_disposed) return;
        _starting = false;
        if (result.Success && !string.IsNullOrWhiteSpace(result.Code))
        {
            _manualCode = result.Code;
            await InvokeAsync(StateHasChanged);
            await ValidateAsync(result.Code);
            return;
        }

        _error = result.Message != "Leitura cancelada.";
        _message = result.Message == "Leitura cancelada."
            ? "Leitura cancelada. Abra a câmera novamente ou digite o código do convite."
            : result.Message;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCodeDetected(string code)
    {
        if (_disposed) return;
        _manualCode = code;
        await InvokeAsync(StateHasChanged);
        await ValidateAsync(code);
    }

    private Task SubmitManualAsync() => ValidateAsync(_manualCode);

    private async Task ValidateAsync(string code)
    {
        if (_disposed || _processing || string.IsNullOrWhiteSpace(code)) return;
        _processing = true;
        _error = false;
        _message = "Validando autorização...";
        await InvokeAsync(StateHasChanged);

        MobileQrScanOutcome result;
        try
        {
            result = await OfflineOperations.ScanQrAsync(LicenseId, code.Trim(), _lifetimeCts.Token);
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            return;
        }
        if (_disposed) return;
        if (!result.Success || result.Visit is null)
        {
            _processing = false;
            _error = true;
            _message = result.Message;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _message = result.WasOffline
            ? "Entrada autorizada offline. Registro protegido na fila de sincronização."
            : "Entrada autorizada e confirmada pela central.";
        _error = false;
        await InvokeAsync(StateHasChanged);
        DeviceActions.Confirm();
        if (result.WasOffline)
        {
            try { await Task.Delay(650, _lifetimeCts.Token); }
            catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested) { return; }
        }
        if (_disposed) return;
        Dialog.Close(DialogResult.Ok(result.Visit));
    }

    private async Task CancelAsync()
    {
        await Task.CompletedTask;
        Dialog.Cancel();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _lifetimeCts.Cancel();
        await Task.CompletedTask;
        _lifetimeCts.Dispose();
    }
}
