@inject CondotifyApiClient Api

<MudDialog Class="mobile-dialog">
    <TitleContent>
        <div class="mobile-dialog-title">
            <MudIcon Icon="@Icons.Material.Outlined.PersonAdd" Color="Color.Primary" />
            <div><MudText Typo="Typo.h6">Nova pessoa</MudText><MudText Typo="Typo.caption">Vincule o cadastro a uma unidade do condomínio.</MudText></div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <div class="mobile-form-grid">
            <MudSelect T="Guid" @bind-Value="_form.UnitId" Label="Unidade" Variant="Variant.Outlined" Required="true">
                @foreach (var unit in Units)
                {
                    <MudSelectItem T="Guid" Value="@unit.Id">@unit.Label</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" @bind-Value="_form.AccessType" Label="Tipo de pessoa" Variant="Variant.Outlined">
                <MudSelectItem T="int" Value="0">Morador</MudSelectItem>
                <MudSelectItem T="int" Value="1">Responsável</MudSelectItem>
                <MudSelectItem T="int" Value="2">Morador não responsável</MudSelectItem>
                <MudSelectItem T="int" Value="3">Convidado</MudSelectItem>
                <MudSelectItem T="int" Value="4">Prestador de serviço</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" @bind-Value="_form.Name" Label="Nome completo" Variant="Variant.Outlined" Required="true" />
            <MudTextField T="string" @bind-Value="_form.CPF" Label="CPF" Variant="Variant.Outlined" />
            <MudTextField T="string" @bind-Value="_form.Email" Label="E-mail" Variant="Variant.Outlined" InputType="InputType.Email" />
            <MudTextField T="string" @bind-Value="_form.PhoneNumber" Label="Telefone" Variant="Variant.Outlined" InputType="InputType.Telephone" />
            <MudTextField T="string" @bind-Value="_form.Description" Label="Observações" Variant="Variant.Outlined" Lines="2" />
        </div>
        <div class="mobile-switch-row">
            <div><strong>Acesso temporário</strong><small>Defina uma data automática de expiração.</small></div>
            <MudSwitch T="bool" @bind-Value="_form.Temporary" Color="Color.Primary" />
        </div>
        @if (_form.Temporary)
        {
            <MudDatePicker @bind-Date="_expire" Label="Válido até" Variant="Variant.Outlined" MinDate="DateTime.Today" Class="mt-3" />
        }
        <div class="mobile-switch-row">
            <div><strong>Notificar acessos</strong><small>Envia aviso quando a pessoa utilizar uma credencial.</small></div>
            <MudSwitch T="bool" @bind-Value="_form.NotifyAccess" Color="Color.Primary" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_saving" OnClick="SaveAsync">
            @(_saving ? "Salvando..." : "Cadastrar pessoa")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid LicenseId { get; set; }
    [Parameter, EditorRequired] public LicenseStructureViewModel Structure { get; set; } = null!;
    private readonly ResidentFormViewModel _form = new() { Relationship = 0 };
    private DateTime? _expire = DateTime.Today.AddMonths(1);
    private bool _saving;
    private string _error = string.Empty;
    private IEnumerable<UnitOption> Units => Structure.Blocks
        .SelectMany(block => block.Units
            .Where(unit => unit.Id != Guid.Empty)
            .Select(unit => new UnitOption(unit.Id, unit.Number, $"{block.Name} · {Structure.UnitLabelSingular} {unit.Number}")))
        .OrderBy(unit => unit.Label);

    protected override void OnInitialized() =>
        _form.UnitId = Units.Select(unit => unit.Id).FirstOrDefault();

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (_form.UnitId == Guid.Empty) { _error = "Selecione uma unidade."; return; }
        if (string.IsNullOrWhiteSpace(_form.Name)) { _error = "Informe o nome da pessoa."; return; }
        if (_form.Temporary && (!_expire.HasValue || _expire.Value.Date < DateTime.Today)) { _error = "Informe uma expiração válida."; return; }
        var selected = Units.FirstOrDefault(unit => unit.Id == _form.UnitId);
        if (selected is null) { _error = "A unidade selecionada não pertence a este condomínio."; return; }
        _form.ApartmentNumber = selected.Number;
        _form.Expire = _form.Temporary ? _expire?.Date.AddDays(1).AddTicks(-1) : null;
        _form.Relationship = _form.AccessType switch { 1 => 3, 2 => 0, 3 => 0, 4 => 0, _ => 0 };
        _saving = true;
        var result = await Api.CreateResidentAsync(LicenseId, _form);
        _saving = false;
        if (!result.Success) { _error = result.Error ?? "Não foi possível cadastrar a pessoa."; return; }
        Dialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => Dialog.Cancel();
    private sealed record UnitOption(Guid Id, string Number, string Label);
}
