@inject MobileDeviceActions DeviceActions
@inject MobileAppState AppState
@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<MudDialog Class="mobile-dialog visitor-pass-dialog">
    <TitleContent>
        <div class="mobile-dialog-title">
            <MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" Color="Color.Primary" />
            <div><MudText Typo="Typo.h6">Convite de acesso</MudText><MudText Typo="Typo.caption">Apresente este QR Code na portaria.</MudText></div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="visitor-pass-hero">
            <div class="visitor-pass-head">
                <span class="visitor-pass-brand"><span class="visitor-pass-logo">F&amp;F</span> F&amp;F Access</span>
                <span class="visitor-pass-status"><i></i> Acesso temporário</span>
            </div>
            <div class="visitor-pass-person"><small>VISITANTE</small><strong>@Visit.VisitorName</strong><span>@Visit.BlockName @(!string.IsNullOrWhiteSpace(Visit.UnitNumber) ? $"· {AppState.UnitLabelSingular} {Visit.UnitNumber}" : string.Empty)</span></div>
            @if (!string.IsNullOrWhiteSpace(QrDataUri))
            {
                <div class="visitor-pass-qr"><span class="visitor-pass-qr-corner top-left"></span><span class="visitor-pass-qr-corner top-right"></span><img src="@QrDataUri" alt="QR Code do convite de @Visit.VisitorName" /><span class="visitor-pass-qr-corner bottom-left"></span><span class="visitor-pass-qr-corner bottom-right"></span></div>
                <div class="visitor-pass-scan-hint"><MudIcon Icon="@Icons.Material.Outlined.CenterFocusStrong" /> Aponte a câmera para o QR Code</div>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">O QR Code ainda não foi disponibilizado.</MudAlert>
            }
            <div class="visitor-pass-validity"><span><small>ENTRADA A PARTIR DE</small><strong>@Visit.ValidFrom.ToLocalTime().ToString("dd/MM · HH:mm")</strong></span><span><small>VÁLIDO ATÉ</small><strong>@Visit.ValidTo.ToLocalTime().ToString("dd/MM · HH:mm")</strong></span></div>
            <div class="visitor-pass-code"><small>CÓDIGO MANUAL</small><code>@Visit.CredentialCode</code></div>
        </div>
        <div class="visitor-pass-security"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /><span><strong>Convite pessoal e protegido</strong><small>A portaria valida horário, situação e limite de utilizações.</small></span></div>

        @if (AllowDigitalPass)
        {
            <section class="visitor-pass-wallet">
                <div class="visitor-pass-wallet-heading"><MudIcon Icon="@Icons.Material.Outlined.Wallet" /><div><strong>Passe digital F&amp;F Access</strong><small>Adicione esta autorização a uma carteira compatível no seu celular.</small></div></div>
                @if (_pass is null && !_hasActivePass)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Outlined.AddCard" Disabled="_issuing" OnClick="IssuePassAsync">@(_issuing ? "Emitindo..." : "Adicionar à carteira")</MudButton>
                }
                else
                {
                    @if (_pass is not null)
                    {
                        <div class="visitor-pass-wallet-buttons">
                            @if (_pass.GoogleWalletConfigured) { <MudButton Href="@_pass.GoogleWalletUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Outlined.Wallet">Google Wallet</MudButton> }
                            @if (_pass.AppleWalletConfigured) { <MudButton Href="@_pass.AppleWalletUrl" Target="_blank" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Outlined.PhoneIphone">Apple Wallet</MudButton> }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">Este convite já tem um passe ativo. Gerar um novo link substitui o anterior, que deixa de funcionar.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Outlined.AddCard" Disabled="_issuing" OnClick="IssuePassAsync">@(_issuing ? "Emitindo..." : "Gerar novo link da carteira")</MudButton>
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.LinkOff" Disabled="_revoking" OnClick="RevokePassAsync">@(_revoking ? "Revogando..." : "Revogar passe")</MudButton>
                }
            </section>
        }
    </DialogContent>
    <DialogActions>
        <div class="visitor-pass-actions">
            <MudButton Variant="Variant.Text" OnClick="Close">Fechar</MudButton>
            <div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy" Disabled="@string.IsNullOrWhiteSpace(Visit.CredentialCode)" OnClick="CopyCodeAsync">Copiar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Share" Disabled="@(_sharing || string.IsNullOrWhiteSpace(Visit.CredentialCode))" OnClick="ShareAsync">@(_sharing ? "Preparando..." : "Enviar QR Code")</MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public ConciergeVisitViewModel Visit { get; set; } = null!;
    /// <summary>
    /// Mirrors the license's <c>AllowResidentDigitalPass</c> policy, supplied by
    /// the caller from the resident profile it already holds. The server-side
    /// <c>Forbid()</c> stays the authority - this only avoids showing a button
    /// that could never succeed.
    /// </summary>
    [Parameter] public bool AllowDigitalPass { get; set; } = true;
    private string QrDataUri => QrCodeRenderer.ToPngDataUri(Visit.CredentialCode);
    private DigitalPassViewModel? _pass;
    private bool _hasActivePass;
    private bool _issuing;
    private bool _revoking;
    private bool _sharing;

    /// <summary>
    /// The raw pass token is never persisted (only its hash), so a reopened
    /// dialog cannot rebuild the previous wallet links. It can still learn that
    /// a pass exists, which is what keeps "Revogar passe" reachable without
    /// having to re-issue first.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (!AllowDigitalPass) return;
        var status = await Api.GetResidentDigitalPassStatusAsync(Visit.Id);
        if (status.Success && status.Value is not null) _hasActivePass = status.Value.HasActivePass;
    }

    private async Task ShareAsync()
    {
        _sharing = true;
        try
        {
            var image = await Js.InvokeAsync<string>("condotifyVisitorPass.render", new
            {
                qrDataUri = QrDataUri,
                visitorName = Visit.VisitorName,
                location = FormatLocation(),
                validFrom = Visit.ValidFrom.ToLocalTime().ToString("dd/MM · HH:mm"),
                validTo = Visit.ValidTo.ToLocalTime().ToString("dd/MM · HH:mm")
            });
            await DeviceActions.SharePngDataUriAsync(
                $"Convite para {Visit.VisitorName}", image, $"convite-condotify-{Visit.Id:N}.png");
        }
        catch (Exception)
        {
            Snackbar.Add("Não foi possível preparar a imagem do convite. Tente novamente.", Severity.Error);
        }
        finally
        {
            _sharing = false;
        }
    }

    private async Task CopyCodeAsync()
    {
        await DeviceActions.CopyTextAsync(Visit.CredentialCode);
        DeviceActions.Tap();
        Snackbar.Add("Código copiado.", Severity.Success);
    }

    private string FormatLocation()
    {
        var block = Visit.BlockName?.Trim();
        var unit = Visit.UnitNumber?.Trim();
        if (string.IsNullOrWhiteSpace(block)) return string.IsNullOrWhiteSpace(unit) ? "Acesso autorizado" : $"{AppState.UnitLabelSingular} {unit}";
        return string.IsNullOrWhiteSpace(unit) ? block : $"{block} · {AppState.UnitLabelSingular} {unit}";
    }

    private void Close() => Dialog.Close();

    private async Task IssuePassAsync()
    {
        _issuing = true;
        try
        {
            var result = await Api.IssueResidentDigitalPassAsync(Visit.Id);
            if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível emitir o passe.", Severity.Error); return; }
            _pass = result.Value;
            _hasActivePass = true;
            Snackbar.Add("Passe digital emitido.", Severity.Success);
        }
        finally
        {
            // A deserialization failure escapes the api client's own catch-all;
            // without this the button would stay disabled for the dialog's life.
            _issuing = false;
        }
    }

    private async Task RevokePassAsync()
    {
        _revoking = true;
        try
        {
            var result = await Api.RevokeResidentDigitalPassAsync(Visit.Id);
            if (!result.Success) { Snackbar.Add(result.Error ?? "Não foi possível revogar.", Severity.Error); return; }
            _pass = null;
            _hasActivePass = false;
            Snackbar.Add("Passe revogado.", Severity.Success);
        }
        finally
        {
            _revoking = false;
        }
    }
}
