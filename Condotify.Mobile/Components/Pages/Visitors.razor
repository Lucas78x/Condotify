@page "/visitors"
@page "/visitors/{EntityId:guid}"
@implements IDisposable
@inject MobileAppState AppState
@inject CondotifyApiClient Api
@inject MobileSessionCoordinator Session
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject MobilePullToRefreshState PullToRefresh

<PageTitle>Visitantes | Condotify</PageTitle>
<PageHeader Eyebrow="AUTORIZAÇÕES" Title="Visitantes" Subtitle="@Subtitle">
    <Actions>
        <div class="page-actions">
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="Atualizar" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAddAlt1"
                       Disabled="@(!CanCreate)" OnClick="OpenCreateAsync">Novo visitante</MudButton>
        </div>
    </Actions>
</PageHeader>

<PageState Loading="_loading" Error="@_error" Empty="@(_rows.Count == 0)" EmptyTitle="Nenhum visitante" EmptyText="As autorizações aparecerão aqui." Retry="LoadAsync">
    <div class="visitor-segments" role="group" aria-label="Filtro de visitantes">
        <button type="button" class="@(_view == MobileVisitorView.Today ? "active" : "")" @onclick="() => SetView(MobileVisitorView.Today)">Hoje <span>@ViewCount(MobileVisitorView.Today)</span></button>
        <button type="button" class="@(_view == MobileVisitorView.Upcoming ? "active" : "")" @onclick="() => SetView(MobileVisitorView.Upcoming)">Próximos <span>@ViewCount(MobileVisitorView.Upcoming)</span></button>
        <button type="button" class="@(_view == MobileVisitorView.History ? "active" : "")" @onclick="() => SetView(MobileVisitorView.History)">Histórico <span>@ViewCount(MobileVisitorView.History)</span></button>
    </div>

    <section class="screen-overview visitor-overview visitor-fast-entry">
        <span class="screen-overview-icon info visitor-entry-icon"><MudIcon Icon="@Icons.Material.Outlined.FaceRetouchingNatural" /></span>
        <div class="screen-overview-main">
            <span>Convite antecipado</span>
            <strong>Entrada mais rápida</strong>
            <small>Envie QR Code ou convite facial. O visitante prepara tudo antes da chegada.</small>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Disabled="@(!CanCreate)" OnClick="OpenCreateAsync">Criar convite</MudButton>
    </section>

    <div class="directory-toolbar">
        <MudTextField @bind-Value="_search"
                      Immediate="true"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Placeholder="Buscar visitante, anfitrião, unidade ou placa"
                      aria-label="Buscar visitante" />
    </div>

    <section class="content-panel card-list-panel visitor-list-panel">
        <div class="panel-heading"><div><MudText Typo="Typo.h5">@ListTitle</MudText><span class="panel-subtitle">@FilteredRows.Count() registro(s) encontrado(s)</span></div></div>
        @if (!FilteredRows.Any())
        {
            <div class="page-state compact-state"><MudIcon Icon="@Icons.Material.Outlined.SearchOff" Color="Color.Secondary" Size="Size.Large" /><MudText>Nenhum resultado para esta busca.</MudText></div>
        }
        @foreach (var visit in FilteredRows)
        {
            <div class="list-row visitor-row">
                @if (_photos.TryGetValue(visit.Id, out var photo))
                {
                    <MudAvatar Class="photo-avatar"><img src="@photo" alt="" /></MudAvatar>
                }
                else
                {
                    <MudAvatar Color="@StatusColor(visit.Status)" Variant="Variant.Filled"><MudIcon Icon="@Icons.Material.Outlined.Person" /></MudAvatar>
                }
                <div class="list-main">
                    <div class="list-title">@visit.VisitorName</div>
                    <div class="list-meta">@visit.ValidFrom.ToLocalTime().ToString("dd/MM HH:mm") até @visit.ValidTo.ToLocalTime().ToString("dd/MM HH:mm")</div>
                    <div class="visitor-details">
                        <span class="row-status @StatusClass(visit.Status)">@StatusLabel(visit.Status)</span>
                        @if (IsStaff) { <span class="list-meta"><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Size="Size.Small" /> @visit.HostName · @visit.BlockName/@visit.UnitNumber</span> }
                        @if (!string.IsNullOrWhiteSpace(visit.VehiclePlate)) { <span class="list-meta"><MudIcon Icon="@Icons.Material.Outlined.DirectionsCar" Size="Size.Small" /> @visit.VehiclePlate</span> }
                    </div>
                </div>
                @if (IsStaff && visit.Status == "PendingApproval")
                {
                    <div class="row-actions">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DecideAsync(visit, false)">Recusar</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="() => DecideAsync(visit, true)">Aprovar</MudButton>
                    </div>
                }
                else
                {
                    <div class="row-actions visitor-pass-actions">
                        @if (visit.CredentialType.Equals("QrCode", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(visit.CredentialCode) && visit.Status is not "Denied" and not "Canceled")
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.QrCode2" Color="Color.Primary" OnClick="() => OpenPassAsync(visit)" aria-label="Ver e compartilhar QR Code" />
                        }
                        @if (IsFacialInviteShareable(visit))
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Share" Color="Color.Primary" OnClick="() => ShareFacialInviteAsync(visit)" aria-label="Gerar e compartilhar novo link facial" />
                        }
                        @if (!IsStaff)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Replay" Color="Color.Secondary" OnClick="() => RepeatVisitAsync(visit)" aria-label="Repetir esta visita" />
                        }
                    </div>
                }
            </div>
        }
    </section>
</PageState>

@code {
    [Parameter] public Guid? EntityId { get; set; }
    private List<ConciergeVisitViewModel> _rows = [];
    private readonly Dictionary<Guid, string> _photos = new();
    private ResidentProfileViewModel? _profile;
    private CancellationTokenSource? _loadCts;
    private bool _loading;
    private string _error = string.Empty;
    private string _search = string.Empty;
    private MobileVisitorView _view = MobileVisitorView.Today;
    private bool IsStaff => Session.Current?.Principal == MobilePrincipalKind.Staff;
    private bool CanCreate => IsStaff ? AppState.SelectedLicenseId.HasValue : _profile is not null;
    private string Subtitle => IsStaff ? "Autorizações e movimentações de visitantes do condomínio." : "Autorizações vinculadas ao seu cadastro.";
    private string ListTitle => _view switch
    {
        MobileVisitorView.Today => "Chegam hoje",
        MobileVisitorView.Upcoming => "Próximas autorizações",
        _ => "Histórico de acessos"
    };
    private IEnumerable<ConciergeVisitViewModel> FilteredRows => _rows
        .Where(visit => MobileAccessPresentation.MatchesVisitorView(visit, _view, DateTime.Now))
        .Where(MatchesSearch)
        .OrderBy(visit => _view == MobileVisitorView.History ? -visit.ValidFrom.Ticks : visit.ValidFrom.Ticks);

    protected override Task OnInitializedAsync()
    {
        PullToRefresh.Register(LoadAsync);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var cancellationToken = _loadCts.Token;
        _loading = true;
        _error = string.Empty;
        var licenseId = AppState.SelectedLicenseId;

        if (IsStaff)
        {
            if (!licenseId.HasValue)
            {
                _error = "Selecione um condomínio.";
                _loading = false;
                return;
            }
            var result = await Api.GetConciergeVisitsAsync(
                licenseId.Value,
                DateTime.Today.AddDays(-90),
                DateTime.Today.AddDays(91),
                cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;
            if (result.Success)
            {
                _rows = result.Value ?? [];
            }
            else
            {
                var fallback = await Api.GetConciergeDashboardAsync(licenseId.Value, cancellationToken);
                if (cancellationToken.IsCancellationRequested) return;
                _rows = fallback.Value?.Visits ?? [];
                if (!fallback.Success) _error = fallback.Error ?? result.Error ?? "Não foi possível carregar os visitantes.";
            }
        }
        else
        {
            var profileTask = Api.GetResidentProfileAsync(cancellationToken);
            var visitsTask = Api.GetResidentVisitsAsync(cancellationToken);
            await Task.WhenAll(profileTask, visitsTask);
            if (cancellationToken.IsCancellationRequested) return;
            var profileResult = await profileTask;
            var visitsResult = await visitsTask;
            _profile = profileResult.Value;
            _rows = visitsResult.Value ?? [];
            if (!profileResult.Success) _error = profileResult.Error ?? "Não foi possível carregar seu vínculo.";
            else if (!visitsResult.Success) _error = visitsResult.Error ?? "Não foi possível carregar os visitantes.";
        }
        await LoadPhotosAsync(cancellationToken);
        if (cancellationToken.IsCancellationRequested) return;
        _loading = false;
    }

    private async Task LoadPhotosAsync(CancellationToken cancellationToken)
    {
        _photos.Clear();
        if (_rows.Count == 0) return;
        using var concurrency = new SemaphoreSlim(3);
        var requests = _rows.Select(async visit =>
        {
            if (!CondotifyApiClient.TryParseMediaReference(visit.PhotoUrl, out var licenseId, out var mediaId))
                return (visit.Id, Photo: (string?)null);
            await concurrency.WaitAsync(cancellationToken);
            try
            {
                var result = IsStaff
                    ? await Api.GetPersonPhotoAsync(licenseId, mediaId, cancellationToken)
                    : await Api.GetResidentMediaAsync(mediaId, cancellationToken);
                return (visit.Id, Photo: result.Success && !string.IsNullOrWhiteSpace(result.Value) ? result.Value : null);
            }
            finally
            {
                concurrency.Release();
            }
        });
        try
        {
            foreach (var item in await Task.WhenAll(requests))
                if (!string.IsNullOrWhiteSpace(item.Photo)) _photos[item.Id] = item.Photo;
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task OpenCreateAsync()
    {
        if (!CanCreate) return;
        IDialogReference dialog;
        if (IsStaff)
        {
            var parameters = new DialogParameters { [nameof(StaffVisitorDialog.LicenseId)] = AppState.SelectedLicenseId!.Value };
            dialog = await Dialogs.ShowAsync<StaffVisitorDialog>(string.Empty, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true });
        }
        else
        {
            var parameters = new DialogParameters { [nameof(ResidentVisitorDialog.Profile)] = _profile! };
            dialog = await Dialogs.ShowAsync<ResidentVisitorDialog>(string.Empty, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true });
        }
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        var created = result?.Data as ConciergeVisitViewModel;
        Snackbar.Add(created?.CredentialType.Equals("Face", StringComparison.OrdinalIgnoreCase) == true
            ? "Convite facial pronto para compartilhar."
            : "Visitante autorizado. O QR Code está pronto para compartilhar.", Severity.Success);
        _view = MobileVisitorView.Today;
        await LoadAsync();
        if (created is not null)
        {
            if (!string.IsNullOrWhiteSpace(created.FacialInviteUrl)) await OpenFacialInviteAsync(created, created.FacialInviteUrl);
            else if (created.CredentialType.Equals("QrCode", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(created.CredentialCode)) await OpenPassAsync(created);
        }
    }

    private async Task OpenPassAsync(ConciergeVisitViewModel visit)
    {
        // The wallet block talks to the resident-scoped endpoints, so it is only
        // meaningful when a resident profile is loaded (never for staff) and the
        // license still allows resident self-issue.
        var parameters = new DialogParameters
        {
            [nameof(VisitorPassDialog.Visit)] = visit,
            [nameof(VisitorPassDialog.AllowDigitalPass)] = _profile?.AllowResidentDigitalPass == true
        };
        await Dialogs.ShowAsync<VisitorPassDialog>(string.Empty, parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true });
    }

    private async Task ShareFacialInviteAsync(ConciergeVisitViewModel visit)
    {
        ApiResult<VisitFacialInviteIssuedViewModel> result;
        if (IsStaff)
        {
            if (!AppState.SelectedLicenseId.HasValue) return;
            result = await Api.ReissueConciergeFacialInviteAsync(AppState.SelectedLicenseId.Value, visit.Id);
        }
        else
        {
            result = await Api.ReissueResidentFacialInviteAsync(visit.Id);
        }

        if (!result.Success || result.Value is null)
        {
            Snackbar.Add(result.Error ?? "Não foi possível gerar um novo link facial.", Severity.Error);
            return;
        }

        visit.FacialInviteStatus = result.Value.Status;
        await OpenFacialInviteAsync(visit, result.Value.InviteUrl);
        await LoadAsync();
    }

    private async Task OpenFacialInviteAsync(ConciergeVisitViewModel visit, string inviteUrl)
    {
        var parameters = new DialogParameters
        {
            [nameof(FacialInviteShareDialog.Visit)] = visit,
            [nameof(FacialInviteShareDialog.InviteUrl)] = inviteUrl
        };
        await Dialogs.ShowAsync<FacialInviteShareDialog>(string.Empty, parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true });
    }

    private async Task RepeatVisitAsync(ConciergeVisitViewModel visit)
    {
        if (_profile is null) return;
        var parameters = new DialogParameters
        {
            [nameof(ResidentVisitorDialog.Profile)] = _profile,
            [nameof(ResidentVisitorDialog.Template)] = visit
        };
        var dialog = await Dialogs.ShowAsync<ResidentVisitorDialog>(string.Empty, parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        Snackbar.Add("Nova autorização criada com os dados anteriores.", Severity.Success);
        _view = MobileVisitorView.Today;
        await LoadAsync();
        if (result.Data is ConciergeVisitViewModel created)
        {
            if (!string.IsNullOrWhiteSpace(created.FacialInviteUrl)) await OpenFacialInviteAsync(created, created.FacialInviteUrl);
            else if (created.CredentialType.Equals("QrCode", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(created.CredentialCode)) await OpenPassAsync(created);
        }
    }

    private void SetView(MobileVisitorView view)
    {
        _view = view;
        _search = string.Empty;
    }

    private int ViewCount(MobileVisitorView view) => _rows.Count(visit => MobileAccessPresentation.MatchesVisitorView(visit, view, DateTime.Now));

    private async Task DecideAsync(ConciergeVisitViewModel visit, bool approved)
    {
        var licenseId = AppState.SelectedLicenseId;
        if (!licenseId.HasValue) return;
        var result = await Api.DecideConciergeVisitAsync(licenseId.Value, visit.Id, approved, string.Empty);
        Snackbar.Add(result.Success ? (approved ? "Visita aprovada." : "Visita recusada.") : result.Error ?? "Falha na operação.", result.Success ? Severity.Success : Severity.Error);
        if (result.Success) await LoadAsync();
    }

    private bool MatchesSearch(ConciergeVisitViewModel visit) => string.IsNullOrWhiteSpace(_search) || new[] { visit.VisitorName, visit.HostName, visit.BlockName, visit.UnitNumber, visit.VehiclePlate, visit.Document }.Any(x => x?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) == true);
    private static bool IsFacialInviteShareable(ConciergeVisitViewModel visit) =>
        visit.CredentialType.Equals("Face", StringComparison.OrdinalIgnoreCase) &&
        visit.Status is not "Denied" and not "Canceled" and not "CheckedOut" &&
        visit.FacialInviteStatus is not "Completed";
    private static Color StatusColor(string status) => status switch { "CheckedIn" => Color.Success, "PendingApproval" or "PendingEnrollment" => Color.Warning, "Denied" or "Canceled" => Color.Error, _ => Color.Primary };
    private static string StatusClass(string status) => status switch { "CheckedIn" => "success", "PendingApproval" or "PendingEnrollment" => "warning", "Denied" or "Canceled" => "error", _ => "info" };
    private static string StatusLabel(string status) => status switch { "CheckedIn" => "No condomínio", "PendingApproval" => "Aguardando aprovação", "PendingEnrollment" => "Aguardando foto facial", "Denied" => "Recusada", "Canceled" => "Cancelada", "Expected" or "Scheduled" => "Prevista", "CheckedOut" => "Finalizada", _ => status };

    public void Dispose()
    {
        PullToRefresh.Unregister(LoadAsync);
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
