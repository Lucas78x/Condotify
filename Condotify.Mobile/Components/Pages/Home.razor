@page "/"
@page "/home"
@implements IDisposable
@inject MobileSessionCoordinator Session
@inject MobileAppState AppState
@inject CondotifyApiClient Api
@inject MobileWeatherService Weather
@inject MobileOfflineCache OfflineCache

<PageTitle>Início | Condotify</PageTitle>

<section class="home-hero">
    <div class="home-hero-heading">
        <div>
            <span class="home-kicker">@ContextName</span>
            <h1>@Greeting</h1>
            <span class="home-question">@HomeQuestion</span>
        </div>
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="Atualizar início" />
    </div>
    <div class="home-conditions">
        <MudIcon Icon="@(_weather?.IconKey ?? Icons.Material.Outlined.Schedule)" Size="Size.Small" />
        @if (_weather is not null)
        {
            <span>@Math.Round(_weather.TemperatureC)°C · @_weather.Description</span>
            <span class="home-conditions-sep">·</span>
        }
        <span>@CurrentDateLabel</span>
    </div>
</section>

<PageState Loading="_loading" Error="@_error" Retry="LoadAsync">
    @if (_cachedAt.HasValue)
    {
        <div class="offline-cache-notice"><MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Small" /><span>Exibindo o último resumo salvo em @_cachedAt.Value.ToLocalTime().ToString("dd/MM HH:mm"). Atualize quando a conexão voltar.</span></div>
    }
    @if (Session.Current?.Principal == MobilePrincipalKind.Resident)
    {
        <a class="home-primary-action" href="/visitors">
            <span class="home-primary-icon"><MudIcon Icon="@Icons.Material.Outlined.PersonAddAlt1" /></span>
            <span class="home-primary-copy"><strong>Autorizar visitante</strong><small>Crie um acesso e compartilhe o convite</small></span>
            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
        </a>

        <section class="home-section">
            <div class="home-section-heading"><MudText Typo="Typo.h5">Seu dia</MudText><a href="/more">Ver tudo</a></div>
            <div class="home-highlight-grid">
                <a class="home-highlight warning" href="/notifications"><span class="home-highlight-icon"><MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" /></span><strong>@(_notifications?.Unread ?? 0) novidade(s)</strong><small>Veja as atualizações da sua rotina</small></a>
                @if (ModuleOn(Condotify.Models.LicenseModuleEnum.Bookings))
                {
                    <a class="home-highlight success" href="/bookings"><span class="home-highlight-icon"><MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" /></span><strong>@(_resident?.Units.Count ?? 0) unidade(s)</strong><small>Reservas e áreas comuns</small></a>
                }
            </div>
        </section>

        <section class="content-panel home-panel">
            <div class="panel-heading"><div><MudText Typo="Typo.h5">Minhas unidades</MudText><span class="panel-subtitle">Vínculos ativos no condomínio</span></div></div>
            @foreach (var unit in _resident?.Units ?? [])
            {
                <div class="list-row">
                    <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled"><MudIcon Icon="@Icons.Material.Outlined.MeetingRoom" /></MudAvatar>
                    <div class="list-main"><div class="list-title">@unit.BlockName / @unit.Number</div><div class="list-meta">@unit.Relationship @(!string.IsNullOrWhiteSpace(unit.Floor) ? $"- andar {unit.Floor}" : "")</div></div>
                    @if (unit.IsPrimary) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Principal</MudChip> }
                </div>
            }
        </section>
    }
    else
    {
        <a class="home-primary-action" href="/concierge">
            <span class="home-primary-icon"><MudIcon Icon="@Icons.Material.Outlined.SensorDoor" /></span>
            <span class="home-primary-copy"><strong>Abrir central da portaria</strong><small>Visitantes, aprovações e movimentações</small></span>
            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
        </a>

        <section class="home-section">
            <div class="home-section-heading"><MudText Typo="Typo.h5">Operação agora</MudText><a href="/more">Ver tudo</a></div>
            <div class="home-highlight-grid">
                @if (ModuleOn(Condotify.Models.LicenseModuleEnum.Incidents))
                {
                    <a class="home-highlight warning" href="/alerts"><span class="home-highlight-icon"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /></span><strong>@(_dashboard?.Alerts.Count ?? 0) alerta(s)</strong><small>Ocorrências que pedem atenção</small></a>
                }
                @if (ModuleOn(Condotify.Models.LicenseModuleEnum.Devices))
                {
                    <a class="home-highlight success" href="/devices"><span class="home-highlight-icon"><MudIcon Icon="@Icons.Material.Outlined.Sensors" /></span><strong>@(_dashboard?.OnlineDeviceCount ?? 0)/@(_dashboard?.DeviceCount ?? 0) online</strong><small>Estado dos equipamentos</small></a>
                }
            </div>
        </section>

        <section class="content-panel home-panel">
            <div class="panel-heading"><div><MudText Typo="Typo.h5">Atividade recente</MudText><span class="panel-subtitle">Últimos eventos sincronizados</span></div></div>
            @if (_dashboard?.RecentActivities.Count == 0)
            {
                <div class="page-state"><MudText Color="Color.Secondary">Nenhuma atividade recente.</MudText></div>
            }
            @foreach (var activity in _dashboard?.RecentActivities.Take(8) ?? [])
            {
                <div class="list-row"><div class="status-dot @(activity.Status.Contains("Success", StringComparison.OrdinalIgnoreCase) ? "online" : "warning")"></div><div class="list-main"><div class="list-title">@activity.Summary</div><div class="list-meta">@activity.LicenseName - @activity.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div></div></div>
            }
        </section>
    }
</PageState>

@code {
    private bool _loading;
    private string _error = string.Empty;
    private OperationalDashboardViewModel? _dashboard;
    private ResidentProfileViewModel? _resident;
    private MobileNotificationPageViewModel? _notifications;
    private CancellationTokenSource _loadCts = new();
    private WeatherSnapshot? _weather;
    private DateTimeOffset? _cachedAt;
    private string Greeting => $"Olá, {FirstName}";
    private string FirstName => (Session.Current?.Name ?? "Usuário").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";
    private string ContextName => Session.Current?.Principal == MobilePrincipalKind.Resident
        ? Session.Current?.LicenseName ?? "Meu condomínio"
        : AppState.SelectedLicense?.Nome ?? "Central operacional";
    private string HomeQuestion => Session.Current?.Principal == MobilePrincipalKind.Resident
        ? "O que você precisa hoje?"
        : "Como está a operação agora?";
    private string CurrentDateLabel => DateTime.Now.ToString("dd/MM · HH:mm");
    private long EnabledModules => Session.Current?.Principal == MobilePrincipalKind.Resident
        ? AppState.ResidentEnabledModules
        : AppState.SelectedLicense?.EnabledModules ?? (long)Condotify.Models.LicenseModuleEnum.All;
    private bool ModuleOn(Condotify.Models.LicenseModuleEnum module) => (EnabledModules & (long)module) != 0;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current?.Principal == MobilePrincipalKind.Staff && AppState.Licenses.Count == 0)
            await AppState.LoadLicensesAsync();
        await LoadAsync();
    }

    private async Task LoadWeatherAsync(CancellationToken cancellationToken)
    {
        var snapshot = await Weather.GetCurrentWeatherAsync(cancellationToken);
        if (cancellationToken.IsCancellationRequested) return;
        _weather = snapshot;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loadCts.Cancel();
        _loadCts.Dispose();
        _loadCts = new CancellationTokenSource();
        var cancellationToken = _loadCts.Token;
        _loading = true; _error = string.Empty;
        _cachedAt = null;
        _ = LoadWeatherAsync(cancellationToken);
        if (Session.Current?.Principal == MobilePrincipalKind.Resident)
        {
            var profileTask = Api.GetResidentProfileAsync(cancellationToken);
            var notificationsTask = Api.GetMobileNotificationsAsync(1, 5, cancellationToken);
            await Task.WhenAll(profileTask, notificationsTask);
            if (cancellationToken.IsCancellationRequested) return;
            var profile = await profileTask;
            var notifications = await notificationsTask;
            _resident = profile.Value;
            _notifications = notifications.Value;
            if (profile.Success && profile.Value is not null)
            {
                await OfflineCache.SaveAsync(ResidentCacheKey, new ResidentHomeCache(profile.Value, notifications.Value));
                AppState.SetResidentModules(profile.Value.EnabledModules);
            }
            else
            {
                var cached = await OfflineCache.LoadAsync<ResidentHomeCache>(ResidentCacheKey, TimeSpan.FromHours(24));
                if (cached is not null) { _resident = cached.Value.Profile; _notifications = cached.Value.Notifications; _cachedAt = cached.StoredAt; }
                else _error = profile.Error ?? "Não foi possível carregar seu cadastro.";
            }
        }
        else
        {
            var result = await Api.GetOperationalDashboardAsync(cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;
            _dashboard = result.Value;
            if (result.Success && result.Value is not null) await OfflineCache.SaveAsync(StaffCacheKey, result.Value);
            else
            {
                var cached = await OfflineCache.LoadAsync<OperationalDashboardViewModel>(StaffCacheKey, TimeSpan.FromHours(12));
                if (cached is not null) { _dashboard = cached.Value; _cachedAt = cached.StoredAt; }
                else _error = result.Error ?? "Não foi possível carregar o resumo operacional.";
            }
        }
        _loading = false;
    }

    private string ResidentCacheKey => MobileOfflineCache.ResidentHomeKey(Session.Current?.SubjectId ?? Guid.Empty, Session.Current?.LicenseId);
    private string StaffCacheKey => MobileOfflineCache.StaffHomeKey(Session.Current?.SubjectId ?? Guid.Empty, AppState.SelectedLicenseId);
    private sealed record ResidentHomeCache(ResidentProfileViewModel Profile, MobileNotificationPageViewModel? Notifications);

    public void Dispose()
    {
        _loadCts.Cancel();
        _loadCts.Dispose();
    }
}
