@page "/notifications"
@implements IDisposable
@inject CondotifyApiClient Api
@inject ISnackbar Snackbar
@inject MobilePullToRefreshState PullToRefresh

<PageTitle>Notificações | Condotify</PageTitle>
<PageHeader Eyebrow="CENTRAL DE AVISOS" Title="Notificações" Subtitle="Atualizações importantes da sua rotina.">
    <Actions><MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="Atualizar" /></Actions>
</PageHeader>

@if (!_loading && string.IsNullOrWhiteSpace(_error) && _page is not null)
{
    <section class="screen-overview notification-overview">
        <span class="screen-overview-icon primary"><MudIcon Icon="@Icons.Material.Outlined.NotificationsActive" /></span>
        <div class="screen-overview-main">
            <span>Sua caixa de entrada</span>
            <strong>@UnreadCount notificação(ões) não lida(s)</strong>
            <small>@(_page.Items.Count) atualização(ões) carregadas nesta consulta</small>
        </div>
        <span class="overview-number">@UnreadCount<small>novas</small></span>
    </section>
}

<MudTabs Rounded="false" ApplyEffectsToContainer="true" Class="notification-tabs">
    <MudTabPanel Text="Inbox" Icon="@Icons.Material.Outlined.Inbox">
        <PageState Loading="_loading" Error="@_error" Empty="@(_page?.Items.Count == 0)" EmptyTitle="Tudo em dia" EmptyText="Novas notificações aparecerão aqui." Retry="LoadAsync">
            <section class="content-panel card-list-panel preference-panel">
                @foreach (var item in _page?.Items ?? [])
                {
                    <button class="list-row notification-row @(item.IsRead ? "read" : "")" type="button" @onclick="() => OpenAsync(item)">
                        <MudAvatar Color="@ColorFor(item.Category)" Variant="Variant.Filled"><MudIcon Icon="@IconFor(item.Category)" /></MudAvatar>
                        <div class="list-main"><div class="list-title">@item.Title</div><div class="list-meta">@item.Body</div><div class="list-meta">@item.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div></div>
                        @if (!item.IsRead) { <span class="unread-dot" aria-label="Não lida"></span> }
                    </button>
                }
            </section>
        </PageState>
    </MudTabPanel>
    <MudTabPanel Text="Preferências" Icon="@Icons.Material.Outlined.Tune">
        <PageState Loading="_loadingPreferences" Error="@_preferenceError" Retry="LoadPreferencesAsync">
            <section class="content-panel card-list-panel">
                @foreach (var preference in _preferences)
                {
                    <div class="list-row">
                        <MudIcon Icon="@IconFor(preference.Category)" Color="@ColorFor(preference.Category)" />
                        <div class="list-main"><div class="list-title">@Label(preference.Category)</div><div class="list-meta">@(preference.IsEssential ? "Essencial para segurança da conta" : "Pode ser desativada a qualquer momento")</div></div>
                        <MudSwitch T="bool" Value="preference.Enabled" ValueChanged="value => ChangePreferenceAsync(preference, value)" Disabled="preference.IsEssential" Color="Color.Primary" />
                    </div>
                }
            </section>
            <MudButton Class="mt-4" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Send" OnClick="SendTestAsync">Enviar notificação de teste</MudButton>
        </PageState>
    </MudTabPanel>
</MudTabs>

@code {
    private MobileNotificationPageViewModel? _page;
    private List<MobileNotificationPreferenceViewModel> _preferences = [];
    private bool _loading;
    private bool _loadingPreferences;
    private string _error = string.Empty;
    private string _preferenceError = string.Empty;
    private int UnreadCount => _page?.Items.Count(x => !x.IsRead) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        PullToRefresh.Register(LoadAsync);
        await Task.WhenAll(LoadAsync(), LoadPreferencesAsync());
    }
    public void Dispose() => PullToRefresh.Unregister(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true; _error = string.Empty;
        var result = await Api.GetMobileNotificationsAsync();
        _page = result.Value;
        if (!result.Success) _error = result.Error ?? "Não foi possível carregar as notificações.";
        _loading = false;
    }

    private async Task LoadPreferencesAsync()
    {
        _loadingPreferences = true; _preferenceError = string.Empty;
        var result = await Api.GetMobileNotificationPreferencesAsync();
        _preferences = result.Value ?? [];
        if (!result.Success) _preferenceError = result.Error ?? "Não foi possível carregar as preferências.";
        _loadingPreferences = false;
    }

    private async Task OpenAsync(MobileNotificationViewModel item)
    {
        if (!item.IsRead)
        {
            var result = await Api.MarkMobileNotificationReadAsync(item.Id);
            if (result.Success) item.IsRead = true;
        }
        if (MobileNavigation.TryResolveDeepLink(item.Route, out var route)) Navigation.NavigateTo(route);
    }

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private async Task ChangePreferenceAsync(MobileNotificationPreferenceViewModel changed, bool enabled)
    {
        changed.Enabled = changed.IsEssential || enabled;
        var result = await Api.UpdateMobileNotificationPreferencesAsync(new MobileNotificationPreferencesUpdateViewModel { Preferences = _preferences });
        if (!result.Success) Snackbar.Add(result.Error ?? "Não foi possível salvar.", Severity.Error);
        else _preferences = result.Value ?? _preferences;
    }

    private async Task SendTestAsync()
    {
        var result = await Api.SendTestMobileNotificationAsync();
        Snackbar.Add(result.Success ? "Notificação adicionada à caixa de entrada." : result.Error ?? "Falha no teste.", result.Success ? Severity.Success : Severity.Error);
        if (result.Success) await LoadAsync();
    }

    private static string Label(MobileNotificationCategory category) => category switch { MobileNotificationCategory.Access => "Acessos", MobileNotificationCategory.Visitor => "Visitantes", MobileNotificationCategory.Delivery => "Encomendas", MobileNotificationCategory.Booking => "Reservas", MobileNotificationCategory.Security => "Segurança", MobileNotificationCategory.Operational => "Operação", MobileNotificationCategory.Financial => "Boletos", MobileNotificationCategory.Announcement => "Comunicados", _ => "Sistema" };
    private static string IconFor(MobileNotificationCategory category) => category switch { MobileNotificationCategory.Access => Icons.Material.Outlined.Badge, MobileNotificationCategory.Visitor => Icons.Material.Outlined.Group, MobileNotificationCategory.Delivery => Icons.Material.Outlined.Inventory2, MobileNotificationCategory.Booking => Icons.Material.Outlined.CalendarMonth, MobileNotificationCategory.Security => Icons.Material.Outlined.Security, MobileNotificationCategory.Operational => Icons.Material.Outlined.WarningAmber, MobileNotificationCategory.Financial => Icons.Material.Outlined.ReceiptLong, MobileNotificationCategory.Announcement => Icons.Material.Outlined.Campaign, _ => Icons.Material.Outlined.Info };
    private static Color ColorFor(MobileNotificationCategory category) => category switch { MobileNotificationCategory.Security => Color.Error, MobileNotificationCategory.Operational => Color.Warning, MobileNotificationCategory.Delivery => Color.Info, MobileNotificationCategory.Booking => Color.Tertiary, MobileNotificationCategory.Announcement => Color.Warning, _ => Color.Primary };
}
