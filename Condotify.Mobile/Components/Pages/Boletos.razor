@page "/boletos"
@inject CondotifyApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Boletos | Condotify</PageTitle>
<PageHeader Eyebrow="FINANCEIRO" Title="Boletos" Subtitle="Boletos disponibilizados pela administração para suas unidades.">
    <Actions><MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="Atualizar" /></Actions>
</PageHeader>

<PageState Loading="_loading" Error="@_error" Empty="@(_boletos.Count == 0)" EmptyTitle="Nenhum boleto disponível" EmptyText="Quando a administração publicar um boleto para sua unidade, ele aparece aqui." Retry="LoadAsync">
    <section class="list-group boletos-list">
        @foreach (var boleto in _boletos)
        {
            <div class="list-row boletos-row">
                <span class="settings-icon warning"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span>
                <div class="list-main">
                    <div class="list-title">@boleto.Reference</div>
                    <div class="list-meta">@boleto.UnitLabel · Vencimento @boleto.DueDate.ToString("dd/MM/yyyy")</div>
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.Download" Disabled="@(_opening == boleto.DocumentId)" OnClick="() => OpenAsync(boleto)" aria-label="@($"Abrir boleto {boleto.Reference}")" />
            </div>
        }
    </section>
</PageState>

@code {
    private List<ResidentBoletoViewModel> _boletos = [];
    private bool _loading;
    private Guid? _opening;
    private string _error = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        var result = await Api.GetResidentBoletosAsync();
        _loading = false;
        if (result.Success) _boletos = result.Value ?? [];
        else _error = result.Error ?? "Não foi possível carregar seus boletos.";
    }

    private async Task OpenAsync(ResidentBoletoViewModel boleto)
    {
        _opening = boleto.DocumentId;
        var result = await Api.GetResidentBoletoFileAsync(boleto.DocumentId);
        _opening = null;
        if (!result.Success || string.IsNullOrWhiteSpace(result.Value))
        {
            Snackbar.Add(result.Error ?? "Não foi possível abrir o boleto.", Severity.Error);
            return;
        }

        // A WebView do Android usada pelo BlazorWebView não tem DownloadListener
        // registrado, então um clique em <a download> sobre uma blob: URL é
        // silenciosamente ignorado (confirmado em dispositivo físico). Em vez de
        // tentar um download "silencioso" via JS/blob, gravamos o PDF em um arquivo
        // temporário e abrimos a folha nativa de compartilhamento do MAUI — o
        // residente pode salvar em Arquivos/Downloads, abrir em um leitor de PDF ou
        // compartilhar diretamente.
        var base64 = StripDataUrlPrefix(result.Value!);
        if (base64 is null)
        {
            Snackbar.Add("Não foi possível abrir o boleto.", Severity.Error);
            return;
        }

        try
        {
            var bytes = Convert.FromBase64String(base64);
            var fileName = $"boleto-{SanitizeFileName(boleto.Reference)}.pdf";
            var path = Path.Combine(FileSystem.CacheDirectory, fileName);
            await File.WriteAllBytesAsync(path, bytes);

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = boleto.Reference,
                File = new ShareFile(path)
            });
        }
        catch (Exception)
        {
            Snackbar.Add("Não foi possível abrir o boleto.", Severity.Error);
        }
    }

    /// <summary>
    /// A API client devolve o PDF como data URL ("data:application/pdf;base64,XXXX");
    /// downloadBase64 espera só a carga base64.
    /// </summary>
    private static string? StripDataUrlPrefix(string dataUrl)
    {
        var separator = dataUrl.IndexOf("base64,", StringComparison.OrdinalIgnoreCase);
        return separator < 0 ? null : dataUrl[(separator + "base64,".Length)..];
    }

    /// <summary>
    /// A referência do lote é livre e tipicamente "Agosto/2026" — a barra (e qualquer
    /// outro caractere inválido em nome de arquivo) viraria um caminho no download.
    /// </summary>
    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars().Concat(['/', '\\', ':']).ToHashSet();
        var cleaned = new string(value.Select(c => invalid.Contains(c) ? '-' : c).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "documento" : cleaned;
    }
}
