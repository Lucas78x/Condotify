@page "/devices"
@implements IDisposable
@inject MobileAppState AppState
@inject CondotifyApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Equipamentos | F&amp;F Access</PageTitle>
<PageHeader Eyebrow="CONTROLE DE ACESSO" Title="Equipamentos" Subtitle="Estado dos controladores e acionamentos manuais.">
    <Actions><MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="Atualizar" /></Actions>
</PageHeader>

<PageState Loading="_loading" Error="@_error" Empty="@(_devices.Count == 0)" EmptyTitle="Nenhum equipamento" EmptyText="Cadastre equipamentos pelo portal administrativo." Retry="LoadAsync">
    <section class="screen-overview device-overview">
        <span class="screen-overview-icon success"><MudIcon Icon="@Icons.Material.Outlined.Sensors" /></span>
        <div class="screen-overview-main">
            <span>Disponibilidade da operação</span>
            <strong>@AvailabilityPercent% dos equipamentos online</strong>
            <div class="overview-progress" aria-label="@($"{AvailabilityPercent}% disponível")"><span style="width: @AvailabilityPercent%"></span></div>
        </div>
        <span class="overview-number">@_devices.Count(x => x.IsActive)<small>/ @_devices.Count</small></span>
    </section>
    <div class="metric-grid">
        <div class="metric success"><span class="metric-icon"><MudIcon Icon="@Icons.Material.Outlined.SensorDoor" /></span><span class="metric-value">@_devices.Count(x => x.IsActive)</span><span class="metric-label">Disponíveis</span></div>
        <div class="metric danger"><span class="metric-icon"><MudIcon Icon="@Icons.Material.Outlined.SensorsOff" /></span><span class="metric-value">@_devices.Count(x => !x.IsActive)</span><span class="metric-label">Indisponíveis</span></div>
    </div>
    <div class="device-list">
        @foreach (var device in _devices)
        {
            <section class="content-panel device-card @(device.IsActive ? "is-online" : "is-offline")">
                <div class="list-row device-row">
                    <span class="status-dot @(device.IsActive ? "online" : "")"></span>
                    <div class="list-main">
                        <div class="list-title">@device.Name</div>
                        <div class="list-meta">@device.Model · @device.IPAddress:@device.Port</div>
                        <span class="row-status @(device.IsActive ? "success" : "neutral")">@(device.IsActive ? "Disponível" : "Indisponível")</span>
                        @if (!device.IsActive && !string.IsNullOrWhiteSpace(device.HealthMessage))
                        {
                            <div class="list-meta device-health" title="@device.HealthMessage">@device.HealthMessage</div>
                        }
                    </div>
                    <MudButton Class="device-open-button"
                               Size="Size.Small"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.LockOpen"
                               Disabled="@(!device.IsActive || _opening == device.Id)"
                               OnClick="() => OpenDoorAsync(device)">
                        @(_opening == device.Id ? "Acionando..." : "Abrir porta")
                    </MudButton>
                </div>
            </section>
        }
    </div>
</PageState>

@code {
    private List<AccessDeviceRowViewModel> _devices = [];
    private bool _loading;
    private Guid? _opening;
    private string _error = string.Empty;
    private CancellationTokenSource? _loadCts;
    private int AvailabilityPercent => _devices.Count == 0 ? 0 : (int)Math.Round(_devices.Count(x => x.IsActive) * 100d / _devices.Count);
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var cancellationToken = _loadCts.Token;

        if (!AppState.SelectedLicenseId.HasValue) { _error = "Selecione um condomínio."; return; }
        _loading = true; _error = string.Empty;
        var result = await Api.GetDevicesAsync(AppState.SelectedLicenseId.Value, cancellationToken);
        if (cancellationToken.IsCancellationRequested) return;
        _devices = result.Value ?? [];
        if (!result.Success) _error = result.Error ?? "Não foi possível carregar os equipamentos.";
        _loading = false;
    }

    private async Task OpenDoorAsync(AccessDeviceRowViewModel device)
    {
        var licenseId = AppState.SelectedLicenseId;
        if (!licenseId.HasValue || _opening.HasValue) return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Confirmar acionamento",
            $"Abrir a porta principal de {device.Name}? A operação será auditada.",
            yesText: "Abrir porta",
            cancelText: "Cancelar");
        if (confirmed != true) return;
        try
        {
            _opening = device.Id;
            var result = await Api.OpenDoorAsync(licenseId.Value, device.Id, 1, "Acionamento pelo aplicativo mobile");
            Snackbar.Add(result.Success ? "Porta acionada com sucesso." : result.Error ?? "O equipamento não confirmou o acionamento.", result.Success ? Severity.Success : Severity.Error);
        }
        finally
        {
            _opening = null;
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
