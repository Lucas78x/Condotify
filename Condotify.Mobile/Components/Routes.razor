@inject MobileSessionCoordinator Session
@inject NavigationManager Navigation
@inject MobileDeepLinkState DeepLinks
@inject MobileAppState AppState
@implements IDisposable

<Router AppAssembly="@typeof(MauiProgram).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private bool _restored;

    protected override void OnInitialized() => DeepLinks.Received += NavigateDeepLink;

    private async Task OnNavigateAsync(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        if (!_restored)
        {
            _restored = true;
            await Session.RestoreAsync();
        }

        var loginRoute = context.Path.Equals("login", StringComparison.OrdinalIgnoreCase);
        if (!Session.IsAuthenticated && !loginRoute)
            Navigation.NavigateTo("/login", replace: true);
        else if (Session.IsAuthenticated && loginRoute)
            Navigation.NavigateTo("/home", replace: true);
        else if (Session.IsAuthenticated && !RouteAllowed(context.Path))
            Navigation.NavigateTo("/home", replace: true);

        if (Session.IsAuthenticated && DeepLinks.Consume() is { } pending)
            Navigation.NavigateTo(RouteAllowed(pending) ? pending : "/home");
    }

    private void NavigateDeepLink(string route)
    {
        if (!Session.IsAuthenticated) return;
        DeepLinks.Consume();
        if (RouteAllowed(route))
            InvokeAsync(() => Navigation.NavigateTo(route));
    }

    private bool RouteAllowed(string route) => MobileRouteAuthorization.IsAllowed(
        Session.Current!.Principal,
        route,
        Session.Current.Principal == MobilePrincipalKind.Resident
            ? AppState.ResidentEnabledModules
            : AppState.SelectedLicense?.EnabledModules ?? (long)Condotify.Models.LicenseModuleEnum.All);

    public void Dispose() => DeepLinks.Received -= NavigateDeepLink;
}
