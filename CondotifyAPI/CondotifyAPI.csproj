<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2da917ef-9119-43bf-92f2-191edfa1dcbb</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="MediatR" Version="13.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.24" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Pinned: Microsoft.AspNetCore.Authentication.JwtBearer 8.0.24 wants System.IdentityModel.Tokens.Jwt ~7.1.2,
         but another dependency in the graph (Azure Container Tools -> MSAL) pulls Microsoft.IdentityModel.Tokens/
         JsonWebTokens/Abstractions up to 8.14.0. Left unpinned, NuGet resolves System.IdentityModel.Tokens.Jwt at
         7.1.2 against Microsoft.IdentityModel.Tokens 8.14.0, a version-skewed pair whose JwtPayload/Claims
         enumeration silently drops claims at runtime (observed while adding the license_id/principal_type claims
         in JwtPrincipalTypeTests - the encoded JWT was correct, but reading it back lost entries). Pinning to the
         same 8.x line keeps the whole IdentityModel family internally consistent. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Condotify.Contracts\Condotify.Contracts.csproj" />
    <ProjectReference Include="..\CondotifyAPI.Infrastructure\CondotifyAPI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CondotifyAPI.Tests" />
  </ItemGroup>

</Project>
